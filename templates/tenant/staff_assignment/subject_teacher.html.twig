{% extends 'base.html.twig' %}

{% block title %}Subject Teachers{% endblock %}

{% block body %}
{% import 'tenant/_list_search.html.twig' as search %}
<div class="px-4 py-4 sm:px-6 sm:py-6">
    <div class="mb-6">
        <h1 class="text-xl font-bold text-ink-900 sm:text-2xl">Subject Teachers</h1>
        <p class="mt-1 text-sm text-ink-600">Which teacher takes which subject, in which classes, for which term.</p>
    </div>

    {# ── Assign: one teacher, one subject, many classes ───────────────────── #}
    <section class="mb-6 rounded-lg bg-white p-4 shadow-card sm:p-6">
        <h2 class="font-semibold text-ink-900">Assign a teacher</h2>
        <p class="mt-1 text-sm text-ink-600">
            Choose the teacher, the subject and the term, then tick every class they take it in.
            Each ticked class is one assignment — one submission covers all of them.
        </p>

        <form method="post" class="mt-4 grid gap-4 sm:grid-cols-2">
            <input type="hidden" name="_token" value="{{ csrf_token('subject_teacher_bulk') }}">

            <div x-data="staffPicker({{ staffOptions|json_encode|e('html_attr') }})" class="relative sm:col-span-2">
                <label class="mb-1 block text-sm font-medium text-ink-800" for="st-staff">Staff</label>
                <input id="st-staff" type="text" x-model="query" @focus="open = true" @input="open = true"
                       placeholder="Search staff name…" autocomplete="off"
                       class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                <input type="hidden" name="staff" :value="selected">
                <div x-show="open" x-cloak @click.outside="open = false"
                     class="absolute z-20 mt-1 w-full max-h-60 overflow-y-auto rounded-lg border border-ink-200 bg-white shadow-lg">
                    <template x-for="s in filtered" :key="s.id">
                        <button type="button" @click="choose(s)"
                                class="block min-h-[44px] w-full px-3 py-2 text-left text-sm text-ink-800 hover:bg-accent-50"
                                x-text="s.name"></button>
                    </template>
                    <div x-show="filtered.length === 0" class="px-3 py-2 text-sm text-ink-500">No staff found</div>
                </div>
                <p class="mt-1 text-xs text-ink-500">Search and pick the teacher — the name must be chosen, not typed.</p>
            </div>

            <div>
                <label for="st-subject" class="mb-1 block text-sm font-medium text-ink-800">Subject</label>
                <select id="st-subject" name="subject" required
                        class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                    <option value="">Select a subject</option>
                    {% for deptName, deptSubjects in subjectGroups %}
                        <optgroup label="{{ deptName }}">
                            {% for s in deptSubjects %}
                                <option value="{{ s.id }}">{{ s.name }}</option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="st-term" class="mb-1 block text-sm font-medium text-ink-800">Term</label>
                <select id="st-term" name="term" required
                        class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                    <option value="">Select a term</option>
                    {% for t in terms %}
                        <option value="{{ t.id }}">{{ t.name }} ({{ t.session.name }})</option>
                    {% endfor %}
                </select>
            </div>

            <fieldset class="sm:col-span-2">
                <legend class="mb-2 text-sm font-medium text-ink-800">Classes this teacher takes the subject in</legend>

                <div class="mb-3 flex flex-wrap items-center gap-2">
                    <button type="button" data-select-all
                            class="min-h-[44px] rounded-lg border border-ink-200 px-3 text-sm font-semibold text-ink-700 transition-colors hover:border-accent-300 hover:text-accent-700">
                        Select all
                    </button>
                    <button type="button" data-clear-all
                            class="min-h-[44px] rounded-lg border border-ink-200 px-3 text-sm font-semibold text-ink-700 transition-colors hover:border-accent-300 hover:text-accent-700">
                        Clear
                    </button>
                    <span id="st-selected-count" aria-live="polite" class="text-xs text-ink-500">No class selected</span>
                </div>

                {% for level, rooms in classroomGroups %}
                    <div class="mb-3">
                        <div class="mb-1 flex items-center justify-between gap-2">
                            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">{{ level }}</p>
                            <button type="button" data-select-group="{{ loop.index }}"
                                    class="min-h-[44px] px-2 text-xs font-semibold text-accent-700">
                                Select all {{ level }}
                            </button>
                        </div>
                        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
                            {% for c in rooms %}
                                <label class="flex min-h-[44px] cursor-pointer items-center gap-2 rounded-lg border border-ink-200 px-3 py-2 text-sm text-ink-800 has-[:checked]:border-accent-500 has-[:checked]:bg-accent-50">
                                    <input type="checkbox" name="classrooms[]" value="{{ c.id }}"
                                           data-group="{{ loop.parent.loop.index }}"
                                           class="h-4 w-4 shrink-0 accent-accent-600">
                                    <span class="min-w-0 break-words">{{ c.arm ?: c.name }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <p class="rounded-lg border border-dashed border-ink-300 p-4 text-sm text-ink-700">
                        There are no classes yet.
                        <a href="{{ path('app_tenant_classroom_index') }}" class="font-semibold text-accent-700 underline">
                            Create the school's classes
                        </a>
                        first.
                    </p>
                {% endfor %}
            </fieldset>

            <div class="sm:col-span-2">
                <button type="submit"
                        class="min-h-[44px] w-full rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-accent-700 sm:w-auto">
                    Assign teacher
                </button>
            </div>
        </form>
    </section>

    {# ── Assigned: one card per teacher per subject per term ──────────────── #}
    {{ search.form(q, 'Search teacher, subject, class or term') }}

    {% if groups is empty %}
        <div class="rounded-lg border border-dashed border-ink-300 bg-white p-6 text-center">
            {% if q %}
                <p class="text-sm text-ink-700">No assignment matches “{{ q }}”.</p>
                <a href="{{ path('app_tenant_subject_teacher') }}"
                   class="mt-1 inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-700 underline">
                    Clear the search
                </a>
            {% else %}
                <p class="text-sm font-medium text-ink-900">No subject teachers assigned yet.</p>
                <p class="mt-1 text-sm text-ink-600">Use the form above to give a teacher a subject and the classes they take it in.</p>
            {% endif %}
        </div>
    {% else %}
        <p class="mb-3 text-sm text-ink-600">
            {{ assignmentCount }} assignment{{ assignmentCount == 1 ? '' : 's' }} recorded.
        </p>

        <div class="space-y-3">
            {% for group in groups %}
                <article class="rounded-lg bg-white p-4 shadow-card">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                        <div class="min-w-0">
                            <h3 class="break-words font-semibold text-ink-900">{{ group.subject.name }}</h3>
                            <p class="mt-0.5 break-words text-sm text-ink-700">
                                {{ group.staff.user.fullName|default(group.staff.user.email) }}
                            </p>
                            <p class="mt-0.5 text-xs text-ink-500">
                                {{ group.term.name }} · {{ group.term.session.name }}
                            </p>
                        </div>
                        <span class="badge-neutral shrink-0">{{ group.rows|length }} class{{ group.rows|length == 1 ? '' : 'es' }}</span>
                    </div>

                    <ul class="mt-3 flex flex-wrap gap-2">
                        {% for a in group.rows %}
                            <li>
                                <form method="post"
                                      action="{{ path('app_tenant_subject_teacher_remove', {id: a.id}) }}"
                                      onsubmit="return confirm('Remove {{ a.classroom.name|e('js') }} from {{ a.staff.user.fullName|default(a.staff.user.email)|e('js') }}?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('st' ~ a.id) }}">
                                    <button type="submit"
                                            class="inline-flex min-h-[44px] items-center gap-1.5 rounded-full border border-ink-200 px-3 text-sm text-ink-800 transition-colors hover:border-failed hover:text-failed"
                                            aria-label="Remove {{ a.classroom.name }} from this assignment">
                                        <span class="break-words">{{ a.classroom.name }}</span>
                                        <span aria-hidden="true" class="text-ink-400">&times;</span>
                                    </button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>

                    <p class="mt-2 text-xs text-ink-500">Tap a class to remove it from this teacher.</p>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

{# The class picker is a checkbox list, not a <select multiple>: a multi-select
   needs ctrl/cmd on a desktop, is close to unusable with a thumb, and never
   shows how many classes are actually ticked.

   The `javascripts` block renders in <head>, before the body exists, so the
   work has to wait for DOMContentLoaded. #}
{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var boxes = Array.prototype.slice.call(document.querySelectorAll('input[name="classrooms[]"]'));
            var count = document.getElementById('st-selected-count');

            if (!boxes.length || !count) {
                return;
            }

            function refresh() {
                var n = boxes.filter(function (box) { return box.checked; }).length;
                count.textContent = n === 0
                    ? 'No class selected'
                    : n + (n === 1 ? ' class selected' : ' classes selected');
            }

            boxes.forEach(function (box) { box.addEventListener('change', refresh); });

            document.querySelectorAll('[data-select-group]').forEach(function (button) {
                button.addEventListener('click', function () {
                    boxes.forEach(function (box) {
                        if (box.dataset.group === button.dataset.selectGroup) {
                            box.checked = true;
                        }
                    });
                    refresh();
                });
            });

            var all = document.querySelector('[data-select-all]');
            if (all) {
                all.addEventListener('click', function () {
                    boxes.forEach(function (box) { box.checked = true; });
                    refresh();
                });
            }

            var clear = document.querySelector('[data-clear-all]');
            if (clear) {
                clear.addEventListener('click', function () {
                    boxes.forEach(function (box) { box.checked = false; });
                    refresh();
                });
            }

            refresh();
        });
    </script>
{% endblock %}
