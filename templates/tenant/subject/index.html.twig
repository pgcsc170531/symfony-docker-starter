{% extends 'base.html.twig' %}

{% block title %}Subjects{% endblock %}

{% block body %}
<div class="p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">📚 Subjects</h1>

    {# Create form #}
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="font-semibold mb-4">Create a Subject</h2>
        <form method="post" class="grid gap-4 md:grid-cols-3 items-end">
            <div>
                <label class="block text-sm font-medium mb-1">Name</label>
                <input type="text" name="name" required placeholder="e.g. Mathematics"
                       class="w-full border rounded p-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Code</label>
                <input type="text" name="code" placeholder="e.g. MTH"
                       class="w-full border rounded p-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Department</label>
                <select name="department" class="w-full border rounded p-2 text-sm">
                    <option value="">— No Department —</option>
                    {% for d in departments %}
                        <option value="{{ d.id }}">{{ d.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <button class="bg-blue-600 text-white px-6 py-2 rounded-lg text-sm md:col-span-3 justify-self-start">Create</button>
        </form>
    </div>

    {# List #}
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 text-left text-gray-500">
                <tr>
                    <th class="p-3">Name</th>
                    <th class="p-3">Code</th>
                    <th class="p-3">Department</th>
                    <th class="p-3 text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for s in subjects %}
                    <tr class="border-t">
                        <td class="p-3 font-medium">{{ s.name }}</td>
                        <td class="p-3">{{ s.code|default('—') }}</td>
                        <td class="p-3">{{ s.department ? s.department.name : '—' }}</td>
                        <td class="p-3 text-right">
                            <form method="post" action="{{ path('app_tenant_subject_delete', {id: s.id}) }}"
                                  onsubmit="return confirm('Delete this subject?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('subject' ~ s.id) }}">
                                <button class="text-red-600 text-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr class="border-t">
                        <td class="p-3 text-gray-500" colspan="4">No subjects yet.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
