{% extends 'base.html.twig' %}

{% block title %}Financial History - {{ student.firstName }}{% endblock %}

{% block body %}
<div class="mt-8 px-4 pb-12">

    {# HEADER #}
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="{{ path('app_parent_dashboard') }}" class="inline-flex items-center min-h-[44px] -my-2 text-sm font-bold text-gray-500 hover:text-gray-800">&larr; Back to Dashboard</a>
            <h1 class="text-2xl font-bold text-gray-800">Financial History</h1>
            <p class="text-gray-500">Records for <span class="font-bold text-gray-700">{{ student.fullName }}</span></p>
        </div>
        
        <div class="text-right">
            <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Admission No</div>
            <div class="font-mono font-bold text-gray-700 bg-gray-100 px-3 py-1 rounded">{{ student.admissionNumber }}</div>
        </div>
    </div>

    {# Printable Statement of Account — A4 PDF with a QR that proves the school
       issued it. Full width on a phone: it is the primary action on this page. #}
    <div class="mb-6 flex flex-col gap-2 sm:flex-row">
        <a href="{{ path('app_parent_statement_pdf', {id: student.id, download: 1}) }}"
           class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-lg bg-accent-600 px-5 text-sm font-bold text-white transition-colors hover:bg-accent-700 sm:w-auto">
            <span aria-hidden="true">⬇</span> Download statement (PDF)
        </a>

        {# The offer letter, reprintable at any time — a parent should never have to
           come to the office for a document the school already issued. #}
        <a href="{{ path('app_parent_admission_letter', {id: student.id}) }}" target="_blank" rel="noopener"
           class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-lg border border-ink-300 bg-white px-5 text-sm font-bold text-ink-700 transition-colors hover:border-accent-400 hover:text-accent-700 sm:w-auto">
            <span aria-hidden="true">🖨️</span> Admission letter (PDF)
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {# === LEFT: INVOICE LIST === #}
        <div class="lg:col-span-2">
            <h3 class="font-bold text-gray-700 border-b border-gray-200 pb-2 mb-4 flex items-center gap-2">
                <span>📄</span> Invoices (Bills)
            </h3>

            {% if onlinePaymentAvailable %}
                {# Said before the button, not after: the channel is chosen on the
                   provider's page and cannot be changed once it is open. #}
                {% include 'tenant/parent/_channel_note.html.twig' %}
                <div class="mb-4"></div>
            {% endif %}

            <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                {% if invoices|length > 0 %}
                    {# Wide table: it scrolls inside its own box, never the page (MOBILE-FIRST rule 7). #}
                    <div class="overflow-x-auto">
                    <table class="w-full min-w-[640px] text-sm text-left">
                        <thead class="bg-gray-50 text-gray-500 font-bold">
                            <tr>
                                <th class="p-4">Reference</th>
                                <th class="p-4">Term</th>
                                <th class="p-4">Status</th>
                                <th class="p-4 text-right">Amount</th>
                                <th class="p-4"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for invoice in invoices %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="p-4">
                                        <div class="font-mono font-bold text-gray-700">{{ invoice.invoiceNumber }}</div>
                                        <div class="text-xs text-gray-400">{{ invoice.createdAt|date('d M Y') }}</div>
                                    </td>
                                    <td class="p-4">
                                        <div class="font-bold text-gray-800">{{ invoice.term.name }}</div>
                                        <div class="text-xs text-gray-500">{{ invoice.session.name }}</div>
                                    </td>
                                    <td class="p-4">
                                        {% if invoice.status == 'PAID' %}
                                            <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">Paid</span>
                                        {% elseif invoice.status == 'PARTIAL' %}
                                            <span class="bg-yellow-100 text-yellow-700 px-2 py-1 rounded text-xs font-bold">Partial</span>
                                        {% else %}
                                            <span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold">Unpaid</span>
                                        {% endif %}
                                    </td>
                                    <td class="p-4 text-right">
                                        <div class="font-bold text-gray-800">₦{{ invoice.totalAmount|number_format }}</div>
                                        {% if invoice.discountApplied > 0 %}
                                            <div class="text-xs font-bold text-paid">−₦{{ invoice.discountApplied|number_format }} scholarship</div>
                                        {% endif %}
                                        {% if invoice.balanceDue > 0 %}
                                            <div class="text-xs text-red-500 font-bold">Due: ₦{{ invoice.balanceDue|number_format }}</div>
                                        {% endif %}
                                    </td>
                                    <td class="p-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}" class="inline-flex items-center justify-center min-h-[44px] px-3 border border-indigo-200 rounded text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 font-bold text-xs whitespace-nowrap">
                                                View
                                            </a>
                                            {% if invoice.balanceDue > 0 and onlinePaymentAvailable %}
                                                <form method="post" action="{{ path('app_parent_payment_start', {id: invoice.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('pay_start_' ~ invoice.id) }}">
                                                    <button type="submit"
                                                            class="inline-flex items-center justify-center min-h-[44px] px-4 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold text-xs rounded whitespace-nowrap">
                                                        Pay ₦{{ (onlineTotals[invoice.id] ?? invoice.balanceDue)|number_format(2) }} online
                                                    </button>
                                                </form>
                                                <form method="post" action="{{ path('app_parent_payment_transfer_start', {id: invoice.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('pay_start_' ~ invoice.id) }}">
                                                    <button type="submit"
                                                            class="inline-flex items-center justify-center min-h-[44px] px-3 border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 font-semibold text-xs rounded whitespace-nowrap">
                                                        Bank transfer
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% else %}
                    <div class="p-8 text-center text-gray-400">No invoices found.</div>
                {% endif %}
            </div>
        </div>

        {# === RIGHT: PAYMENT HISTORY === #}
        <div>
            <h3 class="font-bold text-gray-700 border-b border-gray-200 pb-2 mb-4 flex items-center gap-2">
                <span>🧾</span> Payment Receipts
            </h3>

            <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                {% if payments|length > 0 %}
                    <div class="divide-y divide-gray-100">
                        {% for payment in payments %}
                            <div class="p-4 hover:bg-gray-50 transition-colors flex justify-between items-center">
                                <div>
                                    <div class="font-bold text-gray-800">₦{{ payment.amount|number_format }}</div>
                                    <div class="text-xs text-gray-500">{{ payment.createdAt|date('d M Y') }}</div>
                                    <div class="text-[10px] text-gray-400 mt-0.5">{{ payment.method }}</div>
                                </div>
                                <div class="text-right">
                                    {% if payment.status == 'CONFIRMED' %}
                                        <span class="text-[10px] uppercase font-bold text-green-600 block mb-1">Confirmed</span>
                                    {% else %}
                                        <span class="text-[10px] uppercase font-bold text-yellow-600 block mb-1">Pending</span>
                                    {% endif %}
                                    
                                    <a href="{{ path('app_tenant_payment_receipt', {id: payment.id}) }}" target="_blank" class="inline-flex items-center justify-end min-h-[44px] text-indigo-600 hover:text-indigo-900 text-xs font-bold underline">
                                        Receipt
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="p-8 text-center text-gray-400 text-sm">No payments recorded yet.</div>
                {% endif %}
            </div>
        </div>

    </div>
</div>
{% endblock %}