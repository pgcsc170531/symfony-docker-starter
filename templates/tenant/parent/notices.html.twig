{% extends 'base.html.twig' %}

{% block title %}Family updates{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:py-6">

    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div>
            <a href="{{ path('app_tenant_parent_index') }}"
               class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Parents</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Family updates</h1>
            <p class="mt-1 text-sm text-ink-600">
                Parents confirm or dispute a pupil added to their family. A disputed link needs the office.
            </p>
        </div>
    </div>

    <nav class="mb-4 flex flex-wrap gap-2" aria-label="Filter family updates">
        {% for key, label in {
            'reported': 'Reported by parents',
            'pending': 'Awaiting parent',
            'confirmed': 'Confirmed',
            'all': 'All'
        } %}
            <a href="{{ path('app_tenant_parent_notices', {status: key}) }}"
               class="inline-flex min-h-[44px] shrink-0 items-center rounded-lg border px-3 text-sm font-semibold
                      {{ status == key ? 'border-accent-600 bg-accent-600 text-white' : 'border-ink-200 bg-white text-ink-700 hover:border-accent-400' }}">
                {{ label }}
                {% if counts[key] is defined %}
                    <span class="ml-2 rounded-full {{ status == key ? 'bg-white/20 text-white' : 'bg-ink-100 text-ink-600' }} px-2 py-0.5 text-xs font-bold">
                        {{ counts[key] }}
                    </span>
                {% endif %}
            </a>
        {% endfor %}
    </nav>

    {% if notices is empty %}
        <div class="rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card" role="status">
            <p class="text-sm font-semibold text-ink-900">Nothing here.</p>
            <p class="mt-1 text-sm text-ink-600">
                {% if status == 'reported' %}
                    No parent has disputed a family link.
                {% else %}
                    No family updates in this state.
                {% endif %}
            </p>
        </div>
    {% else %}
        <ul class="space-y-3">
            {% for notice in notices %}
                <li class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5">
                    <div class="flex flex-wrap items-center gap-2">
                        {% if notice.status == 'reported' %}
                            <span class="rounded-full bg-failed/10 px-2 py-0.5 text-[11px] font-bold text-failed">Parent reported</span>
                        {% elseif notice.status == 'confirmed' %}
                            <span class="rounded-full bg-paid/10 px-2 py-0.5 text-[11px] font-bold text-paid">Confirmed</span>
                        {% else %}
                            <span class="rounded-full bg-pending/10 px-2 py-0.5 text-[11px] font-bold text-pending">Awaiting parent</span>
                        {% endif %}
                        <span class="text-xs text-ink-500">{{ notice.createdAt|date('j M Y, H:i') }}</span>
                    </div>

                    <p class="mt-2 break-words text-sm text-ink-800">{{ notice.message }}</p>

                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-600">
                        <span>
                            Parent:
                            <a href="{{ path('app_tenant_parent_family', {id: notice.guardian.id}) }}"
                               class="inline-flex min-h-[44px] items-center font-bold text-accent-700 hover:underline">{{ notice.guardian.fullName ?: 'Unnamed parent' }}</a>
                        </span>
                        <span class="font-mono">{{ notice.guardian.phoneNumber ?: 'no phone' }}</span>
                        <span>{{ learner.capital }}: <strong class="text-ink-800">{{ notice.student ? notice.student.fullName : 'removed' }}</strong></span>
                    </div>

                    {% if notice.note %}
                        <div class="mt-3 rounded-lg border border-failed/20 bg-failed/5 p-3">
                            <p class="text-xs font-black uppercase tracking-wide text-failed">Parent's note</p>
                            <p class="mt-1 whitespace-pre-line break-words text-sm text-ink-800">{{ notice.note }}</p>
                        </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
