{% extends 'base.html.twig' %}

{% block title %}{{ guardian.fullName ?: 'Parent' }} · Family{% endblock %}

{% block body %}
{% import 'tenant/_list_search.html.twig' as search %}

<div class="px-4 py-4 sm:py-6">

    <div class="mb-5">
        <a href="{{ path('app_tenant_parent_index') }}"
           class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Parents</a>
        <h1 class="mt-1 break-words text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">
            {{ guardian.fullName ?: 'Parent' }}
        </h1>
        <p class="mt-1 break-words text-sm text-ink-600">
            {{ guardian.relationshipToStudent ?: 'Parent / guardian' }} ·
            {{ guardian.students|length }} {{ guardian.students|length == 1 ? learner : learner.plural }}
        </p>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

        {# ── Contact details ──────────────────────────────────────────── #}
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5">
            <div class="flex items-start justify-between gap-3">
                <h2 class="text-base font-bold text-ink-900">Contact details</h2>
                <a href="{{ path('app_tenant_parent_edit', {id: guardian.id}) }}"
                   class="inline-flex min-h-[44px] shrink-0 items-center rounded-lg border border-accent-300 px-3 text-xs font-bold text-accent-700 hover:bg-accent-50">
                    Edit
                </a>
            </div>

            <dl class="mt-4 space-y-3 text-sm">
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wide text-ink-500">Phone</dt>
                    <dd class="break-words font-mono text-base font-semibold text-ink-900">{{ guardian.phoneNumber ?: 'Not set' }}</dd>
                </div>
                {% if guardian.alternatePhoneNumber %}
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wide text-ink-500">Alternate phone</dt>
                        <dd class="break-words font-mono text-ink-800">{{ guardian.alternatePhoneNumber }}</dd>
                    </div>
                {% endif %}
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wide text-ink-500">Email / login</dt>
                    <dd class="break-all text-ink-800">{{ guardian.email ?: 'No email' }}</dd>
                    {% if guardian.user %}
                        <dd class="mt-0.5 break-all text-xs text-ink-500">Signs in as {{ guardian.user.email }}</dd>
                    {% else %}
                        <dd class="mt-0.5 text-xs text-pending">No portal login attached</dd>
                    {% endif %}
                </div>
                {% if guardian.address %}
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wide text-ink-500">Home address</dt>
                        <dd class="break-words text-ink-800">{{ guardian.address }}</dd>
                    </div>
                {% endif %}
            </dl>
        </section>

        {# ── Children in this family ──────────────────────────────────── #}
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5 lg:col-span-2">
            <h2 class="text-base font-bold text-ink-900">{{ learner.pluralCapital }} in this family</h2>

            {% if guardian.students is empty %}
                <p class="mt-2 text-sm text-ink-600">No {{ learner.plural }} are linked to this parent yet.</p>
            {% else %}
                <ul class="mt-3 divide-y divide-ink-100">
                    {% for child in guardian.students %}
                        <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <div class="min-w-0">
                                <a href="{{ path('app_tenant_student_profile', {id: child.id}) }}"
                                   class="inline-flex min-h-[44px] items-center break-words text-sm font-bold text-accent-700 hover:underline">
                                    {{ child.fullName }}
                                </a>
                                <p class="text-xs text-ink-500">
                                    {{ child.currentClass ? child.currentClass.name : 'No class' }}
                                    · {{ child.admissionNumber ?: 'No admission number' }}
                                </p>
                            </div>
                            <span class="text-xs font-semibold text-ink-500">{{ learner.capital }} record &rarr;</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>

    {# ── Add another child ───────────────────────────────────────────── #}
    <section class="mt-5 rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5">
        <h2 class="text-base font-bold text-ink-900">Add a {{ learner }} to this family</h2>
        <p class="mt-1 text-sm text-ink-600">
            Use this when a parent says a child is in their care but was registered under someone else.
            The parent will see a notice in their portal and can confirm it or report a mistake.
        </p>

        {{ search.form(q, 'Search ' ~ learner.plural ~ ' by name or admission number', path('app_tenant_parent_family', {id: guardian.id})) }}

        {% if q != '' %}
            {% if results is empty %}
                <div class="rounded-lg border border-ink-200 bg-ink-50 p-3 text-sm text-ink-700" role="status">
                    No {{ learner.plural }} match “{{ q }}”, or every match already belongs to this family.
                </div>
            {% else %}
                <form method="post" action="{{ path('app_tenant_parent_children_add', {id: guardian.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('link_children_' ~ guardian.id) }}">

                    <p class="mb-2 text-xs font-bold uppercase tracking-wide text-ink-500">
                        {{ results|length }} result{{ results|length == 1 ? '' : 's' }} — tick the ones to move here
                    </p>

                    <ul class="space-y-2">
                        {% for child in results %}
                            <li>
                                <label class="flex min-h-[44px] cursor-pointer items-start gap-3 rounded-lg border border-ink-200 p-3 hover:border-accent-400 hover:bg-accent-50/40">
                                    <input type="checkbox" name="student_ids[]" value="{{ child.id }}"
                                           class="mt-0.5 h-5 w-5 shrink-0 rounded border-ink-300 text-accent-600 focus:ring-accent-500">
                                    <span class="min-w-0">
                                        <span class="block break-words text-sm font-bold text-ink-900">{{ child.fullName }}</span>
                                        <span class="block text-xs text-ink-500">
                                            {{ child.currentClass ? child.currentClass.name : 'No class' }}
                                            · {{ child.admissionNumber ?: 'No admission number' }}
                                        </span>
                                        {% if child.guardian %}
                                            <span class="mt-1 block text-xs font-semibold text-pending">
                                                Currently under {{ child.guardian.fullName ?: 'another parent' }} — will be moved
                                            </span>
                                        {% else %}
                                            <span class="mt-1 block text-xs text-ink-500">No parent currently linked</span>
                                        {% endif %}
                                    </span>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>

                    <button type="submit"
                            class="mt-4 min-h-[44px] w-full rounded-lg bg-accent-600 px-6 text-sm font-bold text-white shadow-sm hover:bg-accent-700 sm:w-auto">
                        Add selected to this family
                    </button>
                </form>
            {% endif %}
        {% endif %}
    </section>

    {# ── Family updates / parent answers ─────────────────────────────── #}
    <section class="mt-5 rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-base font-bold text-ink-900">Family updates</h2>
            <a href="{{ path('app_tenant_parent_notices') }}"
               class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">
                Reported by parents &rarr;
            </a>
        </div>

        {% if guardian.familyNotices is empty %}
            <p class="mt-2 text-sm text-ink-600">No family changes have been recorded for this parent.</p>
        {% else %}
            <ul class="mt-3 divide-y divide-ink-100">
                {% for notice in guardian.familyNotices|slice(0, 10) %}
                    <li class="py-3">
                        <div class="flex flex-wrap items-center gap-2">
                            {% if notice.status == 'reported' %}
                                <span class="rounded-full bg-failed/10 px-2 py-0.5 text-[11px] font-bold text-failed">Parent reported</span>
                            {% elseif notice.status == 'confirmed' %}
                                <span class="rounded-full bg-paid/10 px-2 py-0.5 text-[11px] font-bold text-paid">Confirmed</span>
                            {% else %}
                                <span class="rounded-full bg-pending/10 px-2 py-0.5 text-[11px] font-bold text-pending">Awaiting parent</span>
                            {% endif %}
                            <span class="text-xs text-ink-500">{{ notice.createdAt|date('j M Y, H:i') }}</span>
                        </div>
                        <p class="mt-1 break-words text-sm text-ink-700">{{ notice.message }}</p>
                        {% if notice.note %}
                            <div class="mt-2 rounded-lg border border-failed/20 bg-failed/5 p-2">
                                <p class="text-xs font-bold uppercase tracking-wide text-failed">Parent's note</p>
                                <p class="mt-0.5 break-words text-sm text-ink-800">{{ notice.note }}</p>
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
