{# Status pill for an application. Expects: status, label. #}
{% set badgeMap = {
    'draft':            'bg-gray-100 text-gray-700 border-gray-200',
    'awaiting_payment': 'bg-amber-50 text-amber-700 border-amber-200',
    'submitted':        'bg-blue-50 text-blue-700 border-blue-200',
    'under_review':     'bg-indigo-50 text-indigo-700 border-indigo-200',
    'needs_info':       'bg-orange-50 text-orange-700 border-orange-200',
    'approved':         'bg-emerald-50 text-emerald-700 border-emerald-200',
    'enrolled':         'bg-green-100 text-green-800 border-green-300',
    'rejected':         'bg-red-50 text-red-700 border-red-200',
    'withdrawn':        'bg-gray-100 text-gray-500 border-gray-200',
    'waitlisted':       'bg-purple-50 text-purple-700 border-purple-200'
} %}
<span class="inline-flex shrink-0 items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide border {{ badgeMap[status]|default('bg-gray-100 text-gray-700 border-gray-200') }}">
    {{ label|default(status) }}
</span>
