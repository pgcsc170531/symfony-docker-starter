{% extends 'base.html.twig' %}

{% block title %}Application fee {{ intent.reference }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-lg px-4 pb-16 pt-6">

    <a href="{{ path('app_parent_applications_show', {id: application.id}) }}"
       class="mb-3 inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-600 hover:text-accent-700">
        &larr; Back to the application
    </a>

    {% set paid = intent.status == 'paid' %}
    {% set failed = intent.status == 'failed' %}

    {# ── STATUS — the first thing a parent sees ─────────────────────────── #}
    <div class="mb-4 rounded-lg border p-5 text-center
        {% if paid %}border-paid/30 bg-paid/10
        {% elseif failed %}border-failed/30 bg-failed/10
        {% else %}border-pending/30 bg-pending/10{% endif %}"
        {% if not paid and not failed %}data-poll-url="{{ path('app_parent_payment_status_json', {reference: intent.reference}) }}"{% endif %}>

        <div class="mb-1 text-3xl" aria-hidden="true">
            {% if paid %}✅{% elseif failed %}⚠️{% else %}⏳{% endif %}
        </div>

        <h1 class="text-lg font-semibold text-ink-900">
            {% if paid %}Fee received
            {% elseif failed %}Payment did not go through
            {% else %}Waiting for your payment{% endif %}
        </h1>

        <p class="mt-1 text-sm leading-relaxed text-ink-600">
            {% if paid %}
                The application form is now open. Fill it in and submit it when you are ready.
                {% if application.reference %}Keep the reference {{ application.reference }}.{% endif %}
            {% elseif failed %}
                The payment was not completed, so nothing has been charged. You can try again below.
            {% else %}
                Finish the payment on the provider's page. This screen updates on its own — no need to refresh.
            {% endif %}
        </p>

        {% if not paid and not failed %}
            <p id="payment-spinner" class="mt-3 text-xs font-semibold text-pending">Checking…</p>
            {% if intent.authorizationUrl %}
                <a href="{{ intent.authorizationUrl }}"
                   class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-6 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                    Return to the payment page
                </a>
            {% endif %}
        {% endif %}

        {% if paid %}
            <a href="{{ path('app_parent_applications_edit', {id: application.id}) }}"
               class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-6 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                Continue the application &rarr;
            </a>
        {% endif %}
    </div>

    {# ── WHAT WAS PAID FOR ──────────────────────────────────────────────── #}
    <div class="mb-4 rounded-lg border border-ink-200 bg-white p-5 shadow-card">
        <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-ink-500">Summary</h2>

        <dl class="space-y-3 text-sm">
            <div class="flex items-start justify-between gap-4">
                <dt class="text-ink-500">Applicant</dt>
                <dd class="min-w-0 break-words text-right font-semibold text-ink-900">
                    {{ application.firstName }} {{ application.lastName }}
                </dd>
            </div>
            <div class="flex items-start justify-between gap-4">
                <dt class="text-ink-500">Application</dt>
                <dd class="min-w-0 break-all text-right font-mono font-semibold text-ink-900">
                    {{ application.reference ?: '—' }}
                </dd>
            </div>
            <div class="flex items-start justify-between gap-4">
                <dt class="text-ink-500">Application fee</dt>
                <dd class="text-right font-semibold text-ink-900">₦{{ intent.invoiceAmount|number_format(2) }}</dd>
            </div>
            {% if intent.processingFee > 0 %}
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-ink-500">
                        Payment processing
                        <span class="block text-xs text-ink-400">capped at ₦500</span>
                    </dt>
                    <dd class="text-right font-semibold text-ink-900">₦{{ intent.processingFee|number_format(2) }}</dd>
                </div>
            {% endif %}
            <div class="flex items-start justify-between gap-4 border-t border-ink-100 pt-3">
                <dt class="font-semibold text-ink-900">Total charged</dt>
                <dd class="money text-right text-xl font-semibold text-accent-700">₦{{ intent.amount|number_format(2) }}</dd>
            </div>
        </dl>

        <p class="mt-4 break-all text-xs text-ink-500">
            Reference: <span class="font-mono">{{ intent.reference }}</span>
        </p>
    </div>

    {% if failed %}
        <form method="post" action="{{ path('app_parent_application_pay', {id: application.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('pay_application_' ~ application.id) }}">
            <button type="submit"
                    class="min-h-[48px] w-full rounded-lg bg-accent-600 font-semibold text-white hover:bg-accent-700">
                Try again
            </button>
        </form>
    {% endif %}

    <p class="mt-4 text-center text-xs leading-relaxed text-ink-400">
        {% if intent.processingFee > 0 %}
            The school receives the full ₦{{ intent.invoiceAmount|number_format(2) }}. The processing
            charge covers the payment provider, so nothing is deducted from the school.
        {% else %}
            The school has covered the provider's charge itself, so you pay the fee exactly.
        {% endif %}
    </p>
</div>
{% endblock %}

{% block javascripts %}
    {% if intent.status == 'pending' %}
        <script>
            // Poll until the provider decides. A parent who pays and switches back
            // should never have to wonder whether it worked.
            (function () {
                var box = document.querySelector('[data-poll-url]');
                if (!box) return;
                var url = box.getAttribute('data-poll-url');
                var tries = 0;

                var timer = setInterval(function () {
                    tries++;
                    fetch(url, { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (data) {
                            if (!data) return;
                            if (data.status !== 'pending') {
                                clearInterval(timer);
                                window.location.reload();
                            }
                        })
                        .catch(function () { /* offline — the next tick retries */ });

                    if (tries >= 60) clearInterval(timer);   // ~5 minutes, then stop
                }, 5000);
            })();
        </script>
    {% endif %}
{% endblock %}
