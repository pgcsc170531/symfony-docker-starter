{% extends 'base.html.twig' %}

{% block title %}Parent Dashboard{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 px-4 pb-12">
    
    {# 1. HEADER #}
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4 border-b border-gray-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Overview</h1>
            <p class="text-gray-500 text-sm">Welcome back, {{ app.user.fullName }}</p>
        </div>
        <div class="text-right">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Current Date</span>
            <p class="text-gray-800 font-bold">{{ "now"|date('l, d M Y') }}</p>
        </div>
    </div>

    {# 🚨 2. URGENT FLASH NOTICES (Placed here for max visibility) #}
    {% if flashEvents is defined and flashEvents is not empty %}
        <div class="mb-8 space-y-3">
            {% for alert in flashEvents %}
                <div class="bg-red-50 border-l-4 border-red-500 p-4 shadow-sm rounded-r-lg">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 text-2xl">🚨</div>
                        <div class="ml-4">
                            <div class="flex items-center gap-2">
                                <h3 class="text-xs font-bold text-red-800 uppercase tracking-widest">Urgent Notice</h3>
                                <span class="bg-red-200 text-red-800 text-[10px] px-2 py-0.5 rounded-full font-bold">{{ alert.type }}</span>
                            </div>
                            <div class="mt-1 text-sm text-red-900 font-black">
                                {{ alert.title }}
                            </div>
                            <div class="mt-1 text-xs text-red-700 leading-relaxed">
                                {{ alert.description }}
                            </div>
                            <div class="mt-2 text-[10px] font-bold text-red-500 uppercase flex items-center gap-1">
                                📅 Event Date: {{ alert.startDate|date('l, d M Y') }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {# === LEFT COLUMN: STUDENTS === #}
        <div class="lg:col-span-2 space-y-6">
            
            {% if studentData|length > 0 %}
                {% for data in studentData %}
                    {% set student = data.student %}
                    {% set invoice = data.invoice %}
                    {% set lastPayment = data.lastPayment %}
                    
                    {# Calculate Debt from the Invoice Object #}
                    {% set debt = invoice ? invoice.balanceDue : 0 %}

                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow group">
                        <div class="flex flex-col sm:flex-row">
                            
                            {# A. Student Identity #}
                            <div class="p-6 sm:w-1/3 border-b sm:border-b-0 sm:border-r border-gray-100 bg-gray-50 flex flex-col justify-center items-center text-center">
                                {% if student.profilePictureFilename %}
                                    <img src="{{ asset('uploads/students/' ~ student.profilePictureFilename) }}" 
                                         alt="{{ student.firstName }}" 
                                         class="h-16 w-16 rounded-full object-cover border-2 border-indigo-100 shadow-sm mb-3">
                                {% else %}
                                    <div class="h-16 w-16 rounded-full bg-white border-2 border-indigo-100 flex items-center justify-center text-xl font-bold text-indigo-700 shadow-sm mb-3">
                                        {{ student.firstName|first }}{{ student.lastName|first }}
                                    </div>
                                {% endif %}
                                <h3 class="font-bold text-gray-900 text-lg">{{ student.firstName }}</h3>
                                <p class="text-xs text-gray-500 uppercase tracking-wide">{{ student.lastName }}</p>
                                <div class="mt-2 inline-block px-2 py-1 bg-white border border-gray-200 rounded text-xs font-mono text-gray-600">
                                    {{ student.admissionNumber }}
                                </div>
                            </div>

                            {# B. Financial Details #}
                            <div class="p-6 sm:w-2/3 flex flex-col justify-between">
                                <div class="flex justify-between items-start mb-4">
                                    <div>
                                        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Financial Status</p>
                                        {% if invoice and debt > 0 %}
                                            <p class="text-2xl font-black text-gray-800">
                                                <span class="text-red-500 mr-1">●</span> ₦{{ debt|number_format(2) }}
                                                <span class="text-xs font-normal text-gray-400 ml-1">Outstanding</span>
                                            </p>
                                        {% else %}
                                            <p class="text-2xl font-black text-green-600">
                                                <span>✓</span> All Fees Cleared
                                            </p>
                                        {% endif %}
                                    </div>

                                    {# Recent Payment Widget #}
                                    {% if lastPayment %}
                                        <div class="text-right hidden sm:block">
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Last Payment</p>
                                            <div class="bg-indigo-50 border border-indigo-100 rounded px-2 py-1 inline-block">
                                                <p class="text-indigo-700 font-bold text-xs">₦{{ lastPayment.amount|number_format }}</p>
                                                <p class="text-[10px] text-indigo-400">{{ lastPayment.createdAt|date('M d') }}</p>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>

                                {# Status Bar & Actions #}
                                <div class="mt-auto pt-4 border-t border-gray-50">
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        {% if lastPayment %}
                                            {% if lastPayment.status == 'CONFIRMED' %}
                                                <a href="{{ path('app_tenant_payment_receipt', {id: lastPayment.id}) }}" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-2 rounded-lg transition-colors bg-green-50 text-green-700 border border-green-200 hover:bg-green-100">
                                                    View Last Receipt 📄
                                                </a>
                                            {% else %}
                                                <div class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-2 rounded-lg bg-yellow-50 text-yellow-700 border border-yellow-200 cursor-help" title="Payment is awaiting confirmation from the Bursar">
                                                    <svg class="w-4 h-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                    Verifying...
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            <span></span>
                                        {% endif %}
                                        
                                        <div class="flex items-center gap-2 ml-auto">
                                            <a href="{{ path('app_parent_finance_view', {id: student.id}) }}" class="bg-white border border-gray-300 text-gray-700 hover:border-indigo-500 hover:text-indigo-600 px-4 py-2 rounded-lg text-sm font-bold transition-colors shadow-sm">
                                                History
                                            </a>
                                            {% if invoice and debt > 0 %}
                                                <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}" class="bg-indigo-600 text-white px-5 py-2 rounded-lg text-sm font-bold hover:bg-indigo-700 shadow-md transition-transform transform hover:-translate-y-0.5 flex items-center gap-2">
                                                    <span>Pay Now</span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-xl p-12 text-center">
                    <p class="text-gray-500 font-medium">No students linked to your profile.</p>
                </div>
            {% endif %}

        </div>

        {# === RIGHT COLUMN: CALENDAR === #}
        <div class="space-y-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between mb-6 pb-2 border-b border-gray-100">
                    <h3 class="font-bold text-gray-800 text-sm uppercase tracking-wide">📅 School Calendar</h3>
                    <a href="{{ path('app_parent_calendar') }}" class="text-[10px] text-indigo-600 font-bold hover:underline">View Full</a>
                </div>
                
                <div class="space-y-4">
                    {# Use the events you already fetched in the controller if applicable, or a simple placeholder #}
                    {% if events is defined and events is not empty %}
                        {% for event in events|slice(0, 5) %}
                            <div class="flex gap-3 items-start border-b border-gray-50 pb-3 last:border-0">
                                <div class="bg-gray-100 rounded text-center px-2 py-1 min-w-[45px]">
                                    <p class="text-[10px] font-bold text-gray-500 uppercase">{{ event.startDate|date('M') }}</p>
                                    <p class="text-sm font-black text-gray-800">{{ event.startDate|date('d') }}</p>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-gray-800 leading-tight">{{ event.title }}</p>
                                    <p class="text-[10px] text-gray-400 mt-0.5">{{ event.type }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center py-4">
                            <p class="text-gray-400 text-xs">No upcoming events scheduled.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}