{% extends 'base.html.twig' %}

{% block title %}Parent Dashboard{% endblock %}

{% block body %}
<div class="mt-6 px-4 pb-12">
    
    {# 1. HEADER #}
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4 border-b border-gray-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Overview</h1>
            <p class="text-gray-500 text-sm">Welcome back, {{ app.user.fullName }}</p>
        </div>
        <div class="text-right">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Current Date</span>
            <p class="text-gray-800 font-bold">{{ "now"|date('l, d M Y') }}</p>
        </div>
    </div>

    {# 🚨 2. URGENT FLASH NOTICES (Placed here for max visibility) #}
    {% if flashEvents is defined and flashEvents is not empty %}
        <div class="mb-8 space-y-3">
            {% for alert in flashEvents %}
                <div class="bg-red-50 border-l-4 border-red-500 p-4 shadow-sm rounded-r-lg">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 text-2xl">🚨</div>
                        <div class="ml-4">
                            <div class="flex items-center gap-2">
                                <h3 class="text-xs font-bold text-red-800 uppercase tracking-widest">Urgent Notice</h3>
                                <span class="bg-red-200 text-red-800 text-[10px] px-2 py-0.5 rounded-full font-bold">{{ alert.type }}</span>
                            </div>
                            <div class="mt-1 text-sm text-red-900 font-black">
                                {{ alert.title }}
                            </div>
                            <div class="mt-1 text-xs text-red-700 leading-relaxed">
                                {{ alert.description }}
                            </div>
                            <div class="mt-2 text-[10px] font-bold text-red-500 uppercase flex items-center gap-1">
                                📅 Event Date: {{ alert.startDate|date('l, d M Y') }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# 👨‍👩‍👧‍👦 FAMILY UPDATES — the school can add a pupil to this family (a
       guardian, a sibling whose number was corrected). The parent is the only
       person who can say whether the link is right, so it asks them directly. #}
    {% if familyNotices is defined and familyNotices is not empty %}
        <section id="family-notices" class="mb-8 space-y-3">
            {% for notice in familyNotices %}
                <div class="overflow-hidden rounded-xl border {{ notice.status == 'reported' ? 'border-failed/30' : 'border-accent-200' }} bg-white shadow-card">
                    <div class="flex items-start gap-3 p-4 sm:p-5">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-accent-50 text-lg" aria-hidden="true">👨‍👩‍👧</span>
                        <div class="min-w-0 flex-1">
                            <h2 class="text-sm font-black uppercase tracking-wide text-accent-700">Family update</h2>
                            <p class="mt-1 break-words text-sm leading-relaxed text-ink-800">{{ notice.message }}</p>

                            {% if notice.status == 'reported' %}
                                <div class="mt-3 rounded-lg border border-failed/20 bg-failed/5 p-3">
                                    <p class="text-xs font-bold uppercase tracking-wide text-failed">Your note to the school</p>
                                    <p class="mt-1 whitespace-pre-line break-words text-sm text-ink-800">{{ notice.note }}</p>
                                </div>
                                <p class="mt-2 text-xs font-semibold text-ink-500">
                                    Sent — the school office will review this link.
                                </p>
                            {% else %}
                                <form method="post" action="{{ path('app_parent_notice_confirm', {id: notice.id}) }}" class="mt-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('confirm_notice_' ~ notice.id) }}">
                                    <button type="submit"
                                            class="min-h-[44px] w-full rounded-lg bg-accent-600 px-4 text-sm font-bold text-white hover:bg-accent-700 sm:w-auto">
                                        This is correct
                                    </button>
                                </form>

                                <details class="mt-3 rounded-lg border border-ink-200 bg-ink-50">
                                    <summary class="flex min-h-[44px] cursor-pointer list-none items-center px-3 text-sm font-semibold text-ink-700">
                                        This is a mistake — write a note
                                    </summary>
                                    <form method="post" action="{{ path('app_parent_notice_report', {id: notice.id}) }}" class="border-t border-ink-200 p-3">
                                        <input type="hidden" name="_token" value="{{ csrf_token('report_notice_' ~ notice.id) }}">
                                        <label for="notice-note-{{ notice.id }}" class="block text-xs font-semibold text-ink-700">
                                            What is wrong? The school office will see this.
                                        </label>
                                        <textarea id="notice-note-{{ notice.id }}" name="note" rows="3" required
                                                  class="mt-1 w-full rounded-lg border border-ink-300 bg-white px-3 py-2 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"></textarea>
                                        <button type="submit"
                                                class="mt-2 min-h-[44px] w-full rounded-lg border border-failed/40 px-4 text-sm font-bold text-failed hover:bg-failed/10 sm:w-auto">
                                            Send note to the school
                                        </button>
                                    </form>
                                </details>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {# === LEFT COLUMN: STUDENTS === #}
        <div class="lg:col-span-2 space-y-6">

            {# 📝 ADMISSION APPLICATIONS — the parent's entry point into the online application flow.
               On a phone this is the first card a parent meets, so it is built at 360px
               first: the title sits on one line beside its icon, the two states (open /
               closed) each say what to do next, and the family's own applications stay
               visible even after the window shuts — they could not see them at all before. #}
            <div id="admission-applications" class="overflow-hidden rounded-xl border border-ink-200 bg-white shadow-card">
                <div class="bg-accent-700 px-4 py-4 sm:px-6 sm:py-5">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                        <div class="flex min-w-0 items-start gap-2.5 sm:gap-3">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/15 text-base sm:h-10 sm:w-10 sm:text-lg" aria-hidden="true">📝</span>
                            <div class="min-w-0">
                                {# "Admission applications" wrapped onto two lines in a 241px card at
                                   360px and read as a squeezed banner. The nav already says
                                   "Admission Applications"; the card only has to say what it is for. #}
                                <h2 class="text-base font-bold leading-tight text-white sm:text-lg">Applications</h2>
                                <p class="mt-0.5 break-words text-xs leading-snug text-accent-100 sm:text-sm">
                                    {% if applicationCount > 0 %}
                                        {{ applicationCount }} application{{ applicationCount == 1 ? '' : 's' }} from your family
                                    {% else %}
                                        Apply online — no queue at the school gate
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        {% if applicationsOpen %}
                            <a href="{{ path('app_parent_applications_new') }}"
                               class="flex min-h-[44px] w-full shrink-0 items-center justify-center rounded-lg bg-white px-4 text-sm font-bold text-accent-700 transition-colors hover:bg-accent-50 sm:w-auto">
                                + Apply for a child
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="px-4 py-4 sm:px-6 sm:py-5">
                    {% if applications is empty %}
                        {% if not applicationsOpen %}
                            <div class="rounded-lg border border-pending/30 bg-pending/10 p-3 text-sm text-ink-700" role="status">
                                <p class="font-semibold text-ink-900">Applications are closed right now.</p>
                                <p class="mt-0.5">
                                    The school will announce when the next window opens. Your child's details are kept,
                                    so the next application takes a minute.
                                </p>
                            </div>
                        {% else %}
                            <ol class="space-y-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:space-y-0">
                                <li class="flex gap-3 sm:block sm:rounded-lg sm:bg-ink-50 sm:p-3 sm:text-center">
                                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent-100 text-sm font-bold text-accent-700" aria-hidden="true">1</span>
                                    <div class="min-w-0">
                                        <p class="text-sm font-bold text-ink-900">Fill in your child's details</p>
                                        <p class="mt-0.5 text-xs text-ink-600">Five short steps, saved as you type.</p>
                                    </div>
                                </li>
                                <li class="flex gap-3 sm:block sm:rounded-lg sm:bg-ink-50 sm:p-3 sm:text-center">
                                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent-100 text-sm font-bold text-accent-700" aria-hidden="true">2</span>
                                    <div class="min-w-0">
                                        <p class="text-sm font-bold text-ink-900">The school reviews it</p>
                                        <p class="mt-0.5 text-xs text-ink-600">You get a reference number immediately.</p>
                                    </div>
                                </li>
                                <li class="flex gap-3 sm:block sm:rounded-lg sm:bg-ink-50 sm:p-3 sm:text-center">
                                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent-100 text-sm font-bold text-accent-700" aria-hidden="true">3</span>
                                    <div class="min-w-0">
                                        <p class="text-sm font-bold text-ink-900">Your child is enrolled</p>
                                        <p class="mt-0.5 text-xs text-ink-600">Fees and results then appear here.</p>
                                    </div>
                                </li>
                            </ol>
                        {% endif %}
                    {% else %}
                        {# The window closing does not hide a family's own applications — they
                           were told to look "below" and there was nothing below. #}
                        {% if not applicationsOpen %}
                            <p class="mb-3 rounded-lg border border-pending/30 bg-pending/10 p-3 text-sm text-ink-700" role="status">
                                <span class="font-semibold text-ink-900">Applications are closed right now.</span>
                                What your family has already submitted is below.
                            </p>
                        {% endif %}

                        <ul class="space-y-2">
                            {% for application in applications %}
                                <li>
                                    <a href="{{ path('app_parent_applications_show', {id: application.id}) }}"
                                       class="flex min-h-[44px] items-center justify-between gap-3 rounded-lg border border-ink-200 p-3 transition-colors hover:border-accent-400 hover:bg-accent-50/40">
                                        <span class="min-w-0">
                                            <span class="block break-words text-sm font-bold text-ink-900">
                                                {{ application.fullName ?: (application.status == 'awaiting_payment' ? 'New application — awaiting payment' : 'Unnamed draft') }}
                                            </span>
                                            <span class="mt-0.5 block text-xs text-ink-500">
                                                {{ application.reference ?: 'Not submitted yet' }}
                                                {%- if application.requestedClassName %} · {{ application.requestedClassName }}{% endif -%}
                                            </span>
                                        </span>
                                        {% include 'tenant/parent/applications/_status_badge.html.twig' with {
                                            status: application.status,
                                            label: application.statusLabel
                                        } only %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>

                        <div class="mt-3 border-t border-ink-100 pt-1 text-right">
                            <a href="{{ path('app_parent_applications_index') }}"
                               class="inline-flex min-h-[44px] items-center px-1 text-xs font-bold text-accent-700 hover:underline">
                                View all applications →
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            {% if studentData|length > 0 %}
                {% for data in studentData %}
                    {% set student = data.student %}
                    {% set invoice = data.invoice %}
                    {% set lastPayment = data.lastPayment %}
                    
                    {# Calculate Debt from the Invoice Object #}
                    {% set debt = invoice ? invoice.balanceDue : 0 %}

                    <div class="overflow-hidden rounded-xl border border-ink-200 bg-white shadow-card transition-shadow hover:shadow-md">
                        <div class="flex flex-col sm:flex-row">

                            {# A. Student identity — one compact row on a phone (avatar left,
                               name and admission number right). The tall centred block from
                               640px up, where there is room for it. #}
                            <div class="flex items-center gap-3 border-b border-ink-100 p-4 text-left sm:w-1/3 sm:flex-col sm:justify-center sm:border-b-0 sm:border-r sm:bg-ink-50 sm:p-6 sm:text-center">
                                {% if student.profilePictureFilename %}
                                    <img src="{{ asset('uploads/students/' ~ student.profilePictureFilename) }}"
                                         alt=""
                                         class="h-12 w-12 shrink-0 rounded-full border-2 border-accent-100 object-cover sm:mb-3 sm:h-16 sm:w-16">
                                {% else %}
                                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-accent-100 bg-white text-base font-bold text-accent-700 sm:mb-3 sm:h-16 sm:w-16 sm:text-xl"
                                         aria-hidden="true">
                                        {{ student.firstName|first }}{{ student.lastName|first }}
                                    </div>
                                {% endif %}
                                <div class="min-w-0">
                                    <h3 class="break-words text-base font-bold leading-tight text-ink-900 sm:text-lg">
                                        {{ student.firstName }} {{ student.lastName }}
                                    </h3>
                                    {% if student.admissionNumber %}
                                        <p class="mt-1 inline-block rounded border border-ink-200 bg-white px-2 py-0.5 font-mono text-[11px] text-ink-600">
                                            {{ student.admissionNumber }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>

                            {# B. Financial Details #}
                            <div class="flex flex-col justify-between p-4 sm:w-2/3 sm:p-6">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="mb-1 text-[11px] font-bold uppercase tracking-wider text-ink-500">Financial status</p>
                                        {% if invoice and debt > 0 %}
                                            <p class="text-xl font-black leading-tight text-ink-900 sm:text-2xl">
                                                <span class="mr-1 text-failed" aria-hidden="true">●</span>₦{{ debt|number_format(2) }}
                                            </p>
                                            <p class="mt-0.5 text-xs text-ink-500">Outstanding</p>
                                        {% else %}
                                            <p class="text-xl font-black leading-tight text-paid sm:text-2xl">
                                                <span aria-hidden="true">✓</span> All fees cleared
                                            </p>
                                        {% endif %}
                                    </div>

                                    {# Recent Payment Widget — desktop only; on a phone the
                                       receipt link below is the useful part. #}
                                    {% if lastPayment %}
                                        <div class="hidden text-right sm:block">
                                            <p class="mb-1 text-[10px] font-bold uppercase text-ink-400">Last payment</p>
                                            <div class="inline-block rounded border border-accent-100 bg-accent-50 px-2 py-1">
                                                <p class="text-xs font-bold text-accent-700">₦{{ lastPayment.amount|number_format }}</p>
                                                <p class="text-[10px] text-accent-400">{{ lastPayment.createdAt|date('M d') }}</p>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>

                                {# Status & actions.
                                   On a phone this is a stacked list: the primary action
                                   first (nearest the thumb) and every control full width.
                                   From 640px it becomes the right-aligned row it always
                                   was. The status pill sits above the buttons rather than
                                   being squeezed beside them on a 360px screen. #}
                                <div class="mt-4 border-t border-ink-100 pt-3 sm:pt-4">
                                    {% if lastPayment %}
                                        <div class="mb-3 sm:mb-2">
                                            {% if lastPayment.status == 'CONFIRMED' %}
                                                <a href="{{ path('app_tenant_payment_receipt', {id: lastPayment.id}) }}" target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-1.5 rounded-lg border border-paid/20 bg-paid/5 px-3 text-xs font-bold text-paid transition-colors hover:bg-paid/10">
                                                    View last receipt 📄
                                                </a>
                                            {% elseif lastPayment.status == 'DECLINED' %}
                                                {# The reason itself lives in Fees & Payments; this points the parent there. #}
                                                <a href="{{ path('app_parent_finance_view', {id: student.id}) }}"
                                                   class="inline-flex min-h-[44px] max-w-full items-center gap-1.5 rounded-lg border border-failed/20 bg-failed/5 px-3 py-2 text-left text-xs font-bold text-failed"
                                                   title="{{ lastPayment.rejectionReason ?: lastPayment.note }}">
                                                    ✕ Payment rejected — read why
                                                </a>
                                            {% elseif lastPayment.status == 'CANCELLED' %}
                                                <div class="inline-flex items-center gap-1.5 rounded-lg border border-ink-200 bg-ink-50 px-3 py-2 text-xs font-bold text-ink-600">
                                                    Payment cancelled
                                                </div>
                                            {% else %}
                                                <a href="{{ path('app_parent_finance_view', {id: student.id}) }}"
                                                   class="inline-flex items-center gap-1.5 rounded-lg border border-pending/20 bg-pending/5 px-3 py-2 text-xs font-bold text-pending"
                                                   title="Your payment has been recorded and is waiting for the school office to confirm it.">
                                                    <svg class="h-4 w-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                    Waiting for the school to confirm
                                                </a>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {# Actions. The financial column is only ~310px even on a wide
                                       screen, so a row of three never fitted. On a phone every
                                       button is a full-width two-line stack; from 640px the
                                       subtitles drop and it becomes two compact 44px rows —
                                       which is what keeps the card short on a desktop. #}
                                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                                        {% if invoice and debt > 0 %}
                                            {# This opens the bill, not a slip — so it says what it
                                               does. The slip is generated on that page. #}
                                            <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}"
                                               class="order-1 flex min-h-[54px] w-full flex-col items-center justify-center gap-0.5 rounded-lg border border-ink-300 bg-white px-3 py-2 text-center leading-tight transition-colors hover:border-accent-400 hover:bg-accent-50 sm:min-h-[44px] sm:flex-row sm:gap-2">
                                                {# Two labels: the full wording on a phone, where the
                                                   button is full width; the short one in the 165px
                                                   half-column on desktop, where the long one wrapped. #}
                                                <span class="text-sm font-bold text-ink-800">
                                                    <span aria-hidden="true">🧾</span>
                                                    <span class="sm:hidden">School fees details</span>
                                                    <span class="hidden sm:inline">Fees details</span>
                                                </span>
                                                <span class="text-[11px] text-ink-500 sm:hidden">Bill · payment slip</span>
                                            </a>
                                        {% endif %}

                                        <a href="{{ path('app_parent_finance_view', {id: student.id}) }}"
                                           class="order-2 flex min-h-[54px] w-full flex-col items-center justify-center gap-0.5 rounded-lg border border-ink-300 bg-white px-3 py-2 text-center leading-tight transition-colors hover:border-accent-400 hover:bg-accent-50 sm:min-h-[44px] sm:flex-row sm:gap-2">
                                            <span class="text-sm font-semibold text-ink-700">History</span>
                                            <span class="text-[11px] text-ink-500 sm:hidden">Receipts &amp; payments</span>
                                        </a>

                                        {% if invoice and debt > 0 and onlinePaymentAvailable %}
                                            {# Paying by card before the office sees it: same POST the Fees
                                               screen uses, so the amount, the charge policy and the
                                               ownership check are decided server-side, once.
                                               Sits last: it is the biggest commitment on the card. #}
                                            <form method="post" action="{{ path('app_parent_payment_start', {id: invoice.id}) }}" class="order-3 w-full sm:col-span-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('pay_start_' ~ invoice.id) }}">
                                                <button type="submit"
                                                        class="flex min-h-[54px] w-full flex-col items-center justify-center gap-0.5 rounded-lg bg-accent-600 px-3 py-2 text-center leading-tight text-white shadow-sm transition-colors hover:bg-accent-700 sm:min-h-[44px] sm:flex-row sm:gap-2">
                                                    <span class="text-sm font-bold">💳 Pay ₦{{ (onlineTotals[invoice.id] ?? invoice.balanceDue)|number_format(2) }} online</span>
                                                    <span class="text-[11px] font-normal text-white/85 sm:hidden">Confirmed instantly</span>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="rounded-xl border-2 border-dashed border-ink-200 bg-ink-50 p-8 text-center">
                    <p class="text-sm font-bold text-ink-800">No {{ learner.plural }} linked yet</p>
                    <p class="mx-auto mt-1 max-w-sm text-sm text-ink-600">
                        Once the school admits a child, their fees, results and receipts appear here.
                    </p>
                    <a href="{{ path('app_tenant_apply_index') }}"
                       class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                        Start an application
                    </a>
                </div>
            {% endif %}

        </div>

        {# === RIGHT COLUMN: CALENDAR === #}
        <div class="space-y-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between mb-6 pb-2 border-b border-gray-100">
                    <h3 class="font-bold text-gray-800 text-sm uppercase tracking-wide">📅 School Calendar</h3>
                    <a href="{{ path('app_parent_calendar') }}" class="inline-flex min-h-[44px] items-center px-1 text-[10px] font-semibold text-accent-600 hover:underline">View Full</a>
                </div>
                
                <div class="space-y-4">
                    {# Use the events you already fetched in the controller if applicable, or a simple placeholder #}
                    {% if events is defined and events is not empty %}
                        {% for event in events|slice(0, 5) %}
                            <div class="flex gap-3 items-start border-b border-gray-50 pb-3 last:border-0">
                                <div class="bg-gray-100 rounded text-center px-2 py-1 min-w-[45px]">
                                    <p class="text-[10px] font-bold text-gray-500 uppercase">{{ event.startDate|date('M') }}</p>
                                    <p class="text-sm font-black text-gray-800">{{ event.startDate|date('d') }}</p>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-gray-800 leading-tight">{{ event.title }}</p>
                                    <p class="text-[10px] text-gray-400 mt-0.5">{{ event.type }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center py-4">
                            <p class="text-gray-400 text-xs">No upcoming events scheduled.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}