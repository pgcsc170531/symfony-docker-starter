{% extends 'base.html.twig' %}

{% block title %}School Store{% endblock %}

{% block body %}
<div class="container mx-auto mt-10 p-5 grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <div class="md:col-span-1">
        <div class="bg-white p-6 rounded shadow border-t-4 border-teal-500">
            <h2 class="text-xl font-bold mb-4">Add New Item</h2>
            {{ form_start(form) }}
                <div class="mb-3">{{ form_row(form.name) }}</div>
                <div class="mb-3">{{ form_row(form.category) }}</div>
                <div class="grid grid-cols-2 gap-4 mb-3">
                    <div>{{ form_row(form.stockQuantity) }}</div>
                    <div>{{ form_row(form.unitPrice) }}</div>
                </div>
                <div class="mb-3">{{ form_row(form.classroom) }}</div>
                <button class="bg-teal-600 text-white w-full py-2 rounded font-bold hover:bg-teal-700">Add to Store</button>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="md:col-span-2">
        <div class="bg-white rounded shadow p-6">
            <h2 class="text-xl font-bold mb-4">Store Inventory</h2>
             <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-gray-100 border-b">
                    <tr>
                        <th class="text-left py-2 px-4">Item</th>
                        <th class="text-left py-2 px-4">Category</th>
                        <th class="text-right py-2 px-4">Price</th>
                        <th class="text-center py-2 px-4">Stock</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in products %}
                    <tr class="border-b hover:bg-gray-50">
                        <td class="py-2 px-4 font-bold">{{ item.name }}
                            {% if item.classroom %}
                                <span class="text-xs text-gray-500 block">({{ item.classroom.name }})</span>
                            {% endif %}
                        </td>
                        <td class="py-2 px-4">
                            <span class="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded">{{ item.category }}</span>
                        </td>
                        <td class="py-2 px-4 text-right">₦{{ item.unitPrice|number_format(2) }}</td>
                        <td class="py-2 px-4 text-center">
                            {% if item.stockQuantity < 5 %}
                                <span class="text-red-600 font-bold">{{ item.stockQuantity }} (Low)</span>
                            {% else %}
                                <span class="text-green-600 font-bold">{{ item.stockQuantity }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" class="p-4 text-center">Store is empty.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}