{% extends 'base.html.twig' %}

{% block title %}Store Inventory{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 md:mt-10 p-4 md:p-6">
    
    {# --- PAGE HEADER & BULK ACTION --- #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Store Inventory</h1>
            <p class="text-sm text-gray-500 mt-1">Manage physical products, uniforms, and books available for POS sale.</p>
        </div>
        
        {# 🟢 BULK UPLOAD TOGGLE BUTTON #}
        <button onclick="document.getElementById('bulk-upload-section').classList.toggle('hidden')" class="w-full md:w-auto bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition flex items-center justify-center">
            <span class="mr-2">📁</span> Bulk Import CSV
        </button>
    </div>

    {# 🟢 HIDDEN BULK UPLOAD FORM #}
    <div id="bulk-upload-section" class="hidden bg-green-50 border border-green-200 p-6 rounded-xl mb-8 shadow-sm">
        <h3 class="font-bold text-green-800 mb-2">Upload Inventory CSV</h3>
        <p class="text-sm text-green-700 mb-4">Your CSV must have these exact columns: <span class="font-mono bg-white px-2 py-0.5 rounded text-xs border border-green-200">Name | Category | Price | Stock | ClassID (Optional)</span></p>
        
        <form method="POST" action="{{ path('app_tenant_product_bulk') }}" enctype="multipart/form-data" class="flex flex-col sm:flex-row gap-3">
            <input type="file" name="csv_file" accept=".csv" required class="block w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-white file:text-green-700 hover:file:bg-gray-50 border border-green-300 rounded-md bg-white">
            <button type="submit" class="bg-green-700 text-white px-6 py-2.5 rounded-md font-bold shadow-sm hover:bg-green-800 transition whitespace-nowrap">Upload File</button>
        </form>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
        
        {# --- LEFT COLUMN: ADD ITEM FORM --- #}
        <div class="lg:col-span-1">
            <div class="bg-white p-5 md:p-6 rounded-xl shadow-sm border border-gray-200 sticky top-6">
                <div class="flex items-center gap-2 mb-6 border-b border-gray-100 pb-4">
                    <span class="text-xl">📦</span>
                    <h2 class="text-lg font-bold text-gray-800">Add Single Item</h2>
                </div>
                
                {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
                    
                    <div>
                        {{ form_label(form.name, null, {'label_attr': {'class': 'block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'w-full border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white'}}) }}
                    </div>

                    <div>
                        {{ form_label(form.category, null, {'label_attr': {'class': 'block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1'}}) }}
                        {{ form_widget(form.category, {'attr': {'class': 'w-full border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white'}}) }}
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            {{ form_label(form.stockQuantity, 'Stock', {'label_attr': {'class': 'block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1'}}) }}
                            {{ form_widget(form.stockQuantity, {'attr': {'class': 'w-full border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white'}}) }}
                        </div>
                        <div>
                            {{ form_label(form.unitPrice, 'Price (₦)', {'label_attr': {'class': 'block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1'}}) }}
                            {{ form_widget(form.unitPrice, {'attr': {'class': 'w-full border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white'}}) }}
                        </div>
                    </div>

                    <div>
                        {{ form_label(form.classroom, 'Class (Optional)', {'label_attr': {'class': 'block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1'}}) }}
                        {{ form_widget(form.classroom, {'attr': {'class': 'w-full border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white'}}) }}
                    </div>

                    <button type="submit" class="mt-4 w-full bg-indigo-600 text-white py-3 rounded-md font-bold hover:bg-indigo-700 shadow-md transition-transform transform hover:-translate-y-0.5">
                        ➕ Add to Store
                    </button>
                    
                {{ form_end(form) }}
            </div>
        </div>

        {# --- RIGHT COLUMN: INVENTORY TABLE --- #}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                
                <div class="p-5 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h2 class="text-lg font-bold text-gray-800">Current Inventory</h2>
                    <span class="text-xs font-bold bg-white border border-gray-200 px-3 py-1 rounded-full text-gray-600 shadow-sm">
                        Total Items: {{ products|length }}
                    </span>
                </div>

                {# 🟢 MOBILE RESPONSIVE SCROLL WRAPPER #}
                <div class="overflow-x-auto w-full">
                    {# 🟢 min-w-[800px] forces it to scroll sideways on phones instead of squishing #}
                    <table class="w-full min-w-[800px] text-left text-sm whitespace-nowrap">
                       <thead class="bg-gray-50 border-b border-gray-200 sticky top-0 z-10 shadow-sm">
                            <tr>
                                <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Item Details</th>
                                <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Category</th>
                                <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Price</th>
                                <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-center">Stock</th>
                                <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for item in products %}
                            <tr class="hover:bg-indigo-50/30 transition-colors bg-white">
                                
                                <td class="p-4">
                                    <p class="font-bold text-gray-900">{{ item.name }}</p>
                                    {% if item.classroom %}
                                        <p class="text-[11px] text-indigo-600 font-bold mt-0.5">Assigned to: {{ item.classroom.name }}</p>
                                    {% else %}
                                        <p class="text-[11px] text-gray-400 font-medium mt-0.5">General Item</p>
                                    {% endif %}
                                </td>
                                
                                <td class="p-4">
                                    <span class="bg-gray-100 border border-gray-200 text-gray-700 text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wide">
                                        {{ item.category }}
                                    </span>
                                </td>
                                
                                <td class="p-4 text-right font-medium text-gray-700">
                                    ₦{{ item.unitPrice|number_format(2) }}
                                </td>
                                
                                <td class="p-4 text-center">
                                    {% if item.stockQuantity <= 0 %}
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-red-50 text-red-700 border border-red-200">Out of Stock (0)</span>
                                    {% elseif item.stockQuantity < 5 %}
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-yellow-50 text-yellow-700 border border-yellow-200">Low Stock ({{ item.stockQuantity }})</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-green-50 text-green-700 border border-green-200">{{ item.stockQuantity }} in Stock</span>
                                    {% endif %}
                                </td>
                                
                                {# 🟢 EDIT & DELETE BUTTONS #}
                                <td class="p-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a href="{{ path('app_tenant_product_edit', {id: item.id}) }}" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-3 py-1.5 rounded text-xs font-bold shadow-sm transition">
                                            Edit
                                        </a>
                                        <form method="post" action="{{ path('app_tenant_product_delete', {'id': item.id}) }}" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                            <button type="submit" class="bg-red-50 border border-red-200 hover:bg-red-100 text-red-700 px-3 py-1.5 rounded text-xs font-bold shadow-sm transition">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                                
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="p-12 text-center">
                                    <div class="flex flex-col items-center justify-center text-gray-400">
                                        <svg class="w-12 h-12 mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                                        <p class="text-base font-medium text-gray-500">Your store inventory is currently empty.</p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        
    </div>
</div>
{% endblock %}