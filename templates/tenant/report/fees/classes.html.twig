{% extends 'base.html.twig' %}

{% block title %}Collection by Class{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Collection by class</h1>
            {% if term %}<p class="mt-1 text-sm text-ink-600">{{ term.session.name }} · {{ term.name }}</p>{% endif %}
        </div>
        <div class="no-print">
            {% include 'tenant/report/fees/_term_filter.html.twig' with {
                action: path('app_tenant_report_classes'),
                terms: terms,
                term: term
            } only %}
        </div>
    </div>

    {% if term is null %}
        <div class="rounded-xl border border-ink-200 bg-white p-8 text-center text-sm text-ink-600">
            No term selected. Create a term to see fee collection.
        </div>
    {% else %}

        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Expected</p>
                <p class="money mt-1 text-xl font-black text-ink-900">₦{{ totals.netBillable|number_format(2) }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Collected</p>
                <p class="money mt-1 text-xl font-black text-paid">₦{{ totals.collected|number_format(2) }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Outstanding</p>
                <p class="money mt-1 text-xl font-black text-failed">₦{{ totals.outstanding|number_format(2) }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Rate</p>
                <p class="mt-1 text-xl font-black text-ink-900">{{ totals.collectionRate is null ? '—' : totals.collectionRate ~ '%' }}</p>
            </div>
        </div>

        {% if rows is empty %}
            <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
                <p class="text-4xl" aria-hidden="true">🏫</p>
                <h2 class="mt-3 text-lg font-bold text-ink-900">No invoices for this term</h2>
                <p class="mt-1 text-sm text-ink-600">Generate invoices for the classes, then come back.</p>
            </div>
        {% else %}
            <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 bg-white sm:block">
                <table class="min-w-[640px] w-full text-left text-sm">
                    <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                        <tr>
                            <th class="px-4 py-3">Class</th>
                            <th class="px-4 py-3 text-right">Pupils</th>
                            <th class="px-4 py-3 text-right">Expected</th>
                            <th class="px-4 py-3 text-right">Collected</th>
                            <th class="px-4 py-3 text-right">Outstanding</th>
                            <th class="px-4 py-3 text-right">Rate</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for row in rows %}
                            <tr>
                                <td class="px-4 py-3 font-semibold text-ink-900">{{ row.class ?: 'Unassigned' }}</td>
                                <td class="px-4 py-3 text-right text-ink-700">{{ row.pupils }}</td>
                                <td class="money px-4 py-3 text-right text-ink-900">₦{{ row.billed|number_format(2) }}</td>
                                <td class="money px-4 py-3 text-right text-paid">₦{{ row.collected|number_format(2) }}</td>
                                <td class="money px-4 py-3 text-right {{ row.outstanding > 0 ? 'text-failed' : 'text-ink-400' }}">₦{{ row.outstanding|number_format(2) }}</td>
                                <td class="px-4 py-3 text-right text-ink-700">
                                    {{ row.billed > 0 ? (row.collected / row.billed * 100)|round(1) ~ '%' : '—' }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-4 space-y-2 sm:hidden">
                {% for row in rows %}
                    <div class="rounded-xl border border-ink-200 bg-white p-3">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="font-semibold text-ink-900">{{ row.class ?: 'Unassigned' }}</p>
                                <p class="text-xs text-ink-500">{{ row.pupils }} pupil{{ row.pupils == 1 ? '' : 's' }}</p>
                            </div>
                            <span class="rounded bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-700">
                                {{ row.billed > 0 ? (row.collected / row.billed * 100)|round(1) ~ '%' : '—' }}
                            </span>
                        </div>
                        <dl class="mt-2 grid grid-cols-3 gap-2 text-xs">
                            <div><dt class="text-ink-500">Expected</dt><dd class="money font-semibold text-ink-900">₦{{ row.billed|number_format(2) }}</dd></div>
                            <div><dt class="text-ink-500">Collected</dt><dd class="money font-semibold text-paid">₦{{ row.collected|number_format(2) }}</dd></div>
                            <div><dt class="text-ink-500">Owing</dt><dd class="money font-semibold {{ row.outstanding > 0 ? 'text-failed' : 'text-ink-400' }}">₦{{ row.outstanding|number_format(2) }}</dd></div>
                        </dl>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if unbilled is not empty %}
            <details class="mt-4 rounded-xl border border-pending/40 bg-pending/5 p-4">
                <summary class="flex min-h-[44px] cursor-pointer items-center justify-between gap-3 font-semibold text-ink-900">
                    <span>{{ unbilled|length }} enrolled pupil{{ unbilled|length == 1 ? '' : 's' }} not billed for this term</span>
                    <span class="text-xl text-ink-500" aria-hidden="true">+</span>
                </summary>
                <p class="mt-2 text-sm text-ink-700">They are not counted as owing or paid until an invoice exists.</p>
                <ul class="mt-2 grid gap-1 text-sm text-ink-700 sm:grid-cols-2">
                    {% for pupil in unbilled %}
                        <li class="break-words">{{ pupil.fullName }} <span class="text-xs text-ink-500">{{ pupil.admissionNumber }}</span></li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}

        <div class="mt-4 flex justify-end no-print">
            <button type="button" onclick="window.print()"
                    class="min-h-[44px] rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Print
            </button>
        </div>
    {% endif %}
</div>
{% endblock %}
