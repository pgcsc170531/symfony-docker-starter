{% extends 'base.html.twig' %}

{% block title %}Discounts & Scholarships{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Discounts &amp; scholarships</h1>
            {% if term %}<p class="mt-1 text-sm text-ink-600">{{ term.session.name }} · {{ term.name }}</p>{% endif %}
        </div>
        <div class="no-print">
            {% include 'tenant/report/fees/_term_filter.html.twig' with {
                action: path('app_tenant_report_discounts'),
                terms: terms,
                term: term
            } only %}
        </div>
    </div>

    {% if term is null %}
        <div class="rounded-xl border border-ink-200 bg-white p-8 text-center text-sm text-ink-600">
            No term selected.
        </div>
    {% else %}
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Waived this term</p>
                <p class="money mt-1 text-xl font-black text-ink-900">₦{{ data.totals.waived|number_format(2) }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Beneficiaries</p>
                <p class="mt-1 text-xl font-black text-ink-900">{{ data.totals.beneficiaries }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Assigned</p>
                <p class="mt-1 text-xl font-black text-ink-900">{{ data.totals.assigned }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">No invoice yet</p>
                <p class="mt-1 text-xl font-black {{ data.totals.missingInvoice > 0 ? 'text-pending' : 'text-ink-400' }}">{{ data.totals.missingInvoice }}</p>
            </div>
        </div>

        {% if data.totals.missingInvoice > 0 %}
            <p class="mt-3 rounded-lg border border-pending/30 bg-pending/5 px-3 py-2 text-sm text-ink-700">
                {{ data.totals.missingInvoice }} discount assignment{{ data.totals.missingInvoice == 1 ? '' : 's' }}
                {{ data.totals.missingInvoice == 1 ? 'has' : 'have' }} no invoice for this term. The discount has not been applied to any bill yet.
            </p>
        {% endif %}

        {% if data.rows is empty %}
            <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
                <p class="text-4xl" aria-hidden="true">🎖️</p>
                <h2 class="mt-3 text-lg font-bold text-ink-900">No discounts recorded</h2>
                <p class="mt-1 text-sm text-ink-600">Assign a scholarship from the Scholarships screen, then generate the invoice.</p>
            </div>
        {% else %}
            <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 bg-white sm:block">
                <table class="min-w-[820px] w-full text-left text-sm">
                    <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                        <tr>
                            <th class="px-4 py-3">Pupil</th>
                            <th class="px-4 py-3">Class</th>
                            <th class="px-4 py-3">Rule</th>
                            <th class="px-4 py-3">Value</th>
                            <th class="px-4 py-3 text-right">Applied</th>
                            <th class="px-4 py-3">Invoice</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for row in data.rows %}
                            <tr class="{{ not row.billed ? 'bg-pending/5' : '' }}">
                                <td class="px-4 py-3">
                                    <span class="block font-semibold text-ink-900">{{ row.pupil }}</span>
                                    <span class="block text-xs text-ink-500">{{ row.admissionNumber ?: '—' }}{% if row.guardian %} · {{ row.guardian }}{% endif %}</span>
                                </td>
                                <td class="px-4 py-3 text-ink-700">{{ row.class ?: '—' }}</td>
                                <td class="px-4 py-3 text-ink-700">{{ row.rule }}</td>
                                <td class="px-4 py-3 text-ink-700">
                                    {{ row.mode == 'PERCENTAGE' ? row.value ~ '%' : '₦' ~ row.value|number_format(2) }}
                                </td>
                                <td class="money px-4 py-3 text-right font-semibold {{ row.applied > 0 ? 'text-paid' : 'text-ink-400' }}">
                                    ₦{{ row.applied|number_format(2) }}
                                </td>
                                <td class="px-4 py-3 text-xs">
                                    {% if row.billed and row.invoiceId %}
                                        <a href="{{ path('app_tenant_invoice_show', {id: row.invoiceId}) }}"
                                           class="font-mono font-semibold text-accent-700 hover:underline">{{ row.invoiceNumber }}</a>
                                    {% else %}
                                        <span class="badge-pending">Not billed</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-4 space-y-2 sm:hidden">
                {% for row in data.rows %}
                    <div class="rounded-xl border border-ink-200 bg-white p-3 {{ not row.billed ? 'border-pending/50 bg-pending/5' : '' }}">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-ink-900">{{ row.pupil }}</p>
                                <p class="text-xs text-ink-500">{{ row.class ?: 'No class' }} · {{ row.rule }}</p>
                            </div>
                            <p class="money shrink-0 font-bold text-ink-900">₦{{ row.applied|number_format(2) }}</p>
                        </div>
                        <p class="mt-1 text-xs text-ink-600">
                            {{ row.mode == 'PERCENTAGE' ? row.value ~ '% off' : '₦' ~ row.value|number_format(2) ~ ' off' }}
                            {% if not row.billed %} · <span class="font-semibold text-pending">no invoice yet</span>{% endif %}
                        </p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
