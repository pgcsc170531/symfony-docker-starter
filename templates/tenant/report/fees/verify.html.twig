{% extends 'base.html.twig' %}

{% block title %}Genuine {{ document|lower }}{% endblock %}
{% block meta_description %}Verification of an Edus fee document.{% endblock %}

{% block body %}
<div class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-md rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-paid/10 text-2xl text-paid" aria-hidden="true">✓</span>
        <h1 class="mt-3 text-xl font-black text-ink-900">Genuine {{ document|lower }}</h1>
        <p class="mt-1 text-sm text-ink-600">
            This document was issued by <strong class="text-ink-900">{{ school ? school.name : 'the school' }}</strong>.
        </p>

        <dl class="mt-5 divide-y divide-ink-100 rounded-lg border border-ink-200 text-left text-sm">
            <div class="flex justify-between gap-4 px-3 py-2">
                <dt class="text-ink-500">Document</dt>
                <dd class="font-semibold text-ink-900">{{ document }}</dd>
            </div>
            <div class="flex justify-between gap-4 px-3 py-2">
                <dt class="text-ink-500">Period</dt>
                <dd class="font-semibold text-ink-900">{{ verification.period ?: '—' }}</dd>
            </div>
            <div class="flex justify-between gap-4 px-3 py-2">
                <dt class="text-ink-500">Issued</dt>
                <dd class="font-semibold text-ink-900">{{ verification.issuedAt|date('j M Y') }}</dd>
            </div>
            <div class="flex justify-between gap-4 px-3 py-2">
                <dt class="text-ink-500">Code</dt>
                <dd class="font-mono font-semibold text-ink-900">{{ verification.code }}</dd>
            </div>
        </dl>

        <p class="mt-5 text-xs leading-relaxed text-ink-500">
            Only authenticity is shown here. No amounts, balances or pupil records are disclosed.
        </p>
    </div>
</div>
{% endblock %}
