{% extends 'base.html.twig' %}

{% block title %}Payment Reconciliation{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Reconciliation</h1>
            {% if term %}<p class="mt-1 text-sm text-ink-600">{{ term.session.name }} · {{ term.name }}</p>{% endif %}
        </div>
        <div class="no-print">
            {% include 'tenant/report/fees/_term_filter.html.twig' with {
                action: path('app_tenant_report_reconciliation'),
                terms: terms,
                term: term
            } only %}
        </div>
    </div>

    {% if term is null %}
        <div class="rounded-xl border border-ink-200 bg-white p-8 text-center text-sm text-ink-600">
            No term selected.
        </div>
    {% else %}
        <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Confirmed</p>
                <p class="money mt-1 text-xl font-black text-paid">₦{{ confirmed|number_format(2) }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Unverified</p>
                <p class="money mt-1 text-xl font-black {{ pending > 0 ? 'text-pending' : 'text-ink-400' }}">₦{{ pending|number_format(2) }}</p>
            </div>
        </div>

        {% if rows is empty %}
            <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center text-sm text-ink-600">
                No payments recorded against invoices for this term.
            </div>
        {% else %}
            <div class="mt-4 overflow-x-auto rounded-xl border border-ink-200 bg-white">
                <table class="min-w-[520px] w-full text-left text-sm">
                    <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                        <tr>
                            <th class="px-4 py-3">Method</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3 text-right">Payments</th>
                            <th class="px-4 py-3 text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for row in rows %}
                            <tr>
                                <td class="px-4 py-3 font-semibold text-ink-900">{{ row.method|replace({'_': ' '}) }}</td>
                                <td class="px-4 py-3">
                                    {% if row.status == 'CONFIRMED' %}<span class="badge-paid">Confirmed</span>
                                    {% elseif row.status == 'PENDING' %}<span class="badge-pending">Unverified</span>
                                    {% elseif row.status == 'DECLINED' %}<span class="badge-failed">Declined</span>
                                    {% else %}<span class="badge-neutral">{{ row.status|capitalize }}</span>{% endif %}
                                </td>
                                <td class="px-4 py-3 text-right text-ink-700">{{ row.entries }}</td>
                                <td class="money px-4 py-3 text-right font-semibold text-ink-900">₦{{ row.total|number_format(2) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <div class="mt-6">
            <h2 class="text-base font-bold text-ink-900">Proofs waiting more than 48 hours</h2>
            <p class="mt-1 text-sm text-ink-600">Unverified transfers are the most common source of a parent argument.</p>

            {% if stale is empty %}
                <p class="mt-3 rounded-xl border border-ink-200 bg-white p-4 text-sm text-ink-600">
                    Nothing has been waiting more than 48 hours. ✅
                </p>
            {% else %}
                <div class="mt-3 space-y-2">
                    {% for payment in stale %}
                        <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-pending/40 bg-pending/5 p-3">
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-ink-900">
                                    {% if payment.invoice.student %}{{ payment.invoice.student.fullName }}{% else %}{{ payment.invoice.buyerName ?: 'Walk-in customer' }}{% endif %}
                                </p>
                                <p class="text-xs text-ink-600">
                                    {{ payment.referenceCode ?: 'no ref' }} · recorded {{ payment.createdAt|date('j M Y') }}
                                </p>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="money font-bold text-pending">₦{{ payment.amount|number_format(2) }}</span>
                                <a href="{{ path('app_tenant_payment_verify', {code: payment.referenceCode}) }}"
                                   class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 bg-white px-3 text-xs font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                                    Verify
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
