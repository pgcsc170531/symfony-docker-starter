{#
    Term selector shared by the fee reports.

    GET-only: it changes the URL so the view is bookmarkable and the back
    button works. `onchange` submits; a <noscript> button keeps it usable
    without JavaScript.
#}
<form method="get" action="{{ action }}" class="flex flex-wrap items-end gap-2">
    <div class="min-w-0 flex-1 sm:flex-none">
        <label for="term" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Term</label>
        <select id="term" name="term" onchange="this.form.submit()"
                class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500 sm:w-auto">
            {% for t in terms %}
                <option value="{{ t.id }}" {{ term and term.id == t.id ? 'selected' }}>
                    {{ t.session.name }} · {{ t.name }}{{ t.isActive ? ' (active)' : '' }}
                </option>
            {% endfor %}
        </select>
    </div>
    <noscript>
        <button type="submit" class="min-h-[44px] rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white">Show</button>
    </noscript>
</form>
