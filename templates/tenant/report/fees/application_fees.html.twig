{% extends 'base.html.twig' %}

{% block title %}Application Fees{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Application fees</h1>
            <p class="mt-1 text-sm text-ink-600">Money taken before a child becomes a pupil — collected, waived and still owed.</p>
        </div>
        <div class="flex flex-wrap gap-2 no-print">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_tenant_application_index') }}"
                   class="inline-flex min-h-[44px] items-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">
                    Applications queue
                </a>
            {% endif %}
            <button type="button" onclick="window.print()"
                    class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Print
            </button>
        </div>
    </div>

    <form method="get" action="{{ path('app_tenant_report_application_fees') }}"
          class="no-print mb-4 rounded-xl border border-ink-200 bg-white p-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <label for="from" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">From</label>
                <input type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="to" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">To</label>
                <input type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="fee_status" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Fee status</label>
                <select id="fee_status" name="fee_status"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">All statuses</option>
                    {% for s in statuses %}
                        <option value="{{ s }}" {{ status == s ? 'selected' }}>{{ s|replace({'_': ' '})|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="channel" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Channel</label>
                <select id="channel" name="channel"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">All channels</option>
                    {% for c in channels %}
                        <option value="{{ c }}" {{ channel == c ? 'selected' }}>{{ c|replace({'_': ' '})|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
            <button type="submit" class="min-h-[44px] rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700">Apply filters</button>
            <a href="{{ path('app_tenant_report_application_fees') }}"
               class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400">Reset</a>
        </div>
    </form>

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Collected</p>
            <p class="money mt-1 text-xl font-black text-paid">₦{{ totals.paid|number_format(2) }}</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Awaiting confirmation</p>
            <p class="money mt-1 text-xl font-black {{ totals.awaiting > 0 ? 'text-pending' : 'text-ink-400' }}">₦{{ totals.awaiting|number_format(2) }}</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Still unpaid</p>
            <p class="money mt-1 text-xl font-black {{ totals.unpaid > 0 ? 'text-failed' : 'text-ink-400' }}">₦{{ totals.unpaid|number_format(2) }}</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Waived</p>
            <p class="money mt-1 text-xl font-black text-ink-900">₦{{ totals.waived|number_format(2) }}</p>
        </div>
    </div>

    {% if totals.awaiting > 0 %}
        <p class="mt-3 rounded-lg border border-pending/30 bg-pending/5 px-3 py-2 text-sm text-ink-700">
            <strong class="font-semibold text-pending">₦{{ totals.awaiting|number_format(2) }}</strong>
            in proofs is waiting for a bursar to confirm. It is not counted as collected.
        </p>
    {% endif %}

    {% if applications is empty %}
        <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
            <p class="text-4xl" aria-hidden="true">📄</p>
            <h2 class="mt-3 text-lg font-bold text-ink-900">No application fees in this period</h2>
            <p class="mt-1 text-sm text-ink-600">Widen the dates or clear the filters.</p>
        </div>
    {% else %}
        <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 bg-white sm:block">
            <table class="min-w-[860px] w-full text-left text-sm">
                <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                    <tr>
                        <th class="px-4 py-3">Reference</th>
                        <th class="px-4 py-3">Applicant</th>
                        <th class="px-4 py-3">Guardian</th>
                        <th class="px-4 py-3 text-right">Fee</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Channel</th>
                        <th class="px-4 py-3">Paid</th>
                        <th class="px-4 py-3 no-print"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for application in applications %}
                        <tr>
                            <td class="px-4 py-3 font-mono text-xs text-ink-700">{{ application.reference ?: 'Draft' }}</td>
                            <td class="px-4 py-3 font-semibold text-ink-900">{{ application.fullName }}</td>
                            <td class="px-4 py-3">
                                <span class="block text-ink-800">{{ application.guardianName ?: '—' }}</span>
                                <span class="block text-xs text-ink-500">{{ application.guardianPhone ?: '' }}</span>
                            </td>
                            <td class="money px-4 py-3 text-right font-semibold text-ink-900">₦{{ application.feeAmount ? application.feeAmount|number_format(2) : '0.00' }}</td>
                            <td class="px-4 py-3">
                                {% if application.feeStatus == 'paid' %}<span class="badge-paid">Paid</span>
                                {% elseif application.feeStatus == 'awaiting_confirmation' %}<span class="badge-pending">Awaiting</span>
                                {% elseif application.feeStatus == 'waived' %}<span class="badge-neutral">Waived</span>
                                {% else %}<span class="badge-failed">Unpaid</span>{% endif %}
                            </td>
                            <td class="px-4 py-3 text-ink-700">{{ application.feeChannel ? application.feeChannel|replace({'_': ' '}) : '—' }}</td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-600">{{ application.feePaidAt ? application.feePaidAt|date('j M Y') : '—' }}</td>
                            <td class="px-4 py-3 text-right no-print">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_tenant_application_show', {id: application.id}) }}"
                                       class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">Open</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4 space-y-2 sm:hidden">
            {% for application in applications %}
                <div class="rounded-xl border border-ink-200 bg-white p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words font-semibold text-ink-900">{{ application.fullName }}</p>
                            <p class="text-xs text-ink-500">{{ application.reference ?: 'Draft' }} · {{ application.guardianName ?: 'No guardian' }}</p>
                        </div>
                        <p class="money shrink-0 font-bold text-ink-900">₦{{ application.feeAmount ? application.feeAmount|number_format(2) : '0.00' }}</p>
                    </div>
                    <div class="mt-2 flex items-center justify-between gap-2">
                        {% if application.feeStatus == 'paid' %}<span class="badge-paid">Paid</span>
                        {% elseif application.feeStatus == 'awaiting_confirmation' %}<span class="badge-pending">Awaiting</span>
                        {% elseif application.feeStatus == 'waived' %}<span class="badge-neutral">Waived</span>
                        {% else %}<span class="badge-failed">Unpaid</span>{% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_tenant_application_show', {id: application.id}) }}"
                               class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700">Open</a>
                        {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
