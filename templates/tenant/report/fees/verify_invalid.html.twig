{% extends 'base.html.twig' %}

{% block title %}Unknown verification code{% endblock %}

{% block body %}
<div class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-md rounded-xl border border-ink-200 bg-white p-6 text-center">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-failed/10 text-2xl text-failed" aria-hidden="true">?</span>
        <h1 class="mt-3 text-xl font-black text-ink-900">We could not verify this code</h1>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
            The code <span class="font-mono font-semibold">{{ code }}</span> does not match a summary issued by this school.
            Check the code, or ask the school that gave you the document.
        </p>
    </div>
</div>
{% endblock %}
