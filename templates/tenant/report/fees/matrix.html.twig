{% extends 'base.html.twig' %}

{% block title %}Class Fee Status{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Class fee status</h1>
            {% if term %}<p class="mt-1 text-sm text-ink-600">{{ term.session.name }} · {{ term.name }}</p>{% endif %}
        </div>

        <form method="get" action="{{ path('app_tenant_report_matrix') }}" class="flex flex-wrap items-end gap-2 no-print">
            <div>
                <label for="term" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Term</label>
                <select id="term" name="term" class="min-h-[44px] rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    {% for t in terms %}
                        <option value="{{ t.id }}" {{ term and term.id == t.id ? 'selected' }}>{{ t.session.name }} · {{ t.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="classroom" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Class</label>
                <select id="classroom" name="classroom" class="min-h-[44px] rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    {% for c in classrooms %}
                        <option value="{{ c.id }}" {{ classroom and classroom.id == c.id ? 'selected' }}>{{ c.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="min-h-[44px] rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">Show</button>
            <button type="button" onclick="window.print()"
                    class="min-h-[44px] rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Print
            </button>
        </form>
    </div>

    {% if term is null or classroom is null %}
        <div class="rounded-xl border border-ink-200 bg-white p-8 text-center text-sm text-ink-600">
            Pick a term and a class to see the matrix.
        </div>
    {% else %}
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Paid</p>
                <p class="mt-1 text-xl font-black text-paid">{{ data.summary.paid }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Partial</p>
                <p class="mt-1 text-xl font-black text-pending">{{ data.summary.partial }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Unpaid</p>
                <p class="mt-1 text-xl font-black text-failed">{{ data.summary.unpaid }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Not billed</p>
                <p class="mt-1 text-xl font-black text-ink-500">{{ data.summary.notBilled }}</p>
            </div>
        </div>

        <p class="mt-3 text-xs text-ink-500">{{ data.summary.total }} pupil{{ data.summary.total == 1 ? '' : 's' }} in {{ classroom.name }} for this term.</p>

        {% if data.rows is empty %}
            <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
                <p class="text-4xl" aria-hidden="true">👥</p>
                <h2 class="mt-3 text-lg font-bold text-ink-900">No pupils enrolled in this class</h2>
                <p class="mt-1 text-sm text-ink-600">Enrol or import pupils first.</p>
            </div>
        {% else %}
            <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 bg-white sm:block">
                <table class="min-w-[720px] w-full text-left text-sm">
                    <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                        <tr>
                            <th class="px-4 py-3">Pupil</th>
                            <th class="px-4 py-3">Admission no.</th>
                            <th class="px-4 py-3 text-right">Billed</th>
                            <th class="px-4 py-3 text-right">Paid</th>
                            <th class="px-4 py-3 text-right">Outstanding</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3 no-print"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for row in data.rows %}
                            <tr>
                                <td class="px-4 py-3 font-semibold text-ink-900">{{ row.pupil }}</td>
                                <td class="px-4 py-3 font-mono text-xs text-ink-600">{{ row.admissionNumber ?: '—' }}</td>
                                <td class="money px-4 py-3 text-right text-ink-800">{{ row.invoiceId ? '₦' ~ row.invoiced|number_format(2) : '—' }}</td>
                                <td class="money px-4 py-3 text-right text-paid">{{ row.invoiceId ? '₦' ~ row.paid|number_format(2) : '—' }}</td>
                                <td class="money px-4 py-3 text-right {{ row.outstanding > 0 ? 'text-failed' : 'text-ink-400' }}">{{ row.invoiceId ? '₦' ~ row.outstanding|number_format(2) : '—' }}</td>
                                <td class="px-4 py-3">
                                    {% if row.status == 'PAID' %}<span class="badge-paid">Paid</span>
                                    {% elseif row.status == 'PARTIAL' %}<span class="badge-pending">Partial</span>
                                    {% elseif row.status == 'UNPAID' %}<span class="badge-failed">Unpaid</span>
                                    {% else %}<span class="badge-neutral">Not billed</span>{% endif %}
                                </td>
                                <td class="px-4 py-3 text-right no-print">
                                    <span class="flex justify-end gap-3">
                                        <a href="{{ path('app_tenant_report_statement', {id: row.studentId, term: term.id}) }}"
                                           class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">Statement</a>
                                        {% if row.outstanding > 0 %}
                                            <a href="{{ path('app_tenant_payment_terminal', {id: row.studentId}) }}"
                                               class="inline-flex min-h-[44px] items-center text-xs font-semibold text-ink-700 hover:text-accent-700">Pay</a>
                                        {% endif %}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-4 space-y-2 sm:hidden">
                {% for row in data.rows %}
                    <div class="rounded-xl border border-ink-200 bg-white p-3">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-ink-900">{{ row.pupil }}</p>
                                <p class="text-xs text-ink-500">{{ row.admissionNumber ?: 'No admission no.' }}</p>
                            </div>
                            {% if row.status == 'PAID' %}<span class="badge-paid">Paid</span>
                            {% elseif row.status == 'PARTIAL' %}<span class="badge-pending">Partial</span>
                            {% elseif row.status == 'UNPAID' %}<span class="badge-failed">Unpaid</span>
                            {% else %}<span class="badge-neutral">Not billed</span>{% endif %}
                        </div>
                        {% if row.invoiceId %}
                            <dl class="mt-2 grid grid-cols-3 gap-2 text-xs">
                                <div><dt class="text-ink-500">Billed</dt><dd class="money font-semibold text-ink-900">₦{{ row.invoiced|number_format(2) }}</dd></div>
                                <div><dt class="text-ink-500">Paid</dt><dd class="money font-semibold text-paid">₦{{ row.paid|number_format(2) }}</dd></div>
                                <div><dt class="text-ink-500">Owing</dt><dd class="money font-semibold {{ row.outstanding > 0 ? 'text-failed' : 'text-ink-400' }}">₦{{ row.outstanding|number_format(2) }}</dd></div>
                            </dl>
                        {% endif %}
                        <div class="mt-2 flex items-center justify-end gap-3">
                            <a href="{{ path('app_tenant_report_statement', {id: row.studentId, term: term.id}) }}"
                               class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700">Statement</a>
                            {% if row.outstanding > 0 %}
                                <a href="{{ path('app_tenant_payment_terminal', {id: row.studentId}) }}"
                                   class="inline-flex min-h-[44px] items-center text-xs font-semibold text-ink-700">Pay</a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
