{% extends 'base.html.twig' %}

{% block title %}Expense Register{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Expense register</h1>
            <p class="mt-1 text-sm text-ink-600">Every naira that left the school, by category and payee.</p>
        </div>
        <div class="flex flex-wrap gap-2 no-print">
            <a href="{{ path('app_tenant_report_expenses_csv', app.request.query.all) }}"
               class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Export CSV
            </a>
            <a href="{{ path('app_tenant_expense_index') }}"
               class="inline-flex min-h-[44px] items-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">
                Add expense
            </a>
            <button type="button" onclick="window.print()"
                    class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Print
            </button>
        </div>
    </div>

    <form method="get" action="{{ path('app_tenant_report_expenses') }}"
          class="no-print mb-4 rounded-xl border border-ink-200 bg-white p-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <div>
                <label for="from" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">From</label>
                <input type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="to" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">To</label>
                <input type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="category" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Category</label>
                <select id="category" name="category"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">All categories</option>
                    {% for c in categories %}
                        <option value="{{ c.id }}" {{ filters.category and filters.category.id == c.id ? 'selected' }}>{{ c.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="q" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Search</label>
                <input type="search" id="q" name="q" value="{{ filters.q }}" placeholder="Title, payee or note"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="min" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Minimum (₦)</label>
                <input type="number" id="min" name="min" min="0" step="0.01" inputmode="decimal"
                       value="{{ filters.min is not null ? filters.min : '' }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
            <button type="submit" class="min-h-[44px] rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700">Apply filters</button>
            <a href="{{ path('app_tenant_report_expenses') }}"
               class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400">Reset</a>
        </div>
    </form>

    <div class="grid gap-3 lg:grid-cols-3">
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Total expenses</p>
            <p class="money mt-1 text-xl font-black text-failed">₦{{ totals.total|number_format(2) }}</p>
            <p class="mt-1 text-xs text-ink-500">{{ totals.entries }} entr{{ totals.entries == 1 ? 'y' : 'ies' }}</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4 lg:col-span-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">By category</p>
            {% if totals.byCategory is empty %}
                <p class="mt-1 text-sm text-ink-500">No expenses in this period.</p>
            {% else %}
                <ul class="mt-2 divide-y divide-ink-100">
                    {% for category, amount in totals.byCategory %}
                        <li class="flex items-center justify-between gap-3 py-1.5 text-sm">
                            <span class="text-ink-700">{{ category }}</span>
                            <span class="money font-semibold text-ink-900">₦{{ amount|number_format(2) }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>

    {% if register.rows is empty %}
        <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
            <p class="text-4xl" aria-hidden="true">📉</p>
            <h2 class="mt-3 text-lg font-bold text-ink-900">No expenses match these filters</h2>
            <p class="mt-1 text-sm text-ink-600">Widen the dates or record an expense.</p>
        </div>
    {% else %}
        <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 bg-white sm:block">
            <table class="min-w-[820px] w-full text-left text-sm">
                <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                    <tr>
                        <th class="px-4 py-3">Date</th>
                        <th class="px-4 py-3">Category</th>
                        <th class="px-4 py-3">Title</th>
                        <th class="px-4 py-3">Payee</th>
                        <th class="px-4 py-3">Method</th>
                        <th class="px-4 py-3 text-right">Amount</th>
                        <th class="px-4 py-3">Receipt</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for expense in register.rows %}
                        <tr>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-600">{{ expense.expenseDate|date('j M Y') }}</td>
                            <td class="px-4 py-3 text-ink-700">{{ expense.category ? expense.category.name : '—' }}</td>
                            <td class="px-4 py-3">
                                <span class="block font-semibold text-ink-900">{{ expense.title }}</span>
                                {% if expense.note %}<span class="block text-xs text-ink-500">{{ expense.note }}</span>{% endif %}
                            </td>
                            <td class="break-words px-4 py-3 text-ink-700">{{ expense.payee ?: '—' }}</td>
                            <td class="px-4 py-3 text-ink-700">{{ expense.method|default('CASH')|replace({'_': ' '}) }}</td>
                            <td class="money px-4 py-3 text-right font-semibold text-failed">-₦{{ expense.amount|number_format(2) }}</td>
                            <td class="px-4 py-3">
                                {% if expense.receiptFilename %}
                                    <a href="{{ asset('uploads/receipts/' ~ expense.receiptFilename) }}" target="_blank" rel="noopener"
                                       class="text-xs font-semibold text-accent-700 hover:underline">View</a>
                                {% else %}
                                    <span class="text-xs text-ink-400">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4 space-y-2 sm:hidden">
            {% for expense in register.rows %}
                <div class="rounded-xl border border-ink-200 bg-white p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words font-semibold text-ink-900">{{ expense.title }}</p>
                            <p class="text-xs text-ink-500">{{ expense.expenseDate|date('j M Y') }} · {{ expense.category ? expense.category.name : 'No category' }}</p>
                        </div>
                        <p class="money shrink-0 font-bold text-failed">-₦{{ expense.amount|number_format(2) }}</p>
                    </div>
                    <p class="mt-1 text-xs text-ink-600">
                        {{ expense.payee ?: 'No payee' }} · {{ expense.method|default('CASH')|replace({'_': ' '}) }}
                    </p>
                    {% if expense.receiptFilename %}
                        <a href="{{ asset('uploads/receipts/' ~ expense.receiptFilename) }}" target="_blank" rel="noopener"
                           class="mt-1 inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700">Receipt</a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {% include 'tenant/report/fees/_pagination.html.twig' with {
            route: 'app_tenant_report_expenses',
            params: {
                from: from|date('Y-m-d'),
                to: to|date('Y-m-d'),
                category: filters.category ? filters.category.id : null,
                q: filters.q,
                min: filters.min
            },
            page: register.page,
            pages: register.pages
        } only %}
    {% endif %}
</div>
{% endblock %}
