{% extends 'base.html.twig' %}

{% block title %}Payment Register{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-4 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="{{ path('app_tenant_report_fees') }}" class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee reports</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Payment register</h1>
            <p class="mt-1 text-sm text-ink-600">Every payment, filtered and exportable.</p>
        </div>
        <div class="flex flex-wrap gap-2 no-print">
            <a href="{{ path('app_tenant_report_payments_csv', app.request.query.all) }}"
               class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Export CSV
            </a>
            <button type="button" onclick="window.print()"
                    class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                Print
            </button>
        </div>
    </div>

    <form method="get" action="{{ path('app_tenant_report_payments') }}"
          class="no-print mb-4 rounded-xl border border-ink-200 bg-white p-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <label for="from" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">From</label>
                <input type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="to" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">To</label>
                <input type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="q" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Search</label>
                <input type="search" id="q" name="q" value="{{ filters.q }}"
                       placeholder="Pupil, invoice, reference"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="classroom" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Class</label>
                <select id="classroom" name="classroom"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">All classes</option>
                    {% for c in classrooms %}
                        <option value="{{ c.id }}" {{ filters.classroom and filters.classroom.id == c.id ? 'selected' }}>{{ c.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="method" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Method</label>
                <select id="method" name="method"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">All methods</option>
                    {% for m in methods %}
                        <option value="{{ m }}" {{ filters.method == m ? 'selected' }}>{{ m|replace({'_': ' '})|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="status" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Status</label>
                <select id="status" name="status"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">All statuses</option>
                    {% for s in statuses %}
                        <option value="{{ s }}" {{ filters.status == s ? 'selected' }}>{{ s|capitalize }}</option>
                    {% endfor %}
                    {% for value, label in billStatuses|default({}) %}
                        <option value="{{ value }}" {{ filters.status == value ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="type" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Ledger</label>
                <select id="type" name="type"
                        class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <option value="">Academic + store</option>
                    <option value="ACADEMIC" {{ filters.type == 'ACADEMIC' ? 'selected' }}>Academic fees</option>
                    <option value="STORE" {{ filters.type == 'STORE' ? 'selected' }}>Store sales</option>
                </select>
            </div>
            <div>
                <label for="cashier" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Confirmed by</label>
                <input type="text" id="cashier" name="cashier" value="{{ filters.cashier }}"
                       placeholder="Email of the cashier"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
            <button type="submit" class="min-h-[44px] rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700">Apply filters</button>
            <a href="{{ path('app_tenant_report_payments') }}"
               class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400">Reset</a>
        </div>
    </form>

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Confirmed</p>
            <p class="money mt-1 text-xl font-black text-paid">₦{{ totals.confirmed|number_format(2) }}</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Unverified</p>
            <p class="money mt-1 text-xl font-black {{ totals.pending > 0 ? 'text-pending' : 'text-ink-400' }}">₦{{ totals.pending|number_format(2) }}</p>
        </div>
        <div class="col-span-2 rounded-xl border border-ink-200 bg-white p-4 lg:col-span-1">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Rows</p>
            <p class="mt-1 text-xl font-black text-ink-900">{{ register.total }}</p>
        </div>
    </div>

    {% if register.rows is empty %}
        <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
            <p class="text-4xl" aria-hidden="true">🔍</p>
            <h2 class="mt-3 text-lg font-bold text-ink-900">No payments match these filters</h2>
            <p class="mt-1 text-sm text-ink-600">Widen the dates or clear a filter.</p>
        </div>
    {% else %}
        <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 bg-white sm:block">
            <table class="min-w-[900px] w-full text-left text-sm">
                <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                    <tr>
                        <th class="px-4 py-3">Date</th>
                        <th class="px-4 py-3">Pupil / buyer</th>
                        <th class="px-4 py-3">Invoice</th>
                        <th class="px-4 py-3">Method</th>
                        <th class="px-4 py-3">Reference</th>
                        <th class="px-4 py-3 text-right">Amount</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Confirmed by</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for payment in register.rows %}
                        <tr class="align-top">
                            <td class="whitespace-nowrap px-4 py-3 text-ink-600">
                                {{ (payment.paidAt ?? payment.createdAt)|date('j M Y') }}
                                <span class="block text-xs text-ink-400">{{ (payment.paidAt ?? payment.createdAt)|date('H:i') }}</span>
                            </td>
                            <td class="px-4 py-3">
                                {% if payment.invoice.student %}
                                    <span class="block font-semibold text-ink-900">{{ payment.invoice.student.fullName }}</span>
                                    <span class="block text-xs text-ink-500">{{ payment.invoice.student.admissionNumber }}</span>
                                {% else %}
                                    <span class="block font-semibold text-ink-900">{{ payment.invoice.buyerName ?: 'Walk-in customer' }}</span>
                                    <span class="block text-xs text-ink-500">Walk-in sale</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3">
                                <span class="block font-mono text-xs text-ink-700">{{ payment.invoice.invoiceNumber }}</span>
                                <span class="block text-[11px] uppercase tracking-wide text-ink-400">{{ payment.invoice.type }}</span>
                                {# A part payment is only actionable if the row says how much is left. #}
                                {% if payment.invoice.balanceDue > 0.005 %}
                                    <span class="mt-1 block whitespace-nowrap text-[11px] font-semibold text-ink-500">
                                        ₦{{ payment.invoice.balanceDue|number_format(2) }} owing
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-ink-700">{{ payment.method|replace({'_': ' '}) }}</td>
                            <td class="px-4 py-3 font-mono text-xs text-ink-500">
                                {{ payment.referenceCode ?: '—' }}
                                {# A draw-down from an advance says so here, so the
                                   register stands on its own during a physical audit. #}
                                {% if payment.note %}
                                    <span class="mt-1 block max-w-[18rem] break-words font-sans text-[11px] leading-snug text-ink-400">{{ payment.note }}</span>
                                {% endif %}
                            </td>
                            <td class="money px-4 py-3 text-right font-semibold text-ink-900">₦{{ payment.amount|number_format(2) }}</td>
                            <td class="px-4 py-3">
                                {% if payment.status == 'CONFIRMED' %}<span class="badge-paid">Paid</span>
                                {% elseif payment.status == 'PENDING' %}<span class="badge-pending">Unverified</span>
                                {% else %}<span class="badge-failed">{{ payment.status|capitalize }}</span>{% endif %}
                            </td>
                            <td class="break-all px-4 py-3 text-xs text-ink-500">{{ payment.confirmedBy ?: '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4 space-y-2 sm:hidden">
            {% for payment in register.rows %}
                <div class="rounded-xl border border-ink-200 bg-white p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words font-semibold text-ink-900">
                                {% if payment.invoice.student %}{{ payment.invoice.student.fullName }}{% else %}{{ payment.invoice.buyerName ?: 'Walk-in customer' }}{% endif %}
                            </p>
                            <p class="text-xs text-ink-500">
                                {{ (payment.paidAt ?? payment.createdAt)|date('j M Y, H:i') }} ·
                                {{ payment.method|replace({'_': ' '}) }} ·
                                {{ payment.referenceCode ?: 'no ref' }}
                            </p>
                        </div>
                        <p class="money shrink-0 font-bold text-ink-900">₦{{ payment.amount|number_format(2) }}</p>
                    </div>
                    <div class="mt-2 flex items-center justify-between gap-2">
                        {% if payment.status == 'CONFIRMED' %}<span class="badge-paid">Paid</span>
                        {% elseif payment.status == 'PENDING' %}<span class="badge-pending">Unverified</span>
                        {% else %}<span class="badge-failed">{{ payment.status|capitalize }}</span>{% endif %}
                        <span class="text-xs text-ink-500">{{ payment.invoice.type }}</span>
                    </div>
                    {% if payment.invoice.balanceDue > 0.005 %}
                        <p class="mt-1 text-[11px] font-semibold text-ink-600">
                            ₦{{ payment.invoice.balanceDue|number_format(2) }} still owing on {{ payment.invoice.invoiceNumber }}
                        </p>
                    {% endif %}
                    {% if payment.note %}
                        <p class="mt-2 break-words rounded-lg bg-ink-50 px-2 py-1.5 text-[11px] leading-snug text-ink-500">
                            {{ payment.note }}
                        </p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {% include 'tenant/report/fees/_pagination.html.twig' with {
            route: 'app_tenant_report_payments',
            params: {
                from: from|date('Y-m-d'),
                to: to|date('Y-m-d'),
                q: filters.q,
                classroom: filters.classroom ? filters.classroom.id : null,
                method: filters.method,
                status: filters.status,
                type: filters.type,
                cashier: filters.cashier
            },
            page: register.page,
            pages: register.pages
        } only %}
    {% endif %}
</div>
{% endblock %}
