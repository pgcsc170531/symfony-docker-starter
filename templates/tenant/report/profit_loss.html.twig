{% extends 'base.html.twig' %}

{% block title %}Profit & Loss Statement{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto mt-8 px-4 md:px-6">

    {# 1. RESPONSIVE HEADER & CONTROL BAR #}
    <div class="flex flex-col xl:flex-row justify-between items-start xl:items-end mb-10 gap-6">
        
        {# Title Section #}
        <div class="w-full xl:w-auto">
            
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">Profit & Loss</h1>
            <p class="text-gray-500 mt-1 text-sm md:text-base">
                Performance: 
                <span class="font-bold text-gray-900 border-b-2 border-gray-200">{{ startDate|date('M d, Y') }}</span> 
                <span class="text-gray-400 mx-1">to</span> 
                <span class="font-bold text-gray-900 border-b-2 border-gray-200">{{ endDate|date('M d, Y') }}</span>
            </p>
        </div>

        {# CONTROL BAR: Stacks on mobile, Single line on desktop #}
        <div class="w-full xl:w-auto bg-white p-4 md:p-1.5 rounded-2xl shadow-sm border border-gray-200">
            {{ form_start(form, {'attr': {'class': 'flex flex-col md:flex-row items-stretch md:items-center gap-3 md:gap-2'}}) }}
                
                {# Start Date #}
                <div class="relative group w-full md:w-auto">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <span class="text-xs font-bold uppercase">From</span>
                    </div>
                    {{ form_widget(form.startDate, {'attr': {'class': 'w-full md:w-40 pl-12 border-0 bg-gray-50 rounded-xl text-sm font-bold text-gray-900 focus:ring-2 focus:ring-gray-900 hover:bg-gray-100 transition-colors py-3 md:py-2.5'}}) }}
                </div>
                
                {# Arrow Icon (Hidden on Mobile, Visible on Desktop) #}
                <span class="hidden md:block text-gray-300 font-bold">&rarr;</span>
                
                {# End Date #}
                <div class="relative group w-full md:w-auto">
                     <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <span class="text-xs font-bold uppercase">To</span>
                    </div>
                    {{ form_widget(form.endDate, {'attr': {'class': 'w-full md:w-40 pl-8 border-0 bg-gray-50 rounded-xl text-sm font-bold text-gray-900 focus:ring-2 focus:ring-gray-900 hover:bg-gray-100 transition-colors py-3 md:py-2.5'}}) }}
                </div>

                {# Submit Button #}
                <button type="submit" class="w-full md:w-auto bg-gray-900 text-white px-6 py-3 md:py-2.5 rounded-xl font-bold text-sm hover:bg-gray-800 transition-colors shadow-md flex justify-center items-center gap-2">
                    <span>Filter Report</span>
                </button>

            {{ form_end(form) }}
        </div>
    </div>

    {# 2. THE BIG PICTURE (Summary Cards) #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        
        {# INCOME CARD #}
        <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
                <svg class="w-16 h-16 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.293 9.707a1 1 0 010-1.414l6-6a1 1 0 011.414 0l6 6a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L4.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            </div>
            <div class="relative z-10">
                <h3 class="text-gray-500 font-bold text-xs uppercase tracking-widest mb-1">Total Revenue</h3>
                <p class="text-3xl md:text-4xl font-black text-emerald-600 tracking-tight mb-4">₦{{ totalIncome|number_format(0) }}</p>
                
                <div class="space-y-2 pt-4 border-t border-gray-50">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Academic Fees</span>
                        <span class="font-bold text-gray-900">₦{{ incomeFees|number_format(0) }}</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Store Sales</span>
                        <span class="font-bold text-gray-900">₦{{ incomeStore|number_format(0) }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# EXPENSE CARD #}
        <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 relative overflow-hidden group">
             <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
                <svg class="w-16 h-16 text-rose-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 10.293a1 1 0 010 1.414l-6 6a1 1 0 01-1.414 0l-6-6a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l4.293-4.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </div>
            <div class="relative z-10">
                <h3 class="text-gray-500 font-bold text-xs uppercase tracking-widest mb-1">Total Expenses</h3>
                <p class="text-3xl md:text-4xl font-black text-rose-600 tracking-tight mb-4">₦{{ totalExpense|number_format(0) }}</p>
                 
                <div class="pt-4 border-t border-gray-50">
                    <p class="text-sm text-gray-400">
                        Operational costs including salaries, maintenance, and purchases.
                    </p>
                    <a href="{{ path('app_tenant_expense_index') }}" class="inline-block mt-3 text-xs font-bold text-rose-600 hover:text-rose-800">
                        View Expense Breakdown &rarr;
                    </a>
                </div>
            </div>
        </div>

        {# NET PROFIT CARD (The Hero) #}
        <div class="bg-gray-900 rounded-3xl p-6 md:p-8 shadow-xl relative overflow-hidden text-white">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 rounded-full {{ netProfit >= 0 ? 'bg-emerald-500' : 'bg-rose-500' }} blur-3xl opacity-20"></div>
            
            <div class="relative z-10 h-full flex flex-col justify-between">
                <div>
                    <h3 class="text-gray-400 font-bold text-xs uppercase tracking-widest mb-1">Net Profit / (Loss)</h3>
                    <p class="text-4xl md:text-5xl font-black tracking-tight {{ netProfit >= 0 ? 'text-emerald-400' : 'text-rose-400' }}">
                        {% if netProfit > 0 %}+{% endif %}₦{{ netProfit|number_format(0) }}
                    </p>
                </div>

                <div class="mt-6 p-4 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                     {% if netProfit > 0 %}
                        <div class="flex items-center gap-3 text-emerald-300">
                            <span class="text-2xl">🚀</span>
                            <span class="font-bold text-sm">Great job! The school is profitable this period.</span>
                        </div>
                    {% elseif netProfit < 0 %}
                        <div class="flex items-center gap-3 text-rose-300">
                            <span class="text-2xl">⚠️</span>
                            <span class="font-bold text-sm">Attention: Expenses are exceeding income.</span>
                        </div>
                    {% else %}
                         <div class="flex items-center gap-3 text-gray-300">
                            <span class="text-2xl">⚖️</span>
                            <span class="font-bold text-sm">Break-even point reached.</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

    {# 3. VISUALIZATION BAR #}
    {% if totalIncome > 0 %}
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
        <h3 class="font-bold text-gray-900 mb-6">Cash Flow Visualization</h3>
        
        <div class="flex h-12 w-full rounded-full overflow-hidden bg-gray-100">
            {# Profit Portion #}
            {% if netProfit > 0 %}
                {% set profitPercent = (netProfit / totalIncome) * 100 %}
                <div style="width: {{ profitPercent }}%" class="bg-emerald-500 flex items-center justify-center text-white font-bold text-xs transition-all duration-1000">
                    Profit {{ profitPercent|number_format(1) }}%
                </div>
            {% endif %}

            {# Expense Portion #}
            {% set expensePercent = (totalExpense / totalIncome) * 100 %}
            <div style="width: {{ expensePercent }}%" class="bg-rose-500 flex items-center justify-center text-white font-bold text-xs transition-all duration-1000">
                Expenses {{ expensePercent|number_format(1) }}%
            </div>
        </div>
        
        <div class="flex justify-between mt-3 text-xs font-bold text-gray-400 uppercase">
            <span>0%</span>
            <span>50%</span>
            <span>100% of Revenue</span>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}