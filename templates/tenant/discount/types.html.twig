{% extends 'base.html.twig' %}
{% block title %}Discount Rules{% endblock %}

{% block body %}
<div class="container mx-auto mt-10 p-5 grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <div class="md:col-span-1">
        <div class="bg-white p-6 rounded shadow border-t-4 border-indigo-600">
            <h2 class="text-xl font-bold mb-6 text-gray-800">Create Discount Rule</h2>
            
            {{ form_start(form) }}
                <div class="mb-4">
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full border border-gray-300 rounded p-3 focus:outline-none focus:border-indigo-500', 'placeholder': 'e.g. Staff Child'}}) }}
                </div>
                
                <div class="mb-4">
                    {{ form_label(form.mode, null, {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.mode, {'attr': {'class': 'w-full border border-gray-300 rounded p-3 bg-white focus:outline-none focus:border-indigo-500'}}) }}
                </div>

                <div class="mb-6">
                    {{ form_label(form.value, null, {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.value, {'attr': {'class': 'w-full border border-gray-300 rounded p-3 focus:outline-none focus:border-indigo-500', 'placeholder': 'e.g. 50'}}) }}
                    <p class="text-xs text-gray-500 mt-1">Enter percentage (e.g. 50) or Amount (e.g. 5000)</p>
                </div>

                <button class="bg-indigo-600 text-white w-full py-3 rounded font-bold hover:bg-indigo-700 shadow transition duration-150">
                    Save Rule
                </button>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="md:col-span-2">
        <div class="bg-white rounded shadow p-6">
            <h2 class="text-xl font-bold mb-4 text-gray-800">Existing Rules</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                            <th class="text-left py-3 px-4 text-gray-500 font-bold uppercase text-xs tracking-wider">Rule Name</th>
                            <th class="text-left py-3 px-4 text-gray-500 font-bold uppercase text-xs tracking-wider">Mode</th>
                            <th class="text-right py-3 px-4 text-gray-500 font-bold uppercase text-xs tracking-wider">Value</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for type in types %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="py-3 px-4 font-bold text-gray-800">{{ type.name }}</td>
                            <td class="py-3 px-4">
                                {% if type.mode == 'PERCENTAGE' %}
                                    <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded border border-blue-200 font-bold">Percentage</span>
                                {% else %}
                                    <span class="bg-purple-100 text-purple-800 text-xs px-2 py-1 rounded border border-purple-200 font-bold">Fixed Amount</span>
                                {% endif %}
                            </td>
                            <td class="py-3 px-4 text-right font-mono font-bold text-gray-700">
                                {% if type.mode == 'PERCENTAGE' %}
                                    {{ type.value }}%
                                {% else %}
                                    ₦{{ type.value|number_format(2) }}
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="3" class="p-8 text-center text-gray-400 italic">No discount rules defined yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <div class="mt-6 text-right border-t pt-4">
                <a href="{{ path('app_tenant_discount_assign') }}" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-bold">
                    Go to Scholarship Board &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}