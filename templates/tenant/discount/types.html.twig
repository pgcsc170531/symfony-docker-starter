{% extends 'base.html.twig' %}
{% block title %}Discount Rules{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:py-6">

    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div class="min-w-0">
            <a href="{{ path('app_tenant_discount_assign') }}"
               class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">
                &larr; Scholarship Board
            </a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Discount rules</h1>
            <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-600">
                A rule is the reusable reason a bill is reduced. Assign it to a pupil on the Scholarship Board.
            </p>
        </div>
        <a href="{{ path('app_tenant_discount_assign') }}"
           class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-accent-300 bg-white px-4 text-sm font-bold text-accent-700 hover:bg-accent-50 sm:w-auto">
            Assign to a pupil
        </a>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

        {# ── Create / edit ─────────────────────────────────────────────── #}
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-6 lg:col-span-1">
            <h2 class="text-base font-bold text-ink-900">
                {{ editing ? 'Edit discount rule' : 'Create discount rule' }}
            </h2>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">
                {{ editing
                    ? 'Saving re-prices every open bill that uses this rule.'
                    : 'Give the rule a name, then choose percentage or a fixed naira amount.' }}
            </p>

            {{ form_start(form, {'attr': {'class': 'mt-4'}}) }}
                {{ form_errors(form) }}

                <div class="space-y-4">
                    <div>
                        {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-semibold text-ink-700'}}) }}
                        {{ form_widget(form.name, {'attr': {
                            'class': 'mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500',
                            'placeholder': 'e.g. Staff Child Scholarship'
                        }}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div>
                        {{ form_label(form.mode, null, {'label_attr': {'class': 'block text-sm font-semibold text-ink-700'}}) }}
                        {{ form_widget(form.mode, {'attr': {
                            'class': 'mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500'
                        }}) }}
                        {{ form_errors(form.mode) }}
                    </div>

                    <div>
                        {{ form_label(form.value, null, {'label_attr': {'class': 'block text-sm font-semibold text-ink-700'}}) }}
                        {{ form_widget(form.value, {'attr': {
                            'class': 'mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500',
                            'placeholder': 'e.g. 50'
                        }}) }}
                        {{ form_help(form.value) }}
                        {{ form_errors(form.value) }}
                    </div>

                    <div class="rounded-lg border border-ink-200 bg-ink-50 p-3">
                        <div class="flex items-start gap-3">
                            {{ form_widget(form.appliesToAll, {'attr': {
                                'class': 'mt-0.5 h-5 w-5 shrink-0 rounded border-ink-300 text-accent-600 focus:ring-accent-500'
                            }}) }}
                            <div class="min-w-0">
                                {{ form_label(form.appliesToAll, null, {'label_attr': {
                                    'class': 'flex min-h-[44px] cursor-pointer items-center text-sm font-semibold text-ink-900'
                                }}) }}
                            </div>
                        </div>
                        {{ form_errors(form.appliesToAll) }}
                    </div>
                </div>

                <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                    <button type="submit"
                            class="min-h-[44px] w-full rounded-lg bg-accent-600 px-6 text-sm font-bold text-white shadow-sm hover:bg-accent-700 sm:w-auto">
                        {{ editing ? 'Save changes' : 'Create rule' }}
                    </button>
                    {% if editing %}
                        <a href="{{ path('app_tenant_discount_types') }}"
                           class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 bg-white px-4 text-sm font-bold text-ink-700 hover:border-accent-400 sm:w-auto">
                            Cancel
                        </a>
                    {% endif %}
                </div>
            {{ form_end(form) }}
        </section>

        {# ── Existing rules ────────────────────────────────────────────── #}
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-6 lg:col-span-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-base font-bold text-ink-900">Existing rules</h2>
                <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[11px] font-bold text-ink-600">
                    {{ types|length }} rule{{ types|length == 1 ? '' : 's' }}
                </span>
            </div>

            <div class="relative mt-3 overflow-x-auto rounded-lg border border-ink-200">
                <table class="w-full min-w-[760px] text-left text-sm">
                    <thead class="border-b border-ink-200 bg-ink-50">
                        <tr>
                            <th class="p-3 font-bold text-ink-600">Rule</th>
                            <th class="p-3 font-bold text-ink-600">Mode</th>
                            <th class="p-3 text-right font-bold text-ink-600">Value</th>
                            <th class="p-3 font-bold text-ink-600">Applies to</th>
                            <th class="p-3 text-center font-bold text-ink-600">Assigned</th>
                            <th class="p-3 text-right font-bold text-ink-600"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for type in types %}
                            {% set assigned = assignmentCounts[type.id] ?? 0 %}
                            <tr class="hover:bg-ink-50/60">
                                <td class="p-3">
                                    <p class="break-words font-bold text-ink-900">{{ type.name }}</p>
                                </td>
                                <td class="p-3">
                                    {% if type.mode == 'PERCENTAGE' %}
                                        <span class="rounded-full bg-accent-50 px-2 py-0.5 text-[11px] font-bold text-accent-700">Percentage</span>
                                    {% else %}
                                        <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[11px] font-bold text-ink-700">Fixed amount</span>
                                    {% endif %}
                                </td>
                                <td class="p-3 text-right font-mono font-bold text-ink-800">
                                    {% if type.mode == 'PERCENTAGE' %}
                                        {{ type.value|number_format(0) }}%
                                    {% else %}
                                        ₦{{ type.value|number_format(0) }}
                                    {% endif %}
                                </td>
                                <td class="p-3">
                                    {% if type.appliesToAll %}
                                        <span class="rounded-full bg-paid/10 px-2 py-0.5 text-[11px] font-bold text-paid">Grand total</span>
                                    {% else %}
                                        <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[11px] font-bold text-ink-600">Tuition only</span>
                                    {% endif %}
                                </td>
                                <td class="p-3 text-center">
                                    {% if assigned > 0 %}
                                        <span class="rounded-full bg-pending/10 px-2 py-0.5 text-[11px] font-bold text-pending">
                                            {{ assigned }} pupil{{ assigned == 1 ? '' : 's' }}
                                        </span>
                                    {% else %}
                                        <span class="text-xs text-ink-500">Unused</span>
                                    {% endif %}
                                </td>
                                <td class="p-3">
                                    <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-end">
                                        <a href="{{ path('app_tenant_discount_type_edit', {id: type.id}) }}"
                                           class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-accent-300 px-3 text-xs font-bold text-accent-700 hover:bg-accent-50">
                                            Edit
                                        </a>

                                        {% if assigned == 0 %}
                                            <form method="post"
                                                  action="{{ path('app_tenant_discount_type_delete', {id: type.id}) }}"
                                                  onsubmit="return confirm('Delete this discount rule? This cannot be undone.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_discount_type_' ~ type.id) }}">
                                                <button type="submit"
                                                        class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-failed/40 px-3 text-xs font-bold text-failed hover:bg-failed/10 sm:w-auto">
                                                    Delete
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="text-center text-[11px] leading-tight text-ink-500 sm:max-w-[110px] sm:text-right">
                                                In use — revoke it from pupils first
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="p-8 text-center text-sm text-ink-600">
                                    No discount rules yet. Create the first rule on the left.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-4 rounded-lg border border-accent-200 bg-accent-50 p-3 text-xs leading-relaxed text-ink-700">
                <strong class="text-ink-900">How the rule reaches the bill:</strong>
                by default a percentage or fixed rule comes off <strong>tuition only</strong>.
                Tick <strong>Apply to grand total</strong> to take the percentage off the
                whole bill instead, so a 100% rule makes the total due ₦0. The scope
                belongs to the rule and applies to every pupil on it —
                <a href="{{ path('app_tenant_discount_assign') }}" class="font-bold text-accent-700 underline">the Scholarship Board</a>
                only chooses who gets the rule, never what it covers. Editing a rule
                re-prices open bills immediately; a bill with money already paid is not
                changed.
            </div>
        </section>
    </div>
</div>
{% endblock %}