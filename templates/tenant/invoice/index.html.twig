{% extends 'base.html.twig' %}

{% block title %}Invoice History{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Invoices & Bills</h1>
            <p class="text-gray-500">Track all issued bills and payment status.</p>
        </div>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="p-4 font-bold text-gray-600">ID</th>
                    <th class="p-4 font-bold text-gray-600">Student</th>
                    <th class="p-4 font-bold text-gray-600">Type</th>
                    <th class="p-4 font-bold text-gray-600">Date</th>
                    <th class="p-4 font-bold text-gray-600 text-right">Total</th>
                    <th class="p-4 font-bold text-gray-600 text-right">Paid</th>
                    <th class="p-4 font-bold text-gray-600 text-center">Status</th>
                    <th class="p-4 font-bold text-gray-600 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for invoice in invoices %}
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-4 font-mono text-gray-500">#{{ invoice.id }}</td>
                    <td class="p-4 font-bold text-gray-800">{{ invoice.student.fullName }}</td>
                    <td class="p-4">
                        {% if invoice.type == 'ACADEMIC' %}
                            <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded">Fees</span>
                        {% else %}
                            <span class="text-xs bg-orange-100 text-orange-700 px-2 py-1 rounded">Store</span>
                        {% endif %}
                    </td>
                    <td class="p-4 text-gray-600">{{ invoice.createdAt|date('M j, Y') }}</td>
                    <td class="p-4 text-right font-bold">₦{{ invoice.totalAmount|number_format }}</td>
                    <td class="p-4 text-right text-green-600">₦{{ invoice.paidAmount|number_format }}</td>
                    <td class="p-4 text-center">
                        {% if invoice.status == 'PAID' %}
                            <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full">PAID</span>
                        {% elseif invoice.status == 'PARTIAL' %}
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-bold px-2 py-1 rounded-full">PARTIAL</span>
                        {% else %}
                            <span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded-full">UNPAID</span>
                        {% endif %}
                    </td>
                    <td class="p-4 text-right">
                        <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}" class="text-blue-600 hover:underline font-bold">View</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="p-8 text-center text-gray-500">No invoices found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}