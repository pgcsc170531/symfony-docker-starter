{% extends 'base.html.twig' %}

{% block title %}{{ page_title|default('Invoice History') }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 md:mt-10 p-2 sm:p-4 md:p-6">
    
    {# --- PAGE HEADER --- #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">{{ page_title|default('Invoice Ledger') }}</h1>
            <p class="text-sm text-gray-500 mt-1">Track all issued bills, record payments, and monitor balances.</p>
        </div>
    </div>

    {# --- MAIN DATA CARD --- #}
    <div class="bg-white shadow-sm border border-gray-200 rounded-xl overflow-hidden">
        
        {# --- FRICTIONLESS FILTER BAR --- #}
        <div class="p-4 md:p-5 border-b border-gray-100 bg-gray-50 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            
            <div class="text-gray-600 font-medium text-sm flex items-center">
                <i class="fas fa-file-invoice-dollar text-indigo-500 mr-2 text-lg"></i> 
                {{ page_title|default('Financial Records') }}
            </div>
            
            <form method="GET" class="flex flex-col sm:flex-row w-full lg:w-auto gap-2">
                
                {# Status Filter #}
                <select name="status" class="border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white min-w-[130px] shadow-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="UNPAID" {% if app.request.query.get('status') == 'UNPAID' %}selected{% endif %}>🔴 Unpaid</option>
                    <option value="PARTIAL" {% if app.request.query.get('status') == 'PARTIAL' %}selected{% endif %}>🟡 Partial</option>
                    <option value="PAID" {% if app.request.query.get('status') == 'PAID' %}selected{% endif %}>🟢 Fully Paid</option>
                </select>

                {# Search Input #}
                <div class="flex w-full sm:w-72 shadow-sm">
                    <input type="text" name="q" value="{{ app.request.query.get('q') }}" placeholder="Search Name or INV No..." 
                           class="w-full border-gray-300 border-y border-l p-2.5 rounded-l-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none">
                    <button type="submit" class="bg-gray-800 text-white px-5 py-2.5 rounded-r-md hover:bg-gray-900 font-bold text-sm transition-colors border border-gray-800">
                        Search
                    </button>
                </div>
            </form>
        </div>

        {# --- MOBILE-FRIENDLY SCROLLABLE TABLE --- #}
        <div class="overflow-x-auto w-full">
            <table class="w-full min-w-[900px] text-left text-sm whitespace-nowrap">
                <thead class="bg-white border-b border-gray-200">
                    <tr>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Invoice No.</th>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Student / Customer</th>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Type & Date</th>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Total</th>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Paid</th>
                        <th class="p-4 text-xs font-bold text-indigo-600 uppercase tracking-wider text-right bg-indigo-50/30">Balance</th>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-center">Status</th>
                        <th class="p-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for invoice in invoices %}
                    
                    {# Calculate the balance dynamically #}
                    {% set balance = invoice.totalAmount - invoice.paidAmount %}

                    <tr class="hover:bg-indigo-50/30 transition-colors bg-white">
                        
                        {# Professional Invoice Number #}
                        <td class="p-4 font-mono text-indigo-600 font-bold text-xs">{{ invoice.invoiceNumber }}</td>
                        
                        {# DYNAMIC NAME: Handles Students OR Walk-Ins #}
                        <td class="p-4 font-bold text-gray-800">
                            {% if invoice.student %}
                                {{ invoice.student.fullName }}
                            {% else %}
                                {{ invoice.buyerName }} <span class="text-[10px] bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded ml-1 font-medium tracking-wide uppercase">Walk-in</span>
                            {% endif %}
                        </td>
                        
                        <td class="p-4">
                            <div class="flex items-center gap-2">
                                {% if invoice.type == 'ACADEMIC' %}
                                    <span class="text-[10px] font-bold bg-blue-100 text-blue-700 px-2 py-0.5 rounded uppercase">Fees</span>
                                {% else %}
                                    <span class="text-[10px] font-bold bg-orange-100 text-orange-700 px-2 py-0.5 rounded uppercase">Store</span>
                                {% endif %}
                                <span class="text-xs text-gray-500">{{ invoice.createdAt|date('d M, Y') }}</span>
                            </div>
                        </td>
                        
                        <td class="p-4 text-right font-medium text-gray-600">₦{{ invoice.totalAmount|number_format(2) }}</td>
                        <td class="p-4 text-right font-medium text-green-600">₦{{ invoice.paidAmount|number_format(2) }}</td>
                        
                        {# BALANCE DUE COLUMN #}
                        <td class="p-4 text-right font-bold text-red-600 bg-indigo-50/30">
                            {% if balance > 0 %}
                                ₦{{ balance|number_format(2) }}
                            {% else %}
                                <span class="text-gray-400">₦0.00</span>
                            {% endif %}
                        </td>
                        
                        <td class="p-4 text-center">
                            {% if invoice.status == 'PAID' %}
                                <span class="bg-green-100 border border-green-200 text-green-800 text-[10px] font-bold px-2.5 py-1 rounded-md uppercase">PAID</span>
                            {% elseif invoice.status == 'PARTIAL' %}
                                <span class="bg-yellow-100 border border-yellow-200 text-yellow-800 text-[10px] font-bold px-2.5 py-1 rounded-md uppercase">PARTIAL</span>
                            {% else %}
                                <span class="bg-red-100 border border-red-200 text-red-800 text-[10px] font-bold px-2.5 py-1 rounded-md uppercase">UNPAID</span>
                            {% endif %}
                        </td>
                        
                        <td class="p-4 text-right">
                            <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1.5 rounded-md text-xs font-bold transition-colors border border-gray-300 shadow-sm">
                                Manage
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="p-12 text-center">
                            <div class="flex flex-col items-center justify-center text-gray-400">
                                <svg class="w-12 h-12 mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                <p class="text-base font-medium text-gray-500">No invoices found matching your criteria.</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
                
                {# ====================================================== #}
                {# DYNAMIC TOTALS FOOTER                                  #}
                {# ====================================================== #}
                {% if invoices|length > 0 %}
                <tfoot class="bg-gray-100 border-t-2 border-gray-300">
                    <tr>
                        {# Spans the first 3 columns #}
                        <td colspan="3" class="p-4 text-right font-bold text-gray-600 uppercase tracking-wider text-xs">
                            Filtered Totals:
                        </td>
                        
                        {# The Total Amounts #}
                        <td class="p-4 text-right font-bold text-gray-900 text-sm">
                            ₦{{ sum_total|number_format(2) }}
                        </td>
                        <td class="p-4 text-right font-bold text-green-700 text-sm">
                            ₦{{ sum_paid|number_format(2) }}
                        </td>
                        <td class="p-4 text-right font-black text-red-700 bg-indigo-50/50 text-sm border-l border-r border-indigo-100">
                            ₦{{ sum_balance|number_format(2) }}
                        </td>
                        
                        {# Spans the last 2 columns to keep layout clean #}
                        <td colspan="2" class="p-4 bg-indigo-50/50"></td>
                    </tr>
                </tfoot>
                {% endif %}
                
            </table>
        </div>
        
    </div>
</div>
{% endblock %}