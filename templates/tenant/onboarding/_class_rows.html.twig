{#
    The class rows, shared by both states of step 2 (first run / classes already
    exist). One row = one class: tick it, rename it, and give it its own arms.

    Arms are per row because they genuinely differ: JSS 1 often has A–C while SS 1
    has A–B, and a nursery usually has none at all. A single school-wide arms field
    could not say that — it forced an arm that does not exist, or a rename later.
#}
<div id="class-rows" class="space-y-2" data-index="{{ form.classes|length }}">
    {% for row in form.classes %}
        <div class="class-row rounded-xl border border-ink-200 bg-white p-3">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                <div class="flex items-center gap-2 sm:pb-2.5">
                    {{ form_widget(row.checked, {attr: {class: 'h-5 w-5 rounded border-ink-300 text-accent-600 focus:ring-accent-500'}}) }}
                    <span class="text-xs font-semibold uppercase tracking-wide text-ink-400 sm:hidden">Include</span>
                </div>

                <div class="min-w-0 flex-1">
                    <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-ink-500">Class name</label>
                    {{ form_widget(row.name, {attr: {
                        class: 'min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500',
                        placeholder: 'e.g. Nursery 1'
                    }}) }}
                </div>

                <div class="min-w-0 flex-1">
                    <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-ink-500">
                        Arms <span class="normal-case text-ink-400">(comma separated, optional)</span>
                    </label>
                    {{ form_widget(row.arms, {attr: {
                        class: 'min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500',
                        placeholder: 'A, B, C'
                    }}) }}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<div id="class-prototype" class="hidden" data-prototype="{{ form_widget(form.classes.vars.prototype)|e('html_attr') }}"></div>

<button type="button" id="add-class-row"
        class="mt-3 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-dashed border-ink-300 px-4 text-sm font-semibold text-ink-600 hover:border-accent-400 hover:text-accent-700 sm:w-auto">
    + Add another class
</button>

<p class="mt-2 text-xs leading-relaxed text-ink-500">
    Leave <strong>Arms</strong> empty for a single class, or type the arms this class actually has —
    <span class="font-mono">A, B, C</span> makes three classes: {{ 'Nursery 1 A, Nursery 1 B, Nursery 1 C' }}.
    Different classes can have different arms.
</p>

<script>
    (function () {
        var container = document.getElementById('class-rows');
        var protoHolder = document.getElementById('class-prototype');
        var button = document.getElementById('add-class-row');
        if (!container || !protoHolder || !button) { return; }

        var template = protoHolder.getAttribute('data-prototype');
        if (!template) { return; }

        button.addEventListener('click', function () {
            var index = parseInt(container.getAttribute('data-index'), 10) || 0;
            // Symfony names every collection entry `...classes[<index>][...]`.
            var html = template.replace(/__name__/g, String(index));
            container.insertAdjacentHTML('beforeend', html);
            container.setAttribute('data-index', String(index + 1));

            var added = container.lastElementChild;
            if (added) {
                added.querySelector('input[type="checkbox"]')?.setAttribute('checked', 'checked');
                added.querySelector('input[type="text"]')?.focus();
            }
        });
    })();
</script>
