{% extends 'base.html.twig' %}

{% block title %}School Identity{% endblock %}

{% block body %}
{#
    On the shell now (UI-SPEC §4.1.3). What went, and why:
    · its own Tailwind CDN — a SECOND, independent Tailwind with no access to the
      design tokens, so `bg-accent-*` would have produced no CSS at all here;
    · Font Awesome, for three decorative glyphs — now inline SVG;
    · the Inter web font — the system stack is the standard (§3);
    · `-m-6`, which was cancelling <main>'s old padding. That padding is gone;
    · `min-h-screen` on the wrappers and the card — <main> already fills the
      viewport and is the only scroll container.
#}
<div class="px-4 py-2">
    <div class="w-full">

            {# MAIN CARD #}
            <div class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-card md:rounded-3xl">
                
                {# 1. BLUE HEADER #}
                <div class="relative bg-accent-600 p-6 text-white md:p-10">
                    <div class="relative z-10">
                        <h1 class="text-xl font-bold tracking-tight md:text-3xl">School Identity</h1>
                        <p class="mt-1 text-sm text-accent-100 md:text-base">Step 1: Build your brand for {{ school.name ?: 'your school' }}.</p>
                    </div>
                </div>

                {# 2. FORM BODY #}
                <div class="p-5 md:p-12 flex-1">
                    {{ form_start(form, {'attr': {'class': 'space-y-6 md:space-y-8', 'id': 'onboarding-form'}}) }}
                        
                        {# A. Name #}
                        <div class="space-y-2">
                            <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">School / College Name</label>
                            {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-4 md:px-6 md:py-5 rounded-xl border-2 border-gray-100 focus:border-blue-600 focus:ring-0 text-lg md:text-xl font-bold transition-all'}}) }}
                        </div>

                        {# B. Motto #}
                        <div class="space-y-2">
                            <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">Motto</label>
                            {{ form_widget(form.motto, {'attr': {'class': 'w-full px-4 py-4 md:px-6 md:py-5 rounded-xl border-2 border-gray-100 focus:border-blue-600 focus:ring-0 text-lg font-medium transition-all'}}) }}
                        </div>

                        {# C. Institution Type #}
                        <div class="space-y-2">
                            <label class="text-[10px] md:text-xs font-black text-ink-400 uppercase tracking-widest px-1">Institution Type</label>
                            {# Seven options used to sit in a single non-wrapping row of
                               280px cards: 207px of horizontal overflow on a 360px phone,
                               with the labels clipped to "OR DARY 3 ( RS)". A grid wraps
                               instead — two columns from 320px, more as the screen grows. #}
                            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
                                {% for child in form.institutionType %}
                                    <label class="group min-w-0 cursor-pointer">
                                        {{ form_widget(child, {'attr': {'class': 'sr-only peer'}}) }}
                                        <div class="flex h-full min-h-[92px] flex-col items-center justify-center gap-1 rounded-2xl border-2 border-ink-200 bg-white p-3 text-center shadow-sm transition-all peer-checked:border-accent-600 peer-checked:bg-accent-50 active:scale-95 md:min-h-[120px] md:p-5">
                                            <span class="text-2xl md:text-4xl" aria-hidden="true">{% if 'College' in child.vars.label %}🎓{% else %}🏫{% endif %}</span>
                                            <span class="text-[11px] font-bold uppercase leading-tight text-ink-700 peer-checked:text-accent-700 md:text-sm">{{ child.vars.label }}</span>
                                        </div>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        {# D. Brand Color (MATCHED TO 'primaryColor') #}
                        <div class="space-y-2">
                            <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">Brand Color</label>
                            <div class="flex items-center gap-4">
                                {{ form_widget(form.primaryColor, {'attr': {'class': 'h-14 w-14 rounded-xl border-2 border-gray-100 cursor-pointer p-1'}}) }}
                                <span class="text-gray-500 text-xs">This color will be used for your buttons and portal theme.</span>
                            </div>
                        </div>

                        {# E. Contact Details (MATCHED TO 'phoneNumber') #}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">Official Email</label>
                                {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-4 rounded-xl border-2 border-gray-100 focus:border-blue-600 focus:ring-0 font-bold'}}) }}
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">Phone Number</label>
                                {{ form_widget(form.phoneNumber, {'attr': {'class': 'w-full px-4 py-4 rounded-xl border-2 border-gray-100 focus:border-blue-600 focus:ring-0 font-bold'}}) }}
                            </div>
                        </div>

                        {# F. Address #}
                        <div class="space-y-2">
                            <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">Physical Address</label>
                            {{ form_widget(form.address, {'attr': {'class': 'w-full px-4 py-4 rounded-xl border-2 border-gray-100 focus:border-blue-600 focus:ring-0 font-medium', 'rows': '2'}}) }}
                        </div>

                        {# G. Logo Upload #}
                        <div class="space-y-2 pb-24 md:pb-0">
                            <label class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-widest px-1">School Logo</label>
                            <div class="relative border-2 border-dashed border-gray-200 rounded-2xl p-6 md:p-10 bg-gray-50 hover:bg-blue-50 transition-all cursor-pointer text-center"
                                 onclick="document.getElementById('{{ form.logoFile.vars.id }}').click()">
                                
                                <div id="preview-wrapper" class="hidden mb-4 animate-in fade-in zoom-in">
                                    <img id="image-preview" src="#" class="h-24 w-24 object-contain rounded-xl mx-auto shadow-lg border-4 border-white">
                                </div>

                                <div id="upload-instruction">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-2 h-6 w-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
                                        <path d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
                                    </svg>
                                    <p class="text-sm font-bold text-gray-700">Tap to Upload Logo</p>
                                </div>

                                <div class="hidden">
                                    {{ form_widget(form.logoFile, {'attr': {'onchange': 'previewImage(this)'}}) }}
                                </div>
                            </div>
                        </div>

                        {# Was `position: fixed`: that paints against the VIEWPORT, so
                           inside the shell it floated over the footer and covered the
                           last field. In flow at the end of the card is where it goes. #}
                        <div class="mt-8 flex justify-end border-t border-gray-100 pt-5">
                            <button type="submit" class="flex min-h-[52px] w-full items-center justify-center gap-2 rounded-xl bg-accent-600 px-10 py-4 text-base font-bold text-white shadow-lg transition active:scale-95 md:w-auto">
                                Next Step
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <script>
    function previewImage(input) {
        const wrapper = document.getElementById('preview-wrapper');
        const image = document.getElementById('image-preview');
        const instruction = document.getElementById('upload-instruction');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                image.src = e.target.result;
                wrapper.classList.remove('hidden');
                instruction.classList.add('hidden');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    </script>
{% endblock %}