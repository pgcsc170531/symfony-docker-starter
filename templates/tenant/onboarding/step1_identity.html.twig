{% extends 'base.html.twig' %}

{% block title %}School Identity - Gobarau Academy{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 pt-6 md:pt-12 pb-20">
    {# Progress Bar #}
    <div class="mb-8">
        <div class="w-full bg-gray-200 rounded-full h-2">
            <div class="bg-blue-600 h-2 rounded-full transition-all duration-500" style="width: 25%"></div>
        </div>
        <p class="text-xs font-bold text-blue-600 mt-2">STEP 1: IDENTITY</p>
    </div>

    <div class="bg-white shadow-2xl rounded-3xl overflow-hidden border border-gray-100">
        <div class="bg-blue-600 p-8 text-white">
            <h1 class="text-2xl font-extrabold">👋 Welcome!</h1>
            <p class="text-blue-100 mt-1 font-medium">Let's set up your institution's digital identity.</p>
        </div>

        <div class="p-6 md:p-10">
            {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}
                
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">School Name</label>
                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-4 rounded-xl border-gray-300 border text-lg font-bold'}}) }}
                </div>

                {# LOGO UPLOAD #}
                <div class="col-span-2">
                    <label class="text-sm font-bold text-gray-700">Upload School Logo</label>
                    <div class="mt-1 flex flex-col justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-2xl hover:border-blue-400 transition-colors cursor-pointer" 
                         onclick="this.querySelector('input[type=file]').click()">
                        
                        <div id="preview-wrapper" class="hidden mb-4 self-center text-center">
                            <img id="image-preview" src="#" class="h-24 w-24 object-contain rounded-xl shadow-md border-2 border-white mx-auto">
                        </div>

                        <div class="space-y-1 text-center" id="upload-instruction">
                            <i class="fas fa-camera text-gray-400 text-3xl mb-2"></i>
                            <div class="text-sm text-gray-600">
                                {{ form_widget(form.logoFile, {'attr': {'class': 'sr-only', 'onchange': 'previewImage(this)'}}) }}
                                <span class="font-bold text-blue-600">Click to upload logo</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-10">
                    <button type="submit" class="w-full md:w-auto md:float-right bg-blue-600 text-white px-10 py-4 rounded-2xl shadow-xl font-bold">
                        Next Step &rarr;
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    function previewImage(input) {
        const wrapper = document.getElementById('preview-wrapper');
        const image = document.getElementById('image-preview');
        const instruction = document.getElementById('upload-instruction');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                image.src = e.target.result;
                wrapper.classList.remove('hidden');
                instruction.classList.add('opacity-50');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    </script>
{% endblock %} 