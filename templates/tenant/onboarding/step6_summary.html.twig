{% extends 'base.html.twig' %}
{% block title %}Fee Schedule Report{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 px-4 pb-24 print:p-0 print:max-w-none">
    
    {# ================================================================= #}
    {# UNIFIED HEADER: Same Look, Different Buttons                      #}
    {# ================================================================= #}
    
    <div class="print:hidden flex flex-col md:flex-row justify-between items-start md:items-center mb-6 px-4 md:px-0 gap-4">
        
        {# LEFT SIDE: Title & Subtitle #}
        <div>
            {% if app.request.attributes.get('_route') == 'app_tenant_onboarding_summary' %}
                {# ONBOARDING TITLE #}
                <h1 class="text-2xl font-bold text-green-700 flex items-center gap-2">
                    <span>✅ Setup Complete!</span>
                </h1>
                <p class="text-gray-500 text-sm mt-1">This is your final Master Fee Schedule.</p>
            {% else %}
                {# DASHBOARD TITLE #}
                <h1 class="text-2xl font-bold text-gray-800">Master Fee Schedule</h1>
                <p class="text-gray-500 text-sm mt-1">Viewing data for <span class="font-semibold text-gray-700">{{ term.session.name }} - {{ term.name }}</span></p>
            {% endif %}

            {# Note for Hidden Session Fees #}
            {% if isFirstTerm is defined and isFirstTerm == false %}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 mt-2">
                    Note: Session fees hidden (Not 1st Term)
                </span>
            {% endif %}
        </div>

        {# RIGHT SIDE: Actions (Filter, Edit, Print) #}
        <div class="flex flex-col md:flex-row gap-3 w-full md:w-auto">
            
            {# 1. Term Selector (Only show in Dashboard mode) #}
            {% if allTerms is defined and app.request.attributes.get('_route') != 'app_tenant_onboarding_summary' %}
                <form method="get" class="flex-grow md:flex-grow-0">
                    <select name="term" onchange="this.form.submit()" class="w-full md:w-64 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md shadow-sm bg-white cursor-pointer">
                        {% for t in allTerms %}
                            <option value="{{ t.id }}" {{ t.id == term.id ? 'selected' : '' }}>
                                {{ t.session.name }} - {{ t.name }} {{ t.isActive ? '(Active)' : '' }}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            {% endif %}

            <div class="flex gap-2">
                {# 2. Edit Button (Smart Link) #}
                {% if app.request.attributes.get('_route') == 'app_tenant_onboarding_summary' %}
                    {# Onboarding Mode: Just Edit #}
                    <a href="{{ path('app_tenant_onboarding_fee_prices') }}" class="bg-white border border-gray-300 text-gray-700 font-bold px-4 py-2 rounded shadow-sm hover:bg-gray-50 flex items-center gap-2 text-sm whitespace-nowrap">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        Edit Prices
                    </a>
                {% else %}
                    {# Dashboard Mode: Edit + Return Ticket #}
                    <a href="{{ path('app_tenant_onboarding_fee_prices', {'return_to': 'schedule'}) }}" class="bg-white border border-gray-300 text-gray-700 font-bold px-4 py-2 rounded shadow-sm hover:bg-gray-50 flex items-center gap-2 text-sm whitespace-nowrap">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        Edit Prices
                    </a>
                {% endif %}

                {# 3. Print Button #}
                <button onclick="window.print()" class="bg-blue-600 text-white font-bold px-4 py-2 rounded shadow hover:bg-blue-700 flex items-center gap-2 text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                    Print
                </button>
            </div>
        </div>
    </div>


    {# ================================================================= #}
    {# REPORT CARD (Shared Look & Feel)                                  #}
    {# ================================================================= #}
    <div class="bg-white shadow-xl rounded-lg border border-gray-200 p-8 print:shadow-none print:border-none">
        
        {# REPORT HEADER #}
        <div class="text-center mb-8 border-b-2 border-gray-800 pb-4">
            {% if school.logoFilename %}
                <img src="/uploads/logos/{{ school.logoFilename }}" class="h-20 mx-auto mb-2" alt="Logo">
            {% endif %}
            <h1 class="text-3xl font-bold text-gray-900 uppercase">{{ school.name }}</h1>
            <p class="text-gray-600">{{ school.email }}</p>
            <div class="mt-4 inline-block bg-gray-100 px-6 py-2 rounded-full border border-gray-300">
                <span class="font-bold text-gray-800">Fee Schedule:</span> {{ term.name }} ({{ term.session.name }})
            </div>
        </div>

        {# === SECTION 1: ITEMIZED BREAKDOWN === #}
        <div class="mb-8">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-300 border border-gray-300 text-sm">
                    <thead class="bg-gray-800 text-white">
                        <tr>
                            <th class="px-3 py-3 text-left font-bold uppercase w-64 border-r border-gray-600">Fee Description</th>
                            {% for level in levels %}
                                <th class="px-2 py-3 text-center font-bold uppercase border-r border-gray-600">{{ level }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        
                        {# --- PART A: STANDARD BILL --- #}
                        <tr class="bg-gray-100">
                            <td class="px-3 py-2 font-bold text-gray-700 border-r uppercase text-xs tracking-wider" colspan="{{ levels|length + 1 }}">
                                A. Standard Termly Bill (Returning Students)
                            </td>
                        </tr>

                        {% for item in recurringItems %}
                            <tr class="hover:bg-gray-50">
                                <td class="px-3 py-2 font-medium text-gray-900 border-r">{{ item.name }}</td>
                                {% for level in levels %}
                                    <td class="px-2 py-2 text-center border-r">
                                        {% set val = matrix[item.name][level] ?? 0 %}
                                        {{ val > 0 ? val|number_format(2) : '-' }}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                             <tr><td colspan="{{ levels|length + 1 }}" class="p-4 text-center text-gray-400">No recurring fees for this term.</td></tr>
                        {% endfor %}
                        
                        {# SUBTOTAL A #}
                        <tr class="bg-blue-50 font-bold border-t-2 border-blue-200">
                            <td class="px-3 py-2 text-blue-900 text-right border-r">Total Standard Bill (A):</td>
                            {% for level in levels %}
                                <td class="px-2 py-2 text-center text-blue-900 border-r font-mono">
                                    ₦{{ totals[level]['recurring']|number_format(2) }}
                                </td>
                            {% endfor %}
                        </tr>

                        {# --- PART B: NEW INTAKE ADD-ONS --- #}
                        <tr class="bg-gray-100 border-t-4 border-white">
                            <td class="px-3 py-2 font-bold text-gray-700 border-r uppercase text-xs tracking-wider" colspan="{{ levels|length + 1 }}">
                                ➕ B. Add-ons for New Intake Only
                            </td>
                        </tr>

                        {% for item in oneTimeItems %}
                            <tr class="hover:bg-gray-50">
                                <td class="px-3 py-2 font-medium text-gray-900 border-r">{{ item.name }}</td>
                                {% for level in levels %}
                                    <td class="px-2 py-2 text-center border-r">
                                        {% set val = matrix[item.name][level] ?? 0 %}
                                        {{ val > 0 ? val|number_format(2) : '-' }}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                             <tr><td colspan="{{ levels|length + 1 }}" class="p-4 text-center text-gray-400 italic">No additional intake fees.</td></tr>
                        {% endfor %}

                        {# SUBTOTAL B #}
                        <tr class="bg-purple-50 font-bold border-t-2 border-purple-200">
                            <td class="px-3 py-2 text-purple-900 text-right border-r">Total Add-ons (B):</td>
                            {% for level in levels %}
                                <td class="px-2 py-2 text-center text-purple-900 border-r font-mono">
                                    ₦{{ totals[level]['onetime']|number_format(2) }}
                                </td>
                            {% endfor %}
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

        {# === SECTION 2: CASHIER SUMMARY === #}
        <div class="break-inside-avoid mt-8">
            <h3 class="text-lg font-bold text-gray-800 mb-2 border-l-4 border-green-600 pl-2 uppercase">💰 Payment Summary</h3>
            
            <div class="overflow-hidden border border-gray-300 rounded-lg">
                <table class="min-w-full divide-y divide-gray-300">
                    <thead class="bg-gray-800 text-white">
                        <tr>
                            <th class="px-4 py-3 text-left font-bold uppercase w-1/3 text-gray-600">Class Level</th>
                            <th class="px-4 py-3 text-right font-bold uppercase w-1/3 text-blue-800">Returning Student Pays <br><span class="text-xs text-blue-200 opacity-75">(Total A)</span></th>
                            <th class="px-4 py-3 text-right font-bold uppercase w-1/3 text-purple-800">New Intake Pays <br><span class="text-xs text-purple-200 opacity-75">(Total A + Total B)</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        {% for level in levels %}
                            {% set rec = totals[level]['recurring'] %}
                            {% set one = totals[level]['onetime'] %}
                            {% set totalNew = rec + one %}
                            
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 font-bold text-gray-900 border-r">{{ level }}</td>
                                <td class="px-4 py-3 text-right font-mono text-base font-bold text-blue-700 border-r">
                                    ₦{{ rec|number_format(2) }}
                                </td>
                                <td class="px-4 py-3 text-right font-mono text-base font-bold text-purple-700">
                                    ₦{{ totalNew|number_format(2) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-12 text-center text-sm text-gray-500">
            <p>Generated via School Software on {{ "now"|date("d M Y") }}. Authorized Signature: _______________________</p>
        </div>

    </div>
    
    {# ================================================================= #}
    {# 🚀 FOOTER ACTION: GATEWAY TO STUDENT IMPORT                       #}
    {# ================================================================= #}
    
    {# Only show this large call-to-action during the Onboarding Wizard #}
    {% if app.request.attributes.get('_route') == 'app_tenant_onboarding_summary' %}
        
        <div class="mt-10 p-8 bg-indigo-50 border border-indigo-100 rounded-lg text-center print:hidden shadow-sm">
            <h3 class="text-2xl font-black text-indigo-900 mb-2">🎉 Fee Setup Complete!</h3>
            <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
                Your Classes, Term, and Fee Prices are now locked in. 
                The final step is to <b>Add Your Students</b> so the system can automatically generate their bills based on these prices.
            </p>

            <form method="POST" action="{{ path('app_tenant_onboarding_summary') }}">
                <button type="submit" class="bg-indigo-600 text-white text-lg px-10 py-4 rounded-xl font-bold shadow-lg hover:bg-indigo-700 hover:scale-105 transition transform flex items-center justify-center gap-3 mx-auto">
                    <span>🚀</span>
                    <span>Confirm Fees & Import Students</span>
                    <svg class="w-5 h-5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </form>
            
            <p class="text-xs text-gray-400 mt-4">
                Clicking this will save your configuration and open the Bulk Student Import tool.
            </p>
        </div>

    {% endif %}
</div>
{% endblock %}