{% extends 'base.html.twig' %}

{% block title %}Setup Classes{% endblock %}

{% block body %}
{# On the shell now — see the note in step1_identity.html.twig. The gutter moved
   from <body> to the page wrapper, where every other page keeps it. #}
<div class="px-4">
        
        {# PROGRESS BAR #}
        <div class="mb-8">
            <div class="flex justify-between text-xs md:text-sm font-medium text-gray-500 mb-2">
                <span class="text-green-600">✓ Identity</span>
                <span class="text-blue-600 font-bold">2. Classes</span>
                <span>3. Calendar</span>
                <span class="hidden sm:inline">4. Fees</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5">
                <div class="bg-blue-600 h-2.5 rounded-full" style="width: 40%"></div>
            </div>
        </div>

        <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
            
            {# HEADER #}
            <div class="bg-blue-600 p-6 md:p-8 text-white">
                <h1 class="text-2xl md:text-3xl font-bold tracking-tight">🏫 Build Your Class Structure</h1>
                <p class="text-blue-100 mt-2 text-sm md:text-base">
                    We detected you run a <strong>{{ schoolType|capitalize }}</strong> system. Select the levels you need.
                </p>
            </div>

            <div class="p-6 md:p-8">
                
                {{ form_start(form) }}

                {% if existingClassesCount > 0 %}
                    {# ======================================================== #}
                    {# SCENARIO A: CLASSES ALREADY EXIST                        #}
                    {# ======================================================== #}
                    
                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-6">
                        <div class="flex items-start gap-4">
                            <div class="text-3xl">⚠️</div>
                            <div>
                                <h3 class="text-lg font-bold text-amber-900">Wait a minute!</h3>
                                <p class="text-sm text-amber-800 mt-1 leading-relaxed">
                                    You already have <strong>{{ existingClassesCount }} classes</strong> set up in your system. Generating new ones might duplicate your structure.
                                </p>
                            </div>
                        </div>
                    </div>

                    {# PRIMARY SAFE ACTION (Always available if classes exist) #}
                    <button type="submit" name="action" value="keep" class="w-full bg-indigo-900 text-white font-bold py-4 rounded-xl hover:bg-black shadow-lg transition-transform active:scale-95 mb-8">
                        Keep Existing Classes & Continue &rarr;
                    </button>

                    {% if studentCount > 0 %}
                        {# --- SCENARIO A1: STUDENTS EXIST (LOCKED) --- #}
                        <div class="bg-red-50 border border-red-100 rounded-xl p-5 text-center">
                            <span class="text-2xl block mb-2">🔒</span>
                            <p class="text-sm text-red-700 font-bold">Wipe & Regenerate is disabled because {{ studentCount }} student(s) are currently enrolled in these classes.</p>
                        </div>
                        
                        {# Hide form fields to prevent errors #}
                        <div class="hidden">{{ form_rest(form) }}</div>

                        {# Locked Footer (Back Button Only) #}
                        <div class="mt-8 flex justify-start border-t border-gray-100 pt-6">
                            <a href="{{ path('app_tenant_onboarding_identity') }}" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg px-4 py-2 text-sm font-bold text-gray-500 transition-colors hover:bg-gray-50 hover:text-gray-800">
                                &larr; Back to Identity
                            </a>
                        </div>

                    {% else %}
                        {# --- SCENARIO A2: NO STUDENTS (WIPE ALLOWED) --- #}
                        <div class="flex items-center gap-4 my-8 opacity-50">
                            <div class="h-px bg-gray-300 flex-1"></div>
                            <span class="text-xs text-gray-500 font-bold uppercase tracking-widest">OR WIPE & REGENERATE</span>
                            <div class="h-px bg-gray-300 flex-1"></div>
                        </div>

                        {# Show Form Fields #}
                        <div class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 md:p-6 mb-6">
                            <h3 class="font-bold text-gray-800 mb-1 text-sm md:text-base">Your classes</h3>
                            <p class="mb-4 text-xs text-gray-500">Rename anything, and give each class the arms it actually has.</p>
                            {% include 'tenant/onboarding/_class_rows.html.twig' with {form: form} %}
                        </div>

                        {# Wipe Footer #}
                        <div class="flex flex-col-reverse sm:flex-row justify-between items-center gap-4 pt-8 mt-8 border-t border-gray-100">
                            <a href="{{ path('app_tenant_onboarding_identity') }}" class="w-full sm:w-auto text-gray-500 hover:text-gray-800 font-bold text-sm flex items-center justify-center sm:justify-start gap-2 transition-colors py-3 sm:py-2 px-4 rounded-xl hover:bg-gray-50 sm:hover:bg-transparent">
                                &larr; Back to Identity
                            </a>
                            <button type="submit" name="action" value="regenerate" class="w-full sm:w-auto bg-white border-2 border-red-100 text-red-600 font-bold py-3 px-6 rounded-xl hover:bg-red-50 transition-colors">
                                Wipe & Generate New
                            </button>
                        </div>
                    {% endif %}

                {% else %}
                    {# ======================================================== #}
                    {# SCENARIO B: FRESH START (0 CLASSES)                      #}
                    {# ======================================================== #}
                    
                    {# Show Form Fields #}
                    <div class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 md:p-6 mb-6">
                        <h3 class="font-bold text-gray-800 mb-1 text-sm md:text-base">Your classes</h3>
                        <p class="mb-4 text-xs text-gray-500">Rename anything, drop what you do not run, and add your own. Each class carries its own arms.</p>
                        {% include 'tenant/onboarding/_class_rows.html.twig' with {form: form} %}
                    </div>

                    {# Fresh Generation Footer #}
                    <div class="flex flex-col-reverse sm:flex-row justify-between items-center gap-4 pt-8 mt-8 border-t border-gray-100">
                        <a href="{{ path('app_tenant_onboarding_identity') }}" class="w-full sm:w-auto text-gray-500 hover:text-gray-800 font-bold text-sm flex items-center justify-center sm:justify-start gap-2 transition-colors py-3 sm:py-2 px-4 rounded-xl hover:bg-gray-50 sm:hover:bg-transparent">
                            &larr; Back to Identity
                        </a>
                        <button type="submit" name="action" value="generate" class="w-full sm:w-auto bg-blue-600 text-white py-3.5 px-8 rounded-xl font-bold text-lg hover:bg-blue-700 shadow-xl transition-transform transform active:scale-95 flex items-center justify-center gap-2">
                            Generate Classes &rarr;
                        </button>
                    </div>

                {% endif %}

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}