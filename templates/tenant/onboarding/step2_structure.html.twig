<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setup Classes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 min-h-screen py-10 px-4">

    <div class="max-w-3xl mx-auto">
        
        {# PROGRESS BAR (Kept from Old Style) #}
        <div class="mb-8">
            <div class="flex justify-between text-sm font-medium text-gray-500 mb-2">
                <span class="text-green-600">✓ Identity</span>
                <span class="text-blue-600 font-bold">2. Classes</span>
                <span>3. Calendar</span>
                <span>4. Finish</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5">
                <div class="bg-blue-600 h-2.5 rounded-full" style="width: 50%"></div>
            </div>
        </div>

        <div class="bg-white shadow-xl rounded-xl overflow-hidden">
            {# BLUE HEADER (Kept from Old Style) #}
            <div class="bg-blue-600 p-6 text-white">
                <h1 class="text-2xl font-bold">🏫 Build Your Class Structure</h1>
                <p class="text-blue-100 mt-2">
                    We detected you run a <strong>{{ schoolType|capitalize }}</strong> system. Select the levels you need.
                </p>
            </div>

            <div class="p-8">

                {# 🟢 SMART ALERT: If classes exist, show Skip Button #}
                {% if existingClassesCount > 0 %}
                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6 flex justify-between items-center">
                        <div>
                            <h3 class="font-bold text-green-800">✅ Structure Detected</h3>
                            <p class="text-sm text-green-600">You already have {{ existingClassesCount }} classes set up.</p>
                        </div>
                        <a href="{{ path('app_tenant_onboarding_calendar') }}" class="bg-green-600 text-white px-4 py-2 rounded shadow font-bold hover:bg-green-700">
                            Skip to Calendar &rarr;
                        </a>
                    </div>
                {% endif %}
                
                {{ form_start(form) }}
                    
                    <div class="bg-blue-50 border border-blue-100 rounded-lg p-6 mb-6">
                        <h3 class="font-bold text-gray-800 mb-4">1. Which levels exist in your school?</h3>
                        {# Render Checkboxes in a Grid #}
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            {% for child in form.selectedClasses %}
                                <label class="flex items-center space-x-3 bg-white p-3 rounded border border-gray-200 hover:border-blue-400 cursor-pointer shadow-sm transition-colors">
                                    {{ form_widget(child, {'attr': {'class': 'h-5 w-5 text-blue-600 rounded focus:ring-blue-500 border-gray-300'}}) }}
                                    <span class="text-gray-700 font-medium select-none">{{ child.vars.label }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mb-6">
                        <h3 class="font-bold text-gray-800 mb-2">2. Do you have Arms or Sub-divisions?</h3>
                        <p class="text-sm text-gray-500 mb-2">e.g. If you have "JSS 1A" and "JSS 1B", enter <strong>A, B</strong> below.</p>
                        {{ form_widget(form.arms, {'attr': {'class': 'w-full text-lg p-3 border border-gray-300 rounded-lg focus:border-blue-500 focus:ring-1 focus:ring-blue-500', 'placeholder': 'A, B, C'}}) }}
                    </div>

                    <div class="flex justify-between items-center pt-6 border-t border-gray-100">
                        <a href="{{ path('app_tenant_onboarding_identity') }}" class="text-gray-500 hover:text-gray-700 font-medium">
                            &larr; Back
                        </a>
                        {# Use standard form Save button if defined, or custom button #}
                        {% if form.save is defined %}
                            {{ form_row(form.save) }}
                        {% else %}
                             <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-blue-700 shadow-md transition-transform transform hover:-translate-y-0.5">
                                Next Step &rarr;
                            </button>
                        {% endif %}
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</body>
</html>