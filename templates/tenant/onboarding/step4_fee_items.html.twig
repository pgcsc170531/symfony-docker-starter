
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setup Classes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 min-h-screen py-10 px-4">

<div class="max-w-6xl mx-auto mt-10 pb-20 px-4">
    
    {# HEADER #}
    <div class="bg-indigo-600 p-6 rounded-t-xl text-white shadow-lg flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold">⚙️ Configure Your Fee Structure</h1>
            <p class="text-indigo-100 mt-1">Select standard fees or add your own custom ones.</p>
        </div>
        <div class="text-sm bg-indigo-700 py-1 px-3 rounded-lg border border-indigo-500">
            Step 4 of 5
        </div>
    </div>

    {# MAIN FORM #}
    <div class="bg-white shadow-xl rounded-b-xl overflow-hidden p-6 border border-gray-200">
        {{ form_start(form) }}
            
        <div class="overflow-x-auto rounded-lg border border-gray-100">
           <table class="min-w-full divide-y divide-gray-200" id="fee-table">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="w-10 px-4 py-3"></th> {# Drag Handle Column #}
                        <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 uppercase w-16">Active</th>
                        <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase w-1/3">Fee Name</th>
                        <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase">Frequency</th>
                        <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase">Target Audience</th>
                        <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 uppercase w-24">Optional?</th>
                        <th class="px-4 py-3 w-16"></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200" id="fee-list">
                    {% for row in form.items %}
                        {# 🟢 ADD 'draggable="true"' and 'data-index' #}
                        <tr class="hover:bg-gray-50 transition-colors group draggable-row cursor-move" draggable="true">
                            {# 🟢 1. DRAG HANDLE #}
                            <td class="px-4 py-3 text-center text-gray-400 cursor-grab active:cursor-grabbing">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
                                {# Hidden Position Field #}
                                {{ form_widget(row.position) }}
                            </td>

                            <td class="px-4 py-3 text-center">
                                {{ form_widget(row.id) }}
                                {{ form_widget(row.isSelected, {'attr': {'class': 'h-5 w-5 text-indigo-600 rounded focus:ring-indigo-500 cursor-pointer border-gray-300'}}) }}
                            </td>
                            <td class="px-4 py-3">
                                {{ form_widget(row.name, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border'}}) }}
                            </td>
                            <td class="px-4 py-3">
                                {{ form_widget(row.frequency, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border bg-white'}}) }}
                            </td>
                            <td class="px-4 py-3">
                                {{ form_widget(row.target, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border bg-white'}}) }}
                            </td>
                            <td class="px-4 py-3 text-center">
                                {{ form_widget(row.isOptional, {'attr': {'class': 'h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer'}}) }}
                            </td>
                            <td class="px-4 py-3 text-center">
                                <button type="button" class="text-gray-400 hover:text-red-600 transition-colors" onclick="this.closest('tr').remove()">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4 mb-8">
            <button type="button" id="add-fee-btn" 
                    class="flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-sm px-4 py-2 hover:bg-indigo-50 rounded-lg transition-colors">
                <span class="text-xl mr-2 font-bold">+</span> Add Custom Fee Item
            </button>
        </div>

        {# FOOTER ACTIONS #}
        <div class="flex justify-between items-center pt-6 border-t border-gray-100">
            <a href="{{ path('app_tenant_onboarding_calendar') }}" class="text-gray-500 font-medium hover:text-gray-700 flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Back
            </a>
            
            <button type="submit" class="bg-indigo-600 text-white px-8 py-3 rounded-lg font-bold shadow hover:bg-indigo-700 transform hover:-translate-y-0.5 transition-all flex items-center gap-2">
                Save & Set Prices 
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
        </div>

        {% do form.save.setRendered %}
        {{ form_end(form) }}
    </div>
</div>

<script>
    document.getElementById('add-fee-btn').addEventListener('click', function() {
        const list = document.getElementById('fee-list');
        const index = list.querySelectorAll('tr').length;
        
        // CSS Classes matching your theme
        const inputClass = "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border";
        const selectClass = "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border bg-white";
        const checkboxClass = "h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer";

        const newRow = document.createElement('tr');
        newRow.className = "bg-yellow-50 transition-colors border-l-4 border-yellow-400";
        newRow.innerHTML = `
            <td class="px-4 py-3 text-center">
                <input type="checkbox" checked disabled class="h-5 w-5 rounded text-indigo-600 opacity-50 cursor-not-allowed">
            </td>
            <td class="px-4 py-3">
                <input type="text" name="fee_items[items][${index}][name]" required class="${inputClass}" placeholder="Custom Fee Name">
            </td>
            <td class="px-4 py-3">
                <select name="fee_items[items][${index}][frequency]" class="${selectClass}">
                    <option value="TERM">Every Term</option>
                    <option value="SESSION">Once per Session</option>
                    <option value="ONETIME">One-Time (Life of Student)</option>
                </select>
            </td>
            <td class="px-4 py-3">
                <select name="fee_items[items][${index}][target]" class="${selectClass}">
                    <option value="ALL">All Students</option>
                    <option value="NEW">New Intake Only</option>
                </select>
            </td>
            <td class="px-4 py-3 text-center">
                <input type="checkbox" name="fee_items[items][${index}][isOptional]" value="1" class="${checkboxClass}">
            </td>
            <td class="px-4 py-3 text-center">
                <button type="button" class="text-red-500 hover:text-red-700 transition-colors" onclick="this.closest('tr').remove()">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                <input type="hidden" name="fee_items[items][${index}][isSelected]" value="1">
            </td>
        `;
        list.appendChild(newRow);
    });

    document.addEventListener('DOMContentLoaded', () => {
        const list = document.getElementById('fee-list');
        let draggedItem = null;

        // 1. Initialize Drag Events
        function addDragEvents(row) {
            row.addEventListener('dragstart', function() {
                draggedItem = this;
                setTimeout(() => this.classList.add('opacity-50', 'bg-indigo-50'), 0);
            });

            row.addEventListener('dragend', function() {
                setTimeout(() => {
                    this.classList.remove('opacity-50', 'bg-indigo-50');
                    draggedItem = null;
                    updatePositions(); // Update numbers after drop
                }, 0);
            });

            row.addEventListener('dragover', function(e) {
                e.preventDefault();
                const afterElement = getDragAfterElement(list, e.clientY);
                if (afterElement == null) {
                    list.appendChild(draggedItem);
                } else {
                    list.insertBefore(draggedItem, afterElement);
                }
            });
        }

        // 2. Apply to existing rows
        document.querySelectorAll('.draggable-row').forEach(addDragEvents);

        // 3. Helper to calculate drop position
        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.draggable-row:not(.opacity-50)')];

            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        // 4. Update Hidden Input Numbers (0, 1, 2, 3...)
        function updatePositions() {
            document.querySelectorAll('#fee-list tr').forEach((row, index) => {
                const hiddenInput = row.querySelector('.fee-position');
                if (hiddenInput) hiddenInput.value = index;
            });
        }
        
        // Run once on load to set initial order
        updatePositions();

        // 5. Update "Add Button" to include drag logic
        document.getElementById('add-fee-btn').addEventListener('click', function() {
            const index = list.querySelectorAll('tr').length;
            
            // Define styling constants
            const inputClass = "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border";
            const selectClass = "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border bg-white";
            const checkboxClass = "h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer";

            const newRow = document.createElement('tr');
            newRow.className = "bg-yellow-50 transition-colors border-l-4 border-yellow-400 draggable-row cursor-move";
            newRow.draggable = true;
            
            newRow.innerHTML = `
                <td class="px-4 py-3 text-center text-gray-400 cursor-grab">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
                    <input type="hidden" name="fee_items[items][${index}][position]" class="fee-position" value="${index}">
                </td>
                <td class="px-4 py-3 text-center">
                    <input type="checkbox" checked disabled class="h-5 w-5 rounded text-indigo-600 opacity-50 cursor-not-allowed">
                </td>
                <td class="px-4 py-3">
                    <input type="text" name="fee_items[items][${index}][name]" required class="${inputClass}" placeholder="Custom Fee Name">
                </td>
                <td class="px-4 py-3">
                    <select name="fee_items[items][${index}][frequency]" class="${selectClass}">
                        <option value="TERM">Every Term</option>
                        <option value="SESSION">Once per Session</option>
                        <option value="ONETIME">One-Time (Life of Student)</option>
                    </select>
                </td>
                <td class="px-4 py-3">
                    <select name="fee_items[items][${index}][target]" class="${selectClass}">
                        <option value="ALL">All Students</option>
                        <option value="NEW">New Intake Only</option>
                    </select>
                </td>
                <td class="px-4 py-3 text-center">
                    <input type="checkbox" name="fee_items[items][${index}][isOptional]" value="1" class="${checkboxClass}">
                </td>
                <td class="px-4 py-3 text-center">
                    <button type="button" class="text-red-500 hover:text-red-700 transition-colors" onclick="this.closest('tr').remove()">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                    <input type="hidden" name="fee_items[items][${index}][isSelected]" value="1">
                </td>
            `;
            
            list.appendChild(newRow);
            addDragEvents(newRow); // Make the new row draggable immediately
            updatePositions();
        });
    });

</script>

</body>
</html>

