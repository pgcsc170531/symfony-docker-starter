
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setup Classes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 min-h-screen py-10 px-4">
{# 🟢 REMOVED EXTRA PADDING (pb-24 -> pb-12) #}
<div class="max-w-full mx-auto mt-6 px-4 pb-12">
    
    {# HEADER #}
    <div class="bg-indigo-600 p-6 rounded-t-xl text-white shadow-lg flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold">💰 Set Fees for {{ term.name }}</h1>
            <p class="text-indigo-100 mt-1 text-sm">
                Prices entered here apply to the entire level (e.g., <strong>JSS 1</strong> covers 1A, 1B, 1C).
            </p>
        </div>
        <a href="{{ path('app_tenant_onboarding_fee_items') }}" class="px-4 py-2 bg-white text-indigo-700 font-bold rounded shadow hover:bg-indigo-50 text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            Edit Fee Items
        </a>
    </div>

    <form method="POST" class="bg-white shadow-xl rounded-b-xl border border-gray-200 p-6">
        <input type="hidden" name="_token" value="{{ csrf_token('fee_matrix') }}">
        {# 🟢 HIDDEN TICKET (With default filter to prevent crash) #}
        <input type="hidden" name="return_to" value="{{ returnTo|default('') }}">

        {# === TABLE A: RECURRING (EVERYONE PAYS) === #}
        <div class="mb-12">
            <div class="flex items-center gap-2 mb-4 border-b pb-2">
                <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-1 rounded">PART A</span>
                <h2 class="text-lg font-bold text-gray-800">Returning Student Fees</h2>
                <span class="text-xs text-gray-500">(Billed every Term/Session)</span>
            </div>
            
            <div class="overflow-x-auto border rounded-lg shadow-sm">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase sticky left-0 bg-gray-50 border-r w-64 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">Fee Item</th>
                            {% for level in levels %}
                                <th class="px-2 py-3 text-center text-xs font-bold text-gray-500 uppercase min-w-[100px]">{{ level }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for item in recurringItems %}
                            <tr class="hover:bg-blue-50 group transition-colors">
                                <td class="px-4 py-2 font-medium text-gray-700 sticky left-0 bg-white group-hover:bg-blue-50 border-r z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                    {{ item.name }}
                                    <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded {{ item.frequency == 'TERM' ? 'bg-green-100 text-green-700' : 'bg-orange-100 text-orange-700' }}">{{ item.frequency }}</span>
                                </td>
                                {% for level in levels %}
                                    <td class="p-1.5">
                                        {% set savedVal = existingPrices[item.id][level] ?? '' %}
                                        <input type="number" step="0.01" name="fees[{{ item.id }}][{{ level }}]" 
                                               value="{{ savedVal }}"
                                               data-section="A" data-level="{{ level }}"
                                               class="fee-input w-full text-center border-gray-300 rounded text-sm h-9 focus:ring-indigo-500 focus:border-indigo-500 font-mono" 
                                               placeholder="-">
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="100" class="p-6 text-center text-gray-400">No recurring fees found.</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="bg-blue-50 font-bold text-blue-900 border-t-2 border-blue-100">
                        <tr>
                            <td class="px-4 py-3 text-right text-xs uppercase sticky left-0 bg-blue-50 border-r z-10">Subtotal <br> (Part A):</td>
                            {% for level in levels %}
                                <td class="px-2 py-3 text-center font-mono text-sm" id="subtotal-A-{{ level }}">0.00</td>
                            {% endfor %}
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        {# === TABLE B: INTAKE (NEW STUDENTS ONLY) === #}
        <div class="mb-8">
            <div class="flex items-center gap-2 mb-4 border-b pb-2">
                <span class="bg-purple-100 text-purple-800 text-xs font-bold px-2 py-1 rounded">PART B</span>
                <h2 class="text-lg font-bold text-gray-800">New Intake Fees</h2>
                <span class="text-xs text-gray-500">(Billed ONLY on first entry)</span>
            </div>

            <div class="overflow-x-auto border rounded-lg ring-4 ring-purple-50">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-purple-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase sticky left-0 bg-purple-50 border-r w-64 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">Fee Item</th>
                            {% for level in levels %}
                                <th class="px-2 py-3 text-center text-xs font-bold text-gray-500 uppercase min-w-[100px]">{{ level }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for item in oneTimeItems %}
                            <tr class="hover:bg-purple-50 group transition-colors">
                                <td class="px-4 py-2 font-medium text-gray-700 sticky left-0 bg-white group-hover:bg-purple-50 border-r z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                    {{ item.name }}
                                    {% if item.isOptional %}<span class="ml-1 text-[10px] bg-gray-100 text-gray-600 px-1 rounded border">Optional</span>{% endif %}
                                </td>
                                {% for level in levels %}
                                    <td class="p-1.5">
                                        {% set savedVal = existingPrices[item.id][level] ?? '' %}
                                        <input type="number" step="0.01" name="fees[{{ item.id }}][{{ level }}]" 
                                               value="{{ savedVal }}"
                                               data-section="B" data-level="{{ level }}"
                                               class="fee-input w-full text-center border-gray-300 rounded text-sm h-9 focus:ring-purple-500 focus:border-purple-500 font-mono" 
                                               placeholder="-">
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="100" class="p-6 text-center text-gray-400">No intake fees found.</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="bg-purple-100 font-bold text-purple-900 border-t-2 border-purple-200">
                        <tr>
                            <td class="px-4 py-3 text-right text-xs uppercase sticky left-0 bg-purple-100 border-r z-10">Subtotal <br> (Part B):</td>
                            {% for level in levels %}
                                <td class="px-2 py-3 text-center font-mono text-sm" id="subtotal-B-{{ level }}">0.00</td>
                            {% endfor %}
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        
        {# HELP BOX #}
        <div class="bg-gray-50 p-4 rounded-lg mb-8 border border-gray-200">
             <p class="text-sm text-gray-500 mb-2"><strong>Tip:</strong> The logic is:</p>
             <ul class="text-xs text-gray-600 list-disc list-inside space-y-1">
                <li><strong>Returning Student Pays:</strong> Subtotal A</li>
                <li><strong>New Student Pays:</strong> Subtotal A + Subtotal B</li>
             </ul>
        </div>

        {# 🟢 FOOTER ACTIONS (Restored to Content Flow) #}
        <div class="mt-8 pt-6 border-t border-gray-100 flex justify-end gap-3">
             {# Cancel Button #}
             {% if existingPrices|length > 0 %}
                <a href="{{ path('app_tenant_fee_schedule') }}" class="px-6 py-3 rounded-lg font-bold text-gray-600 hover:bg-gray-100 border border-gray-300 transition-colors">
                    Cancel
                </a>
             {% endif %}

             {# Submit Button #}
             {% if existingPrices|length > 0 %}
                {# MODE: UPDATE (Blue) #}
                <button type="submit" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold shadow-lg hover:bg-blue-700 flex items-center gap-2 transform hover:-translate-y-0.5 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    <span>Update Fee Prices</span>
                </button>
             {% else %}
                {# MODE: FINISH (Green) #}
                <button type="submit" class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold shadow-lg hover:bg-green-700 flex items-center gap-2 transform hover:-translate-y-0.5 transition-all">
                    <span>Finish & Initialize Dashboard</span> 🚀
                </button>
             {% endif %}
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputs = document.querySelectorAll('.fee-input');

        function calculateTotals() {
            let totals = {}; 
            inputs.forEach(input => {
                const section = input.dataset.section;
                const level = input.dataset.level;
                const val = parseFloat(input.value) || 0;

                if (!totals[section]) totals[section] = {};
                if (!totals[section][level]) totals[section][level] = 0;

                totals[section][level] += val;
            });

            for (const section in totals) {
                for (const level in totals[section]) {
                    const cellId = `subtotal-${section}-${level}`;
                    const cell = document.getElementById(cellId);
                    if (cell) {
                        cell.innerText = totals[section][level].toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    }
                }
            }
        }

        inputs.forEach(input => {
            input.addEventListener('input', calculateTotals);
        });

        calculateTotals();
    });
</script>

</body>
</html>