<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Fees</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen py-6 md:py-10 px-2 md:px-6">

<div class="w-full mx-auto pb-12">
    
    {# HEADER #}
    <div class="bg-indigo-600 p-5 md:p-6 rounded-t-xl text-white shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-xl md:text-2xl font-bold">💰 Set Fees for {{ term.name }}</h1>
            <p class="text-indigo-100 mt-1 text-sm">
                Prices entered here apply to the entire level (e.g., <strong>JSS 1</strong> covers 1A, 1B, 1C).
            </p>
        </div>
        <a href="{{ path('app_tenant_onboarding_fee_items') }}" class="w-full md:w-auto justify-center px-4 py-2.5 bg-white text-indigo-700 font-bold rounded shadow hover:bg-indigo-50 text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            Edit Fee Items
        </a>
    </div>

    <form method="POST" class="bg-white shadow-xl rounded-b-xl border border-gray-200 p-4 md:p-6">
        <input type="hidden" name="_token" value="{{ csrf_token('fee_matrix') }}">
        <input type="hidden" name="return_to" value="{{ returnTo|default('') }}">

        {# Mobile Scroll Hint #}
        <div class="md:hidden flex items-center gap-2 text-xs font-bold text-indigo-600 bg-indigo-50 p-3 rounded mb-4 border border-indigo-100">
            <svg class="w-5 h-5 animate-pulse shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
            Swipe horizontally on the tables to view all classes.
        </div>

        {# === TABLE A: RECURRING === #}
        <div class="mb-10">
            <div class="flex items-center gap-2 mb-4">
                <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-1 rounded">PART A</span>
                <h2 class="text-lg font-bold text-gray-800">Returning Student Fees</h2>
            </div>
            
            <div class="w-full overflow-x-auto rounded-lg shadow-sm">
                <table class="min-w-max w-full border-collapse border-2 border-gray-300">
                    <thead class="bg-gray-100">
                        <tr>
                            {# 🟢 Added strict borders to all Headers #}
                            <th class="px-3 py-3 text-left text-[11px] md:text-xs font-bold text-gray-700 uppercase sticky left-0 bg-gray-100 border border-gray-300 z-20 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] whitespace-normal break-words min-w-[110px] max-w-[140px]">Fee Item</th>
                            
                            {% for level in levels %}
                                <th class="px-3 py-3 text-center text-xs font-bold text-gray-700 uppercase border border-gray-300 min-w-[150px]">{{ level }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in recurringItems %}
                            {# 🟢 Striped rows (even/odd) for better tracking across wide screens #}
                            <tr class="hover:bg-blue-50 transition-colors {{ loop.index % 2 == 0 ? 'bg-gray-50' : 'bg-white' }}">
                                {# 🟢 Added strict borders to all Cells #}
                                <td class="px-3 py-3 text-xs md:text-sm font-medium text-gray-800 sticky left-0 border border-gray-300 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] whitespace-normal break-words min-w-[110px] max-w-[140px] {{ loop.index % 2 == 0 ? 'bg-gray-50' : 'bg-white' }} group-hover:bg-blue-50">
                                    <div class="mb-1">{{ item.name }}</div>
                                    <span class="text-[9px] px-1.5 py-0.5 rounded font-bold uppercase {{ item.frequency == 'TERM' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-orange-100 text-orange-800 border border-orange-200' }}">{{ item.frequency }}</span>
                                </td>
                                {% for level in levels %}
                                    <td class="p-2 border border-gray-300">
                                        {% set savedVal = existingPrices[item.id][level] ?? '' %}
                                        <input type="number" step="0.01" name="fees[{{ item.id }}][{{ level }}]" 
                                               value="{{ savedVal }}"
                                               data-section="A" data-level="{{ level }}"
                                               class="fee-input w-full min-w-[130px] text-center border-gray-300 rounded text-sm h-10 focus:ring-blue-500 focus:border-blue-500 font-mono shadow-inner" 
                                               placeholder="-">
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="100" class="p-6 text-center text-gray-400 border border-gray-300">No recurring fees found.</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="bg-blue-100 font-bold text-blue-900">
                        <tr>
                            <td class="px-3 py-3 text-right text-[11px] md:text-xs uppercase sticky left-0 bg-blue-100 border border-blue-300 z-10 whitespace-normal min-w-[110px] max-w-[140px]">Subtotal:</td>
                            {% for level in levels %}
                                <td class="px-3 py-3 text-center font-mono text-sm min-w-[150px] border border-blue-300" id="subtotal-A-{{ level }}">0.00</td>
                            {% endfor %}
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        {# === TABLE B: INTAKE === #}
        <div class="mb-8">
            <div class="flex items-center gap-2 mb-4">
                <span class="bg-purple-100 text-purple-800 text-xs font-bold px-2 py-1 rounded">PART B</span>
                <h2 class="text-lg font-bold text-gray-800">New Intake Fees</h2>
            </div>

            <div class="w-full overflow-x-auto rounded-lg shadow-sm">
                <table class="min-w-max w-full border-collapse border-2 border-purple-200">
                    <thead class="bg-purple-50">
                        <tr>
                            <th class="px-3 py-3 text-left text-[11px] md:text-xs font-bold text-purple-900 uppercase sticky left-0 bg-purple-50 border border-purple-200 z-20 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] whitespace-normal break-words min-w-[110px] max-w-[140px]">Fee Item</th>
                            {% for level in levels %}
                                <th class="px-3 py-3 text-center text-xs font-bold text-purple-900 uppercase border border-purple-200 min-w-[150px]">{{ level }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in oneTimeItems %}
                            <tr class="hover:bg-purple-100 transition-colors {{ loop.index % 2 == 0 ? 'bg-gray-50' : 'bg-white' }}">
                                <td class="px-3 py-3 text-xs md:text-sm font-medium text-gray-800 sticky left-0 border border-purple-200 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] whitespace-normal break-words min-w-[110px] max-w-[140px] {{ loop.index % 2 == 0 ? 'bg-gray-50' : 'bg-white' }} group-hover:bg-purple-100">
                                    <div class="mb-1">{{ item.name }}</div>
                                    {% if item.isOptional %}<span class="text-[9px] bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded border border-gray-300 font-bold uppercase">Optional</span>{% endif %}
                                </td>
                                {% for level in levels %}
                                    <td class="p-2 border border-purple-200">
                                        {% set savedVal = existingPrices[item.id][level] ?? '' %}
                                        <input type="number" step="0.01" name="fees[{{ item.id }}][{{ level }}]" 
                                               value="{{ savedVal }}"
                                               data-section="B" data-level="{{ level }}"
                                               class="fee-input w-full min-w-[130px] text-center border-gray-300 rounded text-sm h-10 focus:ring-purple-500 focus:border-purple-500 font-mono shadow-inner" 
                                               placeholder="-">
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="100" class="p-6 text-center text-gray-400 border border-purple-200">No intake fees found.</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="bg-purple-100 font-bold text-purple-900">
                        <tr>
                            <td class="px-3 py-3 text-right text-[11px] md:text-xs uppercase sticky left-0 bg-purple-100 border border-purple-300 z-10 whitespace-normal min-w-[110px] max-w-[140px]">Subtotal:</td>
                            {% for level in levels %}
                                <td class="px-3 py-3 text-center font-mono text-sm min-w-[150px] border border-purple-300" id="subtotal-B-{{ level }}">0.00</td>
                            {% endfor %}
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        {# FOOTER ACTIONS #}
        <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col md:flex-row justify-end gap-3">
             {% if existingPrices|length > 0 %}
                <a href="{{ path('app_tenant_fee_schedule') }}" class="w-full md:w-auto text-center px-6 py-3.5 rounded-lg font-bold text-gray-600 hover:bg-gray-100 border border-gray-300 transition-colors">
                    Cancel
                </a>
             {% endif %}

             {% if existingPrices|length > 0 %}
                <button type="submit" class="w-full md:w-auto justify-center bg-blue-600 text-white px-8 py-3.5 rounded-lg font-bold shadow-lg hover:bg-blue-700 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    <span>Update Fee Prices</span>
                </button>
             {% else %}
                <button type="submit" class="w-full md:w-auto justify-center bg-green-600 text-white px-8 py-3.5 rounded-lg font-bold shadow-lg hover:bg-green-700 flex items-center gap-2">
                    <span>Finish & Initialize Dashboard</span> 🚀
                </button>
             {% endif %}
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputs = document.querySelectorAll('.fee-input');

        function calculateTotals() {
            let totals = {}; 
            inputs.forEach(input => {
                const section = input.dataset.section;
                const level = input.dataset.level;
                const val = parseFloat(input.value) || 0;

                if (!totals[section]) totals[section] = {};
                if (!totals[section][level]) totals[section][level] = 0;

                totals[section][level] += val;
            });

            for (const section in totals) {
                for (const level in totals[section]) {
                    const cellId = `subtotal-${section}-${level}`;
                    const cell = document.getElementById(cellId);
                    if (cell) {
                        cell.innerText = totals[section][level].toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    }
                }
            }
        }

        inputs.forEach(input => {
            input.addEventListener('input', calculateTotals);
        });

        calculateTotals();
    });
</script>

</body>
</html>