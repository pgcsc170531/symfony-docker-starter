{% extends 'base.html.twig' %}
{% block title %}New Session{% endblock %}
{% block body %}
<div class="container mx-auto mt-10 p-5">
    <div class="max-w-md mx-auto bg-white p-8 rounded shadow">
        <h1 class="text-2xl font-bold mb-6">Create New Session</h1>
        {{ form_start(form) }}
            <div class="mb-4">
                {{ form_label(form.name, 'Name') }}
                {{ form_widget(form.name, {'attr': {'class': 'border rounded w-full py-2 px-3'}}) }}
            </div>
            <div class="mb-4">
                {{ form_widget(form.isActive) }} <span class="ml-2">Set as Current Session</span>
            </div>
            <button class="bg-blue-600 text-white font-bold py-2 px-4 rounded w-full">Save Session</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}