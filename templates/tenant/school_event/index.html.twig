{% extends 'base.html.twig' %}

{% block title %}School Calendar{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto mt-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">📅 School Calendar & Events</h1>
        <div class="flex gap-3">
            <a href="{{ path('app_tenant_event_import') }}" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 font-bold text-sm flex items-center shadow">
                <span class="mr-2">📂</span> Import Excel
            </a>
            
            <a href="{{ path('app_tenant_event_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 font-bold text-sm flex items-center shadow">
                <span class="mr-2">➕</span> New Event
            </a>
        </div>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Event</th>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Type</th>
                    <th class="px-6 py-3 text-center text-xs font-bold text-gray-500 uppercase">Flash Alert?</th>
                    <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            {% for event in events %}
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">
                        {{ event.startDate|date('M d, Y H:i') }}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-700">
                        <div class="font-bold text-indigo-900">{{ event.title }}</div>
                        <div class="text-gray-500 text-xs">{{ event.description|slice(0, 60) }}...</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                        {% if event.type == 'Holiday' %}bg-red-100 text-red-800{% elseif event.type == 'Exam' %}bg-yellow-100 text-yellow-800{% else %}bg-green-100 text-green-800{% endif %}">
                            {{ event.type }}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm">
                        {% if event.isFlashNotice %}
                            <span class="text-red-600 font-bold bg-red-50 px-2 py-1 rounded border border-red-100">YES 🚨</span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <div class="flex justify-end items-center gap-3">
                            
                            {# 📢 BROADCAST SMS BUTTON WITH PROTECTION #}
                            <form method="post" 
                                  action="{{ path('app_tenant_event_notify', {'id': event.id}) }}" 
                                  onsubmit="return handleNotifyClick(this, {{ event.id }});" 
                                  class="inline">
                                <button type="submit" 
                                        id="notify-btn-{{ event.id }}"
                                        class="flex items-center text-xs bg-indigo-600 text-white px-3 py-1.5 rounded shadow-sm hover:bg-indigo-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed">
                                    <span class="btn-text-{{ event.id }}">📩 Notify Parents</span>
                                </button>
                            </form>

                             {# ✏️ NEW: EDIT LINK #}
                            <a href="{{ path('app_tenant_event_edit', {'id': event.id}) }}" class="text-indigo-600 hover:text-indigo-900 p-1" title="Edit Event">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                </svg>
                            </a>

                            {# Delete Action #}
                            <form method="post" action="{{ path('app_tenant_event_delete', {'id': event.id}) }}" onsubmit="return confirm('Are you sure?');" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                <button class="text-red-400 hover:text-red-600 p-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                        <div class="text-4xl mb-2">📅</div>
                        <p>No events found for this school term.</p>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
/**
 * Prevents multiple clicks on the SMS Broadcast button.
 */
function handleNotifyClick(form, eventId) {
    const btn = document.getElementById('notify-btn-' + eventId);
    const btnText = document.querySelector('.btn-text-' + eventId);

    // 1. Browser Confirmation Dialog
    const confirmSend = confirm('⚠️ BROADCAST SMS: This will send an alert to ALL registered guardians. It will cost ₦15.00 per parent. Proceed?');
    
    if (confirmSend) {
        // 2. Disable button immediately to prevent double-click
        btn.disabled = true;
        
        // 3. Give visual feedback
        btnText.innerText = '⏳ Processing...';
        btn.classList.add('opacity-75');
        
        // 4. Submit the form
        return true;
    }

    // If canceled, do nothing
    return false;
}
</script>
{% endblock %}