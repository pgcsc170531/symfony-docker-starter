{% extends 'base.html.twig' %}

{% block title %}New Event{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto mt-6">
    <div class="bg-white shadow rounded-lg p-6">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Create New Event</h1>
        
        {{ form_start(form) }}
            <div class="space-y-4">
                <div>{{ form_row(form.title) }}</div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>{{ form_row(form.startDate) }}</div>
                    <div>{{ form_row(form.endDate) }}</div>
                </div>

                <div>{{ form_row(form.type) }}</div>
                
                <div class="bg-yellow-50 p-4 rounded border border-yellow-200">
                    {{ form_row(form.isFlashNotice) }}
                </div>

                <div>{{ form_row(form.description) }}</div>

                <div class="pt-4 flex justify-between">
                    <a href="{{ path('app_tenant_event_index') }}" class="text-gray-600 hover:text-gray-900">Cancel</a>
                    <button class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 shadow font-bold">
                        Save Event
                    </button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}