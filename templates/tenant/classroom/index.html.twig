{% extends 'base.html.twig' %}

{% block title %}Manage Classrooms{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto mt-6 px-4 pb-12">
    
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">📚 Academic Classrooms</h1>
            <p class="text-gray-500 text-sm">Create and manage your class levels and arms.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        {# LEFT COLUMN: SMART ADD FORM #}
        <div class="md:col-span-1">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 sticky top-6">
                <h2 class="text-lg font-bold text-indigo-700 mb-4 flex items-center gap-2">
                    <span>✨ Smart Creator</span>
                </h2>
                
                <form method="POST">
                    <div class="mb-4">
                        <label class="block text-sm font-bold text-gray-700 mb-1">Class Level Name</label>
                        {# 🟢 UPDATED CLASS: Matches standard form theme #}
                        <input type="text" name="name" required placeholder="e.g. JSS 1" 
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3">
                        <p class="text-xs text-gray-500 mt-1">Do not include 'A' or 'B'. Just the main name.</p>
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-bold text-gray-700 mb-1">Number of Arms</label>
                        {# 🟢 UPDATED CLASS: Matches standard form theme #}
                        <select name="arms" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3">
                            <option value="0">No Arms (Single Class)</option>
                            <option value="1">1 Arm (A)</option>
                            <option value="2">2 Arms (A - B)</option>
                            <option value="3">3 Arms (A - C)</option>
                            <option value="4" selected>4 Arms (A - D)</option>
                            <option value="5">5 Arms (A - E)</option>
                            <option value="6">6 Arms (A - F)</option>
                            <option value="7">7 Arms (A - G)</option>
                            <option value="8">8 Arms (A - H)</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">We will generate the letters automatically.</p>
                    </div>

                    <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-2.5 px-4 rounded shadow hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2 text-sm">
                        <span>🚀 Generate Classes</span>
                    </button>
                </form>
            </div>
        </div>

        {# RIGHT COLUMN: EXISTING CLASSES LIST #}
        <div class="md:col-span-2 space-y-6">
            
            {% if groupedClassrooms|length == 0 %}
                <div class="bg-gray-50 rounded-lg p-12 text-center border-2 border-dashed border-gray-300">
                    <div class="text-5xl mb-4">🏫</div>
                    <h3 class="text-lg font-medium text-gray-900">No Classrooms Yet</h3>
                    <p class="text-gray-500">Use the Smart Creator on the left to add your first level.</p>
                </div>
            {% else %}

                {% for level, classes in groupedClassrooms %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                        <div class="bg-gray-50 px-4 py-3 border-b border-gray-200 flex justify-between items-center">
                            <h3 class="font-bold text-gray-800">{{ level }}</h3>
                            <span class="bg-gray-200 text-gray-600 text-xs px-2 py-1 rounded-full font-bold">
                                {{ classes|length }} Arm{{ classes|length > 1 ? 's' : '' }}
                            </span>
                        </div>
                        
                        <div class="p-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                            {% for classroom in classes %}
                                <div class="relative group bg-white border border-gray-200 rounded p-3 hover:border-indigo-300 hover:shadow-md transition-all text-center">
                                    <div class="font-medium text-gray-800">{{ classroom.name }}</div>
                                    
                                    {# 🟢 DELETE BUTTON: Logic checks out. Form submits to delete route. #}
                                    <form method="post" action="{{ path('app_tenant_classroom_delete', {'id': classroom.id}) }}" onsubmit="return confirm('Are you sure you want to delete {{ classroom.name }}? This cannot be undone.');" class="absolute -top-2 -right-2 hidden group-hover:block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ classroom.id) }}">
                                        <button class="bg-red-100 text-red-600 rounded-full p-1 hover:bg-red-600 hover:text-white shadow-sm transition-colors border border-red-200">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                    </form>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}

            {% endif %}
        </div>
    </div>
</div>
{% endblock %}