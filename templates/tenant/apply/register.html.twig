{% extends 'tenant/apply/layout.html.twig' %}

{% block title %}Create your parent account{% endblock %}

{% set input = 'mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500' %}
{% set label = 'block text-sm font-medium text-gray-700' %}
{% set err = {'attr': {'class': 'mt-1 text-xs text-red-600'}} %}

{% block content %}
{# No `max-w-2xl mx-auto`: the form sits on the same 16px gutter as the header
   and footer above and below it. A centred 672px column inside a 1584px shell is
   the misalignment this page had. #}
<div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Create your parent account</h1>
    <p class="mt-2 text-gray-600 text-sm">
        This account is your <strong>permanent parent-portal login</strong> — you will use it for your
        child's applications, fees, payments, results and school notices. You only create it once.
    </p>

    <div class="mt-6 bg-white rounded-2xl shadow-sm ring-1 ring-gray-200 p-6 sm:p-8">
        {{ form_start(form) }}

        <h2 class="text-sm font-bold uppercase tracking-wide text-gray-400">About you</h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                {{ form_label(form.title, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.title, {'attr': {'class': input}}) }}
                {{ form_errors(form.title, err) }}
            </div>
            <div class="sm:col-span-2">
                {{ form_label(form.fullName, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.fullName, {'attr': {'class': input}}) }}
                {{ form_errors(form.fullName, err) }}
            </div>
        </div>

        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                {{ form_label(form.email, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.email, {'attr': {'class': input}}) }}
                {% if form.email.vars.help %}<p class="mt-1 text-xs text-gray-500">{{ form.email.vars.help }}</p>{% endif %}
                {{ form_errors(form.email, err) }}
            </div>
            <div>
                {{ form_label(form.phoneNumber, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.phoneNumber, {'attr': {'class': input}}) }}
                {% if form.phoneNumber.vars.help %}<p class="mt-1 text-xs text-gray-500">{{ form.phoneNumber.vars.help }}</p>{% endif %}
                {{ form_errors(form.phoneNumber, err) }}
            </div>
            <div>
                {{ form_label(form.alternatePhoneNumber, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.alternatePhoneNumber, {'attr': {'class': input}}) }}
                {{ form_errors(form.alternatePhoneNumber, err) }}
            </div>
            <div>
                {{ form_label(form.relationshipToStudent, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.relationshipToStudent, {'attr': {'class': input}}) }}
                {{ form_errors(form.relationshipToStudent, err) }}
            </div>
            <div>
                {{ form_label(form.occupation, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.occupation, {'attr': {'class': input}}) }}
                {{ form_errors(form.occupation, err) }}
            </div>
            <div>
                {{ form_label(form.address, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.address, {'attr': {'class': input}}) }}
                {{ form_errors(form.address, err) }}
            </div>
        </div>

        <h2 class="mt-8 text-sm font-bold uppercase tracking-wide text-gray-400">Security</h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.plainPassword.first, {'attr': {'class': input}}) }}
                {{ form_errors(form.plainPassword.first, err) }}
            </div>
            <div>
                {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': label}}) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': input}}) }}
                {{ form_errors(form.plainPassword.second, err) }}
            </div>
        </div>
        {{ form_errors(form.plainPassword, err) }}
        <p class="mt-1 text-xs text-gray-500">At least 8 characters. You can sign in with a link sent to your email any time.</p>

        <div class="mt-8 flex items-start gap-3 rounded-lg bg-gray-50 ring-1 ring-gray-200 p-4">
            {{ form_widget(form.consent, {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
            <div>
                <label for="{{ form.consent.vars.id }}" class="text-sm text-gray-700">{{ form.consent.vars.label }}</label>
                {{ form_errors(form.consent, err) }}
            </div>
        </div>

        <button type="submit"
                class="mt-6 w-full rounded-lg px-6 py-3 font-semibold text-white shadow-sm hover:opacity-90 transition"
                style="background-color: {{ brand }};">
            Create my account
        </button>

        {{ form_end(form) }}
    </div>

    <p class="mt-5 text-center text-sm text-gray-500">
        Already registered? <a href="{{ path('app_login') }}" class="underline hover:text-gray-700">Sign in</a>
        · <a href="/apply/recover" class="underline hover:text-gray-700">Get a sign-in link</a>
    </p>
    <p class="mt-2 text-center text-xs text-gray-400">
        <a href="/apply" class="underline hover:text-gray-600">← Back to the application page</a>
    </p>
</div>
{% endblock %}
