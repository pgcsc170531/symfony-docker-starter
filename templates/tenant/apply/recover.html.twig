{% extends 'tenant/apply/layout.html.twig' %}

{% block title %}Get a sign-in link{% endblock %}

{% block content %}
<div>
    <h1 class="text-2xl font-extrabold text-gray-900">Get a sign-in link</h1>
    <p class="mt-2 text-sm text-gray-600">
        Enter the email address or phone number you registered with. If we find your account,
        we will email you a link that signs you in — no password needed.
    </p>

    <form method="post" class="mt-6 bg-white rounded-2xl shadow-sm ring-1 ring-gray-200 p-6">
        <label for="contact" class="block text-sm font-medium text-gray-700">Email address or phone number</label>
        <input type="text" name="contact" id="contact" required autofocus
               placeholder="you@example.com or 08031234567"
               class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">

        <button type="submit"
                class="mt-5 w-full rounded-lg px-6 py-3 font-semibold text-white shadow-sm hover:opacity-90 transition"
                style="background-color: {{ brand }};">
            Email me a sign-in link
        </button>
    </form>

    <p class="mt-5 text-center text-sm text-gray-500">
        <a href="/apply/register" class="underline hover:text-gray-700">Create a new account</a>
        · <a href="/apply" class="underline hover:text-gray-700">Back</a>
    </p>
</div>
{% endblock %}
