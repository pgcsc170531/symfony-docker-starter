{% extends 'base.html.twig' %}

{% block title %}Student Directory{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 md:mt-10 p-4 md:p-6">
    
    {# --- PAGE HEADER & PRIMARY ACTION --- #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Student Directory</h1>
            <p class="text-sm text-gray-500 mt-1">Manage all enrolled students, profiles, and financials.</p>
        </div>
        <a href="{{ path('app_tenant_enrollment_promote') }}" class="w-full sm:w-auto bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-bold py-3 px-6 rounded-lg shadow-sm transition-transform transform hover:-translate-y-0.5 flex items-center justify-center">
                🚀 Batch Promote
            </a>
        <a href="{{ path('app_tenant_admission_index') }}" class="w-full md:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition-transform transform hover:-translate-y-0.5 flex items-center justify-center">
            <span class="mr-2">➕</span> Admit New Student
        </a>
    </div>

    {# --- MAIN DIRECTORY CARD --- #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        
        {# --- FRICTIONLESS FILTER BAR --- #}
        <div class="p-4 md:p-5 border-b border-gray-100 bg-gray-50 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            
            <div class="flex flex-wrap items-center gap-4">
                <div class="text-gray-600 font-medium text-sm">
                    <i class="fas fa-users text-indigo-500 mr-1"></i> Page {{ current_page }} of {{ total_pages }}
                </div>
                
                {# 🟢 CONTEXTUAL ACTION: Only show this if a specific class is selected! #}
                {% if selected_class %}
                    <a href="{{ path('app_tenant_class_score_sheet', {'id': selected_class}) }}" target="_blank" 
                       class="bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 hover:text-indigo-600 px-3 py-1.5 rounded text-xs font-bold shadow-sm transition flex items-center">
                        🖨️ Print Class Score Sheet
                    </a>
                {% endif %}

                {# 🟢 EXPORT TO EXCEL BUTTON (Now remembers finance_status) #}
                <a href="{{ path('app_tenant_student_export', {'q': app.request.query.get('q'), 'class_id': selected_class, 'finance_status': finance_status|default('')}) }}" 
                   class="bg-green-50 border border-green-200 text-green-700 hover:bg-green-100 px-3 py-1.5 rounded text-xs font-bold shadow-sm transition flex items-center">
                    📊 Export to Excel
                </a>
            </div>
            
            <form method="GET" class="flex flex-col sm:flex-row w-full lg:w-auto gap-2">
                {# Class Filter #}
                <select name="class_id" class="border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white min-w-[150px]" onchange="this.form.submit()">
                    <option value="">All Classes</option>
                    {% for class in classrooms %}
                        <option value="{{ class.id }}" {% if selected_class == class.id %}selected{% endif %}>
                            {{ class.name }}
                        </option>
                    {% endfor %}
                </select>

                {# 🟢 NEW: Finance Status Filter #}
                <select name="finance_status" class="border-gray-300 border p-2.5 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none bg-white min-w-[150px]" onchange="this.form.submit()">
                    <option value="">All Finances</option>
                    <option value="debtor" {% if finance_status|default('') == 'debtor' %}selected{% endif %}>🔴 Owing Fees</option>
                    <option value="cleared" {% if finance_status|default('') == 'cleared' %}selected{% endif %}>🟢 Cleared</option>
                </select>

                {# Search Input #}
                <div class="flex w-full sm:w-64">
                    <input type="text" name="q" value="{{ app.request.query.get('q') }}" placeholder="Search Name or Adm No..." 
                           class="w-full border-gray-300 border-y border-l p-2.5 rounded-l-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none">
                    <button type="submit" class="bg-gray-800 text-white px-4 py-2.5 rounded-r-md hover:bg-gray-900 font-bold text-sm transition-colors border border-gray-800">
                        Search
                    </button>
                </div>
            </form>
        </div>
        
        {# --- Responsive Table --- #}
        <table class="w-full block md:table">
            <thead class="hidden md:table-header-group bg-white">
                <tr>
                    <th scope="col" class="text-left py-4 px-6 text-xs font-bold text-gray-500 uppercase tracking-wider border-b border-gray-200">Admission No.</th>
                    <th scope="col" class="text-left py-4 px-6 text-xs font-bold text-gray-500 uppercase tracking-wider border-b border-gray-200">Student Profile</th>
                    <th scope="col" class="text-left py-4 px-6 text-xs font-bold text-gray-500 uppercase tracking-wider border-b border-gray-200">Finance Status</th>
                    <th scope="col" class="text-right py-4 px-6 text-xs font-bold text-gray-500 uppercase tracking-wider border-b border-gray-200">Actions</th>
                </tr>
            </thead>
            <tbody class="block md:table-row-group md:divide-y md:divide-gray-100">
                {% for student in students %}
                <tr class="block md:table-row bg-white border-b border-gray-200 md:border-none hover:bg-indigo-50/30 transition-colors">
                    
                    {# Admission Number #}
                    <td class="block md:table-cell p-4 md:py-5 md:px-6">
                        <div class="flex justify-between md:block items-center">
                            <span class="md:hidden text-xs font-bold text-gray-400 uppercase tracking-wider">Admission No.</span>
                            <span class="font-mono text-sm text-indigo-600 font-bold bg-indigo-50 px-2 py-1 rounded border border-indigo-100">
                                {{ student.admissionNumber ?: 'PENDING' }}
                            </span>
                        </div>
                    </td>
                    
                    {# Full Name #}
                    <td class="block md:table-cell p-4 md:py-5 md:px-6">
                        <div class="flex justify-between md:block items-center">
                            <span class="md:hidden text-xs font-bold text-gray-400 uppercase tracking-wider">Student Name</span>
                            <div>
                                <p class="font-bold text-gray-900">{{ student.fullName }}</p>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    {{ student.gender ?: 'Gender Not Set' }} • <span class="font-bold">{{ student.currentClass ? student.currentClass.name : 'No Class' }}</span>
                                </p>
                            </div>
                        </div>
                    </td>

                    {# DEDICATED FINANCE COLUMN #}
                    <td class="block md:table-cell p-4 md:py-5 md:px-6">
                        <div class="flex justify-between md:block items-center">
                            <span class="md:hidden text-xs font-bold text-gray-400 uppercase tracking-wider">Finance Status</span>
                            
                            {# 🟢 UPDATED: Use the studentDebts array passed from the controller #}
                            {% set debt = studentDebts[student.id] ?? null %}
                            
                            {% if debt and debt.total > 0 %}
                                <div class="flex flex-col gap-1.5 items-end md:items-start">
                                    
                                    {% if debt.academic > 0 %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-red-50 text-red-700 border border-red-200 shadow-sm w-max">
                                            📘 Fees: ₦{{ debt.academic|number_format(0) }}
                                        </span>
                                    {% endif %}
                                    
                                    {% if debt.store > 0 %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-orange-50 text-orange-700 border border-orange-200 shadow-sm w-max">
                                            🛒 Store: ₦{{ debt.store|number_format(0) }}
                                        </span>
                                    {% endif %}
                                    
                                </div>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-green-50 text-green-700 border border-green-200 shadow-sm">
                                    🟢 Cleared
                                </span>
                            {% endif %}
                            
                        </div>
                    </td>
                    
                    {# Actions #}
                    <td class="block md:table-cell p-4 md:py-5 md:px-6 bg-gray-50/50 md:bg-transparent rounded-b-lg md:rounded-none">
                        <div class="flex flex-wrap items-center justify-start md:justify-end gap-2 md:gap-3">
                            <a href="{{ path('app_tenant_student_profile', {'id': student.id}) }}" class="flex-1 md:flex-none bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 hover:text-indigo-600 px-4 py-2 rounded-md text-center text-xs font-bold transition-colors shadow-sm">View Profile</a>
                            <a href="{{ path('app_tenant_admission_print', {'id': student.id}) }}" target="_blank" class="flex-1 md:flex-none bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 hover:text-green-600 px-4 py-2 rounded-md text-center text-xs font-bold transition-colors shadow-sm">Print Letter</a>
                            <a href="{{ path('app_tenant_student_finance', {'id': student.id}) }}" class="w-full md:w-auto bg-gray-800 text-white hover:bg-gray-900 px-4 py-2 rounded-md text-center text-xs font-bold transition-colors shadow-sm">Finance</a>
                        </div>
                    </td>
                    
                </tr>
                {% else %}
                <tr class="block md:table-row">
                    <td colspan="4" class="block md:table-cell text-center py-16">
                        <div class="flex flex-col items-center justify-center text-gray-400">
                            <svg class="w-16 h-16 mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            <p class="text-lg font-medium text-gray-500">No students found.</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {# --- PAGINATION FOOTER (Preserves class_id and finance_status) --- #}
        {% if total_pages is defined and total_pages > 1 %}
        <div class="bg-white px-4 py-4 border-t border-gray-200 sm:px-6 flex items-center justify-between">
            <div class="flex-1 flex justify-between sm:hidden">
                <a href="{{ path('app_tenant_student_index', {'page': current_page - 1, 'q': app.request.query.get('q'), 'class_id': selected_class, 'finance_status': finance_status|default('')}) }}" class="{% if current_page == 1 %}pointer-events-none opacity-50{% endif %} relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-bold rounded-md text-gray-700 bg-white hover:bg-gray-50 shadow-sm">Previous</a>
                <a href="{{ path('app_tenant_student_index', {'page': current_page + 1, 'q': app.request.query.get('q'), 'class_id': selected_class, 'finance_status': finance_status|default('')}) }}" class="{% if current_page == total_pages %}pointer-events-none opacity-50{% endif %} ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-bold rounded-md text-gray-700 bg-white hover:bg-gray-50 shadow-sm">Next</a>
            </div>
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-500">Showing page <span class="font-bold text-gray-900">{{ current_page }}</span> of <span class="font-bold text-gray-900">{{ total_pages }}</span></p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                        <a href="{{ path('app_tenant_student_index', {'page': current_page - 1, 'q': app.request.query.get('q'), 'class_id': selected_class, 'finance_status': finance_status|default('')}) }}" class="{% if current_page == 1 %}pointer-events-none opacity-50{% endif %} relative inline-flex items-center px-3 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-bold text-gray-500 hover:bg-gray-50">&laquo; Prev</a>
                        <a href="{{ path('app_tenant_student_index', {'page': current_page + 1, 'q': app.request.query.get('q'), 'class_id': selected_class, 'finance_status': finance_status|default('')}) }}" class="{% if current_page == total_pages %}pointer-events-none opacity-50{% endif %} relative inline-flex items-center px-3 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-bold text-gray-500 hover:bg-gray-50">Next &raquo;</a>
                    </nav>
                </div>
            </div>
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}