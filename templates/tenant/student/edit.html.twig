{% extends 'base.html.twig' %}

{% block title %}Edit Profile: {{ student.fullName }}{% endblock %}

{% block body %}
{# px-0 on mobile for edge-to-edge feel #}
<div class="max-w-5xl mx-auto px-0 sm:px-6 lg:px-8 py-4 sm:py-8">

    {# --- HEADER --- #}
    <div class="mb-6 px-4 sm:px-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">📝 Edit Student Profile</h1>
            <p class="text-sm text-gray-500">
                Student: <span class="font-bold text-indigo-600">{{ student.fullName }}</span>
            </p>
        </div>
        <a href="{{ path('app_tenant_student_profile', {'id': student.id}) }}" class="inline-flex items-center text-sm font-bold bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg transition-colors border border-gray-200 shadow-sm">
            &larr; Back to Profile
        </a>
    </div>

    {{ form_start(form) }}
    
    {# Removed outer rounding on mobile for full-width impact #}
    <div class="bg-white shadow-lg sm:rounded-xl overflow-hidden border-y sm:border border-gray-100">
        
        {# === SECTION 1: IDENTITY === #}
        <div class="p-5 sm:p-8 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
                <span class="bg-indigo-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">1</span> 
                Basic Identity
            </h3>
            
            <div class="mb-5">
                {{ form_row(form.admissionNumber, {'attr': {'class': 'rounded-lg p-3 w-full sm:w-1/3'}}) }}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                {{ form_row(form.firstName, {'attr': {'class': 'rounded-lg p-3 w-full border-gray-300 shadow-sm'}}) }}
                {{ form_row(form.middleName, {'attr': {'class': 'rounded-lg p-3 w-full border-gray-300 shadow-sm'}}) }}
                {{ form_row(form.lastName, {'attr': {'class': 'rounded-lg p-3 w-full border-gray-300 shadow-sm'}}) }}
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mt-5">
                {{ form_row(form.gender, {'attr': {'class': 'rounded-lg p-3 w-full'}}) }}
                {{ form_row(form.dateOfBirth, {'attr': {'class': 'rounded-lg p-3 w-full'}}) }}
                {{ form_row(form.religion, {'attr': {'class': 'rounded-lg p-3 w-full'}}) }}
            </div>
        </div>

        {# === SECTION 2: PLACEMENT (Highlight Box) === #}
        <div class="p-5 sm:p-8 border-b border-gray-100 bg-indigo-50/30">
            <h3 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
                <span class="bg-indigo-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">2</span> 
                Academic Placement
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="bg-white p-5 rounded-xl border border-indigo-100 shadow-sm">
                    {{ form_row(form.currentClass, {'attr': {'class': 'rounded-lg p-3 w-full'}}) }}
                </div>
                <div>
                    {{ form_row(form.previousSchool, {'attr': {'class': 'rounded-lg p-3 w-full', 'placeholder': 'Last school attended'}}) }}
                </div>
            </div>
        </div>

        {# === SECTION 3: ORIGIN === #}
        <div class="p-5 sm:p-8 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
                <span class="bg-indigo-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">3</span> 
                Origin & Location
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                {{ form_row(form.nationality, {'attr': {'class': 'rounded-lg p-3 w-full'}}) }}
                {{ form_row(form.homeTown, {'attr': {'class': 'rounded-lg p-3 w-full'}}) }}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
                <div class="form-group">
                    {{ form_label(form.stateOfOrigin, null, {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.stateOfOrigin, {'attr': {'class': 'rounded-lg p-3 w-full border-gray-300 shadow-sm', 'id': 'select-state'}}) }} 
                </div>
                <div class="form-group">
                    {{ form_label(form.lga, null, {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.lga, {'attr': {'class': 'rounded-lg p-3 w-full border-gray-300 shadow-sm', 'id': 'select-lga'}}) }}
                </div>
            </div>
        </div>

        {# === SECTION 4: MEDICAL (Alert Style) === #}
        <div class="p-5 sm:p-8 bg-red-50 border-t border-red-100">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
                <h3 class="text-lg font-bold text-red-800 flex items-center">
                    <span class="bg-red-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">4</span> 
                    Medical Profile
                </h3>
                <span class="text-[10px] font-black uppercase tracking-widest text-red-600 bg-white px-2 py-1 rounded border border-red-200 inline-block w-max">Critical for Emergencies</span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                {{ form_row(form.bloodGroup, {'attr': {'class': 'rounded-lg p-3 w-full border-red-200'}}) }}
                {{ form_row(form.genotype, {'attr': {'class': 'rounded-lg p-3 w-full border-red-200'}}) }}
            </div>
            
            <div class="mt-5">
                {{ form_row(form.medicalConditions, {'attr': {'class': 'rounded-lg p-3 w-full border-red-200', 'placeholder': 'Allergies, chronic conditions, etc.', 'rows': 3}}) }}
            </div>
        </div>

        {# === FOOTER ACTION === #}
        <div class="p-6 bg-gray-50 flex flex-col sm:flex-row justify-end gap-4">
             <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-10 rounded-xl sm:rounded-lg shadow-lg transition active:scale-95 flex items-center justify-center">
                <span class="mr-2">💾</span> Save Changes
            </button>
        </div>

    </div>
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // We find the elements by their Symfony-generated names if the custom IDs fail
            const stateSelect = document.getElementById('select-state') || document.querySelector('[name*="stateOfOrigin"]');
            const lgaSelect = document.getElementById('select-lga') || document.querySelector('[name*="lga"]');
            
            if (!stateSelect || !lgaSelect) {
                console.error("LGA Error: Could not find State or LGA fields in the DOM.");
                return;
            }

            const lgaApiUrl = "{{ path('app_tenant_api_lgas', {id: 0}) }}".slice(0, -1);

            stateSelect.addEventListener('change', function() {
                const stateId = this.value;
                if (!stateId) return;

                console.log("Fetching LGAs for State ID:", stateId);

                fetch(lgaApiUrl + stateId)
                    .then(response => response.json())
                    .then(data => {
                        // Clear the dropdown
                        lgaSelect.innerHTML = '';
                        
                        // Add the placeholder
                        const placeholder = document.createElement('option');
                        placeholder.value = "";
                        placeholder.textContent = "Select LGA";
                        lgaSelect.appendChild(placeholder);

                        // Build and Append
                        if (data.length > 0) {
                            data.forEach(lga => {
                                const opt = document.createElement('option');
                                opt.value = lga.id;
                                opt.textContent = lga.name;
                                lgaSelect.appendChild(opt);
                            });
                            
                            lgaSelect.disabled = false;
                            // Trigger a change event in case other scripts are watching
                            lgaSelect.dispatchEvent(new Event('change'));
                        } else {
                            const noData = document.createElement('option');
                            noData.textContent = "No LGAs found";
                            lgaSelect.appendChild(noData);
                        }
                    })
                    .catch(error => console.error("Fetch Error:", error));
            });
        });
    </script>
{% endblock %}