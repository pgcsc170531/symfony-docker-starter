{% extends 'base.html.twig' %}

{% block title %}Student Profile: {{ student.fullName }}{% endblock %}

{% block body %}
<div class="px-4 sm:px-6 lg:px-8 py-8">
    
    {# --- Header, Profile Picture, and Actions --- #}
    <div class="flex flex-col md:flex-row justify-between items-start mb-8 p-6 bg-white shadow rounded-lg border border-gray-100">
        
        {# LEFT: Picture and Name #}
        <div class="flex items-center">
            <div class="w-24 h-24 rounded-full bg-gray-200 overflow-hidden flex-shrink-0 relative border-4 border-indigo-500">
                {% if student.profilePictureFilename %}
                    <img src="{{ asset('uploads/students/' ~ student.profilePictureFilename) }}" alt="{{ student.fullName }} Picture" class="w-full h-full object-cover">
                {% else %}
                    <span class="text-4xl text-gray-600 absolute inset-0 flex items-center justify-center">👤</span>
                {% endif %}
            </div>
            <div class="ml-6">
                <h1 class="text-3xl font-extrabold text-gray-900">{{ student.firstName }} {{ student.middleName }} {{ student.lastName }}</h1>
                <p class="text-lg font-medium text-indigo-600">Adm No: {{ student.admissionNumber }}</p>
                {% if enrollment %}
                    <p class="text-sm text-gray-500 mt-1">Current Class: <span class="font-semibold">{{ enrollment.classroom.name }}</span></p>
                {% endif %}
            </div>
        </div>
        
        {# RIGHT: Action Buttons #}
        <div class="flex space-x-4 mt-4 md:mt-0">
            <a href="{{ path('app_tenant_student_upload_photo', {'id': student.id}) }}" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-medium py-2 px-4 rounded-lg transition border border-indigo-200">
                <i class="fas fa-camera mr-2"></i> Upload Photo
            </a>
            <a href="{{ path('app_tenant_student_print_idcard', {'id': student.id}) }}" target="_blank" class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg shadow-md transition">
                <i class="fas fa-id-card mr-2"></i> Print ID Card
            </a>
        </div>
    </div>

    {# --- MAIN PROFILE CONTENT: TWO COLUMNS --- #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# COLUMN 1: PERSONAL, MEDICAL, and FINANCIAL INFO (2/3 width) #}
        <div class="lg:col-span-2 space-y-6">
            
            {# SECTION: PERSONAL & ACADEMIC DETAILS #}
            <div class="bg-white shadow rounded-lg">
                <div class="p-5 border-b border-gray-200">
                    <h2 class="text-xl font-bold text-gray-800"><i class="fas fa-graduation-cap mr-2 text-indigo-500"></i> Personal & Academic Data</h2>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    
                    <div>
                        <p class="text-sm font-medium text-gray-500">Date of Birth</p>
                        <p class="text-gray-900 font-semibold">{{ student.dateOfBirth|date('M d, Y') }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Date of Admission</p>
                        <p class="text-gray-900 font-semibold">{{ student.createdAt|date('M d, Y') }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Home Town / LGA</p>
                        <p class="text-gray-900">{{ student.homeTown }} / {{ student.lga.name }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Previous School</p>
                        <p class="text-gray-900">{{ student.previousSchool ?: 'N/A' }}</p>
                    </div>

                </div>
            </div>

            {# SECTION: MEDICAL PROFILE #}
            <div class="bg-red-50 shadow rounded-lg border border-red-200">
                <div class="p-5 border-b border-red-200">
                    <h2 class="text-xl font-bold text-red-800"><i class="fas fa-heartbeat mr-2 text-red-500"></i> Medical Profile</h2>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Blood Group / Genotype</p>
                        <p class="text-red-900 font-semibold">{{ student.bloodGroup ?: 'N/A' }} / {{ student.genotype ?: 'N/A' }}</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-sm font-medium text-gray-500">Medical Conditions/Allergies</p>
                        <p class="text-red-900">{{ student.medicalConditions ?: 'None Reported' }}</p>
                    </div>
                </div>
            </div>

            {# FINANCIAL SUMMARY CARD #}
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        
        {# CARD HEADER #}
        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="font-bold text-gray-800">💰 Financial Overview</h3>
            <a href="{{ path('app_tenant_student_finance', {id: student.id}) }}" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:underline">
                View Full History &rarr;
            </a>
        </div>

        <div class="p-6">
            {# 1. TOTAL OUTSTANDING BALANCE #}
            <div class="flex justify-between items-end mb-8 bg-white border border-gray-200 p-4 rounded-lg shadow-sm">
                <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider mb-1">Total Debt (All Terms)</p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-3xl font-black {{ totalBalance > 0 ? 'text-red-600' : 'text-green-600' }}">
                            ₦{{ totalBalance|number_format(2) }}
                        </span>
                    </div>
                </div>
                
                {% if totalBalance > 0 %}
                    <a href="{{ path('app_tenant_payment_terminal', {id: student.id}) }}" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-indigo-700 shadow transition-transform transform hover:-translate-y-0.5">
                        Pay Now
                    </a>
                {% else %}
                    <div class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Up to Date
                    </div>
                {% endif %}
            </div>

            {# 2. RECENT ACTIVITY LIST (Invoices) #}
            <div>
                <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3 border-b pb-1">
                    Recent Invoices Generated
                </h4>
                
                {% if recentInvoices|length > 0 %}
                    <div class="space-y-0">
                        {# LIST HEADER ROW #}
                        <div class="grid grid-cols-12 gap-2 text-[10px] uppercase font-bold text-gray-400 mb-2 px-2">
                            <div class="col-span-3">Date</div>
                            <div class="col-span-5">Description</div>
                            <div class="col-span-4 text-right">Amount / Status</div>
                        </div>

                        {# LIST ITEMS #}
                        {% for invoice in recentInvoices %}
                            <div class="grid grid-cols-12 gap-2 items-center py-3 border-b border-gray-100 last:border-0 hover:bg-gray-50 px-2 rounded transition-colors">
                                
                                {# Date #}
                                <div class="col-span-3 text-xs text-gray-600 font-medium">
                                    {{ invoice.createdAt|date('d M, Y') }}
                                </div>

                                {# Description #}
                                <div class="col-span-5">
                                    <p class="text-sm font-bold text-gray-800 truncate">{{ invoice.term.name }}</p>
                                    <p class="text-[10px] text-gray-400 truncate">#{{ invoice.invoiceNumber }}</p>
                                </div>

                                {# Amount & Status #}
                                <div class="col-span-4 text-right">
                                    <p class="text-sm font-bold text-gray-800">₦{{ invoice.totalAmount|number_format(2) }}</p>
                                    
                                    <div class="mt-1">
                                        {% if invoice.status == 'PAID' %}
                                            <span class="inline-block text-[10px] font-bold text-green-700 bg-green-100 px-2 py-0.5 rounded-full">Paid</span>
                                        {% elseif invoice.status == 'PARTIAL' %}
                                            <span class="inline-block text-[10px] font-bold text-yellow-700 bg-yellow-100 px-2 py-0.5 rounded-full">Partial</span>
                                        {% else %}
                                            <span class="inline-block text-[10px] font-bold text-red-700 bg-red-100 px-2 py-0.5 rounded-full">Unpaid</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-6 border-2 border-dashed border-gray-100 rounded">
                        <p class="text-gray-400 text-sm">No recent invoices found.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
            
        </div>

        {# COLUMN 2: GUARDIAN & SIBLINGS (1/3 width) #}
        <div class="lg:col-span-1 space-y-6">
            
            {# SECTION: GUARDIAN INFORMATION #}
            {% if guardian %}
            <div class="bg-white shadow rounded-lg border border-gray-200">
                <div class="p-5 border-b border-gray-200 bg-gray-50">
                    <h2 class="text-xl font-bold text-gray-800"><i class="fas fa-user-shield mr-2 text-green-500"></i> Guardian Details</h2>
                </div>
                <div class="p-5 space-y-3">
                    <div>
                        <p class="text-sm font-medium text-gray-500">Name</p>
                        <p class="text-gray-900 font-semibold">{{ guardian.fullName }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Phone</p>
                        <p class="text-gray-900">{{ guardian.phoneNumber }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Email</p>
                        <p class="text-gray-900">{{ guardian.email }}</p>
                    </div>
                </div>
            </div>
            {% endif %}

            {# SECTION: SIBLINGS #}
            {% if siblings is not empty %}
            <div class="bg-white shadow rounded-lg border border-gray-200">
                <div class="p-5 border-b border-gray-200">
                    <h2 class="text-xl font-bold text-gray-800"><i class="fas fa-users mr-2 text-yellow-500"></i> Siblings ({{ siblings|length }})</h2>
                </div>
                <ul class="divide-y divide-gray-200">
                    {% for sibling in siblings %}
                        <li class="p-3 hover:bg-gray-50">
                            <a href="{{ path('app_tenant_student_profile', {'id': sibling.id}) }}" class="flex justify-between items-center group">
                                <div>
                                    <p class="text-sm font-medium text-gray-900 group-hover:text-indigo-600">{{ sibling.firstName }} {{ sibling.lastName }}</p>
                                    <p class="text-xs text-gray-500">
                                        {% set siblingEnrollment = sibling.enrollments|last %}
                                        {{ siblingEnrollment.classroom.name|default('No Class') }}
                                    </p>
                                </div>
                                <i class="fas fa-arrow-right text-gray-400 group-hover:text-indigo-600 text-sm"></i>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
            
        </div>
        
    </div>
</div>
{% endblock %}