{% extends 'base.html.twig' %}

{% block title %}Student Profile: {{ student.firstName }}{% endblock %}

{% block body %}
<div class="px-4 sm:px-6 lg:px-8 py-6 md:py-8 max-w-7xl mx-auto">
    
    {# --- Header, Profile Picture, and Actions --- #}
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-8 p-5 sm:p-6 bg-white shadow-sm rounded-xl border border-gray-100 relative">
        
        {# LEFT: Picture and Name #}
        <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left w-full lg:w-auto">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-gray-100 overflow-hidden flex-shrink-0 relative border-4 border-indigo-100 shadow-sm mb-4 sm:mb-0">
                {% if student.profilePictureFilename %}
                    <img src="{{ asset('uploads/students/' ~ student.profilePictureFilename) }}" alt="{{ student.fullName }} Picture" class="w-full h-full object-cover">
                {% else %}
                    <span class="text-4xl text-gray-400 absolute inset-0 flex items-center justify-center">
                        <i class="fas fa-user"></i>
                    </span>
                {% endif %}
            </div>
            <div class="sm:ml-6 mt-2 sm:mt-1">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">{{ student.firstName }} {{ student.middleName ?: '' }} {{ student.lastName }}</h1>
                <p class="text-base sm:text-lg font-bold text-indigo-600 mt-1">Adm No: {{ student.admissionNumber ?: 'Pending' }}</p>
                
                <p class="text-sm text-gray-500 mt-2 bg-gray-50 inline-block px-3 py-1 rounded-full border border-gray-200">
                    Current Class: <span class="font-bold text-gray-800">
                        {% if student.currentClass %}
                            {{ student.currentClass.name }}
                        {% elseif enrollment and enrollment.classroom %}
                            {{ enrollment.classroom.name }}
                        {% else %}
                            Unassigned
                        {% endif %}
                    </span>
                </p>

                {# ====================================================== #}
                {# 🟢 NEW: CURRENT TERM FEE STATUS INDICATOR              #}
                {# ====================================================== #}
                {% if activeTerm %}
                    <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-start gap-2">
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">{{ activeTerm.name }} Billing:</span>
                        
                        {% if hasCurrentTermFee %}
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-green-50 text-green-700 border border-green-200 shadow-sm">
                                ✅ Generated
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-yellow-50 text-yellow-800 border border-yellow-300 shadow-sm">
                                ⚠️ Not Generated
                            </span>
                            
                          {% if is_granted('ROLE_BURSAR') or is_granted('ROLE_ADMIN') %}
                                <form action="{{ path('app_tenant_payment_generate_invoice', {'studentId': student.id}) }}" 
                                      method="POST" 
                                      class="inline-block m-0 p-0"
                                      onsubmit="const btn = this.querySelector('button'); btn.disabled = true; btn.innerHTML = '⚙️ GENERATING...'; btn.classList.add('opacity-75', 'cursor-not-allowed');">
                                    <button type="submit" class="bg-yellow-200 hover:bg-yellow-300 text-yellow-900 border border-yellow-400 px-3 py-1 rounded text-[10px] uppercase font-black transition-colors shadow-sm cursor-pointer flex items-center">
                                        ⚙️ Generate Now &rarr;
                                    </button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endif %}
                {# ====================================================== #}

            </div>
        </div>
        
        {# RIGHT: Action Buttons (Mobile Friendly Stack) #}
        <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center lg:justify-end gap-3 mt-6 lg:mt-0 w-full lg:w-auto">
            
            <a href="{{ path('app_tenant_student_edit', {'id': student.id}) }}" class="w-full sm:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold py-2.5 px-4 rounded-lg transition-colors border border-blue-200 flex items-center justify-center shadow-sm">
                <i class="fas fa-pencil-alt mr-2"></i> Edit Profile
            </a>
            
            <a href="{{ path('app_tenant_student_upload_photo', {'id': student.id}) }}" class="w-full sm:w-auto bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-2.5 px-4 rounded-lg transition-colors border border-indigo-200 flex items-center justify-center shadow-sm">
                <i class="fas fa-camera mr-2"></i> Photo
            </a>
            
            <a href="{{ path('app_tenant_student_print_idcard', {'id': student.id}) }}" target="_blank" class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-4 rounded-lg shadow-md transition-colors flex items-center justify-center">
                <i class="fas fa-id-card mr-2"></i> ID Card
            </a>
            
        </div>
    </div>

    {# --- MAIN PROFILE CONTENT: TWO COLUMNS --- #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# COLUMN 1: PERSONAL, MEDICAL, and FINANCIAL INFO (2/3 width) #}
        <div class="lg:col-span-2 space-y-6">
            
            {# SECTION: PERSONAL & ACADEMIC DETAILS #}
            <div class="bg-white shadow-sm rounded-xl overflow-hidden border border-gray-100">
                <div class="p-5 border-b border-gray-100 bg-gray-50/50">
                    <h2 class="text-lg font-bold text-gray-800"><i class="fas fa-graduation-cap mr-2 text-indigo-500"></i> Personal & Academic Data</h2>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Date of Birth</p>
                        <p class="text-gray-900 font-medium">{{ student.dateOfBirth ? student.dateOfBirth|date('M d, Y') : 'Not Set' }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Date of Admission</p>
                        <p class="text-gray-900 font-medium">{{ student.createdAt ? student.createdAt|date('M d, Y') : 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Home Town / LGA</p>
                        <p class="text-gray-900 font-medium">{{ student.homeTown ?: 'N/A' }} / {{ student.lga ? student.lga.name : 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Previous School</p>
                        <p class="text-gray-900 font-medium">{{ student.previousSchool ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>

            {# SECTION: MEDICAL PROFILE #}
            <div class="bg-red-50/50 shadow-sm rounded-xl border border-red-100 overflow-hidden">
                <div class="p-5 border-b border-red-100 bg-red-50">
                    <h2 class="text-lg font-bold text-red-800"><i class="fas fa-heartbeat mr-2 text-red-500"></i> Medical Profile</h2>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Blood Group / Genotype</p>
                        <p class="text-red-900 font-bold">{{ student.bloodGroup ?: 'N/A' }} / {{ student.genotype ?: 'N/A' }}</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Medical Conditions / Allergies</p>
                        <p class="text-red-900 font-medium">{{ student.medicalConditions ?: 'None Reported' }}</p>
                    </div>
                </div>
            </div>

            {# FINANCIAL SUMMARY CARD #}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <h3 class="text-lg font-bold text-gray-800">💰 Financial Overview</h3>
                    <a href="{{ path('app_tenant_student_finance', {id: student.id}) }}" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:underline bg-indigo-50 px-3 py-1.5 rounded-md">
                        Full History &rarr;
                    </a>
                </div>

                <div class="p-5 sm:p-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-8 bg-white border border-gray-200 p-5 rounded-xl shadow-sm gap-4">
                        <div>
                            <p class="text-xs text-gray-500 uppercase font-bold tracking-wider mb-2">Total Debt (All Terms)</p>
                            <span class="text-3xl sm:text-4xl font-black tracking-tight {{ totalBalance > 0 ? 'text-red-600' : 'text-green-600' }}">
                                ₦{{ totalBalance|number_format(2) }}
                            </span>
                        </div>
                        
                        <div class="w-full sm:w-auto">
                            {% if totalBalance > 0 %}
                                <a href="{{ path('app_tenant_payment_terminal', {id: student.id}) }}" class="block text-center w-full bg-indigo-600 text-white px-6 py-3 rounded-lg text-sm font-bold hover:bg-indigo-700 shadow-md transition-transform transform hover:-translate-y-0.5">
                                    Pay Now
                                </a>
                            {% else %}
                                <div class="px-4 py-2 bg-green-100 text-green-700 rounded-lg text-sm font-bold flex items-center justify-center gap-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Up to Date
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div>
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3 border-b pb-2">
                            Recent Invoices
                        </h4>
                        
                        {% if recentInvoices|length > 0 %}
                            <div class="space-y-0 overflow-x-auto">
                                <div class="min-w-[400px]">
                                    <div class="grid grid-cols-12 gap-2 text-[10px] uppercase font-bold text-gray-400 mb-2 px-2">
                                        <div class="col-span-3">Date</div>
                                        <div class="col-span-5">Description</div>
                                        <div class="col-span-4 text-right">Amount / Status</div>
                                    </div>

                                    {% for invoice in recentInvoices %}
                                        <div class="grid grid-cols-12 gap-2 items-center py-3 border-b border-gray-100 last:border-0 hover:bg-gray-50 px-2 rounded transition-colors">
                                            <div class="col-span-3 text-xs text-gray-600 font-medium">
                                                {{ invoice.createdAt|date('d M, Y') }}
                                            </div>

                                            <div class="col-span-5">
                                                <p class="text-sm font-bold text-gray-800 truncate">{{ invoice.term ? invoice.term.name : 'Unspecified Term' }}</p>
                                                <p class="text-[10px] text-gray-400 truncate">#{{ invoice.invoiceNumber }}</p>
                                            </div>

                                            <div class="col-span-4 text-right">
                                                <p class="text-sm font-bold text-gray-800">₦{{ invoice.totalAmount|number_format(2) }}</p>
                                                <div class="mt-1">
                                                    {% if invoice.status == 'PAID' %}
                                                        <span class="inline-block text-[10px] font-bold text-green-700 bg-green-100 px-2 py-0.5 rounded-full">Paid</span>
                                                    {% elseif invoice.status == 'PARTIAL' %}
                                                        <span class="inline-block text-[10px] font-bold text-yellow-700 bg-yellow-100 px-2 py-0.5 rounded-full">Partial</span>
                                                    {% else %}
                                                        <span class="inline-block text-[10px] font-bold text-red-700 bg-red-100 px-2 py-0.5 rounded-full">Unpaid</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <div class="text-center py-8 bg-gray-50 rounded-lg border-2 border-dashed border-gray-200">
                                <p class="text-gray-500 font-medium text-sm">No recent invoices found.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            
        </div>

        {# COLUMN 2: GUARDIAN & SIBLINGS (1/3 width) #}
        <div class="lg:col-span-1 space-y-6">
            
            {# SECTION: GUARDIAN INFORMATION #}
            {% if guardian %}
            <div class="bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden">
                <div class="p-5 border-b border-gray-100 bg-gray-50/50">
                    <h2 class="text-lg font-bold text-gray-800"><i class="fas fa-user-shield mr-2 text-green-500"></i> Guardian Details</h2>
                </div>
                <div class="p-5 space-y-4">
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Name</p>
                        <p class="text-gray-900 font-medium">{{ guardian.fullName ?: 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Phone</p>
                        <p class="text-gray-900 font-medium">{{ guardian.phoneNumber ?: 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Email</p>
                        <p class="text-gray-900 font-medium break-all">{{ guardian.email ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            {% endif %}

            {# SECTION: SIBLINGS #}
            {% if siblings is not empty %}
            <div class="bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden">
                <div class="p-5 border-b border-gray-100 bg-gray-50/50">
                    <h2 class="text-lg font-bold text-gray-800"><i class="fas fa-users mr-2 text-yellow-500"></i> Siblings ({{ siblings|length }})</h2>
                </div>
                <ul class="divide-y divide-gray-100">
                    {% for sibling in siblings %}
                        <li class="p-4 hover:bg-gray-50 transition-colors">
                            <a href="{{ path('app_tenant_student_profile', {'id': sibling.id}) }}" class="flex justify-between items-center group">
                                <div>
                                    <p class="text-sm font-bold text-gray-900 group-hover:text-indigo-600 transition-colors">{{ sibling.firstName }} {{ sibling.lastName }}</p>
                                    <p class="text-xs text-gray-500 mt-0.5">
                                        {% set siblingEnrollment = sibling.enrollments|last %}
                                        {{ (siblingEnrollment and siblingEnrollment.classroom) ? siblingEnrollment.classroom.name : 'No Class Assigned' }}
                                    </p>
                                </div>
                                <div class="bg-white border border-gray-200 rounded-full w-8 h-8 flex items-center justify-center group-hover:border-indigo-300 group-hover:bg-indigo-50 transition-colors">
                                    <i class="fas fa-chevron-right text-gray-400 group-hover:text-indigo-600 text-xs"></i>
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
            
        </div>
        
    </div>
</div>
{% endblock %}