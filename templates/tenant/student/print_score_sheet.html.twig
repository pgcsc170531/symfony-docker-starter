<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Score Sheet - {{ classroom.name }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% include '_design_tokens.html.twig' %}
    {#
        A blank sheet the teacher prints and fills in by hand, then types into
        Result Entry. Its columns come from the assessment scheme — two CAs for a
        school that keeps two, three for a school that keeps three — so the paper
        and the screen never disagree about how many marks there are to give.
    #}
    <style>
        @page { size: A4 portrait; margin: 15mm; }
        @media print {
            .no-print { display: none !important; }
            body { background: white; margin: 0; padding: 0; }
            .print-container { box-shadow: none !important; margin: 0 !important; width: 100% !important; max-width: 100% !important; }
            /* Force borders to print strongly */
            th, td { border: 1px solid #000 !important; }
        }
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid #e5e7eb; padding: 6px 8px; text-align: left; }
        th { background-color: #f9fafb; font-weight: bold; font-size: 11px; text-transform: uppercase; }
        td { font-size: 12px; }
    </style>
</head>
<body class="bg-ink-200 font-sans text-ink-900">

    <div class="print-container bg-white max-w-4xl mx-auto my-8 p-6 shadow-lg sm:p-8">

        <div class="no-print mb-6 flex justify-end gap-3">
            <a href="{{ path('app_tenant_student_index') }}"
               class="inline-flex min-h-[44px] items-center rounded bg-ink-100 px-4 text-sm font-bold text-ink-700 hover:bg-ink-200">
                Close
            </a>
            <button type="button" onclick="window.print()"
                    class="inline-flex min-h-[44px] items-center gap-2 rounded bg-accent-600 px-4 text-sm font-bold text-white hover:bg-accent-700">
                🖨️ Print Sheet
            </button>
        </div>

        <div class="text-center mb-6">
            <h1 class="text-xl font-bold uppercase break-words sm:text-2xl">{{ tenant.name }}</h1>
            <h2 class="text-base font-semibold mt-1 uppercase decoration-2 underline underline-offset-4 sm:text-lg">Blank Score Sheet</h2>

            <div class="mt-6 flex flex-col gap-3 text-sm font-bold sm:flex-row sm:items-end sm:justify-between">
                <p>Class: <span class="text-accent-700">{{ classroom.name }}</span></p>
                <p>Subject: ___________________________</p>
                <p>Term/Session: ______________________</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th class="w-8 text-center">S/N</th>
                        <th class="w-24">Adm No.</th>
                        <th class="w-64">{{ learner.capital }} Name</th>
                        {% for column in columns %}
                            <th class="w-12 text-center whitespace-nowrap">{{ column.label }}<br><span class="text-[9px] font-normal">({{ column.max }})</span></th>
                        {% endfor %}
                        <th class="w-12 text-center whitespace-nowrap">Total<br><span class="text-[9px] font-normal">({{ maximum }})</span></th>
                        <th class="w-12 text-center">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    {% for student in students %}
                    <tr>
                        <td class="text-center text-ink-500">{{ loop.index }}</td>
                        <td class="font-mono text-xs">{{ student.admissionNumber ?: '---' }}</td>
                        <td class="font-bold uppercase text-[11px]">{{ student.fullName }}</td>
                        {% for column in columns %}<td></td>{% endfor %}
                        <td></td>
                        <td></td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="{{ 3 + columns|length + 2 }}" class="text-center py-8 text-ink-400 italic">No active students found in this class.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-12 text-sm">
            <p>Teacher's Name: ___________________________</p>
            <p class="mt-4">Signature / Date: _________________________</p>
        </div>

    </div>

</body>
</html>