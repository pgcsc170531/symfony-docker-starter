{% extends 'tenant/home/layout.html.twig' %}

{% block title %}Contact {{ school_name }}{% endblock %}

{% block tenant_public_content %}

{#
    The contact page is the second conversion path after "Apply". A parent with
    a question used to find four cards and a map and no way to ask it, so the
    only options were to leave the site or phone during office hours.

    Order is deliberate: the fastest channels first (one tap, no typing), then
    the form, then the map. Sending is POST-redirect-GET, so a refresh cannot
    send the same message twice.
#}

{# ---------- HEADER ---------- #}
<section class="border-b border-ink-200 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-500">Contact</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
            Talk to {{ school_name }}
        </h1>
        <p class="mt-3 max-w-2xl text-base text-ink-700 sm:text-lg">
            Questions about admissions, fees or your child's place? Call, message us on WhatsApp,
            or send a note below and we will reply.
        </p>
    </div>
</section>

{# ---------- ONE-TAP CHANNELS ---------- #}
{% if tel_url or whatsapp_url or school_email or directions_url %}
<section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 sm:pt-8 lg:px-8">
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            {% if tel_url %}
                <a href="{{ tel_url }}"
                   class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    Call
                </a>
            {% endif %}
            {% if whatsapp_url %}
                <a href="{{ whatsapp_url }}" target="_blank" rel="noopener"
                   class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.05-.52-.099-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.893c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a12.03 12.03 0 005.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.896A11.82 11.82 0 0020.52 3.45z"/></svg>
                    WhatsApp
                </a>
            {% endif %}
            {% if school_email %}
                <a href="mailto:{{ school_email }}"
                   class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    Email
                </a>
            {% endif %}
            {% if directions_url %}
                <a href="{{ directions_url }}" target="_blank" rel="noopener"
                   class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Directions
                </a>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}

{# ---------- THE FORM ---------- #}
<section class="bg-white py-10 sm:py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-2">

            <div>
                <h2 class="text-2xl font-extrabold text-ink-900">Send a message</h2>
                <p class="mt-2 text-sm text-ink-700">
                    Your message goes to the school office. Include a phone number if you would
                    rather be called back.
                </p>

                {% if sent %}
                    <div class="mt-6 rounded-xl border border-paid/30 bg-paid/5 p-5" role="status">
                        <p class="text-base font-bold text-ink-900">Message sent</p>
                        <p class="mt-1 text-sm text-ink-700">
                            Thank you — the school office has your message and will reply as soon as
                            they can.
                        </p>
                        <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}"
                           class="mt-4 inline-flex min-h-[44px] items-center text-sm font-semibold underline"
                           style="color: {{ brand_ink }};">
                            Send another message
                        </a>
                    </div>
                {% else %}
                    {% if errors.form is defined %}
                        <div class="mt-5 rounded-lg border border-failed/30 bg-failed/5 p-4" role="alert">
                            <p class="text-sm font-semibold text-ink-900">{{ errors.form }}</p>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}"
                          class="mt-6 space-y-4" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">

                        {# Honeypot: hidden from people, irresistible to bots. #}
                        <div class="hidden" aria-hidden="true">
                            <label for="website">Website</label>
                            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                        </div>

                        <div>
                            <label for="name" class="block text-sm font-semibold text-ink-800">Your name</label>
                            <input type="text" id="name" name="name" value="{{ old.name }}" required
                                   autocomplete="name"
                                   class="mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                            {% if errors.name is defined %}
                                <p class="mt-1 text-sm text-failed">{{ errors.name }}</p>
                            {% endif %}
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label for="phone" class="block text-sm font-semibold text-ink-800">Phone number</label>
                                <input type="tel" id="phone" name="phone" value="{{ old.phone }}"
                                       inputmode="tel" autocomplete="tel"
                                       class="mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                                {% if errors.phone is defined %}
                                    <p class="mt-1 text-sm text-failed">{{ errors.phone }}</p>
                                {% endif %}
                            </div>
                            <div>
                                <label for="email" class="block text-sm font-semibold text-ink-800">
                                    Email <span class="font-normal text-ink-500">(optional)</span>
                                </label>
                                <input type="email" id="email" name="email" value="{{ old.email }}"
                                       autocomplete="email" inputmode="email"
                                       class="mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                                {% if errors.email is defined %}
                                    <p class="mt-1 text-sm text-failed">{{ errors.email }}</p>
                                {% endif %}
                            </div>
                        </div>

                        <div>
                            <label for="message" class="block text-sm font-semibold text-ink-800">Your message</label>
                            <textarea id="message" name="message" rows="5" required
                                      class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">{{ old.message }}</textarea>
                            {% if errors.message is defined %}
                                <p class="mt-1 text-sm text-failed">{{ errors.message }}</p>
                            {% endif %}
                        </div>

                        <button type="submit"
                                class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg px-6 text-base font-bold text-white transition hover:opacity-90 sm:w-auto"
                                style="background-color: {{ brand_ink }};">
                            Send message
                        </button>

                        <p class="text-xs text-ink-500">
                            We only use your details to answer this message.
                        </p>
                    </form>
                {% endif %}
            </div>

            {# ---------- WHERE TO FIND US ---------- #}
            <div>
                <h2 class="text-2xl font-extrabold text-ink-900">Find us</h2>
                <dl class="mt-4 space-y-4 text-sm">
                    {% if school_address %}
                        <div>
                            <dt class="font-semibold text-ink-500">Address</dt>
                            <dd class="mt-0.5 break-words text-ink-900">{{ school_address }}</dd>
                        </div>
                    {% endif %}
                    {% if school_phone %}
                        <div>
                            <dt class="font-semibold text-ink-500">Phone</dt>
                            <dd class="mt-0.5">
                                {% if tel_url %}
                                    <a href="{{ tel_url }}" class="font-semibold text-ink-900 underline underline-offset-2">{{ school_phone }}</a>
                                {% else %}
                                    <span class="text-ink-900">{{ school_phone }}</span>
                                {% endif %}
                            </dd>
                        </div>
                    {% endif %}
                    {% if school_email %}
                        <div>
                            <dt class="font-semibold text-ink-500">Email</dt>
                            <dd class="mt-0.5">
                                <a href="mailto:{{ school_email }}" class="break-words font-semibold text-ink-900 underline underline-offset-2">{{ school_email }}</a>
                            </dd>
                        </div>
                    {% endif %}
                </dl>

                {% if school_map %}
                    <div class="mt-5 overflow-hidden rounded-xl border border-ink-200">
                        {{ school_map|raw }}
                    </div>
                {% endif %}

                <div class="mt-6 rounded-xl border border-ink-200 bg-ink-50 p-4">
                    <p class="text-sm text-ink-700">Ready to apply?</p>
                    <a href="{{ path('app_tenant_apply_index', {'subdomain': subdomain}) }}"
                       class="mt-2 inline-flex min-h-[44px] items-center text-sm font-bold underline"
                       style="color: {{ brand_ink }};">
                        Start an application online
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}