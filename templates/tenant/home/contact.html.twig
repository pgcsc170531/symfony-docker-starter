{% extends 'tenant/home/layout.html.twig' %}

{% block title %}Contact {{ school_name }}{% endblock %}

{% block tenant_public_content %}

{# ---------- PAGE HEADER ---------- #}
<section class="relative overflow-hidden text-white" style="background: linear-gradient(135deg, {{ brand }}, {{ brand }}d9);">
    <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">We're Here to Help</p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight">Contact {{ school_name }}</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-white/85">Have a question? Reach out and our team will respond promptly.</p>
    </div>
</section>

{# ---------- CONTACT CARDS ---------- #}
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {% if school_address %}
            <div class="bg-gray-50 rounded-2xl border border-gray-100 p-7 text-center shadow-sm">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </span>
                <h2 class="mt-4 text-lg font-bold text-gray-900">Address</h2>
                <p class="mt-2 text-gray-700">{{ school_address }}</p>
            </div>
            {% endif %}

            {% if school_phone %}
            <div class="bg-gray-50 rounded-2xl border border-gray-100 p-7 text-center shadow-sm">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </span>
                <h2 class="mt-4 text-lg font-bold text-gray-900">Phone</h2>
                <p class="mt-2 text-gray-700">{{ school_phone }}</p>
            </div>
            {% endif %}

            {% if school_email %}
            <div class="bg-gray-50 rounded-2xl border border-gray-100 p-7 text-center shadow-sm">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </span>
                <h2 class="mt-4 text-lg font-bold text-gray-900">Email</h2>
                <a href="mailto:{{ school_email }}" class="mt-2 inline-block text-blue-600 hover:underline">{{ school_email }}</a>
            </div>
            {% endif %}

            {% if school_website %}
            <div class="bg-gray-50 rounded-2xl border border-gray-100 p-7 text-center shadow-sm">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                </span>
                <h2 class="mt-4 text-lg font-bold text-gray-900">Website</h2>
                <a href="{{ school_website }}" target="_blank" class="mt-2 inline-block text-blue-600 hover:underline">{{ school_website }}</a>
            </div>
            {% endif %}
        </div>

        <div class="mt-14 text-center">
            <p class="text-gray-600">Prefer to apply right away? Visit our admissions page.</p>
            <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="mt-4 inline-flex items-center justify-center px-7 py-3.5 rounded-full text-white font-bold shadow-lg hover:opacity-90 transition" style="background-color: {{ brand }};">
                Go to Admissions
            </a>
        </div>
    </div>
</section>

{% endblock %}