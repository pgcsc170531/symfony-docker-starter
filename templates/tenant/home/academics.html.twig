{% extends 'tenant/home/layout.html.twig' %}

{% block title %}Academics — {{ school_name }}{% endblock %}

{#
    Built from the school's real `Classroom` rows, grouped into stages by name.
    A brochure that lists "Nursery – SS3" for a school that only runs JSS would
    be a lie, and a parent notices on the first visit.
#}

{% block tenant_public_content %}

{# ---------- HEADER ---------- #}
<section class="border-b border-ink-200 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-500">Academics</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
            Classes at {{ school_name }}
        </h1>
        <p class="mt-3 max-w-2xl text-base text-ink-700 sm:text-lg">
            Every class we run, from the youngest to the most senior. Ask us about the
            curriculum, class sizes or a specific stage and we will walk you through it.
        </p>
    </div>
</section>

{# ---------- STAGES ---------- #}
<section class="bg-white py-10 sm:py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        {% if stages is not empty %}
            <div class="space-y-4">
                {% for stage, classes in stages %}
                    <section class="rounded-2xl border border-ink-200 p-5 sm:p-6">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <h2 class="text-xl font-extrabold text-ink-900">{{ stage }}</h2>
                            <span class="text-xs font-semibold uppercase tracking-wide text-ink-500">
                                {{ classes|length }} {{ classes|length == 1 ? 'class' : 'classes' }}
                            </span>
                        </div>
                        <ul class="mt-4 flex flex-wrap gap-2">
                            {% for class_name in classes %}
                                <li class="break-words rounded-lg bg-ink-50 px-3 py-2 text-sm font-semibold text-ink-800">
                                    {{ class_name }}
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
            </div>
        {% else %}
            {# Never an empty box: say what would be here and how to get it. #}
            <div class="rounded-2xl border border-dashed border-ink-300 bg-white px-6 py-12 text-center">
                <p class="text-lg font-semibold text-ink-700">The class list is being prepared</p>
                <p class="mx-auto mt-1 max-w-md text-sm text-ink-500">
                    {{ school_name }} has not published its classes on the website yet. Call or message
                    the school office and they will tell you which classes are open.
                </p>
                <div class="mt-5 flex flex-col justify-center gap-2 sm:flex-row">
                    {% if tel_url %}
                        <a href="{{ tel_url }}"
                           class="inline-flex min-h-[44px] items-center justify-center rounded-lg px-5 text-sm font-bold text-white"
                           style="background-color: {{ brand_ink }};">
                            Call the school
                        </a>
                    {% endif %}
                    <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-800">
                        Send a message
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</section>

{# ---------- NEXT STEP ---------- #}
<section class="border-t border-ink-100 bg-ink-50 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold text-ink-900">Ready to join a class?</h2>
        <p class="mt-2 max-w-2xl text-ink-700">
            Applying takes a few minutes online, and you will be told by SMS at every step.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="{{ apply_url }}"
               class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg px-6 text-base font-bold text-white transition hover:opacity-90 sm:w-auto"
               style="background-color: {{ brand_ink }};">
                Apply online
            </a>
            <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}"
               class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg border border-ink-300 bg-white px-6 text-base font-semibold text-ink-800 transition hover:bg-ink-100 sm:w-auto">
                Fees and admissions
            </a>
        </div>
    </div>
</section>

{% endblock %}
