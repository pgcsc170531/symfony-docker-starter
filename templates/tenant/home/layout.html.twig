{% extends 'base.html.twig' %}

{# This is the school's public website: opt out of the app shell (sidebar,
   admin header, app footer) even when a signed-in user is browsing it. #}
{% set public_site = true %}

{% set brand = school is defined and school and school.primaryColor ? school.primaryColor : '#1e40af' %}
{# The school picks any colour; white text must stay readable on it. `brand_ink`
   is that colour darkened only as far as WCAG AA needs — for surfaces that carry
   white text and for links on white. `brand` itself stays for tints. #}
{% set brand_ink = brand|brand_on_white %}
{% set school_name = school is defined and school and school.name ? school.name : 'School Portal' %}
{# The category that rides with the name everywhere it is shown — a group with one
   tenant per section has several schools whose names begin identically. #}
{% set school_tag = school is defined and school and school.typeTag ? school.typeTag : null %}
{% set school_motto = school is defined and school and school.motto ? school.motto : null %}
{% set school_logo = school is defined and school and school.logoFilename ? school.logoFilename : null %}
{% set school_address = school is defined and school and school.address ? school.address : null %}
{% set school_phone = school is defined and school and school.phoneNumber ? school.phoneNumber : null %}
{% set school_email = school is defined and school and school.email ? school.email : null %}
{% set school_website = school is defined and school and school.website ? school.website : null %}
{% set school_map = school is defined and school and school.mapEmbedUrl ? school.mapEmbedUrl : null %}
{% set hero_tagline = school is defined and school and school.heroTagline ? school.heroTagline : null %}
{% set hero_image_filename = school is defined and school and school.heroImageFilename ? school.heroImageFilename : null %}
{% set about_content = school is defined and school and school.aboutContent ? school.aboutContent : null %}
{% set admissions_intro = school is defined and school and school.admissionsIntro ? school.admissionsIntro : null %}
{% set facebook_url = school is defined and school and school.facebookUrl ? school.facebookUrl : null %}
{% set twitter_url = school is defined and school and school.twitterUrl ? school.twitterUrl : null %}
{% set instagram_url = school is defined and school and school.instagramUrl ? school.instagramUrl : null %}

{#
    Contact actions, derived once so every page agrees.

    A parent on a phone must be able to CALL or MESSAGE the school in one tap.
    Plain-text phone numbers were the single worst conversion gap on these pages
    (SCHOOL-PUBLIC-SITE.md §2.1). WhatsApp falls back to the phone number,
    because most schools give one number for both.
#}
{% set phone_digits = school_phone ? school_phone|replace({' ': '', '-': '', '(': '', ')': '', '.': ''}) : null %}
{% set tel_url = phone_digits ? 'tel:' ~ phone_digits : null %}
{% set whatsapp_digits = school is defined and school and school.whatsappNumber
    ? school.whatsappNumber|replace({' ': '', '-': '', '(': '', ')': '', '+': '', '.': ''})
    : (phone_digits ? phone_digits|trim('+') : null) %}
{# wa.me needs an international number. A local `0803…` produces a dead link, so
   the leading 0 is rewritten to Nigeria's 234 — the market this site serves. #}
{% if whatsapp_digits and whatsapp_digits starts with '0' %}
    {% set whatsapp_digits = '234' ~ whatsapp_digits|slice(1) %}
{% endif %}
{% set whatsapp_url = whatsapp_digits ? 'https://wa.me/' ~ whatsapp_digits : null %}
{% set directions_url = school_address ? 'https://www.google.com/maps/search/?api=1&query=' ~ (school_address ~ ' ' ~ school_name)|url_encode : null %}
{#
    "Apply" always means the application page, never the admissions brochure.
    It used to fall back to /admissions whenever the school had its application
    switch off, so a parent who read the page and tapped Apply landed back on
    the page they had just left. /apply explains the closed state itself.
#}
{% set apply_url = path('app_tenant_apply_index', {'subdomain': subdomain}) %}

{# The school is the brand here; Edus is the colophon. Do not append the SaaS
   name to every page title, and describe the school rather than the product. #}
{% block title_suffix %}{% endblock %}
{% block meta_description %}{{ school_name }}{% if school_motto %} — {{ school_motto }}{% endif %}{% if school_address %}, {{ school_address }}{% endif %}. Admissions, contact details and the parent portal.{% endblock %}

{# A link to the school must preview the SCHOOL, not the Edus logo: the hero
   photograph, then the logo, then the generic card. Kept on one line so no
   whitespace leaks into the meta content attribute. #}
{% block og_image %}{% if hero_image_filename %}{{ absolute_url(asset('uploads/hero/' ~ hero_image_filename)) }}{% elseif school_logo %}{{ absolute_url(asset('uploads/logos/' ~ school_logo)) }}{% else %}{{ absolute_url(asset('images/brand/og-edus.png')) }}{% endif %}{% endblock %}

{#
    `School` structured data — what a search engine shows beside the result
    (name, address, phone) and what lets a parent tap "call" straight from the
    search page. Every field is optional; we merge only the ones we hold.
#}
{% block structured_data %}
    {% set social_links = [] %}
    {% for link in [facebook_url, twitter_url, instagram_url] %}
        {% if link %}{% set social_links = social_links|merge([link]) %}{% endif %}
    {% endfor %}
    {% set school_schema = {
        '@context': 'https://schema.org',
        '@type': 'School',
        'name': school_name,
        'url': app.request.schemeAndHttpHost ~ '/',
    } %}
    {% if school_phone %}{% set school_schema = school_schema|merge({'telephone': school_phone}) %}{% endif %}
    {% if school_email %}{% set school_schema = school_schema|merge({'email': school_email}) %}{% endif %}
    {% if school_address %}{% set school_schema = school_schema|merge({'address': {'@type': 'PostalAddress', 'streetAddress': school_address, 'addressCountry': 'NG'}}) %}{% endif %}
    {% if school_logo %}{% set school_schema = school_schema|merge({'logo': absolute_url(asset('uploads/logos/' ~ school_logo))}) %}{% endif %}
    {% if social_links is not empty %}{% set school_schema = school_schema|merge({'sameAs': social_links}) %}{% endif %}
    <script type="application/ld+json">{{ school_schema|json_encode|raw }}</script>
{% endblock %}

{% block body %}
{# Skip link: the first thing a keyboard user meets, invisible until focused. #}
<a href="#public-main"
   class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-white">
    Skip to content
</a>

<header class="sticky top-0 z-50 border-b border-ink-200 bg-white/95 backdrop-blur">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-3 py-3">

            {# ── The school, and only the school ─────────────────────────── #}
            <a href="{{ path('app_tenant_home', {'subdomain': subdomain}) }}"
               class="flex min-h-[44px] min-w-0 items-center gap-3">
                {% if school_logo %}
                    <img src="{{ asset('uploads/logos/' ~ school_logo) }}" alt=""
                         width="40" height="40" decoding="async"
                         class="h-10 w-10 shrink-0 rounded-lg border border-ink-200 bg-white object-contain">
                {% else %}
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg text-lg font-bold text-white"
                          style="background-color: {{ brand_ink }};" aria-hidden="true">{{ school_name|first|upper }}</span>
                {% endif %}
                <span class="min-w-0">
                    <span class="block truncate text-base font-bold leading-tight text-ink-900 sm:text-lg">{{ school_name }}</span>
                    {% if school_tag %}
                        <span class="block truncate text-[11px] font-semibold uppercase leading-tight tracking-wide text-ink-500">{{ school_tag }}</span>
                    {% endif %}
                    {% if school_motto %}
                        <span class="hidden truncate text-xs text-ink-500 sm:block">{{ school_motto }}</span>
                    {% endif %}
                </span>
            </a>

            {# ── Desktop nav ─────────────────────────────────────────────── #}
            <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
                <a href="{{ path('app_tenant_home', {'subdomain': subdomain}) }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">Home</a>
                <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">About</a>
                <a href="{{ path('app_tenant_academics', {'subdomain': subdomain}) }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">Academics</a>
                <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">Admissions</a>
                <a href="{{ path('app_tenant_events', {'subdomain': subdomain}) }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">Events</a>
                <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">Contact</a>
                <a href="{{ path('app_login') }}" class="text-sm font-medium text-ink-700 hover:text-ink-900">Portal</a>
            </nav>

            <div class="flex shrink-0 items-center gap-2">
                <a href="{{ apply_url }}"
                   class="inline-flex min-h-[44px] items-center justify-center rounded-lg px-4 text-sm font-bold text-white transition hover:opacity-90"
                   style="background-color: {{ brand_ink }};">
                    Apply
                </a>

                <button type="button" id="mobile-menu-btn"
                        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-ink-600 hover:bg-ink-100 md:hidden"
                        aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    {# ── Phone menu ─────────────────────────────────────────────────────── #}
    <div id="mobile-menu" class="hidden border-t border-ink-200 bg-white md:hidden">
        <nav class="mx-auto flex max-w-7xl flex-col px-4 py-2" aria-label="Menu">
            <a href="{{ path('app_tenant_home', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">Home</a>
            <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">About</a>
            <a href="{{ path('app_tenant_academics', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">Academics</a>
            <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">Admissions</a>
            <a href="{{ path('app_tenant_events', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">Events</a>
            <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">Contact</a>
            <a href="{{ path('app_login') }}" class="flex min-h-[44px] items-center rounded-lg px-3 font-medium text-ink-800 hover:bg-ink-50">Parent / Staff portal</a>

            {% if tel_url or whatsapp_url %}
                <div class="mt-1 flex gap-2 border-t border-ink-100 pt-3 pb-2">
                    {% if tel_url %}
                        <a href="{{ tel_url }}" class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-ink-300 text-sm font-semibold text-ink-800">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            Call
                        </a>
                    {% endif %}
                    {% if whatsapp_url %}
                        <a href="{{ whatsapp_url }}" target="_blank" rel="noopener"
                           class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-ink-300 text-sm font-semibold text-ink-800">
                            WhatsApp
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </nav>
    </div>
</header>

<main id="public-main">
{% block tenant_public_content %}{% endblock %}
</main>

<footer class="mt-12 border-t border-ink-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {# The school, once. #}
            <div>
                <p class="text-base font-bold text-ink-900">{{ school_name }}</p>
                {% if school_motto %}<p class="mt-1 text-sm italic text-ink-500">“{{ school_motto }}”</p>{% endif %}
                {% if school_address %}<p class="mt-3 text-sm text-ink-600">{{ school_address }}</p>{% endif %}
            </div>

            {# Contact, tappable. #}
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Contact</p>
                {% if tel_url %}
                    <a href="{{ tel_url }}" class="flex min-h-[44px] items-center text-sm font-semibold text-ink-800 hover:underline">{{ school_phone }}</a>
                {% endif %}
                {% if whatsapp_url %}
                    <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="flex min-h-[44px] items-center text-sm font-semibold text-ink-800 hover:underline">WhatsApp</a>
                {% endif %}
                {% if school_email %}
                    <a href="mailto:{{ school_email }}" class="flex min-h-[44px] items-center break-words text-sm font-semibold text-ink-800 hover:underline">{{ school_email }}</a>
                {% endif %}
            </div>

            {# Pages. #}
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">School</p>
                <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center text-sm text-ink-700 hover:text-ink-900">About</a>
                <a href="{{ path('app_tenant_academics', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center text-sm text-ink-700 hover:text-ink-900">Academics</a>
                <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center text-sm text-ink-700 hover:text-ink-900">Admissions</a>
                <a href="{{ path('app_tenant_events', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center text-sm text-ink-700 hover:text-ink-900">Events</a>
                <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}" class="flex min-h-[44px] items-center text-sm text-ink-700 hover:text-ink-900">Contact</a>
                <a href="{{ path('app_login') }}" class="flex min-h-[44px] items-center text-sm text-ink-700 hover:text-ink-900">Parent / Staff portal</a>
            </div>
        </div>

        {#
            Colophon. The brand appears ONCE, small, on the same row as the
            copyright — this is the school's site; Edus is the engine underneath
            it, not a co-sponsor of the page.
        #}
        <div class="mt-8 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-ink-100 pt-5">
            {% import '_brand.html.twig' as brand_macro %}
            <a href="https://edus.ng" target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center hover:opacity-80">
                {{ brand_macro.wordmark('xs') }}
            </a>
            <p class="text-xs text-ink-400">&copy; {{ "now"|date("Y") }} {{ school_name }}</p>
        </div>

        {% if facebook_url or twitter_url or instagram_url %}
            <div class="mt-2 flex justify-center gap-5 text-sm sm:justify-start">
                {% if facebook_url %}<a href="{{ facebook_url }}" target="_blank" rel="noopener" class="text-ink-500 hover:text-ink-800">Facebook</a>{% endif %}
                {% if twitter_url %}<a href="{{ twitter_url }}" target="_blank" rel="noopener" class="text-ink-500 hover:text-ink-800">Twitter / X</a>{% endif %}
                {% if instagram_url %}<a href="{{ instagram_url }}" target="_blank" rel="noopener" class="text-ink-500 hover:text-ink-800">Instagram</a>{% endif %}
            </div>
        {% endif %}
    </div>
</footer>

<script>
(function () {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', function () {
        var open = menu.classList.toggle('hidden') === false;
        // The screen reader must know the state changed, not just the eye.
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
})();
</script>

{% endblock %}
