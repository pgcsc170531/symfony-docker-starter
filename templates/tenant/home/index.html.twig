{% extends 'tenant/home/layout.html.twig' %}

{% block title %}{{ school_name }} - Welcome{% endblock %}

{% block tenant_public_content %}

{# ---------- 1. HERO SLIDER ---------- #}
<section class="relative overflow-hidden text-white" style="background: linear-gradient(135deg, {{ brand }}, {{ brand }}d9);">
    {% if hero_image_filename %}
        <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('{{ asset('uploads/hero/' ~ hero_image_filename) }}');"></div>
    {% endif %}
    <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
    <div class="absolute -bottom-20 -left-10 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
        <div class="hero-slide" data-slide="0">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Welcome to</p>
            <h1 class="mt-3 text-4xl sm:text-6xl font-extrabold tracking-tight">{{ school_name }}</h1>
            {% if school_motto %}
                <p class="mx-auto mt-4 max-w-2xl text-white/80">{{ school_motto }}</p>
            {% else %}
                <p class="mx-auto mt-4 max-w-2xl text-white/75">A nurturing environment where every child is inspired to learn, grow and achieve their full potential.</p>
            {% endif %}
            <p class="mx-auto mt-4 max-w-2xl text-white/75">A nurturing environment where every child is inspired to learn, grow and achieve their full potential.</p>
            <div class="mt-10 flex flex-wrap justify-center gap-4">
                <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="inline-flex items-center px-7 py-3.5 rounded-full bg-white text-gray-900 font-bold shadow-lg hover:bg-gray-100 transition">Apply for Admission</a>
                <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}" class="inline-flex items-center px-7 py-3.5 rounded-full border border-white/60 font-semibold text-white hover:bg-white/10 transition">Learn More</a>
            </div>
        </div>

        <div class="hero-slide hidden" data-slide="1">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Academic Excellence</p>
            <h1 class="mt-3 text-4xl sm:text-6xl font-extrabold tracking-tight">Preparing Leaders of Tomorrow</h1>
            <p class="mx-auto mt-5 max-w-2xl text-lg sm:text-xl text-white/85">A rigorous curriculum that builds strong foundations and lifelong confidence.</p>
            <div class="mt-10">
                <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}" class="inline-flex items-center px-7 py-3.5 rounded-full bg-white text-gray-900 font-bold shadow-lg hover:bg-gray-100 transition">Discover More</a>
            </div>
        </div>

        <div class="hero-slide hidden" data-slide="2">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Admissions Open</p>
            <h1 class="mt-3 text-4xl sm:text-6xl font-extrabold tracking-tight">Your Child's Journey Starts Here</h1>
            <p class="mx-auto mt-5 max-w-2xl text-lg sm:text-xl text-white/85">Join {{ school_name }} and give your child the gift of a quality education.</p>
            <div class="mt-10">
                <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="inline-flex items-center px-7 py-3.5 rounded-full bg-white text-gray-900 font-bold shadow-lg hover:bg-gray-100 transition">Start Application</a>
            </div>
        </div>
    </div>

    <div class="relative flex justify-center gap-2 pb-8">
        <button type="button" class="hero-dot h-2 w-8 rounded-full bg-white" data-dot="0" aria-label="Slide 1"></button>
        <button type="button" class="hero-dot h-2 w-8 rounded-full bg-white/40" data-dot="1" aria-label="Slide 2"></button>
        <button type="button" class="hero-dot h-2 w-8 rounded-full bg-white/40" data-dot="2" aria-label="Slide 3"></button>
    </div>
</section>

<script>
(function () {
    var slides = document.querySelectorAll('[data-slide]');
    var dots = document.querySelectorAll('[data-dot]');
    if (!slides.length) return;

    var current = 0;

    function show(index) {
        slides.forEach(function (slide) { slide.classList.add('hidden'); });
        dots.forEach(function (dot) { dot.classList.remove('bg-white'); dot.classList.add('bg-white/40'); });

        slides[index].classList.remove('hidden');
        dots[index].classList.remove('bg-white/40');
        dots[index].classList.add('bg-white');
        current = index;
    }

    dots.forEach(function (dot) {
        dot.addEventListener('click', function () { show(parseInt(dot.dataset.dot, 10)); });
    });

    setInterval(function () { show((current + 1) % slides.length); }, 5000);
})();
</script>

{# ---------- 2. QUICK STATS BAR ---------- #}
<section class="bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <dl class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100">
            <div class="py-8 text-center px-4">
                <dt class="text-sm font-semibold uppercase tracking-wide text-gray-400">Enrolled Students</dt>
                <dd class="mt-2 text-3xl font-black" style="color: {{ brand }};">{{ student_count|default(0) }}</dd>
            </div>
            <div class="py-8 text-center px-4">
                <dt class="text-sm font-semibold uppercase tracking-wide text-gray-400">Focus</dt>
                <dd class="mt-2 text-3xl font-black" style="color: {{ brand }};">360°</dd>
                <dd class="text-xs text-gray-500 -mt-1">Academics &amp; Character</dd>
            </div>
            <div class="py-8 text-center px-4">
                <dt class="text-sm font-semibold uppercase tracking-wide text-gray-400">Environment</dt>
                <dd class="mt-2 text-2xl font-black" style="color: {{ brand }};">Safe</dd>
                <dd class="text-xs text-gray-500 -mt-1">Secure &amp; Caring</dd>
            </div>
            <div class="py-8 text-center px-4">
                <dt class="text-sm font-semibold uppercase tracking-wide text-gray-400">Portal</dt>
                <dd class="mt-2 text-2xl font-black" style="color: {{ brand }};">24/7</dd>
                <dd class="text-xs text-gray-500 -mt-1">Parent Access</dd>
            </div>
        </dl>
    </div>
</section>

{# ---------- 3. WELCOME / ABOUT PREVIEW ---------- #}
<section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
            <p class="text-sm font-bold uppercase tracking-widest" style="color: {{ brand }};">About Us</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-gray-900">Discover {{ school_name }}</h2>
            <p class="mt-4 text-lg text-gray-600">
                We blend strong moral values with a rich, modern curriculum to raise confident, well-rounded leaders of tomorrow.
            </p>
        </div>

        <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm hover:shadow-md transition">
                <div class="h-12 w-12 rounded-xl flex items-center justify-center text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422A12.083 12.083 0 0112 21.5a12.083 12.083 0 01-6.16-10.922L12 14z"/></svg>
                </div>
                <h3 class="mt-5 text-lg font-bold text-gray-900">Academic Excellence</h3>
                <p class="mt-2 text-gray-600 leading-relaxed">A rigorous, child-centred curriculum that challenges learners and builds strong foundations.</p>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm hover:shadow-md transition">
                <div class="h-12 w-12 rounded-xl flex items-center justify-center text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </div>
                <h3 class="mt-5 text-lg font-bold text-gray-900">Character &amp; Values</h3>
                <p class="mt-2 text-gray-600 leading-relaxed">We nurture honesty, respect and responsibility alongside knowledge and skills.</p>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm hover:shadow-md transition">
                <div class="h-12 w-12 rounded-xl flex items-center justify-center text-white" style="background-color: {{ brand }};">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="mt-5 text-lg font-bold text-gray-900">Safe Environment</h3>
                <p class="mt-2 text-gray-600 leading-relaxed">A secure, disciplined campus where every child feels safe, seen and supported.</p>
            </div>
        </div>

        <div class="mt-12 text-center">
            <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}" class="inline-flex items-center font-bold" style="color: {{ brand }};">
                More about our school
                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>
    </div>
</section>

{# ---------- 4. PROGRAMMES ---------- #}
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
            <p class="text-sm font-bold uppercase tracking-widest" style="color: {{ brand }};">Programmes</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-gray-900">Learning at Every Stage</h2>
            <p class="mt-4 text-lg text-gray-600">Age-appropriate learning experiences designed to help each child flourish.</p>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {% set programmes = [
                {'title': 'Early Years', 'desc': 'Play-based learning that develops curiosity and social skills.'},
                {'title': 'Primary', 'desc': 'Strong foundations in literacy, numeracy and discovery.'},
                {'title': 'Junior Secondary', 'desc': 'Critical thinking, leadership and broad subject exposure.'},
                {'title': 'Senior Secondary', 'desc': 'Exam readiness and preparation for higher education.'}
            ] %}
            {% for programme in programmes %}
            <div class="rounded-2xl border border-gray-100 bg-gray-50 p-7 hover:shadow-md transition">
                <span class="text-3xl">{{ loop.index < 4 ? ['🎨','📚','🧭','🎓'][loop.index0] : '🎓' }}</span>
                <h3 class="mt-4 text-lg font-bold text-gray-900">{{ programme.title }}</h3>
                <p class="mt-2 text-sm text-gray-600 leading-relaxed">{{ programme.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ---------- 5. WHY CHOOSE US ---------- #}
<section class="py-20 text-white" style="background: linear-gradient(135deg, {{ brand }}, {{ brand }}d9);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-12 lg:grid-cols-2 items-center">
        <div>
            <p class="text-sm font-bold uppercase tracking-widest text-white/70">Why Choose Us</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold">The {{ school_name }} Difference</h2>
            <p class="mt-4 text-white/80 leading-relaxed">
                Parents choose us because we combine strong academics with genuine care for every child.
            </p>
            <ul class="mt-8 space-y-4">
                {% for point in ['Qualified and caring teachers', 'Modern, well-equipped classrooms', 'Regular progress reports to parents', 'Rich co-curricular activities', 'Discipline with love and respect'] %}
                <li class="flex items-start gap-3">
                    <svg class="h-6 w-6 flex-shrink-0 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span class="font-medium">{{ point }}</span>
                </li>
                {% endfor %}
            </ul>
        </div>
        <div class="bg-white/10 rounded-3xl p-8 backdrop-blur">
            <svg class="h-10 w-10 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/></svg>
            <blockquote class="mt-6 text-xl sm:text-2xl font-medium leading-relaxed text-white">
                “Education is the most powerful weapon which you can use to change the world.”
            </blockquote>
            <p class="mt-4 text-white/70 font-semibold">— Our Guiding Principle</p>
        </div>
    </div>
</section>

{# ---------- 6. CONTACT / CTA ---------- #}
<section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-2 items-start">
        <div class="bg-white rounded-3xl border border-gray-100 p-9 shadow-sm">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Visit {{ school_name }}</h2>
            <p class="mt-3 text-gray-600">We would love to show you around our campus and discuss your child's future.</p>

            <ul class="mt-8 space-y-5">
                {% if school_address %}
                <li class="flex gap-4">
                    <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl text-white" style="background-color: {{ brand }};">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-gray-400 uppercase">Address</p>
                        <p class="mt-1 text-gray-800">{{ school_address }}</p>
                    </div>
                </li>
                {% endif %}

                {% if school_phone %}
                <li class="flex gap-4">
                    <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl text-white" style="background-color: {{ brand }};">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-gray-400 uppercase">Phone</p>
                        <p class="mt-1 text-gray-800">{{ school_phone }}</p>
                    </div>
                </li>
                {% endif %}

                {% if school_email %}
                <li class="flex gap-4">
                    <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl text-white" style="background-color: {{ brand }};">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-gray-400 uppercase">Email</p>
                        <a href="mailto:{{ school_email }}" class="mt-1 block text-blue-600 hover:underline">{{ school_email }}</a>
                    </div>
                </li>
                {% endif %}
            </ul>

            <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}" class="mt-8 inline-flex items-center justify-center w-full px-6 py-3.5 rounded-full text-white font-bold shadow-lg hover:opacity-90 transition" style="background-color: {{ brand }};">
                Get in Touch
            </a>
        </div>

        <div class="bg-white rounded-3xl border border-gray-100 p-9 shadow-sm text-center">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Ready to Enrol?</h2>
            <p class="mt-3 text-gray-600">Start your child's journey with us today. Applying is quick and simple.</p>
            <ol class="mt-8 max-w-sm mx-auto space-y-4 text-left">
                <li class="flex items-center gap-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full text-white font-bold" style="background-color: {{ brand }};">1</span>
                    <span class="text-gray-700">Visit the admissions page</span>
                </li>
                <li class="flex items-center gap-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full text-white font-bold" style="background-color: {{ brand }};">2</span>
                    <span class="text-gray-700">Obtain and submit the application form</span>
                </li>
                <li class="flex items-center gap-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full text-white font-bold" style="background-color: {{ brand }};">3</span>
                    <span class="text-gray-700">Complete assessment and enrollment</span>
                </li>
            </ol>
            <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="mt-8 inline-flex items-center justify-center w-full px-6 py-3.5 rounded-full text-white font-bold shadow-lg hover:opacity-90 transition" style="background-color: {{ brand }};">
                Start Application
            </a>
            <p class="mt-4 text-sm text-gray-500">Existing parents can access the portal anytime.</p>
            <a href="{{ path('app_login') }}" class="mt-1 inline-flex items-center text-sm font-semibold" style="color: {{ brand }};">
                Parent / Staff Login
                <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>
    </div>
</section>

{% endblock %}