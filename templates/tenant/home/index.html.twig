{% extends 'tenant/home/layout.html.twig' %}

{% block title %}{{ school_name }} — {% if school_motto %}{{ school_motto }}{% else %}Admissions &amp; Portal{% endif %}{% endblock %}

{% block tenant_public_content %}

{#
    ═══ HERO — one static panel, one <h1> ═══

    The carousel this replaces had THREE <h1>s, changed under the reader's thumb
    every five seconds with no pause control, and said the same thing three
    times (SCHOOL-PUBLIC-SITE.md §2.2). A parent now gets one photograph, the
    school's name, and the two actions that matter: apply, or call.
#}
<section class="relative isolate overflow-hidden"
         style="background-color: {{ brand_ink }};">
    {% if hero_image_filename %}
        {# A real <img>, not a CSS background: this is the LCP element, and a
           background-image is discovered only after the stylesheet. #}
        <img src="{{ asset('uploads/hero/' ~ hero_image_filename) }}"
             alt="{{ school_name }}"
             width="1600" height="900" fetchpriority="high" decoding="async"
             class="absolute inset-0 -z-10 h-full w-full object-cover">
        <div class="absolute inset-0 -z-10" style="background-color: {{ brand_ink }}; mix-blend-mode: multiply; opacity: .78;"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/45 via-black/10 to-transparent"></div>
    {% endif %}

    <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/80">Welcome to</p>
        <h1 class="mt-3 break-words text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
            {{ school_name }}
        </h1>
        {% if school_tag %}
            <p class="mt-2 text-xs font-semibold uppercase tracking-[0.3em] text-white/80">{{ school_tag }}</p>
        {% endif %}

        {% if school_motto %}
            <p class="mx-auto mt-4 max-w-2xl text-base text-white/90 sm:text-lg">{{ school_motto }}</p>
        {% elseif hero_tagline %}
            <p class="mx-auto mt-4 max-w-2xl text-base text-white/90 sm:text-lg">{{ hero_tagline }}</p>
        {% endif %}

        {# Trust line: facts we actually hold, never a count of pupils. #}
        <p class="mt-4 text-sm text-white/75">
            {% if school_address %}{{ school_address }}{% endif %}
            {% if school_address and school_phone %} · {% endif %}
            {% if school_phone %}{{ school_phone }}{% endif %}
            {% if school.foundedYear %} · Est. {{ school.foundedYear }}{% endif %}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a href="{{ apply_url }}"
               class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg bg-white px-6 text-base font-bold text-ink-900 shadow-lg transition hover:bg-ink-50 sm:w-auto">
                {% if school is defined and school and school.applicationsOpen %}Apply online{% else %}Apply for admission{% endif %}
            </a>
            {% if tel_url %}
                <a href="{{ tel_url }}"
                   class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg border border-white/60 px-6 text-base font-semibold text-white transition hover:bg-white/10 sm:w-auto">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    Call the school
                </a>
            {% endif %}
        </div>
    </div>
</section>

{#
    ═══ QUICK ACTIONS ═══
    One tap to the four things a parent actually wants. Each is a full-width
    thumb target on a phone and shrinks to a normal button from sm up.
#}
{% if tel_url or whatsapp_url or directions_url %}
<section class="border-b border-ink-200 bg-white">
    <div class="mx-auto grid max-w-5xl grid-cols-2 gap-2 px-4 py-4 sm:grid-cols-4 sm:px-6 lg:px-8">
        {% if tel_url %}
            <a href="{{ tel_url }}" class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call
            </a>
        {% endif %}
        {% if whatsapp_url %}
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.05-.52-.099-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.893c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a12.03 12.03 0 005.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.896A11.82 11.82 0 0020.52 3.45z"/></svg>
                WhatsApp
            </a>
        {% endif %}
        {% if directions_url %}
            <a href="{{ directions_url }}" target="_blank" rel="noopener" class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Directions
            </a>
        {% endif %}
        <a href="{{ path('app_login') }}" class="flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg border border-ink-200 text-sm font-semibold text-ink-800 transition hover:border-ink-300 hover:bg-ink-50">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Portal
        </a>
    </div>
</section>
{% endif %}

{# ═══ ABOUT PREVIEW ═══ #}
<section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color: {{ brand }};">About us</p>
        <h2 class="mt-2 text-2xl font-extrabold text-ink-900 sm:text-3xl">Discover {{ school_name }}</h2>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-700">
            {% if about_content %}
                {{ about_content|striptags|slice(0, 320) }}{% if about_content|length > 320 %}…{% endif %}
            {% else %}
                We blend strong moral values with a rich, modern curriculum to raise confident, well-rounded
                learners. Come and see the school — the best way to judge a school is to stand in it.
            {% endif %}
        </p>
        <a href="{{ path('app_tenant_about', {'subdomain': subdomain}) }}"
           class="mt-5 inline-flex min-h-[44px] items-center font-bold" style="color: {{ brand }};">
            More about our school <span aria-hidden="true" class="ml-1">→</span>
        </a>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
            {% for card in [
                {'title': 'Academic excellence', 'desc': 'A rigorous, child-centred curriculum that builds strong foundations.'},
                {'title': 'Character & values', 'desc': 'Honesty, respect and responsibility, taught alongside knowledge.'},
                {'title': 'A safe environment', 'desc': 'A secure, disciplined campus where every child is seen and supported.'}
            ] %}
                <div class="rounded-xl border border-ink-200 p-5">
                    <span class="block h-1 w-8 rounded-full" style="background-color: {{ brand }};" aria-hidden="true"></span>
                    <h3 class="mt-3 text-base font-bold text-ink-900">{{ card.title }}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-ink-600">{{ card.desc }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ═══ PROGRAMMES ═══ #}
<section class="bg-ink-50 py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color: {{ brand }};">Programmes</p>
        <h2 class="mt-2 text-2xl font-extrabold text-ink-900 sm:text-3xl">Learning at every stage</h2>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for programme in [
                {'title': 'Early Years', 'desc': 'Play-based learning that grows curiosity and social confidence.'},
                {'title': 'Primary', 'desc': 'Strong foundations in literacy, numeracy and discovery.'},
                {'title': 'Junior Secondary', 'desc': 'Critical thinking, leadership and broad subject exposure.'},
                {'title': 'Senior Secondary', 'desc': 'Exam readiness and preparation for higher education.'}
            ] %}
                <div class="rounded-xl border border-ink-200 bg-white p-5">
                    <h3 class="text-base font-bold text-ink-900">{{ programme.title }}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-ink-600">{{ programme.desc }}</p>
                </div>
            {% endfor %}
        </div>

        <a href="{{ path('app_tenant_academics', {'subdomain': subdomain}) }}"
           class="mt-6 inline-flex min-h-[44px] items-center font-bold"
           style="color: {{ brand_ink }};">
            See every class we run <span aria-hidden="true" class="ml-1">&rarr;</span>
        </a>
    </div>
</section>

{# ═══ ADMISSIONS CTA ═══ #}
<section class="py-14 text-white sm:py-20" style="background-color: {{ brand_ink }};">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold sm:text-3xl">Ready to enrol?</h2>
        <p class="mt-3 text-base text-white/85">
            {% if school is defined and school and school.applicationFeeAmount %}
                Applying takes a few minutes. The application fee is
                ₦{{ school.applicationFeeAmount|number_format(0) }}.
            {% else %}
                Applying takes a few minutes — start online and we will contact you about the next step.
            {% endif %}
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a href="{{ apply_url }}"
               class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg bg-white px-6 text-base font-bold text-ink-900 shadow-lg transition hover:bg-ink-50 sm:w-auto">
                Start an application
            </a>
            {% if tel_url %}
                <a href="{{ tel_url }}"
                   class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg border border-white/60 px-6 text-base font-semibold text-white transition hover:bg-white/10 sm:w-auto">
                    Call {{ school_phone }}
                </a>
            {% endif %}
        </div>
    </div>
</section>

{# ═══ CONTACT ═══ #}
<section class="bg-white py-14 sm:py-20">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div>
            <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">Visit {{ school_name }}</h2>
            <p class="mt-3 text-base text-ink-700">We would be glad to show you around and answer your questions.</p>

            <ul class="mt-6 space-y-3 text-sm">
                {% if school_address %}
                    <li class="break-words text-ink-800"><span class="font-semibold text-ink-500">Address:</span> {{ school_address }}</li>
                {% endif %}
                {% if school_phone %}
                    <li><span class="font-semibold text-ink-500">Phone:</span>
                        <a href="{{ tel_url }}" class="font-semibold text-ink-900 underline underline-offset-2">{{ school_phone }}</a>
                    </li>
                {% endif %}
                {% if school_email %}
                    <li class="break-words"><span class="font-semibold text-ink-500">Email:</span>
                        <a href="mailto:{{ school_email }}" class="font-semibold text-ink-900 underline underline-offset-2">{{ school_email }}</a>
                    </li>
                {% endif %}
            </ul>

            <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}"
               class="mt-6 inline-flex min-h-[44px] items-center font-bold" style="color: {{ brand }};">
                Contact the school <span aria-hidden="true" class="ml-1">→</span>
            </a>
        </div>

        {% if school_map %}
            <div class="overflow-hidden rounded-xl border border-ink-200">
                <iframe src="{{ school_map }}" title="Map showing {{ school_name }}"
                        width="100%" height="320" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        style="border:0; display:block;"></iframe>
            </div>
        {% endif %}
    </div>
</section>

{% endblock %}
