{% extends 'tenant/home/layout.html.twig' %}

{% block title %}About {{ school_name }}{% endblock %}

{% block tenant_public_content %}

{# ---------- PAGE HEADER ---------- #}
<section class="border-b border-ink-200 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-500">Our story</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
            About {{ school_name }}
        </h1>
        {% if school_motto %}
            <p class="mt-3 max-w-2xl text-lg italic text-ink-600 sm:text-xl">“{{ school_motto }}”</p>
        {% endif %}
        {% if school.foundedYear %}
            <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-ink-500">
                Established {{ school.foundedYear }}
            </p>
        {% endif %}
    </div>
</section>

{# ---------- WHO WE ARE ---------- #}
<section class="bg-white py-12 sm:py-16">
    <div class="mx-auto grid max-w-6xl items-start gap-8 px-4 sm:px-6 lg:grid-cols-3 lg:px-8">
        <div class="lg:col-span-2">
            <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">A place where children thrive</h2>

            {% if about_content %}
                <div class="mt-4 space-y-3 text-base leading-relaxed text-ink-700">
                    {{ about_content|nl2br }}
                </div>
            {% else %}
                <p class="mt-4 text-base leading-relaxed text-ink-700">
                    {{ school_name }} is a learning community built on strong academics, clear values
                    and the kind of personal attention that only a school that knows its children can
                    give. Every child is known by name, and every parent has someone to talk to.
                </p>
                <p class="mt-3 text-base leading-relaxed text-ink-700">
                    Come and see the school. The best way to judge a school is to stand in it.
                </p>
            {% endif %}

            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
                <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}"
                   class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg px-5 text-sm font-bold text-white transition hover:opacity-90 sm:w-auto"
                   style="background-color: {{ brand_ink }};">
                    Plan a visit
                </a>
                <a href="{{ path('app_tenant_academics', {'subdomain': subdomain}) }}"
                   class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-800 transition hover:bg-ink-50 sm:w-auto">
                    See our classes
                </a>
            </div>
        </div>

        <div class="text-center lg:text-left">
            {% if school_logo %}
                <img src="{{ asset('uploads/logos/' ~ school_logo) }}" alt="{{ school_name }}"
                     width="192" height="192" loading="lazy"
                     class="mx-auto h-40 w-40 rounded-2xl border border-ink-200 bg-white object-contain p-4 lg:mx-0">
            {% else %}
                <span class="mx-auto grid h-40 w-40 place-items-center rounded-2xl text-6xl font-black text-white lg:mx-0"
                      style="background-color: {{ brand_ink }};" aria-hidden="true">{{ school_name|first|upper }}</span>
            {% endif %}
        </div>
    </div>
</section>

{# ---------- VALUES ---------- #}
<section class="border-y border-ink-100 bg-ink-50 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">What guides us</h2>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {% for value in school.core_values %}
                <div class="rounded-xl border border-ink-200 bg-white p-5">
                    <span class="grid h-9 w-9 place-items-center rounded-full text-sm font-bold text-white"
                          style="background-color: {{ brand_ink }};" aria-hidden="true">{{ value.title|first }}</span>
                    <h3 class="mt-3 text-base font-bold text-ink-900">{{ value.title }}</h3>
                    {% if value.desc %}
                        <p class="mt-1 text-sm leading-relaxed text-ink-600">{{ value.desc }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ---------- FACILITIES ---------- #}
{% if school.facilities_list is not empty %}
    <section class="bg-white py-12 sm:py-16">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">What we have</h2>
            <ul class="mt-5 grid max-w-3xl gap-2 sm:grid-cols-2">
                {% for facility in school.facilities_list %}
                    <li class="flex items-start gap-3 rounded-lg border border-ink-200 px-4 py-3">
                        <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: {{ brand_ink }};">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="break-words text-sm font-medium text-ink-800">{{ facility }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}

{# ---------- FIND US ---------- #}
<section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">Where to find us</h2>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <div>
                <dl class="space-y-4 text-sm">
                    {% if school_address %}
                        <div>
                            <dt class="font-semibold text-ink-500">Address</dt>
                            <dd class="mt-0.5 break-words text-ink-900">{{ school_address }}</dd>
                        </div>
                    {% endif %}
                    {% if school_phone %}
                        <div>
                            <dt class="font-semibold text-ink-500">Phone</dt>
                            <dd class="mt-0.5">
                                {% if tel_url %}
                                    <a href="{{ tel_url }}" class="font-semibold text-ink-900 underline underline-offset-2">{{ school_phone }}</a>
                                {% else %}
                                    <span class="text-ink-900">{{ school_phone }}</span>
                                {% endif %}
                            </dd>
                        </div>
                    {% endif %}
                    {% if school_email %}
                        <div>
                            <dt class="font-semibold text-ink-500">Email</dt>
                            <dd class="mt-0.5">
                                <a href="mailto:{{ school_email }}" class="break-words font-semibold text-ink-900 underline underline-offset-2">{{ school_email }}</a>
                            </dd>
                        </div>
                    {% endif %}
                    {% if school.principalName %}
                        <div>
                            <dt class="font-semibold text-ink-500">{{ school.principalTitle ?: 'Head of school' }}</dt>
                            <dd class="mt-0.5 break-words text-ink-900">{{ school.principalName }}</dd>
                        </div>
                    {% endif %}
                </dl>

                <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                    {% if directions_url %}
                        <a href="{{ directions_url }}" target="_blank" rel="noopener"
                           class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-800 transition hover:bg-ink-50 sm:w-auto">
                            Get directions
                        </a>
                    {% endif %}
                    {% if whatsapp_url %}
                        <a href="{{ whatsapp_url }}" target="_blank" rel="noopener"
                           class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-800 transition hover:bg-ink-50 sm:w-auto">
                            WhatsApp
                        </a>
                    {% endif %}
                </div>
            </div>

            {% if school_map %}
                <div class="overflow-hidden rounded-xl border border-ink-200">
                    {{ school_map|raw }}
                </div>
            {% endif %}
        </div>
    </div>
</section>

{# ---------- CTA ---------- #}
<section class="py-12 text-white sm:py-16" style="background-color: {{ brand_ink }};">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold sm:text-3xl">Join {{ school_name }}</h2>
        <p class="mt-3 text-base text-white/85">
            Applications are made online, from your phone, and you will be told by SMS at every step.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a href="{{ apply_url }}"
               class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg bg-white px-6 text-base font-bold text-ink-900 shadow-lg transition hover:bg-ink-50 sm:w-auto">
                Apply online
            </a>
            <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}"
               class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg border border-white/60 px-6 text-base font-semibold text-white transition hover:bg-white/10 sm:w-auto">
                Fees and admissions
            </a>
        </div>
    </div>
</section>

{% endblock %}