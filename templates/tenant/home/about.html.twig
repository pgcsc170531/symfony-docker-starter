{% extends 'tenant/home/layout.html.twig' %}

{% block title %}About {{ school_name }}{% endblock %}

{% block tenant_public_content %}

{# ---------- PAGE HEADER ---------- #}
<section class="relative overflow-hidden text-white" style="background: linear-gradient(135deg, {{ brand }}, {{ brand }}d9);">
    <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Our Story</p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight">About {{ school_name }}</h1>
        {% if school_motto %}
            <p class="mx-auto mt-5 max-w-2xl text-lg sm:text-xl italic text-white/90">“{{ school_motto }}”</p>
        {% endif %}
    </div>
</section>

{# ---------- WHO WE ARE ---------- #}
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-12 lg:grid-cols-2 items-center">
        <div>
            <p class="text-sm font-bold uppercase tracking-widest" style="color: {{ brand }};">Who We Are</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-gray-900">A Place Where Children Thrive</h2>
            <p class="mt-5 text-lg text-gray-600 leading-relaxed">
                {{ school_name }} is a nurturing learning community dedicated to raising confident,
                well-rounded learners. We combine strong academics with the values of integrity,
                discipline and compassion.
            </p>
            <a href="{{ path('app_tenant_contact', {'subdomain': subdomain}) }}" class="mt-6 inline-flex items-center font-bold" style="color: {{ brand }};">
                Plan a visit
                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>

        {% if school_logo %}
            <div class="text-center">
                <img src="{{ asset('uploads/logos/' ~ school_logo) }}" alt="{{ school_name }}" class="mx-auto h-48 w-48 rounded-3xl bg-white object-contain border border-gray-100 shadow-lg p-6" />
            </div>
        {% else %}
            <div class="text-center">
                <span class="mx-auto flex h-48 w-48 items-center justify-center rounded-3xl text-7xl font-black text-white shadow-lg" style="background: linear-gradient(135deg, {{ brand }}, {{ brand }}d9);">{{ school_name|first|upper }}</span>
            </div>
        {% endif %}
    </div>
</section>

{# ---------- VALUES ---------- #}
<section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
            <p class="text-sm font-bold uppercase tracking-widest" style="color: {{ brand }};">Our Values</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-gray-900">What Guides Us</h2>
        </div>

        <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {% set values = [
                {'title': 'Integrity', 'desc': 'We do the right thing even when no one is watching.'},
                {'title': 'Excellence', 'desc': 'We strive for the highest standards in all we do.'},
                {'title': 'Respect', 'desc': 'We honour every child, parent and community member.'},
                {'title': 'Service', 'desc': 'We raise leaders who serve others with love.'}
            ] %}
            {% for value in values %}
            <div class="bg-white rounded-2xl border border-gray-100 p-8 text-center shadow-sm hover:shadow-md transition">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full text-white font-black text-xl" style="background-color: {{ brand }};">{{ value.title|first }}</span>
                <h3 class="mt-5 text-lg font-bold text-gray-900">{{ value.title }}</h3>
                <p class="mt-2 text-sm text-gray-600 leading-relaxed">{{ value.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ---------- CONTACT DETAILS ---------- #}
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 text-center mb-12">Get in Touch</h2>
        <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {% if school_address %}
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <dt class="text-sm font-semibold uppercase text-gray-400">Address</dt>
                <dd class="mt-2 text-gray-800">{{ school_address }}</dd>
            </div>
            {% endif %}

            {% if school_phone %}
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <dt class="text-sm font-semibold uppercase text-gray-400">Phone</dt>
                <dd class="mt-2 text-gray-800">{{ school_phone }}</dd>
            </div>
            {% endif %}

            {% if school_email %}
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <dt class="text-sm font-semibold uppercase text-gray-400">Email</dt>
                <dd class="mt-2"><a href="mailto:{{ school_email }}" class="text-blue-600 hover:underline">{{ school_email }}</a></dd>
            </div>
            {% endif %}

            {% if school_website %}
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <dt class="text-sm font-semibold uppercase text-gray-400">Website</dt>
                <dd class="mt-2"><a href="{{ school_website }}" target="_blank" class="text-blue-600 hover:underline">{{ school_website }}</a></dd>
            </div>
            {% endif %}

            {% if school_map %}
            <section class="py-20 bg-gray-50">
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 text-center mb-12">Find Us</h2>
                    <div class="aspect-video rounded-3xl overflow-hidden border border-gray-200 shadow-sm bg-white">
                        {{ school_map|raw }}
                    </div>
                </div>
            </section>
            {% endif %}
        </dl>

        <div class="mt-12 text-center">
            <a href="{{ path('app_tenant_admissions', {'subdomain': subdomain}) }}" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full text-white font-bold shadow-lg hover:opacity-90 transition" style="background-color: {{ brand }};">
                Start the Admissions Journey
            </a>
        </div>
    </div>
</section>

{% endblock %}