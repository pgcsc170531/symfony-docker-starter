{% extends 'base.html.twig' %}

{% block title %}Fees Import{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:py-6">

    <div class="mb-5">
        <a href="{{ path('app_tenant_fee_schedule') }}"
           class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Fee Schedule</a>
        <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Opening-balance fees import</h1>
        <p class="mt-1 max-w-3xl text-sm leading-relaxed text-ink-600">
            Import fees the school has already collected by hand. Edus computes the term bill from the fee schedule,
            posts the amount already paid, and leaves the outstanding balance on the family statement.
        </p>
    </div>

    {% if csv_errors is not empty %}
        <div class="mb-5 rounded-xl border border-failed/30 bg-failed/5 p-4" role="alert">
            <p class="text-sm font-bold text-failed">Nothing was imported.</p>
            <ul class="mt-2 space-y-1 text-sm text-ink-800">
                {% for error in csv_errors %}
                    <li class="break-words">{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

        {# ── Upload ───────────────────────────────────────────────────── #}
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-6 lg:col-span-2">
            <h2 class="text-base font-bold text-ink-900">1. Upload the CSV</h2>
            <p class="mt-1 text-sm text-ink-600">
                The file must have one row per {{ learner }}. Nothing is posted until you review the preview and confirm.
            </p>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'mt-4'}}) }}
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {{ form_row(form.term) }}
                    {{ form_row(form.csvFile) }}
                </div>

                <div class="mt-4 rounded-lg border border-accent-200 bg-accent-50 p-3 text-xs leading-relaxed text-ink-700">
                    <strong class="text-ink-900">Columns required:</strong>
                    Admission Number, Surname, First Name, Class Name, Student Type (NEW/RETURNING),
                    Amount Paid. Optional: Payment Date, Payment Method, Payment Reference, Note.
                    <br>
                    <strong class="text-ink-900">Amount Paid is the total already collected</strong> for the term —
                    not an instalment. A returning pupil is not billed the one-time new-intake items.
                </div>

                <button type="submit"
                        class="mt-5 min-h-[44px] w-full rounded-lg bg-accent-600 px-8 font-bold text-white shadow-sm hover:bg-accent-700 sm:w-auto">
                    Preview import
                </button>
            {{ form_end(form) }}
        </section>

        {# ── Template download ────────────────────────────────────────── #}
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-6">
            <h2 class="text-base font-bold text-ink-900">Build the file from a class roster</h2>
            <p class="mt-1 text-sm text-ink-600">
                Start from the class list, so no pupil is retyped. The fee columns are left for the bursary.
            </p>

            <form method="get" action="{{ path('app_tenant_fee_import_template') }}" class="mt-4 space-y-3">
                <div>
                    <label for="template-class" class="block text-sm font-semibold text-ink-700">Class</label>
                    <select id="template-class" name="classroom" required
                            class="mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500">
                        <option value="">Choose a class…</option>
                        {% for classroom in classrooms %}
                            <option value="{{ classroom.id }}">{{ classroom.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit"
                        class="min-h-[44px] w-full rounded-lg border border-accent-300 bg-white px-4 text-sm font-bold text-accent-700 hover:bg-accent-50">
                    Download roster CSV
                </button>
            </form>

            <p class="mt-3 text-xs leading-relaxed text-ink-500">
                If the class has no {{ learner.plural }} yet, download a blank template and type the rows.
            </p>
        </section>
    </div>

    {# ── Recent batches ──────────────────────────────────────────────── #}
    <section class="mt-5 rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-6">
        <h2 class="text-base font-bold text-ink-900">Recent imports</h2>

        {% if recent_batches is empty %}
            <p class="mt-2 text-sm text-ink-600">No fees import has been uploaded yet.</p>
        {% else %}
            <ul class="mt-3 divide-y divide-ink-100">
                {% for batch in recent_batches %}
                    <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <a href="{{ path('app_tenant_fee_import_batch', {batch: batch.id}) }}"
                               class="inline-flex min-h-[44px] items-center break-words text-sm font-bold text-accent-700 hover:underline">
                                Batch #{{ batch.id }} · {{ batch.term ? batch.term.name : 'No term' }}
                            </a>
                            <p class="text-xs text-ink-500">
                                {{ batch.originalFilename ?: 'CSV' }} · {{ batch.createdAt|date('j M Y, H:i') }}
                                · {{ batch.rowCount }} row{{ batch.rowCount == 1 ? '' : 's' }}
                            </p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            {% if batch.isPosted %}
                                <span class="rounded-full bg-paid/10 px-2 py-0.5 text-[11px] font-bold text-paid">Posted</span>
                            {% elseif batch.isRolledBack %}
                                <span class="rounded-full bg-failed/10 px-2 py-0.5 text-[11px] font-bold text-failed">Reversed</span>
                            {% else %}
                                <span class="rounded-full bg-pending/10 px-2 py-0.5 text-[11px] font-bold text-pending">Preview</span>
                            {% endif %}
                            <span class="font-mono text-xs text-ink-600">₦{{ batch.totalPaid|number_format(2) }} paid</span>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
