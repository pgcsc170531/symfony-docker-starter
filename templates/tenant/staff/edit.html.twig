{% extends 'base.html.twig' %}

{% block title %}Edit staff{% endblock %}

{% block body %}
<div class="px-4 py-4">

    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent-600">Staff</p>
            <h1 class="text-2xl font-semibold tracking-tight text-ink-900">
                {{ staffUser.fullName ?: staffUser.email }}
            </h1>
            <p class="break-words text-sm text-ink-500">
                {{ staffUser.email }}{% if isSelf %} &middot; your own account{% endif %}
            </p>
        </div>
        <a href="{{ path('app_tenant_staff_index') }}"
           class="inline-flex min-h-[44px] shrink-0 items-center text-sm font-semibold text-accent-600 hover:text-accent-700">
            &larr; Back to directory
        </a>
    </div>

    <div class="max-w-xl rounded-lg border border-ink-200 bg-white p-5 shadow-card">
        {{ form_start(form) }}
            <div class="space-y-4">
                <div>
                    {{ form_label(form.fullName, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.fullName, {'attr': {'class': 'min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200'}}) }}
                    {{ form_errors(form.fullName) }}
                </div>

                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                {# Phone, home address and staff number live on the Staff profile.
                   Rendered explicitly here so they sit with the other identity
                   fields rather than after the Save button (form_end's form_rest
                   would otherwise drop them at the bottom of the form). #}
                <div>
                    {{ form_label(form.phone, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.phone, {'attr': {'class': 'min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200'}}) }}
                    {{ form_errors(form.phone) }}
                </div>

                <div>
                    {{ form_label(form.address, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.address, {'attr': {'class': 'w-full rounded-lg border border-ink-200 px-3 py-2 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200'}}) }}
                    {{ form_errors(form.address) }}
                </div>

                <div>
                    {{ form_label(form.employeeNumber, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.employeeNumber, {'attr': {'class': 'min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200'}}) }}
                    {{ form_errors(form.employeeNumber) }}
                </div>

                <div>
                    {{ form_label(form.roles, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.roles, {'attr': {'class': 'min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 disabled:bg-ink-50 disabled:text-ink-500'}}) }}
                    {% if form.roles.vars.help %}
                        <p class="mt-1 text-xs leading-relaxed text-ink-500">{{ form.roles.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(form.roles) }}
                </div>

                <div>
                    {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'mb-1 block text-sm font-semibold text-ink-800'}}) }}
                    {{ form_widget(form.plainPassword, {'attr': {'class': 'min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200'}}) }}
                    {% if form.plainPassword.vars.help %}
                        <p class="mt-1 text-xs leading-relaxed text-ink-500">{{ form.plainPassword.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(form.plainPassword) }}
                </div>
            </div>

            <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                <button type="submit"
                        class="min-h-[44px] w-full rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-accent-700 sm:w-auto">
                    Save changes
                </button>
                <a href="{{ path('app_tenant_staff_index') }}"
                   class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-200 px-5 text-sm font-semibold text-ink-700 hover:bg-ink-50 sm:w-auto">
                    Cancel
                </a>
            </div>
        {{ form_end(form) }}
    </div>

    {% if isSelf %}
        <p class="mt-4 max-w-xl rounded-lg border border-ink-200 bg-ink-50 p-4 text-sm leading-relaxed text-ink-600">
            Your own role is locked so you cannot remove your access by mistake.
            Ask the school owner to change it if it is wrong.
        </p>
    {% endif %}

</div>
{% endblock %}
