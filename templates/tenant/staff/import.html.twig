{% extends 'base.html.twig' %}

{% block title %}Import Staff{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="mb-6">
        <a href="{{ path('app_tenant_staff_index') }}"
           class="inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-700 hover:underline">
            &larr; Back to the staff directory
        </a>
        <h1 class="mt-1 text-xl font-bold text-ink-900 sm:text-2xl">Import staff from a CSV file</h1>
        <p class="mt-1 text-sm text-ink-600">
            One file creates every account: login, staff profile and role. A file of any size is read
            in batches, so a thousand rows will not break the upload.
        </p>
    </div>

    {# ── How it works ────────────────────────────────────────────────── #}
    <section class="mb-6 rounded-lg bg-white p-4 shadow-card sm:p-6">
        <h2 class="font-semibold text-ink-900">Before you upload</h2>

        <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm text-ink-700">
            <li>
                <a href="{{ path('app_tenant_staff_import_template') }}" class="font-semibold text-accent-700 underline">
                    Download the template
                </a>
                — it has the exact column headings.
            </li>
            <li>Fill one row per staff member.</li>
            <li>Upload it below. Nothing is created until you submit.</li>
        </ol>

        <div class="mt-4 overflow-x-auto rounded-lg border border-ink-200">
            <table class="w-full min-w-[640px] text-sm">
                <thead class="bg-ink-50 text-left text-xs uppercase tracking-wide text-ink-500">
                    <tr>
                        {% for column in columns %}
                            <th class="p-2 font-semibold">{{ column }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody class="text-ink-700">
                    <tr class="border-t border-ink-100">
                        <td class="p-2">Aisha Bello</td>
                        <td class="p-2">08031234567</td>
                        <td class="p-2 text-ink-400">blank</td>
                        <td class="p-2">12 Kofar Kaura, Katsina</td>
                        <td class="p-2">Class Teacher</td>
                        <td class="p-2">STF-001</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <dl class="mt-4 space-y-2 text-sm text-ink-700">
            <div>
                <dt class="font-semibold text-ink-900">Phone or email — one becomes the login</dt>
                <dd class="mt-0.5">
                    Leave <em>Email</em> blank and the phone number becomes the address, e.g.
                    <span class="break-all font-mono text-xs">08031234567@edus.ng</span>.
                </dd>
            </div>
            <div>
                <dt class="font-semibold text-ink-900">Job Title</dt>
                <dd class="mt-0.5">
                    Leave it blank for a class teacher. Recognised: teacher, bursar, store keeper,
                    admission officer, administrator/principal.
                </dd>
            </div>
            <div>
                <dt class="font-semibold text-ink-900">Password</dt>
                <dd class="mt-0.5">
                    Everyone starts with <strong class="font-mono">{{ default_password }}</strong> and is
                    asked to choose their own the first time they sign in.
                </dd>
            </div>
            <div>
                <dt class="font-semibold text-ink-900">Duplicates</dt>
                <dd class="mt-0.5">
                    A row whose login already exists is skipped, not merged — the rest of the file still lands.
                </dd>
            </div>
        </dl>
    </section>

    {# ── Upload ──────────────────────────────────────────────────────── #}
    <section class="mb-6 rounded-lg bg-white p-4 shadow-card sm:p-6">
        <h2 class="font-semibold text-ink-900">Upload</h2>

        <form method="post" enctype="multipart/form-data"
              action="{{ path('app_tenant_staff_import') }}" class="mt-3 flex flex-col gap-3">
            <input type="hidden" name="_token" value="{{ csrf_token('staff_import') }}">

            <label for="staff-csv" class="text-sm font-medium text-ink-800">CSV file</label>
            <input id="staff-csv" type="file" name="csv_file" accept=".csv,text/csv" required
                   class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm text-ink-900 file:mr-3 file:rounded-md file:border-0 file:bg-accent-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-accent-700">

            <button type="submit"
                    class="min-h-[44px] w-full rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-accent-700 sm:w-auto">
                Upload and create accounts
            </button>
        </form>
    </section>

    {# ── What happened ───────────────────────────────────────────────── #}
    {% if result %}
        <section class="rounded-lg bg-white p-4 shadow-card sm:p-6">
            <h2 class="font-semibold text-ink-900">Import report</h2>

            <div class="mt-3 grid grid-cols-3 gap-2 text-center">
                <div class="rounded-lg bg-ink-50 p-3">
                    <p class="text-2xl font-bold tabular text-ink-900">{{ result.rows }}</p>
                    <p class="text-xs uppercase tracking-wide text-ink-500">Rows read</p>
                </div>
                <div class="rounded-lg bg-paid/10 p-3">
                    <p class="text-2xl font-bold tabular text-paid">{{ result.created }}</p>
                    <p class="text-xs uppercase tracking-wide text-ink-500">Created</p>
                </div>
                <div class="rounded-lg {{ result.skippedCount > 0 ? 'bg-failed/10' : 'bg-ink-50' }} p-3">
                    <p class="text-2xl font-bold tabular {{ result.skippedCount > 0 ? 'text-failed' : 'text-ink-900' }}">{{ result.skippedCount }}</p>
                    <p class="text-xs uppercase tracking-wide text-ink-500">Skipped</p>
                </div>
            </div>

            {% if result.skippedCount > 0 %}
                <h3 class="mt-4 text-sm font-semibold text-ink-900">Rows that were left alone</h3>
                <ul class="mt-1 max-h-64 space-y-1 overflow-y-auto rounded-lg border border-ink-200 bg-ink-50 p-3 text-sm text-ink-700">
                    {% for message in result.skipped %}
                        <li class="break-words">{{ message }}</li>
                    {% endfor %}
                </ul>
                <p class="mt-2 text-xs text-ink-500">
                    Fix those rows and upload just that file again — the accounts already created are skipped automatically.
                </p>
            {% endif %}

            {% if result.created > 0 %}
                <p class="mt-4 text-sm text-ink-700">
                    Everyone signs in with the password
                    <strong class="font-mono">{{ default_password }}</strong> and is asked to change it immediately.
                </p>
                <a href="{{ path('app_tenant_staff_index') }}"
                   class="mt-3 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                    Open the staff directory
                </a>
            {% endif %}
        </section>
    {% endif %}
</div>
{% endblock %}
