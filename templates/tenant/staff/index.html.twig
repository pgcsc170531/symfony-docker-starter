{% extends 'base.html.twig' %}

{% block title %}Staff Directory{% endblock %}

{% block body %}
    {# <main> deliberately adds no horizontal gutter (UI-SPEC §4.1) — the page
       owns its own. `flex-wrap` too: the title and "Add New Staff" do not fit on
       one 320px line and were colliding. #}
    <div class="px-4">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Staff Directory</h1>
                <p class="text-gray-500">
                    {% if q or role %}
                        {{ users|length }} of {{ total }} staff member{{ total == 1 ? '' : 's' }}
                        <a href="{{ path('app_tenant_staff_index') }}" class="font-semibold text-blue-600">Show all</a>
                    {% else %}
                        {{ total }} staff member{{ total == 1 ? '' : 's' }}. Manage user access and roles.
                    {% endif %}
                </p>
            </div>
            <a href="{{ path('app_tenant_staff_new') }}" class="flex min-h-[44px] items-center rounded bg-blue-600 px-4 py-2 font-bold text-white shadow hover:bg-blue-700">
                <span class="mr-2">+</span> Add New Staff
            </a>
        </div>

        {#
            Search + role filter in one GET form. The filter separates the two
            kinds of "role" this school actually has: the login role (Super Admin,
            Principal, Bursar, Store, Teacher) and the academic assignments
            (Head of Department, Form Teacher, Year Group Master) — which are
            rows in other tables and were previously invisible here.
        #}
        <form method="get" action="{{ path('app_tenant_staff_index') }}"
              class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-[minmax(0,1fr)_14rem_auto] sm:items-center">
            <div class="min-w-0">
                <label class="sr-only" for="staff-q">Search staff</label>
                <input id="staff-q" name="q" type="search" value="{{ q }}" autocomplete="off"
                       placeholder="Name, email, department or class"
                       class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
            </div>
            <div>
                <label class="sr-only" for="staff-role">Filter by role</label>
                <select id="staff-role" name="role"
                        class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                    <option value="">All roles</option>
                    <option value="super" {{ role == 'super' ? 'selected' }}>Super Admin</option>
                    <option value="admin" {{ role == 'admin' ? 'selected' }}>Administrator</option>
                    <option value="bursar" {{ role == 'bursar' ? 'selected' }}>Bursar</option>
                    <option value="store" {{ role == 'store' ? 'selected' }}>Store Keeper</option>
                    <option value="teacher" {{ role == 'teacher' ? 'selected' }}>Teacher</option>
                    <optgroup label="Assignments">
                        <option value="hod" {{ role == 'hod' ? 'selected' }}>Head of Department</option>
                        <option value="form" {{ role == 'form' ? 'selected' }}>Form Teacher</option>
                        <option value="ygm" {{ role == 'ygm' ? 'selected' }}>Year Group Master</option>
                    </optgroup>
                </select>
            </div>
            <div class="flex gap-2">
                <button type="submit"
                        class="min-h-[44px] flex-1 rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white transition-colors hover:bg-accent-700 sm:flex-none">
                    Filter
                </button>
                {% if q or role %}
                    <a href="{{ path('app_tenant_staff_index') }}"
                       class="inline-flex min-h-[44px] items-center px-2 text-sm font-semibold text-ink-500 hover:text-ink-800">
                        Clear
                    </a>
                {% endif %}
            </div>
        </form>

        <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow">
            <table class="w-full min-w-[760px] text-left text-sm">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="p-4 font-bold text-gray-600">Name</th>
                        <th class="p-4 font-bold text-gray-600">Email</th>
                        <th class="p-4 font-bold text-gray-600">Role</th>
                        <th class="p-4 font-bold text-gray-600">Assignments</th>
                        <th class="p-4 font-bold text-gray-600 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for user in users %}
                    {% set staffId = staffIds[user.id] is defined ? staffIds[user.id] : null %}
                    {% set mine = staffId and assignments[staffId] is defined ? assignments[staffId] : {} %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="p-4 font-bold text-gray-800">{{ user.fullName ?: '—' }}</td>
                        <td class="p-4 text-gray-600 break-words">{{ user.email }}</td>
                        <td class="p-4">
                            {% if 'ROLE_TENANT_SUPER_ADMIN' in user.roles %}
                                <span class="bg-amber-100 text-amber-800 px-2 py-1 rounded text-xs font-bold">Super Admin</span>
                            {% elseif 'ROLE_ADMIN' in user.roles %}
                                <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-xs font-bold">Principal</span>
                            {% elseif 'ROLE_BURSAR' in user.roles %}
                                <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs font-bold">Bursar</span>
                            {% elseif 'ROLE_STORE' in user.roles %}
                                <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded text-xs font-bold">Store</span>
                            {% elseif 'ROLE_TEACHER' in user.roles %}
                                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-bold">Teacher</span>
                            {% else %}
                                <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded text-xs font-bold">Staff</span>
                            {% endif %}
                        </td>
                        <td class="p-4">
                            <div class="flex flex-wrap gap-1">
                                {% if mine.form is defined %}
                                    <span class="rounded bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-700">Form · {{ mine.form }}</span>
                                {% endif %}
                                {% if mine.hod is defined %}
                                    <span class="rounded bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-700">HOD · {{ mine.hod }}</span>
                                {% endif %}
                                {% if mine.ygm is defined %}
                                    <span class="rounded bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-700">YGM · {{ mine.ygm }}</span>
                                {% endif %}
                                {% if mine.form is not defined and mine.hod is not defined and mine.ygm is not defined %}
                                    <span class="text-gray-400">—</span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="p-4 text-right">
                            <a href="{{ path('app_tenant_staff_edit', {id: user.id}) }}"
                               class="inline-flex min-h-[44px] items-center text-sm font-bold text-blue-600 hover:text-blue-800">
                                Edit
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="p-8 text-center text-gray-500">
                            {% if q or role %}
                                No staff member matches that search.
                                <a href="{{ path('app_tenant_staff_index') }}" class="font-semibold text-blue-600">Show all staff</a>.
                            {% else %}
                                No staff found.
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
