{% extends 'base.html.twig' %}

{% block title %}Result Entry{% endblock %}

{% block body %} {# ⚠️ confirm this block name in base.html.twig #}
<div class="p-6">
    <h1 class="text-2xl font-bold mb-4">My Subject Assignments</h1>

    {% if assignments is empty %}
        <div class="bg-white rounded-lg shadow p-6 text-gray-500">
            You have no subject assignments yet. Contact your HOD to assign you.
        </div>
    {% else %}
        <div class="grid gap-4">
            {% for a in assignments %}
            <a href="{{ path('tenant_result_entry_form', {id: a.id}) }}"
               class="bg-white rounded-lg shadow p-4 hover:bg-blue-50 transition">
                <div class="font-semibold text-lg">{{ a.subject.name }}</div>
                <div class="text-sm text-gray-600">
                    {{ a.classroom.name }} • {{ a.term.label ?? a.term.name }} • {{ a.term.session.name }}
                </div>
            </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}