<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ classSubject.subject.name }} — {{ classroom_label ?? classSubject.classroom.name }} — Mark Sheet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% include '_design_tokens.html.twig' %}
    {#
        The ENTERED scores on paper — the twin of the blank sheet.

        A teacher prints this twice in the life of one sheet of marks: before
        submitting, to check their typing against the handwritten sheet; and after
        submitting, as the record of exactly what was handed in. The columns come
        from the same assessment scheme as the blank sheet and the entry screen,
        and the numbers come from the same builder as the reviewer's read-only
        view — so paper, screen and print cannot tell three different stories.
    #}
    <style>
        {% include 'tenant/print/_styles.html.twig' %}
        /* The status badge is the one place colour means something on paper:
           a draft is not a record, a submitted sheet is awaiting a signature,
           an approved one has been accepted. */
        .stamp { display: inline-block; border: 1.2px solid #6b7280; border-radius: 3px;
                 padding: 1px 6px; font-size: 8px; font-weight: bold;
                 text-transform: uppercase; letter-spacing: .08em; color: #4b5563; }
        .stamp.submitted { border-color: #b45309; color: #b45309; }
        .stamp.approved { border-color: #059669; color: #059669; }
    </style>
</head>
<body class="bg-ink-100 font-sans text-ink-900">

{% set paper_ink = tenant and tenant.primaryColor ? tenant.primaryColor : '#1e40af' %}
{% set status_label = status == 'approved' ? 'Approved' : (status == 'submitted' ? 'Submitted' : 'Draft') %}

<div class="px-4 py-4 sm:px-6 sm:py-6">

    <div class="no-print mx-auto max-w-[210mm]">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <a href="{{ path('tenant_result_entry_index') }}"
               class="inline-flex min-h-[44px] items-center text-sm font-bold text-accent-700 hover:text-accent-900">
                &larr; Back to my subjects
            </a>
            <button type="button" onclick="window.print()"
                    class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" />
                </svg>
                Print mark sheet
            </button>
        </div>
        <p class="mt-1 text-xs text-ink-500">
            The marks as they stand right now — printable before or after you submit.
            Marks are <strong class="font-semibold text-ink-700">not</strong> changed by printing.
        </p>
    </div>

    {# ── The paper ───────────────────────────────────────────────────────── #}
    <div class="paper mx-auto mt-3 rounded-xl border border-ink-200 bg-white shadow-sm">
        <div class="paper-inner p-5 sm:p-8">

            {% include 'tenant/print/_letterhead.html.twig' with {
                school: tenant,
                term: term,
                kicker: status_label,
                title: 'Mark Sheet',
                ink: paper_ink,
            } only %}

            {# ── Which sheet this is, and how far it got ────────────────────── #}
            <section class="grid grid-cols-2 gap-x-5 gap-y-3 border-b border-ink-200 py-3 sm:grid-cols-4">
                <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-500">Class</p>
                    <p class="break-words text-sm font-bold text-ink-900">{{ classSubject.classroom.name }}</p>
                    {% if classSubject.classroom.level is defined and classSubject.classroom.level %}
                        <p class="text-[11px] text-ink-500">{{ classSubject.classroom.level.name }}</p>
                    {% endif %}
                </div>
                <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-500">Subject</p>
                    <p class="break-words text-sm font-bold text-ink-900">{{ classSubject.subject.name }}</p>
                </div>
                <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-500">Subject teacher</p>
                    <p class="break-words text-sm font-bold text-ink-900">{{ teacher ?: '—' }}</p>
                </div>
                <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-500">Assessment</p>
                    <p class="text-xs font-semibold leading-snug text-ink-900">
                        {%- for column in columns -%}
                            {{ column.label }} ({{ column.max }}){{ not loop.last ? ' + ' : '' }}
                        {%- endfor -%}
                    </p>
                    <p class="text-[11px] text-ink-500">
                        {{ maximum }} marks in all &middot;
                        {{ roster }} {{ roster == 1 ? learner : learner.plural }}
                    </p>
                </div>
            </section>

            <div class="mt-4 overflow-x-auto">
                <table class="sheet min-w-[640px]">
                    <thead>
                        <tr>
                            <th class="w-8 mid">S/N</th>
                            <th class="w-24">Adm. No.</th>
                            <th class="w-56">{{ learner.capital }} name</th>
                            {% for column in columns %}
                                <th class="w-12 mid whitespace-nowrap">{{ column.label }}<br><span class="text-[9px] font-normal">({{ column.max }})</span></th>
                            {% endfor %}
                            <th class="w-12 mid whitespace-nowrap">Total<br><span class="text-[9px] font-normal">({{ maximum }})</span></th>
                            <th class="w-12 mid">Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in sheet %}
                        <tr>
                            <td class="mid text-ink-500">{{ loop.index }}</td>
                            <td class="font-mono text-xs">{{ row.student.admissionNumber ?: '—' }}</td>
                            <td class="text-[11px] font-semibold uppercase">{{ row.student.fullName }}</td>
                            {% for column in columns %}
                                <td class="num">
                                    {%- if row.scores[column.component] is defined -%}
                                        {{ row.scores[column.component]|number_format(0) }}
                                    {%- else -%}
                                        <span class="text-ink-300">·</span>
                                    {%- endif -%}
                                </td>
                            {% endfor %}
                            <td class="num font-bold">
                                {{ row.total is null ? '—' : row.total|number_format(0) }}
                            </td>
                            <td class="mid font-bold">{{ row.grade ?: '—' }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="{{ 3 + columns|length + 2 }}" class="py-8 text-center italic text-ink-400">
                                No {{ learner.plural }} in this class yet.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ── The counts an HOD signs on ─────────────────────────────────── #}
            <section class="mt-3 grid grid-cols-3 gap-x-4 border-t border-b border-ink-200 py-2 text-center sm:grid-cols-6">
                <div>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">On roll</p>
                    <p class="text-xs font-bold text-ink-900">{{ roster }}</p>
                </div>
                <div>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">Marked</p>
                    <p class="text-xs font-bold text-ink-900">{{ graded }}</p>
                </div>
                <div>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">Average</p>
                    <p class="text-xs font-bold text-ink-900">{{ average is null ? '—' : average|number_format(1) }}</p>
                </div>
                <div>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">Credits</p>
                    <p class="text-xs font-bold text-ink-900">{{ credits }}</p>
                </div>
                <div>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">Passes</p>
                    <p class="text-xs font-bold text-ink-900">{{ passes }}</p>
                </div>
                <div>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-ink-500">Fails</p>
                    <p class="text-xs font-bold text-ink-900">{{ fails }}</p>
                </div>
            </section>

            {# ── Status: what the reader is holding ────────────────────────── #}
            <p class="mt-2 text-[10px] leading-snug text-ink-600">
                <span class="stamp {{ status }}">{{ status_label }}</span>
                {% if status == 'draft' %}
                    &nbsp;Not yet submitted — this sheet may still change. Marks printed here are not final.
                {% elseif status == 'submitted' %}
                    &nbsp;Submitted for approval{% if approval and approval.hodAt %} on {{ approval.hodAt|date('j M Y') }}{% endif %} — the marks are locked until an HOD or admin unlocks them.
                {% else %}
                    &nbsp;Approved{% if approval and approval.hodAt %} on {{ approval.hodAt|date('j M Y') }}{% endif %} — these are the marks of record.
                {% endif %}
                Credits are A1–C6, passes D7–E8, fails F9; {{ learner.plural }} with no marks are not averaged.
            </p>

            {% include 'tenant/print/_signatures.html.twig' with { school: tenant, teacher: teacher } only %}

            <footer class="mt-6 flex flex-col gap-1 border-t border-ink-200 pt-2 text-[10px] leading-snug text-ink-500 sm:flex-row sm:items-baseline sm:justify-between">
                <span class="break-words">
                    {{ tenant ? tenant.name : '' }}{% if tenant and tenant.address %} &middot; {{ tenant.address }}{% endif %}{% if tenant and tenant.phoneNumber %} &middot; {{ tenant.phoneNumber }}{% endif %}
                </span>
                <span class="shrink-0">Printed {{ printed_at|date('j M Y') }} &middot; Generated by Edus</span>
            </footer>

        </div>
    </div>

</div>

</body>
</html>
