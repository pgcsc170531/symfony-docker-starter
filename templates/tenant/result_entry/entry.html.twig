{% extends 'base.html.twig' %}

{% block title %}{{ assignment.subject.name }} — Result Entry{% endblock %}

{% block body %} {# ⚠️ confirm block name #}
<div x-data="resultEntry()" x-init="init()"
     data-save-url="{{ path('tenant_result_entry_save', {id: assignment.id}) }}"
     data-import-url="{{ path('tenant_result_entry_import', {id: assignment.id}) }}"
     data-submit-url="{{ path('tenant_result_entry_submit', {id: assignment.id}) }}"
     data-token="{{ csrf }}"
     class="p-4 sm:p-6">
    <h1 class="text-2xl font-bold mb-1">{{ assignment.subject.name }}</h1>
    <p class="text-gray-600 mb-4">{{ assignment.classroom.name }} • {{ assignment.term.label ?? assignment.term.name }}</p>

    {% if rejection is defined and rejection %}
        {# Sent back by the HOD: say what to fix, in their words. #}
        <div class="mb-4 rounded-lg border border-failed/40 bg-failed/5 p-3 text-sm" role="alert">
            <p class="font-bold text-failed">Sent back by the HOD</p>
            <p class="mt-1 break-words text-ink-700">{{ rejection }}</p>
            <p class="mt-1 text-xs text-ink-500">Correct the sheet and submit it again.</p>
        </div>
    {% endif %}

    {# CSV toolbar #}
    <div class="flex flex-wrap items-center gap-3 mb-4">
        <a href="{{ path('tenant_result_entry_template', {id: assignment.id}) }}"
           class="bg-gray-100 border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-200">
            ⬇️ Download CSV Template
        </a>
        <label class="bg-gray-100 border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-200 cursor-pointer">
            ⬆️ Upload CSV
            <input type="file" accept=".csv,text/csv" class="hidden" @change="importCsv($event)">
        </label>
        <span x-show="importing" class="text-sm text-gray-500">Importing…</span>
        <span x-text="importMessage" class="text-sm text-red-600"></span>
    </div>

    {# Locked banner #}
    <div x-show="locked" x-cloak class="bg-yellow-50 border border-yellow-300 text-yellow-800 rounded-lg p-3 mb-4 text-sm">
        🔒 These results are submitted and locked. An HOD or Admin must unlock them before editing.
    </div>

    {# Scheme display #}
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4 text-sm">
        <span class="font-semibold">Scheme:</span>
        CA count = <span x-text="scheme.ca_count"></span>,
        Exam mode = <span x-text="scheme.exam_mode"></span>
        <template x-if="scheme.exam_mode === 'dual'">
            <span>(Practical enabled)</span>
        </template>
    </div>

    {# Grid mode #}
    <div class="overflow-x-auto bg-white rounded-lg shadow">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 text-left">
                <tr>
                    <th class="p-3">{{ learner.capital }}</th>
                    <template x-for="n in scheme.ca_count" :key="'ca'+n">
                        <th class="p-3" x-text="'CA' + n"></th>
                    </template>
                    <th class="p-3">Exams</th>
                    <template x-if="scheme.exam_mode === 'dual'">
                        <th class="p-3">Practical</th>
                    </template>
                    <th class="p-3">Total</th>
                    <th class="p-3">Grade</th>
                </tr>
            </thead>
            <tbody>
                <template x-for="(s, idx) in students" :key="s.id">
                    <tr class="border-t hover:bg-gray-50 cursor-pointer" @click="!locked && openModal(idx)">
                        <td class="p-3" x-text="s.name"></td>
                        <template x-for="n in scheme.ca_count" :key="'ca'+n">
                            <td class="p-3">
                                <input type="number" class="w-16 border rounded p-1 text-center text-base"
                                       x-model.number="s['ca'+n]"
                                       :disabled="locked"
                                       @click.stop
                                       @change="calcTotal(s)">
                            </td>
                        </template>
                        <td class="p-3">
                            <input type="number" class="w-16 border rounded p-1 text-center text-base"
                                   x-model.number="s.theory"
                                   :disabled="locked"
                                   @click.stop
                                   @change="calcTotal(s)">
                        </td>
                        <template x-if="scheme.exam_mode === 'dual'">
                            <td class="p-3">
                                <input type="number" class="w-16 border rounded p-1 text-center text-base"
                                       x-model.number="s.practical"
                                       :disabled="locked"
                                       @click.stop
                                       @change="calcTotal(s)">
                            </td>
                        </template>
                        {# A pupil with no marks entered yet is *unmarked*, not a fail.
                           Printing 0 / F9 for an empty sheet told every teacher their
                           whole class had failed. #}
                        <td class="p-3 font-semibold" x-text="s.total === null ? '—' : s.total"></td>
                        <td class="p-3" x-text="grade(s.total)"></td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>

    <div class="flex items-center gap-3 mt-4">
        <button @click="saveAll()" :disabled="locked" class="bg-green-600 text-white px-6 py-2 rounded-lg disabled:opacity-50 disabled:cursor-not-allowed">
            Save All Scores
        </button>
        <button @click="submit()" :disabled="locked" class="bg-indigo-600 text-white px-6 py-2 rounded-lg disabled:opacity-50 disabled:cursor-not-allowed">
            Submit for Approval
        </button>
    </div>

    {# Focus modal — Save & Next #}
    <div x-show="modalOpen" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6">
            <h2 class="text-lg font-semibold mb-4" x-text="currentStudent?.name"></h2>
            <template x-for="n in scheme.ca_count" :key="'ca'+n">
                <div class="mb-3">
                    <label class="block text-sm font-medium mb-1" x-text="'CA' + n"></label>
                    <input type="number" class="w-full border rounded p-2"
                           x-model.number="currentStudent['ca'+n]"
                           :disabled="locked"
                           @keydown.enter="saveCurrentAndNext()">
                </div>
            </template>
            <div class="mb-3">
                <label class="block text-sm font-medium mb-1">Exams</label>
                <input type="number" class="w-full border rounded p-2"
                       x-model.number="currentStudent.theory"
                       :disabled="locked"
                       @keydown.enter="saveCurrentAndNext()">
            </div>
            <template x-if="scheme.exam_mode === 'dual'">
                <div class="mb-3">
                    <label class="block text-sm font-medium mb-1">Practical</label>
                    <input type="number" class="w-full border rounded p-2"
                           x-model.number="currentStudent.practical"
                           :disabled="locked"
                           @keydown.enter="saveCurrentAndNext()">
                </div>
            </template>
            <div class="flex justify-between mt-6">
                <button @click="modalOpen = false" class="bg-gray-200 px-4 py-2 rounded-lg">Close</button>
                <button @click="saveCurrentAndNext()" :disabled="locked" class="bg-blue-600 text-white px-4 py-2 rounded-lg disabled:opacity-50">
                    Save & Next
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function resultEntry() {
    return {
        scheme: {{ scheme|json_encode|raw }},
        students: {{ students_json|json_encode|raw }},
        scores: {{ scores|json_encode|raw }},
        grading: {{ gradingScale|json_encode|raw }},
        currentIndex: 0,
        modalOpen: false,
        locked: {{ locked|default(false) ? 'true' : 'false' }},
        token: '',
        importing: false,
        importMessage: '',

        init() {
            this.token = this.$root.dataset.token;
            this.students.forEach(s => {
                // Empty, not zero: no mark is a missing mark.
                this.scheme.ca_count && ['ca1','ca2','ca3'].slice(0, this.scheme.ca_count).forEach(c => {
                    s[c] = this.scores[s.id]?.[c] ?? '';
                });
                s.theory = this.scores[s.id]?.theory ?? '';
                s.practical = this.scores[s.id]?.practical ?? '';
                this.calcTotal(s);
            });
        },

        hasScores(s) {
            const parts = [s.theory, s.practical];
            for (let i = 1; i <= this.scheme.ca_count; i++) {
                parts.push(s['ca'+i]);
            }
            return parts.some(v => v !== '' && v !== null && v !== undefined);
        },

        calcTotal(s) {
            let total = 0;
            for (let i = 1; i <= this.scheme.ca_count; i++) {
                total += parseFloat(s['ca'+i] || 0);
            }
            total += parseFloat(s.theory || 0);
            if (this.scheme.exam_mode === 'dual') {
                total += parseFloat(s.practical || 0);
            }
            s.total = this.hasScores(s) ? total : null;
        },

        grade(total) {
            if (total === null || total === '' || total === undefined) return '—';
            for (const g of this.grading) {
                if (total >= g.min && total <= g.max) return g.grade;
            }
            return total >= 75 ? 'A1' : total >= 70 ? 'B2' : total >= 60 ? 'B3'
                : total >= 50 ? 'C4' : total >= 45 ? 'C5' : total >= 40 ? 'C6'
                : total >= 35 ? 'D7' : total >= 30 ? 'E8' : 'F9';
        },

        openModal(idx) {
            this.currentIndex = idx;
            this.modalOpen = true;
        },

        get currentStudent() {
            return this.students[this.currentIndex];
        },

        async saveAll() {
            try {
                await this.persist();
                alert('Scores saved.');
            } catch (e) {
                alert(e.message);
            }
        },

        async submit() {
            try {
                await this.persist();
                const res = await fetch(this.$root.dataset.submitUrl, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({_token: this.token})
                });
                const result = await res.json();
                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.error || 'Submit failed.');
                }
            } catch (e) {
                alert(e.message);
            }
        },

        async saveCurrentAndNext() {
            await this.persist();
            if (this.currentIndex < this.students.length - 1) {
                this.currentIndex++;
            } else {
                this.modalOpen = false;
            }
        },

        async persist() {
            // Only send pupils that actually have a mark. Sending the whole
            // roster wrote a row of zeroes for every pupil on the sheet, which
            // then read back as "scored 0 → F9" for children nobody had marked.
            const components = ['theory'];
            for (let i = 1; i <= this.scheme.ca_count; i++) components.push('ca' + i);
            if (this.scheme.exam_mode === 'dual') components.push('practical');

            const payload = this.students
                .filter(s => this.hasScores(s))
                .map(s => ({
                    student_id: s.id,
                    ...Object.fromEntries(components
                        .map(c => [c, (s[c] === '' || s[c] === null || s[c] === undefined) ? 0 : s[c]]))
                }));
            const res = await fetch(this.$root.dataset.saveUrl, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({scores: payload, _token: this.token})
            });

            if (!res.ok) {
                const detail = await res.text();
                throw new Error(`Could not save scores (HTTP ${res.status}). ${detail.slice(0, 120)}`);
            }
        },

        async importCsv(event) {
            const file = event.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);
            formData.append('_token', this.token);

            this.importing = true;
            this.importMessage = '';
            try {
                const res = await fetch(this.$root.dataset.importUrl, {
                    method: 'POST',
                    body: formData,
                });
                const result = await res.json();
                if (result.success) {
                    window.location.reload();
                } else {
                    this.importMessage = result.error || 'Import failed.';
                }
            } catch (e) {
                this.importMessage = 'Import failed.';
            } finally {
                this.importing = false;
            }
        }
    };
}
</script>
<style>[x-cloak]{display:none;}</style>
{% endblock %}