{% extends 'base.html.twig' %}

{% block title %}New Admission - Step 1{% endblock %}

{% block body %}
{# px-0 on mobile for edge-to-edge cards #}
<div class="max-w-7xl mx-auto px-0 sm:px-6 lg:px-8 py-4 sm:py-8">
    
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-6 sm:mb-8 px-4 sm:px-0">📝 New Admission</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-8">
        
        {# === SEARCH COLUMN: NOW FIRST ON BOTH MOBILE AND DESKTOP === #}
        <div class="lg:col-span-1 order-1">
            <div class="bg-white p-5 sm:rounded-xl shadow-sm border-y sm:border border-gray-100 lg:sticky lg:top-6">
                <div class="flex items-center justify-between lg:block">
                    <h2 class="text-lg font-bold text-gray-700 mb-2 lg:mb-4">🔍 Existing Parent?</h2>
                    <span class="lg:hidden bg-indigo-100 text-indigo-700 text-[10px] font-bold px-2 py-1 rounded">FAST SEARCH</span>
                </div>
                <p class="text-xs sm:text-sm text-gray-500 mb-4">Search by Phone to skip registration.</p>
                
                <form method="get" action="{{ path('app_tenant_admission_index') }}">
                    <div class="flex gap-2">
                        {# Force number pad on mobile with type="tel" #}
                        <input type="tel" name="q" value="{{ searchQuery }}" placeholder="080..." 
                               class="flex-1 rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base p-3 border">
                        <button type="submit" class="bg-gray-800 text-white px-5 py-3 rounded-lg font-bold hover:bg-gray-700 transition active:scale-95">Go</button>
                    </div>
                </form>

                {% if foundGuardian %}
                    <div class="mt-4 p-4 bg-green-50 border border-green-200 rounded-xl">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="font-bold text-green-800">{{ foundGuardian.fullName }}</p>
                                <p class="text-xs text-green-600">{{ foundGuardian.email }}</p>
                            </div>
                            <span class="text-green-500 text-xl">✅</span>
                        </div>
                        <a href="{{ path('app_tenant_admission_register', {id: foundGuardian.id}) }}" 
                           class="block mt-4 text-center bg-green-600 text-white py-3 rounded-lg text-sm font-bold shadow-md shadow-green-100 transition active:scale-95">
                            Continue with this Parent &rarr;
                        </a>
                    </div>
                {% elseif searchQuery %}
                    <div class="mt-4 p-4 bg-amber-50 text-amber-700 text-xs rounded-xl border border-amber-100">
                        Parent not found. Please use the registration form below.
                    </div>
                {% endif %}
            </div>
        </div>

        {# === FORM COLUMN: COMES SECOND === #}
        <div class="lg:col-span-2 order-2">
            <div class="bg-white p-5 sm:p-8 sm:rounded-xl shadow-md border-t-4 border-indigo-600 border-x-0 sm:border-x border-b sm:border-b">
                <div class="flex items-center gap-3 mb-6">
                    <span class="bg-indigo-100 text-indigo-700 w-8 h-8 rounded-full flex items-center justify-center font-bold">1</span>
                    <h2 class="text-xl font-bold text-gray-800">New Parent Registration</h2>
                </div>

                {{ form_start(form) }}
                    
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 mb-5">
                        <div class="sm:col-span-3">
                            {{ form_row(form.title) }}
                        </div>
                        <div class="sm:col-span-9">
                            {{ form_row(form.fullName) }}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                        {{ form_row(form.relationshipToStudent) }}
                        {{ form_row(form.occupation) }}
                    </div>

                    <h3 class="text-xs uppercase tracking-widest text-indigo-500 font-black mb-4 mt-8 flex items-center">
                        <span class="mr-2">📞</span> Contact Information
                    </h3>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                        {{ form_row(form.phoneNumber) }}
                        {{ form_row(form.alternatePhoneNumber) }}
                    </div>
                    
                    <div class="mb-5">
                        {{ form_row(form.email) }}
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                        {{ form_row(form.address) }}
                        {{ form_row(form.officeAddress) }}
                    </div>

                    <div class="px-0">
                        <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-4 rounded-none sm:rounded-xl hover:bg-indigo-700 active:scale-95 transition shadow-lg shadow-indigo-100">
                            Create Profile & Next Step &rarr;
                        </button>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}