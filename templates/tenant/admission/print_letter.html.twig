<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Provisional Admission Letter — {{ student.fullName }}</title>
    {#
        A4 LETTER — plain CSS only.

        Deliberately not a Tailwind page, and deliberately a separate file from any
        screen template: this document is printed, filed and forwarded, so it must
        render identically with no CDN, no flex, no grid and no web font
        (see .github/instructions/pdf.instructions.md, rule 4). Everything here is a
        block, a table or a border.

        The layout follows a standard formal school letter: institutional
        letterhead, reference-and-date line, addressee, a bold subject line, the
        offer, the admission particulars as a table, numbered conditions, the
        acceptance instruction, and a signature block with the school stamp.
    #}
    <style>
        @page { size: A4 portrait; margin: 0; }

        :root {
            --brand: {{ tenant.primaryColor|default('#1e40af') }};
            --ink: #111827;
            --muted: #4b5563;
            --faint: #9ca3af;
            --line: #d1d5db;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: #e5e7eb;
            color: var(--ink);
            font-family: Georgia, 'Times New Roman', 'Liberation Serif', serif;
            font-size: 10pt;
            line-height: 1.42;
        }

        /* ── The sheet ───────────────────────────────────────────────── */
        /* A block, never display:table — on a table element `height` is only a
           minimum, so the sheet would grow past 297mm and print a second page. */
        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 24px auto;
            padding: 12mm 18mm 20mm;
            background: #fff;
            box-shadow: 0 10px 30px rgba(17, 24, 39, .18);
            position: relative;
        }

        /* ── Letterhead ──────────────────────────────────────────────── */
        .lh { width: 100%; border-collapse: collapse; }
        .lh td { vertical-align: middle; padding: 0; }
        .lh-crest { width: 26mm; }
        .lh-crest img { max-width: 24mm; max-height: 24mm; display: block; }
        .lh-crest .mono {
            width: 22mm; height: 22mm; line-height: 22mm; text-align: center;
            border: 1px solid var(--line); border-radius: 3px;
            font-size: 20pt; font-weight: bold; color: var(--faint);
        }
        .lh-text { text-align: center; padding: 0 6mm !important; }
        .lh-name {
            margin: 0; font-size: 18pt; font-weight: bold;
            letter-spacing: .08em; text-transform: uppercase; color: var(--brand);
            line-height: 1.15;
        }
        .lh-address { margin: 2pt 0 0; font-size: 8.5pt; color: var(--muted); letter-spacing: .02em; }
        .lh-motto { margin: 3pt 0 0; font-size: 8.5pt; font-style: italic; color: var(--muted); }
        .lh-spacer { width: 26mm; }

        .rule-thick { border: 0; border-top: 2.5pt solid var(--brand); margin: 5pt 0 0; }
        .rule-thin  { border: 0; border-top: .75pt solid var(--brand); margin: 1.5pt 0 0; }

        /* ── Reference & date ────────────────────────────────────────── */
        .meta { width: 100%; border-collapse: collapse; margin: 9pt 0 0; font-size: 9.5pt; }
        .meta td { padding: 0; }
        .meta .date { text-align: right; }
        .meta .label { color: var(--muted); }
        .meta .value { font-weight: bold; }
        .meta .ref-code { font-family: 'Courier New', monospace; }

        /* ── Addressee & subject ─────────────────────────────────────── */
        .addressee { margin: 11pt 0 0; }
        .addressee .to { color: var(--muted); font-size: 9pt; margin: 0 0 2pt; }
        .addressee .name { margin: 0; font-weight: bold; }
        .addressee .line { margin: 0; font-size: 9.5pt; color: var(--muted); }

        .subject {
            margin: 10pt 0 0; padding: 4pt 0;
            border-top: .75pt solid var(--line); border-bottom: .75pt solid var(--line);
            font-size: 10.5pt; font-weight: bold; text-transform: uppercase;
            letter-spacing: .03em; text-align: center; line-height: 1.3;
        }

        .salutation { margin: 9pt 0 0; }

        p { margin: 0 0 5.5pt; text-align: justify; }

        /* ── Conditions ──────────────────────────────────────────────── */
        .conditions { margin: 0 0 6pt; padding-left: 16pt; }
        .conditions li { margin-bottom: 2.5pt; text-align: justify; }

        /* ── Signature block ─────────────────────────────────────────── */
        .sign { width: 100%; border-collapse: collapse; margin-top: 6pt; }
        .sign td { padding: 0; vertical-align: bottom; }
        .sign .who { width: 62%; }
        .sign .seal { width: 38%; text-align: right; }
        .sign .sig-img { max-height: 17mm; max-width: 55mm; display: block; margin-bottom: 1pt; }
        .sign .sig-line { width: 58mm; border-bottom: 1pt solid var(--ink); height: 16pt; }
        .sign .sig-rule { width: 58mm; border-bottom: 1pt solid var(--ink); height: 6pt; }
        .sign .sig-name { margin: 3pt 0 0; font-weight: bold; text-transform: uppercase; font-size: 10pt; }
        .sign .sig-role, .sign .sig-school { margin: 0; font-size: 9pt; color: var(--muted); }

        /*
            The school's own round seal, as the previous letter printed it:
            name around the arc, OFFICIAL SEAL beneath, ADMITTED across the
            middle, date and admission number inside.

            Red, because that is what a rubber stamp looks like on paper — the
            brand colour belongs to the letterhead, not to the endorsement. The
            slight rotation and the low opacity are what stop it reading as a
            logo printed by the same machine as the text.
        */
        .seal-svg {
            width: 48mm; height: 48mm; display: block; margin-left: auto;
            color: #b91c1c; opacity: .85;
            transform: rotate(-11deg);
        }

        /* ── Footer ──────────────────────────────────────────────────── */
        .foot {
            position: absolute; left: 18mm; right: 18mm; bottom: 8mm;
            padding-top: 4pt; border-top: .75pt solid var(--line);
            font-size: 7.5pt; color: var(--faint); line-height: 1.45;
        }
        .foot table { width: 100%; border-collapse: collapse; }
        .foot td { padding: 0; vertical-align: top; }
        .foot .right { text-align: right; }
        .foot .code { font-family: 'Courier New', monospace; color: var(--muted); }

        /* ── Screen-only toolbar ─────────────────────────────────────── */
        .toolbar { max-width: 210mm; margin: 16px auto 0; text-align: right; }
        .toolbar button {
            font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
            font-size: 13px; font-weight: 600; min-height: 44px;
            padding: 10px 18px; border-radius: 8px; cursor: pointer;
            border: 1px solid #d1d5db; background: #fff; color: #374151;
        }
        .toolbar .primary {
            background: {{ tenant.primaryColor|default('#1e40af') }};
            border-color: transparent; color: #fff;
        }

        /* A phone shows the letter at screen width; printing restores the real
           210mm sheet below. The two fixed millimetre widths (crest gutter and
           signature rule) are what would otherwise push the page sideways, so
           they collapse here. */
        @media screen and (max-width: 820px) {
            .sheet { width: 100%; min-height: 0; margin: 0; padding: 20px 16px; box-shadow: none; }
            .toolbar { padding: 0 12px; text-align: center; }

            .lh-crest { width: 18mm; }
            .lh-crest img { max-width: 16mm; max-height: 16mm; }
            .lh-crest .mono { width: 16mm; height: 16mm; line-height: 16mm; font-size: 14pt; }
            .lh-spacer { display: none; }
            .lh-text { padding: 0 0 0 8px !important; text-align: left; }
            .lh-name { font-size: 13.5pt; letter-spacing: .04em; }

            .subject { font-size: 9.5pt; text-align: left; }

            .sign .who, .sign .seal { display: block; width: auto; }
            .sign .sig-line, .sign .sig-rule { width: 100%; }
            .sign .sig-img { max-width: 100%; }
            .sign .seal { margin-top: 12px; text-align: left; }
            .seal-svg { width: 34mm; height: 34mm; margin-left: 0; }

            .foot { position: static; margin-top: 14px; }
            .foot td { display: block; text-align: left; }
        }

        @media print {
            body { background: #fff; }
            .no-print { display: none !important; }
            .sheet {
                width: 210mm !important;
                height: 297mm !important;
                min-height: 297mm !important;
                margin: 0 !important;
                padding: 12mm 18mm 20mm !important;
                box-shadow: none !important;
                page-break-after: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>

{# Screen-only controls. Never printed. #}
<div class="toolbar no-print">
    <button type="button"
            onclick="if (window.opener || history.length === 1) { window.close(); } else { history.back(); }">Close</button>
    <button type="button" class="primary" onclick="window.print()">🖨️ Print A4</button>
</div>

{#
    `placedIn` prefers the classroom recorded at admission, because
    `Student.currentClass` is usually null and used to print "our institution".
#}
{% set placedIn = entryClassroom
    ? entryClassroom.name
    : (student.currentClassroom ? student.currentClassroom.name : (student.currentClass ? student.currentClass.name : null)) %}
{% set sessionName = entrySession ? entrySession.name : null %}
{% set termName = entryTerm ? entryTerm.name : null %}
{% set admittedOn = entryDate ?? student.createdAt %}
{% set guardianName = student.guardian ? student.guardian.fullName : 'Parent / Guardian' %}

<div class="sheet">

    <div class="sheet-body">

        {# ── LETTERHEAD ──────────────────────────────────────────────── #}
        <table class="lh">
            <tr>
                <td class="lh-crest">
                    {% if tenant.logoFilename %}
                        <img src="{{ asset('uploads/logos/' ~ tenant.logoFilename) }}" alt="{{ tenant.name }}">
                    {% else %}
                        <div class="mono">{{ tenant.name|first|upper }}</div>
                    {% endif %}
                </td>
                <td class="lh-text">
                    <h1 class="lh-name">{{ tenant.name }}</h1>
                    {% if tenant.address %}<p class="lh-address">{{ tenant.address }}</p>{% endif %}
                    {% set contacts = [] %}
                    {% if tenant.phoneNumber %}{% set contacts = contacts|merge([tenant.phoneNumber]) %}{% endif %}
                    {% if tenant.email %}{% set contacts = contacts|merge([tenant.email]) %}{% endif %}
                    {% if tenant.whatsappNumber %}{% set contacts = contacts|merge(['WhatsApp ' ~ tenant.whatsappNumber]) %}{% endif %}
                    {% if contacts|length %}<p class="lh-address">{{ contacts|join('  •  ') }}</p>{% endif %}
                    {% if tenant.motto %}<p class="lh-motto">&ldquo;{{ tenant.motto }}&rdquo;</p>{% endif %}
                </td>
                <td class="lh-spacer"></td>
            </tr>
        </table>
        <hr class="rule-thick">
        <hr class="rule-thin">

        {# ── REFERENCE & DATE ────────────────────────────────────────── #}
        <table class="meta">
            <tr>
                <td>
                    <span class="label">Our Ref:</span>
                    <span class="value ref-code">{{ student.admissionNumber ?? 'PENDING' }}</span>
                </td>
                <td class="date">
                    <span class="label">Date:</span>
                    <span class="value">{{ admittedOn|date('jS F, Y') }}</span>
                </td>
            </tr>
        </table>

        {# ── ADDRESSEE ───────────────────────────────────────────────── #}
        <div class="addressee">
            <p class="to">To:</p>
            <p class="name">{{ guardianName }}</p>
            {% if student.guardian and student.guardian.phoneNumber %}
                <p class="line">{{ student.guardian.phoneNumber }}</p>
            {% endif %}
        </div>

        {# ── SUBJECT ─────────────────────────────────────────────────── #}
        <p class="subject">
            Re: Provisional Offer of Admission
            {%- if placedIn %} into {{ placedIn }}{% endif %}
            {%- if sessionName %} for the {{ sessionName }} Academic Session{% endif %}
        </p>

        <p class="salutation">Dear {{ guardianName }},</p>

        {# ── THE OFFER ───────────────────────────────────────────────── #}
        {#
            Every particular in one sentence, on the owner's instruction: the
            letter reads as a letter, not as a form. Name, class, session, term,
            date and admission number all appear here and nowhere else.
        #}
        <p>
            We are pleased to inform you that your child/ward,
            <strong>{{ student.fullName|upper }}</strong>
            {%- if student.dateOfBirth %} (born {{ student.dateOfBirth|date('jS F, Y') }}){% endif %},
            has been offered <strong>provisional admission</strong>
            {%- if placedIn %} into <strong>{{ placedIn }}</strong>{% endif %}
            {%- if sessionName %} for the <strong>{{ sessionName }}</strong> academic session{% endif %}
            {%- if termName %}, commencing <strong>{{ termName }}</strong>{% endif %}
            {%- if student.admissionNumber %}, and has been assigned the admission number
                <strong style="font-family:'Courier New',monospace">{{ student.admissionNumber }}</strong>{% endif %}
            with effect from <strong>{{ admittedOn|date('jS F, Y') }}</strong>.
            The offer is made on the strength of the application received and remains subject
            to the conditions set out below.
        </p>

        {# ── CONDITIONS ──────────────────────────────────────────────── #}
        <p style="margin-bottom:3pt"><strong>This offer is subject to the following conditions:</strong></p>
        <ol class="conditions">
            <li>
                Payment of the prescribed school fees for the term. Fees may be paid in full or
                in part at the school's bursary, or online where the school offers it.
            </li>
            <li>
                Presentation of the pupil's birth certificate and the documents submitted with
                the application, for sighting by the school office.
            </li>
            <li>
                Completion of the school's medical and admission forms, together with any
                immunization record the school may require.
            </li>
            <li>
                Acceptance of this offer within two weeks of the date above. Where the offer is
                not taken up within that period, the place may be offered to another applicant.
            </li>
        </ol>

        <p>
            Kindly retain this letter: it records your child's admission and may be requested at any time.
            The admission number above identifies your child in the school's register.
        </p>

        <p>
            We congratulate you and your family, and we look forward to welcoming
            <strong>{{ student.firstName ?: 'your child' }}</strong> to {{ tenant.name }}.
        </p>

        {# ── SIGNATURE ───────────────────────────────────────────────── #}
        <table class="sign">
            <tr>
                <td class="who">
                    <p style="margin:0 0 8pt">Yours faithfully,</p>
                    {% if tenant.principalSignatureFilename %}
                        <img class="sig-img" src="{{ asset('uploads/signatures/' ~ tenant.principalSignatureFilename) }}" alt="">
                        <div class="sig-rule"></div>
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <p class="sig-name">{{ tenant.principalName ?: 'Principal' }}</p>
                    <p class="sig-role">{{ tenant.principalTitle ?: 'Principal / Head Teacher' }}</p>
                    <p class="sig-school">For: {{ tenant.name }}</p>
                </td>
                <td class="seal">
                    {# The school's official seal — drawn, not an image, so it needs no upload. #}
                    <svg class="seal-svg" viewBox="0 0 200 200" role="img" aria-label="Official seal — admitted">
                        <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="3"></circle>
                        <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="1"></circle>
                        <circle cx="100" cy="100" r="58" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                        <circle cx="100" cy="100" r="54" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2"></circle>

                        <defs>
                            <path id="sealTopArc" d="M 26,100 A 74,74 0 0,1 174,100"></path>
                            <path id="sealBottomArc" d="M 26,100 A 74,74 0 0,0 174,100"></path>
                        </defs>

                        <text font-size="13" font-weight="bold" font-family="sans-serif" letter-spacing="1" fill="currentColor">
                            <textPath href="#sealTopArc" startOffset="50%" text-anchor="middle" dominant-baseline="baseline">
                                {{ tenant.name|slice(0, 26)|upper }}
                            </textPath>
                        </text>

                        <text font-size="11" font-weight="bold" font-family="sans-serif" letter-spacing="3" fill="currentColor">
                            <textPath href="#sealBottomArc" startOffset="50%" text-anchor="middle" dominant-baseline="hanging">
                                ★ OFFICIAL SEAL ★
                            </textPath>
                        </text>

                        <text x="100" y="86" font-size="18" font-weight="900" font-family="sans-serif" text-anchor="middle" letter-spacing="2" fill="currentColor">
                            ADMITTED
                        </text>

                        <rect x="58" y="98" width="84" height="22" fill="none" stroke="currentColor" stroke-width="1"></rect>
                        <text x="100" y="113" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle" letter-spacing="1" fill="currentColor">
                            {{ admittedOn|date('d M Y')|upper }}
                        </text>

                        <text x="100" y="136" font-size="8" font-weight="bold" font-family="monospace" text-anchor="middle" fill="currentColor" opacity="0.85">
                            {{ student.admissionNumber|default('PENDING') }}
                        </text>
                    </svg>
                </td>
            </tr>
        </table>

    </div>

    {# ── FOOTER ──────────────────────────────────────────────────────── #}
    <div class="sheet-foot">
        <div class="foot">
            <table>
                <tr>
                    <td>
                        {{ tenant.name }}{% if tenant.address %} &middot; {{ tenant.address }}{% endif %}
                        {%- if tenant.phoneNumber %}<br>{{ tenant.phoneNumber }}{% endif %}
                        {%- if tenant.email %} &middot; {{ tenant.email }}{% endif %}
                    </td>
                    <td class="right">
                        <span class="code">{{ student.admissionNumber ?? '' }}</span><br>
                        Provisional admission letter &middot; issued electronically
                    </td>
                </tr>
            </table>
        </div>
    </div>

</div>

</body>
</html>
