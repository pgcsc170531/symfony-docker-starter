{% extends 'base.html.twig' %}

{% block title %}Applications{% endblock %}

{% block body %}
{# The bursar's review queue (DESIGN.md §7.3). Full width, 16px gutter, one
   column on a phone — the list is a stack of cards there because a 6-column
   table at 360px is unreadable no matter how you wrap it. #}
<div class="px-4">

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-ink-900">Applications</h1>
            <p class="mt-1 text-sm text-ink-500">
                Online applications from parents. Approving one creates the {{ learner }},
                the enrolment and the first invoice.
            </p>
        </div>
    </div>

    {# ── Counters ───────────────────────────────────────────────────── #}
    {% set tiles = [
        { key: 'queue',        label: 'Needs attention', status: 'queue',
          tone: 'text-accent-700 bg-accent-50' },
        { key: 'submitted',    label: 'New',             status: 'submitted',
          tone: 'text-accent-700 bg-accent-50' },
        { key: 'under_review', label: 'Under review',    status: 'under_review',
          tone: 'text-ink-700 bg-ink-100' },
        { key: 'needs_info',   label: 'Needs info',      status: 'needs_info',
          tone: 'text-pending bg-pending/10' },
        { key: 'enrolled',     label: 'Enrolled',        status: 'enrolled',
          tone: 'text-paid bg-paid/10' },
        { key: 'rejected',     label: 'Rejected',        status: 'rejected',
          tone: 'text-failed bg-failed/10' },
    ] %}

    <div class="mb-6 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6 sm:gap-3">
        {% for tile in tiles %}
            <a href="{{ path('app_tenant_application_index', {status: tile.status}) }}"
               class="rounded-xl border border-ink-200 bg-white p-3 transition hover:border-accent-300 hover:shadow-card">
                <span class="block text-2xl font-bold text-ink-900">{{ counters[tile.key]|default(0) }}</span>
                <span class="mt-0.5 inline-block rounded px-1.5 py-0.5 text-[11px] font-semibold {{ tile.tone }}">
                    {{ tile.label }}
                </span>
            </a>
        {% endfor %}
    </div>

    {# ── Filters ────────────────────────────────────────────────────── #}
    <form method="get" action="{{ path('app_tenant_application_index') }}"
          class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end">
        <div class="flex-1">
            <label for="q" class="mb-1 block text-sm font-medium text-ink-700">Search</label>
            <input id="q" name="q" value="{{ q }}" type="search"
                   placeholder="Reference, child, parent, phone or email"
                   class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:ring-accent-500">
        </div>
        <div class="sm:w-52">
            <label for="status" class="mb-1 block text-sm font-medium text-ink-700">Status</label>
            <select id="status" name="status"
                    class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                <option value="queue"        {{ status == 'queue'        ? 'selected' }}>Needs attention</option>
                <option value="submitted"    {{ status == 'submitted'    ? 'selected' }}>New</option>
                <option value="under_review" {{ status == 'under_review' ? 'selected' }}>Under review</option>
                <option value="needs_info"   {{ status == 'needs_info'   ? 'selected' }}>Needs info</option>
                <option value="waitlisted"   {{ status == 'waitlisted'   ? 'selected' }}>Waitlisted</option>
                <option value="approved"     {{ status == 'approved'     ? 'selected' }}>Approved</option>
                <option value="enrolled"     {{ status == 'enrolled'     ? 'selected' }}>Enrolled</option>
                <option value="rejected"     {{ status == 'rejected'     ? 'selected' }}>Rejected</option>
                <option value="withdrawn"    {{ status == 'withdrawn'    ? 'selected' }}>Withdrawn</option>
                <option value="all"          {{ status == 'all'          ? 'selected' }}>Everything</option>
            </select>
        </div>
        <button type="submit"
                class="min-h-[44px] w-full rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700 sm:w-auto">
            Filter
        </button>
    </form>

    {# ── List ───────────────────────────────────────────────────────── #}
    {% if applications is empty %}
        <div class="rounded-xl border border-dashed border-ink-300 bg-white px-6 py-12 text-center">
            <p class="text-lg font-semibold text-ink-700">Nothing here</p>
            <p class="mx-auto mt-1 max-w-md text-sm text-ink-500">
                {% if q %}
                    No application matches “{{ q }}”.
                {% else %}
                    No applications with this status. Parents apply through the public
                    <span class="font-medium">/apply</span> page.
                {% endif %}
            </p>
        </div>
    {% else %}

        {# Phone: cards #}
        <ul class="space-y-3 md:hidden">
            {% for app in applications %}
                <li>
                    <a href="{{ path('app_tenant_application_show', {id: app.id}) }}"
                       class="block rounded-xl border border-ink-200 bg-white p-4 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-ink-900">{{ app.fullName }}</p>
                                <p class="mt-0.5 break-words text-xs text-ink-500">{{ app.reference }}</p>
                            </div>
                            <span class="shrink-0 rounded px-2 py-0.5 text-[11px] font-semibold {{ _self.badge(app.status) }}">
                                {{ app.status|replace({'_': ' '})|capitalize }}
                            </span>
                        </div>
                        <dl class="mt-3 grid grid-cols-2 gap-y-1 text-xs">
                            <dt class="text-ink-500">Class</dt>
                            <dd class="text-right font-medium text-ink-900">{{ app.requestedClassroom ? app.requestedClassroom.name : '—' }}</dd>
                            <dt class="text-ink-500">Parent</dt>
                            <dd class="truncate text-right font-medium text-ink-900">{{ app.guardianName ?: '—' }}</dd>
                            <dt class="text-ink-500">Applied</dt>
                            <dd class="text-right font-medium text-ink-900">{{ app.createdAt ? app.createdAt|date('d M Y') : '—' }}</dd>
                        </dl>
                    </a>
                </li>
            {% endfor %}
        </ul>

        {# Tablet and up: the table #}
        <div class="hidden overflow-x-auto rounded-xl border border-ink-200 bg-white shadow-card md:block">
            <table class="w-full min-w-[720px] text-sm">
                <thead class="bg-ink-100 text-left text-xs uppercase tracking-wide text-ink-500">
                    <tr>
                        <th class="px-4 py-3 font-semibold">Reference</th>
                        <th class="px-4 py-3 font-semibold">Child</th>
                        <th class="px-4 py-3 font-semibold">Class</th>
                        <th class="px-4 py-3 font-semibold">Parent</th>
                        <th class="px-4 py-3 font-semibold">Applied</th>
                        <th class="px-4 py-3 font-semibold">Status</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for app in applications %}
                        <tr class="hover:bg-ink-50">
                            <td class="px-4 py-3 font-mono text-xs text-ink-600">{{ app.reference }}</td>
                            <td class="px-4 py-3 font-semibold text-ink-900">
                                <a href="{{ path('app_tenant_application_show', {id: app.id}) }}"
                                   class="hover:text-accent-700 hover:underline">{{ app.fullName }}</a>
                            </td>
                            <td class="px-4 py-3 text-ink-700">{{ app.requestedClassroom ? app.requestedClassroom.name : '—' }}</td>
                            <td class="px-4 py-3 text-ink-700">
                                <span class="block">{{ app.guardianName ?: '—' }}</span>
                                <span class="block text-xs text-ink-500">{{ app.guardianPhone }}</span>
                            </td>
                            <td class="px-4 py-3 text-ink-600">{{ app.createdAt ? app.createdAt|date('d M Y') : '—' }}</td>
                            <td class="px-4 py-3">
                                <span class="rounded px-2 py-0.5 text-[11px] font-semibold {{ _self.badge(app.status) }}">
                                    {{ app.status|replace({'_': ' '})|capitalize }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a href="{{ path('app_tenant_application_show', {id: app.id}) }}"
                                   class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-3 text-xs font-semibold text-ink-700 transition hover:border-accent-400 hover:text-accent-700">
                                    Review
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Status colour means status, never decoration — accent for "in flight",
   pending for "waiting on someone", paid for "done", failed for "closed out". #}
{% macro badge(status) %}
    {%- set map = {
        submitted:    'bg-accent-50 text-accent-700',
        under_review: 'bg-accent-50 text-accent-700',
        approved:     'bg-paid/10 text-paid',
        enrolled:     'bg-paid/10 text-paid',
        needs_info:   'bg-pending/10 text-pending',
        waitlisted:   'bg-ink-100 text-ink-700',
        draft:        'bg-ink-100 text-ink-600',
        awaiting_payment: 'bg-pending/10 text-pending',
        rejected:     'bg-failed/10 text-failed',
        withdrawn:    'bg-ink-100 text-ink-500',
    } -%}
    {{- map[status]|default('bg-ink-100 text-ink-700') -}}
{% endmacro %}
{% endblock %}
