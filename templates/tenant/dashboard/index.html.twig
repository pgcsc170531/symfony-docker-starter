{% extends 'base.html.twig' %}

{% import 'tenant/dashboard/_kpi.html.twig' as kpi %}

{% block title %}{{ persona.label }} dashboard{% endblock %}

{% block body %}

{# The page gutter lives here, not on <main> — see docs/architecture/UI-SPEC.md §4.1. #}
<div class="px-4 py-4">

    {# ═══ 1. WHO IS LOOKING AT THIS ═══════════════════════════════════
       The shell already names the school and the person. This header names the
       *seat*: the same URL answers differently for the bursar, the form teacher
       and the overseer, so it has to say which one is speaking. #}
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent-600">{{ persona.label }}</p>
            <h1 class="text-2xl font-semibold tracking-tight text-ink-900">Dashboard</h1>
            <p class="text-sm leading-relaxed text-ink-500">{{ persona.headline }}</p>
            <p class="mt-1 text-sm text-ink-500">
                {% if currentSession %}
                    <span class="font-semibold text-ink-700">{{ currentSession.name }}</span>
                    {% if currentTerm %}
                        <span class="mx-2 text-ink-300">|</span>{{ currentTerm.name }}
                    {% endif %}
                {% else %}
                    <span class="badge-failed">No active session</span>
                {% endif %}
            </p>
        </div>

        {# The date is the one fact that is the same for every seat. Full width on
           a phone so it stays a thumb-sized target, auto on a desktop. #}
        <div class="flex min-h-[44px] w-full items-center justify-between gap-3 rounded-lg border border-ink-200 bg-white px-4 py-2 shadow-card sm:w-auto sm:justify-start">
            <div class="text-left sm:text-right">
                <div class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Today</div>
                <div class="text-sm font-semibold leading-none text-ink-900">{{ "now"|date("l, M j") }}</div>
            </div>
            <div class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-600">
                {{ kpi.icon('clock') }}
            </div>
        </div>
    </div>

    {# A school with nobody enrolled: say what is missing instead of drawing a
       dashboard full of zeroes. Administrators are redirected to onboarding
       before they ever reach this page. #}
    {% if studentCount == 0 %}
        <div class="mb-6 rounded-lg border border-pending/30 bg-pending/10 p-4">
            <p class="text-sm font-semibold text-ink-900">No {{ learner.plural }} have been enrolled yet</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">
                Your school is set up but the register is empty. An administrator needs to
                finish the setup wizard before attendance, results and fees have anything to show.
            </p>
        </div>
    {% endif %}

    {# ═══ 2. YOUR WORK — the actionable part ═══════════════════════════
       Everything on this list belongs to the person reading it. If it is empty,
       that is worth saying: a blank space reads as a broken page. #}
    {% if actions|length %}
        <section class="mb-8" aria-labelledby="your-work-heading">
            <h2 id="your-work-heading" class="mb-3 text-sm font-semibold text-ink-900">Your work</h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {% for action in actions %}
                    <a href="{{ action.url }}"
                       class="flex min-h-[68px] items-center gap-3 rounded-lg border border-ink-200 bg-white p-4 shadow-card transition-colors hover:border-accent-300">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg
                            {%- if action.tone == 'failed' %} bg-failed/10 text-failed
                            {%- elseif action.tone == 'pending' %} bg-pending/10 text-pending
                            {%- else %} bg-accent-50 text-accent-600{% endif %}">
                            {{ kpi.icon(action.tone == 'failed' ? 'alert' : (action.tone == 'pending' ? 'clock' : 'check')) }}
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block text-sm font-semibold leading-snug text-ink-900">{{ action.label }}</span>
                            <span class="mt-0.5 block text-xs leading-relaxed text-ink-500">{{ action.hint }}</span>
                        </span>
                        <span class="shrink-0 text-ink-400" aria-hidden="true">&rarr;</span>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% else %}
        <p class="mb-8 rounded-lg border border-paid/30 bg-paid/10 p-4 text-sm text-ink-700">
            Nothing is waiting on you right now.
        </p>
    {% endif %}

    {# ═══ 3. THE PANELS THIS SEAT MAY SEE ═════════════════════════════
       Each partial is included only when the persona can see it, and the
       controller only loads the data for those same panels. #}
    {% if persona.seesWholeSchool() %}
        {% include 'tenant/dashboard/_overview.html.twig' %}
    {% else %}
        {% if persona.canSeeAdmissions is defined and persona.canSeeAdmissions and admissions is defined %}
            {% include 'tenant/dashboard/_admissions.html.twig' %}
        {% endif %}
        {% if persona.canSeeFinance %}
            {% include 'tenant/dashboard/_finance.html.twig' %}
        {% endif %}
        {% if persona.canSeeStore %}
            {% include 'tenant/dashboard/_store.html.twig' %}
        {% endif %}
    {% endif %}

    {% if teaching is defined and (teaching.total > 0 or not persona.seesWholeSchool()) %}
        {% include 'tenant/dashboard/_teaching.html.twig' %}
    {% endif %}

    {% if formClass is defined and formClass %}
        {% include 'tenant/dashboard/_form_class.html.twig' %}
    {% endif %}

    {% if (departments is defined and departments|length > 0) or (yearGroups is defined and yearGroups|length > 0) %}
        {% include 'tenant/dashboard/_approvals.html.twig' %}
    {% endif %}

    {# A staff account with no seat at all — usually a login created before a job
       title was assigned. An empty page would look like a bug. #}
    {% if not persona.seesWholeSchool()
        and not persona.canSeeFinance
        and not persona.canSeeAdmissions
        and not persona.canSeeStore
        and not persona.canSeeTeaching
        and not persona.isFormTeacher
        and not persona.isHod
        and not persona.isYearGroupMaster %}
        <div class="rounded-lg border border-dashed border-ink-300 bg-white p-6 text-center">
            <p class="text-sm font-semibold text-ink-900">Your account has no responsibilities yet</p>
            <p class="mx-auto mt-1 max-w-md text-sm leading-relaxed text-ink-500">
                Ask an administrator to give you a job title on the Staff screen. Once you are
                a form teacher, an HOD or a subject teacher, this page fills itself in.
            </p>
        </div>
    {% endif %}

</div>{# / page gutter #}

{% endblock %}
