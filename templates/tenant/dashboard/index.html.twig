{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}

{# The page gutter lives here, not on <main> — see docs/architecture/UI-SPEC.md §4.1. #}
<div class="px-4 py-4">

{# === 1. HEADER SECTION === #}
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    
    {# Title Section #}
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-ink-900">Dashboard</h1>
        <p class="text-sm font-medium text-ink-500">
            {% if currentSession %}
                <span class="font-semibold text-accent-600">{{ currentSession.name }}</span> 
                <span class="text-ink-300 mx-2">|</span> 
                {{ currentTerm.name|default('No Term') }}
            {% else %}
                <span class="badge-failed">System halted</span>
            {% endif %}
        </p>
    </div>
    
    {# Date Pill (Full width on mobile for touch target, Auto on desktop) #}
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            
            {# 🟢 NEW: "Resume Setup" Button (Only shows if no students exist) #}
            {% if studentCount == 0 %}
                <a href="{{ path('app_tenant_onboarding_identity') }}" class="flex min-h-[44px] w-full items-center justify-center gap-2 rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white shadow-card transition-colors hover:bg-accent-700 sm:w-auto">
                    Resume setup
                </a>
            {% endif %}

            {# Date pill #}
            <div class="flex min-h-[44px] w-full items-center justify-between gap-3 rounded-lg border border-ink-200 bg-white px-4 py-2 shadow-card sm:w-auto sm:justify-start">
                <div class="text-left sm:text-right">
                    <div class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Today</div>
                    <div class="text-sm font-semibold leading-none text-ink-900">{{ "now"|date("l, M j") }}</div>
                </div>
                <div class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-600" aria-hidden="true">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M4 11h16M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
            </div>
    </div>

</div>

{# === 2. HEADLINE FIGURES ===
   Four numbers, not five. "Active debtor count" is a detail OF the debt, so it
   lives in that card rather than shouting on its own — and four is what the grid
   holds, so nothing wraps onto a second row by itself.

   Flat white cards. Neutral figures. The accent appears only on the one thing you
   can act on, and colour appears only where a state exists. #}
<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

    {# ── Wallet balance ──────────────────────────────────────────────── #}
    <div class="flex flex-col rounded-lg border border-ink-200 bg-white p-5 shadow-card">
        <div class="flex items-start justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Wallet balance</p>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-600" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/>
                    <path stroke-linecap="round" d="M16 13h.01"/>
                </svg>
            </span>
        </div>
        <p class="money mt-3 text-2xl font-semibold tracking-tight text-ink-900">
            ₦{{ landlordSchool.walletBalance|default(0)|number_format(0) }}
        </p>
        <a href="{{ path('tenant_wallet_index') }}"
           class="mt-auto inline-flex min-h-[44px] items-center pt-3 text-sm font-semibold text-accent-600 hover:text-accent-700">
            Top up or view history &rarr;
        </a>
    </div>

    {# ── Students ────────────────────────────────────────────────────── #}
    <div class="flex flex-col rounded-lg border border-ink-200 bg-white p-5 shadow-card">
        <div class="flex items-start justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">{{ learner.pluralCapital }}</p>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-600" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.42A12 12 0 0112 21a12 12 0 01-6.16-10.42L12 14z"/>
                </svg>
            </span>
        </div>
        <p class="tabular mt-3 text-2xl font-semibold tracking-tight text-ink-900">{{ studentCount }}</p>
        <a href="{{ path('app_tenant_student_index') }}"
           class="mt-auto inline-flex min-h-[44px] items-center pt-3 text-sm font-semibold text-accent-600 hover:text-accent-700">
            View directory &rarr;
        </a>
    </div>

    {# ── Cash in today ───────────────────────────────────────────────── #}
    <div class="flex flex-col rounded-lg border border-ink-200 bg-white p-5 shadow-card">
        <div class="flex items-start justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Cash in today</p>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-600" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 9v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                </svg>
            </span>
        </div>
        <p class="money mt-3 text-2xl font-semibold tracking-tight text-ink-900">
            ₦{{ cashInToday|number_format(0) }}
        </p>
        <p class="mt-auto pt-3 text-sm text-ink-500">Confirmed payments</p>
    </div>

    {# ── Fees outstanding ────────────────────────────────────────────── #}
    <div class="flex flex-col rounded-lg border border-ink-200 bg-white p-5 shadow-card">
        <div class="flex items-start justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Fees outstanding</p>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-600" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </span>
        </div>
        <p class="money mt-3 text-2xl font-semibold tracking-tight text-ink-900">
            ₦{{ totalDebt|number_format(0) }}
        </p>
        {# The badge states the state in words — never colour alone. #}
        <div class="mt-auto pt-3">
            {% if debtors|length > 0 %}
                <a href="{{ path('app_tenant_invoice_index') }}" class="badge-pending">Across {{ debtorCount|default(debtors|length) }} student{{ debtorCount|default(debtors|length) == 1 ? '' : 's' }}</a>
            {% else %}
                <span class="badge-paid">Nothing outstanding</span>
            {% endif %}
        </div>
    </div>

</div>

{# === 3. DATA TABLES === #}
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    {# LOW STOCK #}
    <section class="flex h-full flex-col overflow-hidden rounded-lg border border-ink-200 bg-white shadow-card">
        <div class="flex items-center justify-between gap-3 border-b border-ink-200 px-5 py-3">
            <h2 class="text-sm font-semibold text-ink-900">Low stock</h2>
            <a href="{{ path('app_tenant_product_index') }}"
               class="inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-600 hover:text-accent-700">Manage &rarr;</a>
        </div>
        <div class="flex-1 overflow-x-auto">
            <table class="w-full min-w-[420px] text-left text-sm">
                <thead>
                    <tr class="border-b border-ink-200">
                        <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-ink-500">Item</th>
                        <th scope="col" class="px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-ink-500">In stock</th>
                        <th scope="col" class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-ink-500">Unit price</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for product in lowStock %}
                    <tr>
                        <td class="px-5 py-3 font-medium text-ink-900">{{ product.name }}</td>
                        <td class="px-5 py-3 text-center"><span class="badge-failed">{{ product.stockQuantity }} left</span></td>
                        <td class="money px-5 py-3 text-right text-ink-600">₦{{ product.unitPrice|number_format(2) }}</td>
                    </tr>
                    {% else %}
                        <tr><td colspan="3" class="px-5 py-8 text-center text-sm text-ink-500">Nothing is running low.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# HIGHEST DEBTS #}
    <section class="flex h-full flex-col overflow-hidden rounded-lg border border-ink-200 bg-white shadow-card">
        <div class="flex items-center justify-between gap-3 border-b border-ink-200 px-5 py-3">
            <h2 class="text-sm font-semibold text-ink-900">Highest debts</h2>
            <a href="{{ path('app_tenant_invoice_index') }}"
               class="inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-600 hover:text-accent-700">View all &rarr;</a>
        </div>
        <div class="flex-1 overflow-x-auto">
            <table class="w-full min-w-[420px] text-left text-sm">
                <thead>
                    <tr class="border-b border-ink-200">
                        <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-ink-500">{{ learner.capital }}</th>
                        <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-ink-500">Invoice</th>
                        <th scope="col" class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-ink-500">Owing</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for invoice in debtors %}
                    <tr>
                        <td class="px-5 py-3">
                            {# A real link, not an onclick on the row: a row is not
                               reachable by keyboard, and a screen reader cannot
                               announce it. #}
                            <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}"
                               class="inline-flex min-h-[44px] flex-col justify-center font-semibold text-ink-900 hover:text-accent-600">
                                {{ invoice.student.fullName }}
                                <span class="text-xs font-normal text-ink-500">{{ invoice.student.admissionNumber }}</span>
                            </a>
                        </td>
                        <td class="px-5 py-3 text-xs text-ink-500">
                            <span class="badge-neutral">{{ invoice.invoiceNumber }}</span>
                        </td>
                        <td class="money px-5 py-3 text-right font-semibold text-ink-900">
                            ₦{{ (invoice.totalAmount - invoice.paidAmount)|number_format(2) }}
                        </td>
                    </tr>
                    {% else %}
                        <tr><td colspan="3" class="px-5 py-8 text-center text-sm text-ink-500">No debts found.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>

</div>{# / page gutter #}

{% endblock %}