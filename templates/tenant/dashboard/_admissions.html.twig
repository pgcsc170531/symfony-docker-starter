{#
    Admissions panel — the admissions officer's desk.

    A narrow, honest view: what is waiting for a decision and the oldest files
    first, because a parent who applied three weeks ago should not sit behind the
    one who applied yesterday. No money, no results, no school-wide figures —
    this seat admits children.
#}
{% import 'tenant/dashboard/_kpi.html.twig' as kpi %}

<section class="mb-8" aria-labelledby="admissions-heading">
    <h2 id="admissions-heading" class="mb-3 text-sm font-semibold text-ink-900">Admissions queue</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {{ kpi.kpi('To review', admissions.submitted,
            admissions.submitted > 0 ? 'Waiting for a first decision' : 'Nothing new',
            path('app_tenant_application_index', {status: 'queue'}), 'Open queue', 'applications') }}
        {{ kpi.kpi('Under review', admissions.underReview,
            'Files you have opened',
            path('app_tenant_application_index', {status: 'under_review'}), 'Continue', 'clock') }}
        {{ kpi.kpi('Needs info', admissions.needsInfo,
            admissions.needsInfo > 0 ? 'Sent back to the parent' : 'Nothing outstanding',
            path('app_tenant_application_index', {status: 'needs_info'}), 'See them', 'alert') }}
    </div>
</section>

{% if admissions.recent|length %}
    <section class="mb-8 rounded-lg border border-ink-200 bg-white shadow-card" aria-labelledby="oldest-heading">
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-ink-100 p-4">
            <div class="min-w-0">
                <h2 id="oldest-heading" class="text-sm font-semibold text-ink-900">Oldest first</h2>
                <p class="mt-1 text-xs leading-relaxed text-ink-500">
                    The five that have waited longest. Open a file, check the uploaded
                    documents and offer a place — the arm is chosen when you enrol.
                </p>
            </div>
            <a href="{{ path('app_tenant_application_index') }}"
               class="inline-flex min-h-[44px] shrink-0 items-center text-xs font-semibold text-accent-700 hover:underline">
                All applications &rarr;
            </a>
        </div>

        <ul class="divide-y divide-ink-100">
            {% for application in admissions.recent %}
                <li>
                    <a href="{{ path('app_tenant_application_show', {id: application.id}) }}"
                       class="flex min-h-[56px] items-center gap-3 p-4 transition-colors hover:bg-ink-50">
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-semibold text-ink-900">
                                {{ application.fullName ?: 'Unnamed draft' }}
                            </span>
                            <span class="mt-0.5 block text-xs text-ink-500">
                                {{ application.reference ?: 'no reference' }}
                                {%- if application.requestedClassName %} &middot; {{ application.requestedClassName }}{% endif %}
                                {%- if application.submittedAt %} &middot; {{ application.submittedAt|date('j M') }}{% endif %}
                            </span>
                        </span>
                        <span class="badge-{{ application.status == 'needs_info' ? 'pending' : 'neutral' }} shrink-0">
                            {{ application.statusLabel }}
                        </span>
                        <span class="shrink-0 text-ink-400" aria-hidden="true">&rarr;</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
