{% extends 'tenant/base.html.twig' %}

{% block title %}Website Settings - {{ school.name }}{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900">School Website Settings</h1>
    <p class="mt-2 text-sm text-gray-500">
        These details personalise your public website and make it unique to your school.
    </p>

    {% for message in app.flashes('success') %}
        <div class="mt-4 rounded-md bg-green-50 p-4 text-sm text-green-800 border border-green-200">{{ message }}</div>
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'mt-8 bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6'}}) }}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_errors(form.name) }}
        </div>
        <div>
            {{ form_label(form.motto, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.motto, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_errors(form.motto) }}
        </div>
        <div>
            {{ form_label(form.heroTagline, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.heroTagline, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_help(form.heroTagline) }}
        </div>
        <div>
            {{ form_label(form.primaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.primaryColor, {'attr': {'class': 'mt-1 block w-24 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_errors(form.primaryColor) }}
        </div>
        <div>
            {{ form_label(form.logoFile, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.logoFile, {'attr': {'class': 'mt-1 block w-full text-sm text-gray-600'}}) }}
            {{ form_help(form.logoFile) }}
        </div>
        <div>
            {{ form_label(form.heroImageFile, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.heroImageFile, {'attr': {'class': 'mt-1 block w-full text-sm text-gray-600'}}) }}
            {{ form_help(form.heroImageFile) }}
        </div>
        <div class="md:col-span-2">
            {{ form_label(form.aboutContent, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.aboutContent, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_errors(form.aboutContent) }}
        </div>
        <div class="md:col-span-2">
            {{ form_label(form.admissionsIntro, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.admissionsIntro, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_errors(form.admissionsIntro) }}
        </div>
        <div class="md:col-span-2">
            {{ form_label(form.mapEmbedUrl, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.mapEmbedUrl, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
            {{ form_help(form.mapEmbedUrl) }}
        </div>
        <div>
            {{ form_label(form.address, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.address, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
        <div>
            {{ form_label(form.phoneNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.phoneNumber, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
        <div>
            {{ form_label(form.website, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.website, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
        <div>
            {{ form_label(form.facebookUrl, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.facebookUrl, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
        <div>
            {{ form_label(form.twitterUrl, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.twitterUrl, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
        <div>
            {{ form_label(form.instagramUrl, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.instagramUrl, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
        </div>
    </div>

    <div class="pt-4 border-t border-gray-100">
        <button type="submit" class="inline-flex justify-center rounded-md border border-transparent px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90" style="background-color: {{ school.primaryColor ?: '#1e40af' }};">
            Save Settings
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}