{% extends 'base.html.twig' %}

{% block title %}Marking scheme{% endblock %}

{% block body %}
{% set ca = form.caCount.vars.data|default(3) %}
{% set caMax = form.caMax.vars.data|default(20) %}
{% set theory = form.theoryMax.vars.data|default(60) %}
{% set practical = form.practicalMax.vars.data|default(0) %}
{% set dual = form.examMode.vars.data == 'dual' %}
{% set total = (ca * caMax) + theory + (dual ? practical : 0) %}

<div class="px-4 py-4 sm:py-6">
    <div class="mb-5">
        <a href="{{ path('app_tenant_reports_hub') }}"
           class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; Reports</a>
        <h1 class="mt-1 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl">Marking scheme</h1>
        <p class="mt-1 max-w-2xl text-sm text-ink-600">
            How a subject is scored in this school. These numbers decide the boxes a teacher fills and the
            columns a report card prints — nothing here is fixed in code.
        </p>
    </div>

    {% if not session %}
        <div class="mb-5 rounded-xl border border-failed/40 bg-failed/5 p-4" role="alert">
            <p class="text-sm font-bold text-ink-900">No active session.</p>
            <p class="mt-1 text-sm text-ink-700">
                Set the current session first (Session &amp; term). The scheme is stored per term, and there is
                no term to store it in yet.
            </p>
        </div>
    {% elseif terms is empty %}
        <div class="mb-5 rounded-xl border border-failed/40 bg-failed/5 p-4" role="alert">
            <p class="text-sm font-bold text-ink-900">{{ session.name }} has no terms.</p>
            <p class="mt-1 text-sm text-ink-700">Add the session’s terms, then come back — the scheme is stored against each term.</p>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <section class="rounded-xl border border-ink-200 bg-white p-4 shadow-card lg:col-span-2">
            {{ form_start(form) }}

            <div class="mb-5">
                <p class="text-[11px] font-black uppercase tracking-wide text-ink-500">Continuous assessment</p>
                <div class="mt-2 space-y-2">
                    {% for child in form.caCount %}
                        <label class="flex min-h-[44px] items-center gap-3 rounded-lg border border-ink-200 px-3 text-sm font-semibold text-ink-800">
                            {{ form_widget(child, {'attr': {'class': 'h-4 w-4 shrink-0 accent-accent-600'}}) }}
                            <span>{{ child.vars.label }}</span>
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.caCount) }}
                <p class="mt-2 text-xs leading-relaxed text-ink-500">{{ form.caCount.vars.help }}</p>

                <div class="mt-3">
                    {{ form_label(form.caMax, null, {'label_attr': {'class': 'block text-sm font-semibold text-ink-700'}}) }}
                    {{ form_widget(form.caMax, {'attr': {
                        'class': 'mt-1 block min-h-[44px] w-full max-w-[160px] rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500',
                        'inputmode': 'numeric'
                    }}) }}
                    {{ form_errors(form.caMax) }}
                    <p class="mt-1 text-xs leading-relaxed text-ink-500">{{ form.caMax.vars.help }}</p>
                </div>
            </div>

            <div class="mb-5 border-t border-ink-100 pt-5">
                <p class="text-[11px] font-black uppercase tracking-wide text-ink-500">Examination</p>
                <div class="mt-2 space-y-2">
                    {% for child in form.examMode %}
                        <label class="flex min-h-[44px] items-center gap-3 rounded-lg border border-ink-200 px-3 text-sm font-semibold text-ink-800">
                            {{ form_widget(child, {'attr': {'class': 'h-4 w-4 shrink-0 accent-accent-600'}}) }}
                            <span>{{ child.vars.label }}</span>
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.examMode) }}
                <p class="mt-2 text-xs leading-relaxed text-ink-500">{{ form.examMode.vars.help }}</p>

                <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div>
                        {{ form_label(form.theoryMax, null, {'label_attr': {'class': 'block text-sm font-semibold text-ink-700'}}) }}
                        {{ form_widget(form.theoryMax, {'attr': {
                            'class': 'mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500',
                            'inputmode': 'numeric'
                        }}) }}
                        {{ form_errors(form.theoryMax) }}
                    </div>
                    <div>
                        {{ form_label(form.practicalMax, null, {'label_attr': {'class': 'block text-sm font-semibold text-ink-700'}}) }}
                        {{ form_widget(form.practicalMax, {'attr': {
                            'class': 'mt-1 block min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500',
                            'inputmode': 'numeric'
                        }}) }}
                        {{ form_errors(form.practicalMax) }}
                        <p class="mt-1 text-xs leading-relaxed text-ink-500">{{ form.practicalMax.vars.help }}</p>
                    </div>
                </div>
            </div>

            <button type="submit"
                    class="min-h-[44px] w-full rounded-lg bg-accent-600 px-6 text-sm font-bold text-white shadow-sm hover:bg-accent-700 sm:w-auto">
                Save marking scheme
            </button>
            {{ form_end(form) }}
        </section>

        <aside class="space-y-4">
            <div class="rounded-xl border border-accent-200 bg-accent-50 p-4">
                <p class="text-[11px] font-black uppercase tracking-wide text-accent-700">What this produces</p>
                <dl class="mt-3 space-y-2 text-sm text-ink-800">
                    {% for i in 1..ca %}
                        <div class="flex items-baseline justify-between gap-2 border-b border-accent-200/60 pb-2">
                            <dt class="font-semibold">CA {{ i }}</dt>
                            <dd class="money">out of {{ caMax }}</dd>
                        </div>
                    {% endfor %}
                    <div class="flex items-baseline justify-between gap-2 border-b border-accent-200/60 pb-2">
                        <dt class="font-semibold">Exam</dt>
                        <dd class="money">out of {{ theory }}</dd>
                    </div>
                    {% if dual %}
                        <div class="flex items-baseline justify-between gap-2 border-b border-accent-200/60 pb-2">
                            <dt class="font-semibold">Practical</dt>
                            <dd class="money">out of {{ practical }}</dd>
                        </div>
                    {% endif %}
                    <div class="flex items-baseline justify-between gap-2 pt-1">
                        <dt class="font-black text-ink-900">Subject total</dt>
                        <dd class="money font-black text-ink-900">{{ total }}</dd>
                    </div>
                </dl>
                <p class="mt-3 text-xs leading-relaxed text-ink-600">
                    The figures above are what you last saved. Save again to see the new total.
                </p>
            </div>

            <div class="rounded-xl border border-ink-200 bg-white p-4 text-xs leading-relaxed text-ink-600">
                <p class="font-bold text-ink-900">Applies to</p>
                <p class="mt-1">
                    {% if session %}
                        Every term of <strong class="text-ink-900">{{ session.name }}</strong>{% if terms is not empty %}
                        ({{ terms|map(t => t.name)|join(', ') }}){% endif %},
                        for every class and subject that has no scheme of its own.
                    {% else %}
                        The whole school, once a session is active.
                    {% endif %}
                </p>
                {% if overrides > 0 %}
                    <p class="mt-3 rounded-lg border border-pending/40 bg-pending/5 p-2 font-semibold text-ink-800">
                        {{ overrides }} class or subject scheme{{ overrides == 1 ? '' : 's' }} already override this.
                        They keep their own maxima.
                    </p>
                {% endif %}
            </div>
        </aside>
    </div>
</div>
{% endblock %}
