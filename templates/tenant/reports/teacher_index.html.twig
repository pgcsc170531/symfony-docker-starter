{% extends 'base.html.twig' %}

{% block title %}Teacher Report{% endblock %}

{% block body %}
<div class="p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">🧑‍🏫 Teacher Report</h1>

    {% if assignments is empty %}
        <div class="bg-white rounded-lg shadow p-6 text-gray-500">You have no subject assignments.</div>
    {% else %}
        <div class="grid gap-3">
            {% for a in assignments %}
                <a href="{{ path('app_tenant_report_teacher_show', {id: a.id}) }}"
                   class="bg-white rounded-lg shadow p-4 hover:bg-blue-50 transition">
                    <div class="font-semibold">{{ a.subject.name }}</div>
                    <div class="text-sm text-gray-600">{{ a.classroom.name }} • {{ a.term.name }} ({{ a.term.session.name }})</div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
