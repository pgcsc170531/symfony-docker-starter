<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Class reports — {{ classroom.name }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% include '_design_tokens.html.twig' %}
    <style>
        body { background-color: #F9FAFB; }
        @media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .print-page { page-break-after: always; break-after: page; }
            .print-page:last-child { page-break-after: auto; break-after: auto; }
            .px-4 { padding-left: 0 !important; padding-right: 0 !important; }
            article { box-shadow: none !important; border: 0.6pt solid #D1D5DB !important; margin-bottom: 0 !important; }
            @page { size: A4 portrait; margin: 9mm; }
        }
    </style>
</head>
<body>

    <div class="no-print sticky top-0 z-10 border-b border-ink-200 bg-white px-4 py-3">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
                <p class="text-base font-bold text-ink-900">{{ classroom.name }} — class reports</p>
                <p class="text-xs text-ink-500">{{ term.name }}{% if term.session %} · {{ term.session.name }}{% endif %} · {{ sheets|length }} {{ learner.plural }}</p>
            </div>
            <div class="flex flex-col gap-2 sm:flex-row">
                <button type="button" onclick="window.print()"
                        class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white hover:bg-accent-700">
                    Print all
                </button>
                <a href="{{ path('app_tenant_my_class', {classroom: classroom.id}) }}"
                   class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                    Back to My Class
                </a>
            </div>
        </div>
        <p class="mt-2 text-[11px] text-ink-400">
            Each {{ learner }} starts on a new page. Withheld reports print as a notice, never as blank paper.
        </p>
    </div>

    <div class="px-4 py-4">
        {% for sheet in sheets %}
            <div class="print-page">
                {% if sheet.withheld|default(false) %}
                    <div class="mb-6 rounded-xl border border-pending/30 bg-white p-6 text-center">
                        <p class="text-lg font-bold text-ink-900">Report withheld — outstanding fees</p>
                        <p class="mt-2 text-sm text-ink-600">
                            {{ sheet.student.fullName }} · {{ classroom.name }} · {{ term.name }}
                        </p>
                        <p class="mt-2 text-sm text-ink-500">
                            Balance: <strong class="tabular">₦{{ sheet.outstanding|number_format(2) }}</strong>
                        </p>
                    </div>
                {% else %}
                    {% include 'tenant/reports/_document.html.twig' with {sheet: sheet, term: term} %}
                {% endif %}
            </div>
        {% else %}
            <div class="rounded-xl border border-dashed border-ink-300 bg-white px-6 py-12 text-center">
                <p class="text-lg font-semibold text-ink-700">No {{ learner.plural }} in this class</p>
            </div>
        {% endfor %}
    </div>

</body>
</html>
