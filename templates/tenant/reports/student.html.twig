{% extends 'base.html.twig' %}

{% block title %}My Results{% endblock %}

{% block body %}
<div class="p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">🎓 My Results</h1>

    {% for entry in result %}
        <div class="bg-white rounded-lg shadow p-5 mb-6">
            <h2 class="text-lg font-semibold mb-4">{{ entry.student.fullName }}</h2>

            {% for termId, termData in entry.terms %}
                <div class="mb-4">
                    <h3 class="font-medium text-gray-700 mb-2">{{ termData.term.name }} ({{ termData.term.session.name }})</h3>
                    <table class="w-full text-sm">
                        <thead class="bg-gray-100 text-left text-gray-500">
                            <tr><th class="p-2">Subject</th><th class="p-2">Total</th><th class="p-2">Grade</th></tr>
                        </thead>
                        <tbody>
                            {% for csId, s in termData.subjects %}
                                <tr class="border-t">
                                    <td class="p-2">{{ s.classSubject.subject.name }}</td>
                                    <td class="p-2 font-semibold">{{ s.total }}</td>
                                    <td class="p-2">{{ s.grade }}</td>
                                </tr>
                            {% else %}
                                <tr class="border-t"><td class="p-2 text-gray-500" colspan="3">No results yet.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-gray-500 text-sm">No results recorded.</div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
{% endblock %}
