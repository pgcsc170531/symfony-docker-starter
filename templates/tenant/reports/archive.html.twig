{% extends 'base.html.twig' %}

{% block title %}Report archive{% endblock %}

{% block body %}
<div class="px-4">

    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
            <h1 class="text-2xl font-bold text-ink-900">Report archive</h1>
            <p class="mt-1 text-sm text-ink-500">Every card and transcript issued, with its fingerprint and timestamp.</p>
        </div>

        <form method="get" class="w-full sm:w-64">
            <label class="block">
                <span class="mb-1 block text-sm font-medium text-ink-700">Term</span>
                <select name="term" onchange="this.form.submit()"
                        class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    {% for option in terms %}
                        <option value="{{ option.id }}" {{ term and option.id == term.id ? 'selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </label>
        </form>
    </div>

    {% if term is null %}
        <div class="rounded-xl border border-dashed border-ink-300 bg-white px-6 py-12 text-center">
            <p class="text-lg font-semibold text-ink-700">No terms yet</p>
        </div>
    {% elseif rows is empty %}
        <div class="rounded-xl border border-dashed border-ink-300 bg-white px-6 py-12 text-center">
            <p class="text-lg font-semibold text-ink-700">No documents archived for {{ term.name }}</p>
            <p class="mx-auto mt-1 max-w-md text-sm text-ink-500">
                A row appears here the first time a report or transcript PDF is downloaded, emailed or opened from a share link.
            </p>
        </div>
    {% else %}
        <div class="overflow-hidden rounded-xl border border-ink-200 bg-white shadow-card">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[640px] text-sm">
                    <thead class="bg-ink-100 text-left text-[11px] uppercase tracking-wide text-ink-500">
                        <tr>
                            <th class="px-3 py-2.5 font-semibold">{{ learner.capital }}</th>
                            <th class="px-3 py-2.5 font-semibold">Admission no</th>
                            <th class="px-3 py-2.5 font-semibold">Document</th>
                            <th class="px-3 py-2.5 font-semibold">Generated</th>
                            <th class="px-3 py-2.5 font-semibold">By</th>
                            <th class="px-3 py-2.5 font-semibold">SHA-256</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for row in rows %}
                            <tr>
                                <td class="px-3 py-2 font-medium text-ink-900">{{ row.student.fullName }}</td>
                                <td class="px-3 py-2 text-ink-600">{{ row.student.admissionNumber ?? '—' }}</td>
                                <td class="px-3 py-2">
                                    <span class="rounded bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-700">
                                        {{ row.kind == 'transcript' ? 'Transcript' : 'Report card' }}
                                    </span>
                                </td>
                                <td class="px-3 py-2 text-ink-600">{{ row.generatedAt|date('j M Y H:i') }}</td>
                                <td class="max-w-[180px] break-words px-3 py-2 text-xs text-ink-500">{{ row.generatedBy ?? '—' }}</td>
                                <td class="px-3 py-2 font-mono text-[11px] text-ink-400" title="{{ row.sha256 }}">{{ row.sha256|slice(0, 12) }}…</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
