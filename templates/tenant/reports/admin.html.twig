{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="p-6 max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">📈 Admin Dashboard</h1>

    <form method="get" class="mb-6 flex items-end gap-3">
        <div>
            <label class="block text-sm font-medium mb-1">Session</label>
            <select name="session" class="border rounded p-2 text-sm">
                {% for s in sessions %}
                    <option value="{{ s.id }}" {{ session and s.id == session.id ? 'selected' : '' }}>{{ s.name }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="bg-blue-600 text-white px-5 py-2 rounded-lg text-sm">View</button>
    </form>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 text-left text-gray-500">
                <tr>
                    <th class="p-3">Class</th>
                    <th class="p-3">Subject</th>
                    <th class="p-3">Students</th>
                    <th class="p-3">Average</th>
                    <th class="p-3">A1</th><th class="p-3">B2</th><th class="p-3">B3</th><th class="p-3">C4</th>
                    <th class="p-3">C5</th><th class="p-3">C6</th><th class="p-3">D7</th><th class="p-3">E8</th><th class="p-3">F9</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr class="border-t">
                        <td class="p-3">{{ row.classSubject.classroom.name }}</td>
                        <td class="p-3">{{ row.classSubject.subject.name }}</td>
                        <td class="p-3">{{ row.count }}</td>
                        <td class="p-3 font-semibold">{{ row.average ?? '—' }}</td>
                        <td class="p-3">{{ row.distribution.A1 }}</td>
                        <td class="p-3">{{ row.distribution.B2 }}</td>
                        <td class="p-3">{{ row.distribution.B3 }}</td>
                        <td class="p-3">{{ row.distribution.C4 }}</td>
                        <td class="p-3">{{ row.distribution.C5 }}</td>
                        <td class="p-3">{{ row.distribution.C6 }}</td>
                        <td class="p-3">{{ row.distribution.D7 }}</td>
                        <td class="p-3">{{ row.distribution.E8 }}</td>
                        <td class="p-3">{{ row.distribution.F9 }}</td>
                    </tr>
                {% else %}
                    <tr class="border-t"><td class="p-3 text-gray-500" colspan="13">No data for this session.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
