{# ══════════════════════════════════════════════════════════════════════
   The report document itself.

   Included by the parent's signed-in card, the public share page and (with
   different CSS) mirrored by the PDF template. It expects `sheet` and `term`.
   ══════════════════════════════════════════════════════════════════════ #}
{% set summary = sheet.summary %}
{% set school = sheet.school %}
{% set maxCa = 0 %}
{% for s in sheet.subjects %}{% set maxCa = max(maxCa, s.ca_count) %}{% endfor %}
{% set hasDual = sheet.subjects|filter(s => s.exam_mode == 'dual')|length > 0 %}

<article class="mb-6 overflow-hidden rounded-xl border border-ink-200 bg-white shadow-card">

    {# ══ School letterhead ═════════════════════════════════════ #}
    <header class="px-5 py-4 text-white"
            style="background-color: {{ school and school.primaryColor ? school.primaryColor : '#16223C' }}">
        <div class="flex items-center gap-3">
            {% if school and school.logoFilename %}
                <img src="{{ asset('uploads/logos/' ~ school.logoFilename) }}" alt=""
                     class="h-11 w-11 shrink-0 rounded-lg bg-white/90 object-contain p-1">
            {% else %}
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-white/15 text-lg font-bold" aria-hidden="true">
                    {{ (school ? school.name : 'School')|slice(0, 1)|upper }}
                </span>
            {% endif %}
            <div class="min-w-0">
                <p class="truncate text-lg font-bold leading-tight">{{ school ? school.name : 'School' }}</p>
                {% if school and school.motto %}<p class="truncate text-xs text-white/80">{{ school.motto }}</p>{% endif %}
            </div>
            <p class="ml-auto hidden shrink-0 text-right text-[11px] uppercase tracking-wider text-white/80 sm:block">
                {{ term.name }}<br>Report Sheet
            </p>
        </div>
        {% if school and (school.address or school.phoneNumber) %}
            <p class="mt-2 truncate text-[11px] text-white/75">
                {{ school.address }}{% if school.address and school.phoneNumber %} · {% endif %}{{ school.phoneNumber }}
            </p>
        {% endif %}
    </header>

    {# ══ Identity ══════════════════════════════════════════════ #}
    <div class="grid grid-cols-2 gap-x-4 gap-y-2 border-b border-ink-200 px-5 py-4 text-base sm:grid-cols-4">
        <div class="col-span-2 sm:col-span-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Name</p>
            <p class="break-words text-lg font-bold text-ink-900">{{ sheet.student.fullName }}</p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Admission no</p>
            <p class="break-words font-bold text-ink-900">{{ sheet.student.admissionNumber ?? '—' }}</p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Class</p>
            <p class="font-bold text-ink-900">{{ sheet.classroom.name }}</p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Session</p>
            <p class="font-bold text-ink-900">{{ term.session ? term.session.name : '—' }}</p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Term</p>
            <p class="font-bold text-ink-900">{{ term.name }}</p>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">{{ learner.pluralCapital }} in class</p>
            <p class="font-bold text-ink-900">{{ summary.of }}</p>
        </div>
        <div class="col-span-2 sm:col-span-3">
            <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">Next term begins</p>
            <p class="font-bold text-ink-900">
                {{ sheet.next_term and sheet.next_term.start ? sheet.next_term.start|date('j F Y') : 'To be announced' }}
            </p>
        </div>
    </div>

    {# ══ Headline numbers ══════════════════════════════════════ #}
    <div class="grid grid-cols-3 divide-x divide-ink-200 border-b border-ink-200">
        <div class="px-4 py-3 text-center">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Average</p>
            <p class="text-xl font-bold tabular text-ink-900">
                {{ summary.percentage is null ? '—' : summary.percentage ~ '%' }}
            </p>
        </div>
        <div class="px-4 py-3 text-center">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Position</p>
            <p class="text-xl font-bold tabular text-ink-900">
                {% if summary.position %}
                    {{ summary.position }}<span class="text-base font-semibold text-ink-600"> of {{ summary.of }}</span>
                {% else %}—{% endif %}
            </p>
        </div>
        <div class="px-4 py-3 text-center">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Grade</p>
            <p class="text-xl font-bold text-ink-900">{{ summary.grade ?? '—' }}</p>
        </div>
    </div>

    {# ══ Subjects — phones get cards, wider screens get the grid ═ #}
    <div class="px-5 py-4">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-600">Subjects</h2>

        {% if sheet.subjects is empty %}
            <p class="text-sm text-ink-500">No subjects are set up for {{ sheet.classroom.name }}.</p>
        {% else %}
            {# Phone #}
            <ul class="space-y-2 md:hidden">
                {% for s in sheet.subjects %}
                    <li class="rounded-lg border border-ink-200 p-3">
                        <div class="flex items-start justify-between gap-2">
                            <p class="min-w-0 break-words text-base font-bold text-ink-900">{{ s.name }}</p>
                            <div class="shrink-0 text-right">
                                <p class="text-lg font-bold tabular text-ink-900">{{ s.total is null ? '—' : s.total }}</p>
                                <p class="text-sm font-bold text-ink-700">{{ s.grade ?? '' }}</p>
                            </div>
                        </div>
                        <p class="mt-1 text-sm text-ink-600">
                            {% if s.position %}Position {{ s.position }} of {{ s.position_of }}{% else %}Not positioned{% endif %}
                            {% if s.class_average is not null %} · average {{ s.class_average }}{% endif %}
                            {% if s.class_highest is not null %} · highest {{ s.class_highest }}{% endif %}
                        </p>
                    </li>
                {% endfor %}
            </ul>

            {# Tablet and up #}
            <div class="hidden overflow-x-auto rounded-lg border border-ink-200 md:block">
                <table class="w-full min-w-[880px] text-base">
                    <thead class="bg-ink-100 text-left text-xs uppercase tracking-wide text-ink-600">
                        <tr>
                            <th class="px-3 py-2.5 font-bold">Subject</th>
                            {% for n in 1..maxCa %}
                                <th class="px-2 py-2.5 text-right font-bold">CA{{ n }}</th>
                            {% endfor %}
                            <th class="px-2 py-2.5 text-right font-bold">Exam</th>
                            {% if hasDual %}<th class="px-2 py-2.5 text-right font-bold">Prac.</th>{% endif %}
                            <th class="px-2 py-2.5 text-right font-bold">Total</th>
                            <th class="px-2 py-2.5 text-right font-bold">High</th>
                            <th class="px-2 py-2.5 text-right font-bold">Average</th>
                            <th class="px-2 py-2.5 text-right font-bold">Position</th>
                            <th class="px-2 py-2.5 text-right font-bold">Grade</th>
                            <th class="px-3 py-2.5 font-bold">Remark</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        {% for s in sheet.subjects %}
                            <tr>
                                <td class="px-3 py-2.5 font-semibold text-ink-900">{{ s.name }}</td>
                                {% for n in 1..maxCa %}
                                    <td class="px-2 py-2.5 text-right tabular text-ink-800">
                                        {{ n <= s.ca_count ? (s.components['ca' ~ n]|default('—')) : '' }}
                                    </td>
                                {% endfor %}
                                <td class="px-2 py-2.5 text-right tabular text-ink-800">{{ s.components.theory|default('—') }}</td>
                                {% if hasDual %}
                                    <td class="px-2 py-2.5 text-right tabular text-ink-800">{{ s.components.practical|default('—') }}</td>
                                {% endif %}
                                <td class="px-2 py-2.5 text-right font-bold tabular text-ink-900">{{ s.total is null ? '—' : s.total }}</td>
                                <td class="px-2 py-2.5 text-right tabular text-ink-700">{{ s.class_highest ?? '—' }}</td>
                                <td class="px-2 py-2.5 text-right tabular text-ink-700">{{ s.class_average ?? '—' }}</td>
                                <td class="px-2 py-2.5 text-right font-semibold tabular text-ink-800">
                                    {{ s.position ? s.position ~ '/' ~ s.position_of : '—' }}
                                </td>
                                <td class="px-2 py-2.5 text-right text-base font-bold text-ink-900">{{ s.grade ?? '—' }}</td>
                                <td class="px-3 py-2.5 text-ink-700">{{ s.remark ?? '' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 rounded-lg bg-ink-50 p-3 text-base sm:grid-cols-4">
            <div>
                <dt class="text-sm text-ink-600">Total obtained</dt>
                <dd class="font-bold tabular text-ink-900">{{ summary.obtained }} / {{ summary.obtainable }}</dd>
            </div>
            <div>
                <dt class="text-sm text-ink-600">Class average</dt>
                <dd class="font-bold tabular text-ink-900">{{ summary.class_average is null ? '—' : summary.class_average ~ '%' }}</dd>
            </div>
            <div>
                <dt class="text-sm text-ink-600">Highest in class</dt>
                <dd class="font-bold tabular text-ink-900">{{ summary.class_highest is null ? '—' : summary.class_highest ~ '%' }}</dd>
            </div>
            <div>
                <dt class="text-sm text-ink-600">Lowest in class</dt>
                <dd class="font-bold tabular text-ink-900">{{ summary.class_lowest is null ? '—' : summary.class_lowest ~ '%' }}</dd>
            </div>
        </dl>

        {# An incomplete term must say so, or a parent reads a mid-term
           figure as a final one. #}
        {% if summary.subjects_entered < summary.subjects_total %}
            <p class="mt-2 rounded-lg border border-pending/30 bg-pending/10 p-3 text-xs text-ink-700">
                <span class="font-semibold text-pending">Term in progress.</span>
                Figures are based on {{ summary.subjects_entered }} of
                {{ summary.subjects_total }} subjects. This card becomes final when
                every subject has been entered and approved.
            </p>
        {% endif %}
    </div>

    {# ══ Performance across the session ═════════════════════════ #}
    {% set trend = sheet.trend %}
    {% if trend and trend.has_history %}
        <div class="border-t border-ink-200 px-5 py-4">
            <h2 class="mb-1 text-xs font-bold uppercase tracking-wide text-ink-500">Performance across the session</h2>
            <p class="mb-3 text-sm text-ink-500">
                {% if trend.session_average is not null %}
                    Session average <strong class="text-ink-800 tabular">{{ trend.session_average }}%</strong>
                {% endif %}
                {% if trend.cumulative.percentage is not null %}
                    · cumulative <strong class="text-ink-800 tabular">{{ trend.cumulative.percentage }}%</strong>
                {% endif %}
                · {{ trend.terms|length }} terms
            </p>

            <ul class="space-y-2">
                {% for subject in trend.subjects %}
                    <li class="rounded-lg border border-ink-200 p-3">
                        <div class="flex items-start justify-between gap-2">
                            <p class="min-w-0 break-words text-sm font-semibold text-ink-900">{{ subject.name }}</p>
                            <span class="shrink-0 text-sm font-bold tabular {{ subject.change is same as(null) ? 'text-ink-400' : (subject.change > 0 ? 'text-paid' : (subject.change < 0 ? 'text-failed' : 'text-ink-500')) }}">
                                {% if subject.change is same as(null) %}—{% elseif subject.change > 0 %}▲ +{{ subject.change }}{% elseif subject.change < 0 %}▼ {{ subject.change }}{% else %}● 0{% endif %}
                            </span>
                        </div>
                        <div class="mt-2 grid gap-2" style="grid-template-columns: repeat({{ trend.terms|length }}, minmax(0, 1fr));">
                            {% for termPoint in trend.terms %}
                                {% set point = subject.points[termPoint.id] ?? null %}
                                <div>
                                    <p class="text-[10px] uppercase tracking-wide text-ink-400">{{ termPoint.name }}</p>
                                    <p class="text-sm font-semibold tabular {{ point ? 'text-ink-900' : 'text-ink-300' }}">
                                        {{ point and point.percentage is not null ? point.percentage ~ '%' : '—' }}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 rounded-lg bg-ink-50 p-3 text-sm sm:grid-cols-4">
                <div>
                    <dt class="text-xs text-ink-500">Session obtained</dt>
                    <dd class="font-bold tabular text-ink-900">{{ trend.cumulative.obtained }} / {{ trend.cumulative.obtainable }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-ink-500">Cumulative average</dt>
                    <dd class="font-semibold tabular text-ink-900">{{ trend.cumulative.percentage is null ? '—' : trend.cumulative.percentage ~ '%' }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-ink-500">Cumulative grade</dt>
                    <dd class="font-semibold text-ink-900">{{ trend.cumulative.grade ?? '—' }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-ink-500">Terms included</dt>
                    <dd class="font-semibold tabular text-ink-900">{{ trend.terms|length }}</dd>
                </div>
            </dl>
        </div>
    {% endif %}

    {# ══ Attendance ════════════════════════════════════════════ #}
    {% set att = sheet.attendance %}
    <div class="border-t border-ink-200 px-5 py-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-ink-500">Attendance</h2>
        {% if att.opened == 0 %}
            <p class="text-sm text-ink-500">The school has not recorded a register for this term yet.</p>
        {% else %}
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                <span class="whitespace-nowrap">
                    <span class="text-ink-500">School opened</span>
                    <strong class="tabular text-ink-900">{{ att.opened }}</strong>
                </span>
                <span class="whitespace-nowrap">
                    <span class="text-ink-500">Present</span>
                    <strong class="tabular text-ink-900">{{ att.present + att.late }}</strong>
                </span>
                <span class="whitespace-nowrap">
                    <span class="text-ink-500">Absent</span>
                    <strong class="tabular {{ att.absent > 0 ? 'text-failed' : 'text-ink-900' }}">{{ att.absent }}</strong>
                    {% if att.excused > 0 %}<span class="text-xs text-ink-500">({{ att.excused }} excused)</span>{% endif %}
                </span>
                <span class="whitespace-nowrap">
                    <span class="text-ink-500">Attendance</span>
                    <strong class="tabular text-ink-900">{{ att.rate is null ? '—' : att.rate ~ '%' }}</strong>
                </span>
            </div>
        {% endif %}
    </div>

    {# ══ Behaviour ════════════════════════════════════════════ #}
    {% set beh = sheet.behaviour %}
    <div class="border-t border-ink-200 px-5 py-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-ink-500">Behaviour</h2>
        <div class="grid grid-cols-2 gap-3">
            {% for domain, title in {'AFFECTIVE': 'Affective domain', 'PSYCHOMOTOR': 'Psychomotor domain'} %}
                <div>
                    <h3 class="mb-1.5 text-xs font-semibold text-ink-600">{{ title }}</h3>
                    {% if beh[domain] is empty %}
                        <p class="text-sm text-ink-500">Not rated.</p>
                    {% else %}
                        <ul class="space-y-1">
                            {% for item in beh[domain] %}
                                <li class="flex flex-col gap-0.5 sm:flex-row sm:items-center sm:justify-between sm:gap-2">
                                    <span class="min-w-0 break-words text-xs text-ink-800 sm:text-sm">{{ item.label }}</span>
                                    <span class="inline-flex shrink-0 gap-0.5" aria-label="{{ item.score }} of 5">
                                        {% for n in 1..5 %}
                                            <span class="h-2 w-2 rounded-full sm:h-2.5 sm:w-2.5 {{ n <= item.score ? 'bg-accent-600' : 'bg-ink-200' }}" aria-hidden="true"></span>
                                        {% endfor %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    {# ══ Remarks — form teacher, HOD, principal ═════════════════ #}
    {% set remarkBlocks = [
        {
            label: "Form teacher's remark",
            text: sheet.remark ? sheet.remark.text : null,
            author: sheet.form_teacher ? sheet.form_teacher.name : null,
            title: sheet.form_teacher ? sheet.form_teacher.title : null,
            date: sheet.remark ? sheet.remark.updated_at : null,
            signature: null
        },
        {
            label: "Head of Department's remark",
            text: sheet.remark ? sheet.remark.hod.text : null,
            author: sheet.remark ? sheet.remark.hod.author : null,
            title: 'Head of Department',
            date: sheet.remark ? sheet.remark.hod.updated_at : null,
            signature: null
        },
        {
            label: "Principal's remark",
            text: sheet.remark ? sheet.remark.principal.text : null,
            author: school ? school.principalName : null,
            title: school ? school.principalTitle : 'Principal',
            date: sheet.remark ? sheet.remark.principal.updated_at : null,
            signature: school ? school.principalSignatureFilename : null
        }
    ] %}
    <div class="border-t border-ink-200 px-5 py-4">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-600">Remarks</h2>
        <div class="space-y-4">
            {% for block in remarkBlocks %}
                <div class="border-t border-ink-100 pt-3 first:border-t-0 first:pt-0">
                    <h3 class="text-sm font-bold text-ink-700">{{ block.label }}</h3>
                    {% if block.text %}
                        <p class="mt-1 whitespace-pre-line break-words text-base leading-relaxed text-ink-800">{{ block.text }}</p>
                    {% else %}
                        <p class="mt-1 text-base text-ink-500">No remark recorded for this term.</p>
                    {% endif %}

                    <div class="mt-3 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                        <div class="min-w-0">
                            {% if block.signature %}
                                <img src="{{ asset('uploads/signatures/' ~ block.signature) }}" alt=""
                                     class="mb-1 h-8 max-w-[140px] object-contain">
                            {% endif %}
                            <p class="break-words text-base font-bold text-ink-900">{{ block.author ?? '—' }}</p>
                            {% if block.title %}<p class="text-sm text-ink-600">{{ block.title }}</p>{% endif %}
                        </div>
                        <p class="text-sm text-ink-600">
                            {{ block.date ? block.date|date('j F Y') : (term.endDate ? term.endDate|date('j F Y') : '') }}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# ══ Grading key ══════════════════════════════════════════ #}
    {% if sheet.grading is not empty %}
        <div class="border-t border-ink-200 bg-ink-50 px-5 py-3">
            <p class="text-[11px] text-ink-500">
                <span class="font-semibold text-ink-600">Grading:</span>
                {% for band in sheet.grading %}
                    {{ band.grade }} {{ band.min|round }}–{{ band.max|round }}{% if not loop.last %} · {% endif %}
                {% endfor %}
            </p>
        </div>
    {% endif %}
</article>
