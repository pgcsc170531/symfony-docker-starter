{% extends 'base.html.twig' %}

{% block title %}No child linked to this account{% endblock %}

{% block body %}
<div class="px-4 py-8 sm:py-12">
    <div class="mx-auto max-w-lg rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-accent-50 text-accent-700" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
        </span>

        <h1 class="mt-4 text-xl font-bold text-ink-900">No child is linked to this account yet</h1>
        <p class="mt-2 text-sm text-ink-500">
            Report cards appear here once the school has linked your child to your account.
            If you have just enrolled, this can take a little while — or the school may have
            your child under a different phone number or email address.
        </p>

        <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-center">
            <a href="{{ path('app_tenant_dashboard') }}"
               class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700">
                Back to dashboard
            </a>
            <a href="{{ path('app_logout') }}"
               class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-700 transition hover:border-accent-400 hover:text-accent-700">
                Sign out
            </a>
        </div>

        <p class="mt-5 text-xs text-ink-400">
            Ask the school office to check the guardian details on your child's admission record.
        </p>
    </div>
</div>
{% endblock %}
