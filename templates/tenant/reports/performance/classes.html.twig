{% extends 'base.html.twig' %}

{% block title %}Class performance — {{ term.name }}{% endblock %}

{% block body %}
{% set s = data.summary %}
{% set query = {term: term.id, year_group: yearGroup ? yearGroup.id : ''} %}
<div class="px-4 py-2">

    <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
            <a href="{{ path('app_tenant_report_performance', query) }}"
               class="text-xs font-semibold text-accent-700 hover:text-accent-800">← School brief</a>
            <h1 class="mt-1 text-2xl font-bold text-ink-900">Class performance</h1>
            <p class="mt-1 text-sm text-ink-500">
                {{ term.name }}{% if yearGroup %} · {{ yearGroup.name }}{% endif %}
                · {{ data.class_count }} classes · {{ data.pupil_count }} {{ learner.plural }}
            </p>
        </div>

        <form method="get" class="flex flex-col gap-2 sm:flex-row sm:items-end">
            <label class="min-w-0">
                <span class="mb-1 block text-xs font-medium text-ink-600">Term</span>
                <select name="term" onchange="this.form.submit()"
                        class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500 sm:w-44">
                    {% for option in terms %}
                        <option value="{{ option.id }}" {{ option.id == term.id ? 'selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="min-w-0">
                <span class="mb-1 block text-xs font-medium text-ink-600">Year group</span>
                <select name="year_group" onchange="this.form.submit()"
                        class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500 sm:w-44">
                    <option value="">All year groups</option>
                    {% for option in yearGroups %}
                        <option value="{{ option.id }}" {{ yearGroup and option.id == yearGroup.id ? 'selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </label>
        </form>
    </div>

    <nav class="mb-4 grid grid-cols-3 gap-2 rounded-xl border border-ink-200 bg-white p-1.5 shadow-card" aria-label="Performance views">
        <a href="{{ path('app_tenant_report_performance', query) }}"
           class="flex min-h-[44px] items-center justify-center rounded-lg px-2 text-center text-sm font-semibold text-ink-600 hover:bg-ink-50">Brief</a>
        <a href="{{ path('app_tenant_report_performance_subjects', query) }}"
           class="flex min-h-[44px] items-center justify-center rounded-lg px-2 text-center text-sm font-semibold text-ink-600 hover:bg-ink-50">Subjects</a>
        <span class="flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-2 text-center text-sm font-semibold text-white">Classes</span>
    </nav>

    {% if data.classes is empty %}
        <div class="rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card">
            <p class="text-sm font-semibold text-ink-800">No class results yet</p>
            <p class="mt-1 text-sm text-ink-500">Enter or approve results for this term, then come back.</p>
        </div>
    {% else %}

        {# ── Spread at a glance ─────────────────────────────────────── #}
        {% set ranked = data.classes|filter(class => class.average is not null) %}
        {% if ranked|length >= 2 %}
            {% set best = ranked|first %}
            {% set worst = ranked|last %}
            <div class="mb-4 grid gap-3 sm:grid-cols-3">
                <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <p class="text-[11px] font-bold uppercase tracking-wide text-ink-400">Highest</p>
                    <p class="mt-1 truncate text-lg font-bold text-ink-900">{{ best.name }}</p>
                    <p class="text-sm text-paid">{{ best.average }}% average</p>
                </div>
                <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <p class="text-[11px] font-bold uppercase tracking-wide text-ink-400">Lowest</p>
                    <p class="mt-1 truncate text-lg font-bold text-ink-900">{{ worst.name }}</p>
                    <p class="text-sm text-failed">{{ worst.average }}% average</p>
                </div>
                <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <p class="text-[11px] font-bold uppercase tracking-wide text-ink-400">Gap</p>
                    <p class="mt-1 text-lg font-bold tabular text-ink-900">{{ (best.average - worst.average)|round(1) }} pts</p>
                    <p class="text-sm text-ink-500">between highest and lowest</p>
                </div>
            </div>
        {% endif %}

        {# ── Mobile: one card per class ──────────────────────────────── #}
        <div class="space-y-3 md:hidden">
            {% for class in data.classes %}
                <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words text-sm font-bold text-ink-900">{{ class.name }}</p>
                            <p class="mt-0.5 text-[11px] text-ink-400">
                                {{ class.pupils }} with results{% if class.roster != class.pupils %} of {{ class.roster }} on roll{% endif %}
                                {% if class.year_group %} · {{ class.year_group }}{% endif %}
                            </p>
                        </div>
                        <p class="shrink-0 text-lg font-bold tabular text-ink-900">{{ class.average is null ? '—' : class.average ~ '%' }}</p>
                    </div>

                    <div class="relative mt-2 h-2 w-full rounded-full bg-ink-100">
                        {% if class.average is not null %}
                            <div class="h-2 rounded-full bg-accent-500" style="width: {{ class.average }}%"></div>
                        {% endif %}
                        {% if s.average is not null %}
                            <div class="absolute -top-0.5 h-3 w-0.5 bg-ink-700" style="left: {{ s.average }}%"
                                 title="School average {{ s.average }}%"></div>
                        {% endif %}
                    </div>

                    <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
                        <div class="rounded-lg bg-ink-50 p-2">
                            <dt class="text-[10px] uppercase tracking-wide text-ink-400">Pass</dt>
                            <dd class="text-sm font-bold tabular text-ink-900">{{ class.pass_rate is null ? '—' : class.pass_rate ~ '%' }}</dd>
                        </div>
                        <div class="rounded-lg bg-ink-50 p-2">
                            <dt class="text-[10px] uppercase tracking-wide text-ink-400">5+ credits</dt>
                            <dd class="text-sm font-bold tabular text-ink-900">{{ class.five_credit_rate is null ? 'n/a' : class.five_credit_rate ~ '%' }}</dd>
                        </div>
                        <div class="rounded-lg bg-ink-50 p-2">
                            <dt class="text-[10px] uppercase tracking-wide text-ink-400">Attendance</dt>
                            <dd class="text-sm font-bold tabular text-ink-900">{{ class.attendance is null ? '—' : class.attendance ~ '%' }}</dd>
                        </div>
                    </dl>
                </div>
            {% endfor %}
        </div>

        {# ── Desktop: table ──────────────────────────────────────────── #}
        <div class="hidden overflow-x-auto rounded-xl border border-ink-200 bg-white shadow-card md:block">
            <table class="min-w-[640px] w-full text-sm">
                <thead class="bg-ink-50 text-left text-[11px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th class="px-4 py-3 font-semibold">Class</th>
                        <th class="px-3 py-3 text-right font-semibold">{{ learner.pluralCapital }}</th>
                        <th class="px-3 py-3 text-right font-semibold">Average</th>
                        <th class="px-3 py-3 text-right font-semibold">Pass</th>
                        <th class="px-3 py-3 text-right font-semibold">5+ credits</th>
                        <th class="px-3 py-3 text-right font-semibold">Attendance</th>
                        <th class="px-4 py-3 text-right font-semibold">vs school</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for class in data.classes %}
                        <tr class="hover:bg-ink-50/60">
                            <td class="px-4 py-3">
                                <p class="font-semibold text-ink-900">{{ class.name }}</p>
                                <p class="text-[11px] text-ink-400">{{ class.year_group ?? 'Unassigned' }}</p>
                            </td>
                            <td class="px-3 py-3 text-right tabular text-ink-600">
                                {{ class.pupils }}{% if class.roster != class.pupils %}<span class="text-ink-400">/{{ class.roster }}</span>{% endif %}
                            </td>
                            <td class="px-3 py-3">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="relative h-1.5 w-24 rounded-full bg-ink-100">
                                        {% if class.average is not null %}
                                            <div class="h-1.5 rounded-full bg-accent-500" style="width: {{ class.average }}%"></div>
                                        {% endif %}
                                        {% if s.average is not null %}
                                            <div class="absolute -top-0.5 h-2.5 w-0.5 bg-ink-700" style="left: {{ s.average }}%"></div>
                                        {% endif %}
                                    </div>
                                    <span class="w-14 text-right font-bold tabular text-ink-900">{{ class.average is null ? '—' : class.average ~ '%' }}</span>
                                </div>
                            </td>
                            <td class="px-3 py-3 text-right tabular text-ink-700">{{ class.pass_rate is null ? '—' : class.pass_rate ~ '%' }}</td>
                            <td class="px-3 py-3 text-right tabular text-ink-700">{{ class.five_credit_rate is null ? 'n/a' : class.five_credit_rate ~ '%' }}</td>
                            <td class="px-3 py-3 text-right tabular text-ink-700">{{ class.attendance is null ? '—' : class.attendance ~ '%' }}</td>
                            <td class="px-4 py-3 text-right font-semibold tabular
                                {{ class.average is not null and s.average is not null and class.average >= s.average ? 'text-paid' : 'text-failed' }}">
                                {% if class.average is not null and s.average is not null %}
                                    {{ class.average >= s.average ? '+' : '' }}{{ (class.average - s.average)|round(1) }}
                                {% else %}—{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ── Year-group roll-up ─────────────────────────────────────── #}
        {% if data.year_groups is not empty and not yearGroup %}
            <section class="mt-4 rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5">
                <h2 class="mb-3 text-xs font-bold uppercase tracking-wide text-ink-500">Year groups</h2>
                <ul class="divide-y divide-ink-100">
                    {% for group in data.year_groups %}
                        <li class="flex items-center justify-between gap-3 py-2.5">
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-ink-900">{{ group.name }}</p>
                                <p class="text-[11px] text-ink-400">{{ group.pupils }} {{ learner.plural }}</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-4 text-right">
                                <div>
                                    <p class="text-sm font-bold tabular text-ink-900">{{ group.average is null ? '—' : group.average ~ '%' }}</p>
                                    <p class="text-[11px] text-ink-400">average</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold tabular text-ink-900">{{ group.pass_rate is null ? '—' : group.pass_rate ~ '%' }}</p>
                                    <p class="text-[11px] text-ink-400">pass</p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <p class="mt-3 text-[11px] text-ink-400">
            A class average is the mean of its {{ learner.plural }}' overall percentages, weighted by the subjects each {{ learner }} actually sat.
            “5+ credits” counts {{ learner.plural }} with five credits including English and Mathematics.
            The tick on each bar is the school average ({{ s.average ?? '—' }}%).
        </p>
    {% endif %}
</div>
{% endblock %}
