{% extends 'base.html.twig' %}

{% block title %}Subject performance — {{ term.name }}{% endblock %}

{% block body %}
{% set s = data.summary %}
{% set query = {term: term.id, year_group: yearGroup ? yearGroup.id : ''} %}
<div class="px-4 py-2">

    <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
            <a href="{{ path('app_tenant_report_performance', query) }}"
               class="text-xs font-semibold text-accent-700 hover:text-accent-800">← School brief</a>
            <h1 class="mt-1 text-2xl font-bold text-ink-900">Subject performance</h1>
            <p class="mt-1 text-sm text-ink-500">
                {{ term.name }}{% if yearGroup %} · {{ yearGroup.name }}{% endif %}
                · {{ data.pupil_count }} {{ learner.plural }} · {{ data.subjects|length }} subjects
            </p>
        </div>

        <form method="get" class="flex flex-col gap-2 sm:flex-row sm:items-end">
            <label class="min-w-0">
                <span class="mb-1 block text-xs font-medium text-ink-600">Term</span>
                <select name="term" onchange="this.form.submit()"
                        class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500 sm:w-44">
                    {% for option in terms %}
                        <option value="{{ option.id }}" {{ option.id == term.id ? 'selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="min-w-0">
                <span class="mb-1 block text-xs font-medium text-ink-600">Year group</span>
                <select name="year_group" onchange="this.form.submit()"
                        class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500 sm:w-44">
                    <option value="">All year groups</option>
                    {% for option in yearGroups %}
                        <option value="{{ option.id }}" {{ yearGroup and option.id == yearGroup.id ? 'selected' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
            </label>
        </form>
    </div>

    <nav class="mb-4 grid grid-cols-3 gap-2 rounded-xl border border-ink-200 bg-white p-1.5 shadow-card" aria-label="Performance views">
        <a href="{{ path('app_tenant_report_performance', query) }}"
           class="flex min-h-[44px] items-center justify-center rounded-lg px-2 text-center text-sm font-semibold text-ink-600 hover:bg-ink-50">Brief</a>
        <span class="flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-2 text-center text-sm font-semibold text-white">Subjects</span>
        <a href="{{ path('app_tenant_report_performance_classes', query) }}"
           class="flex min-h-[44px] items-center justify-center rounded-lg px-2 text-center text-sm font-semibold text-ink-600 hover:bg-ink-50">Classes</a>
    </nav>

    {% if data.subjects is empty %}
        <div class="rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card">
            <p class="text-sm font-semibold text-ink-800">No subject results yet</p>
            <p class="mt-1 text-sm text-ink-500">Enter or approve results for this term, then come back.</p>
        </div>
    {% else %}

        {# ── Spotlight ─────────────────────────────────────────────── #}
        {% set populated = data.subjects|filter(subject => subject.entered >= 5) %}
        {% if populated|length >= 2 %}
            {% set strongest = populated|first %}
            {% set weakest = populated|last %}
            <div class="mb-4 grid gap-3 sm:grid-cols-2">
                <div class="rounded-xl border border-paid/20 bg-paid/5 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-wide text-paid">Strongest</p>
                    <p class="mt-1 text-lg font-bold text-ink-900">{{ strongest.name }}</p>
                    <p class="mt-0.5 text-sm text-ink-600">
                        {{ strongest.average }}% average · {{ strongest.pass_rate }}% pass
                        · {{ strongest.entered }} entries
                    </p>
                </div>
                <div class="rounded-xl border border-failed/20 bg-failed/5 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-wide text-failed">Needs attention</p>
                    <p class="mt-1 text-lg font-bold text-ink-900">{{ weakest.name }}</p>
                    <p class="mt-0.5 text-sm text-ink-600">
                        {{ weakest.average }}% average · {{ weakest.pass_rate }}% pass
                        · {{ weakest.entered }} entries
                    </p>
                </div>
            </div>
        {% endif %}

        {# ── Mobile: one card per subject ──────────────────────────── #}
        <div class="space-y-3 md:hidden">
            {% for subject in data.subjects %}
                <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words text-sm font-bold text-ink-900">{{ subject.name }}</p>
                            <p class="mt-0.5 text-[11px] text-ink-400">{{ subject.entered }} entries</p>
                        </div>
                        {% if subject.average is not null and s.average is not null %}
                            <span class="shrink-0 rounded px-2 py-1 text-[11px] font-bold
                                {{ subject.average >= s.average ? 'bg-paid/10 text-paid' : 'bg-failed/10 text-failed' }}">
                                {{ subject.average >= s.average ? '+' : '' }}{{ (subject.average - s.average)|round(1) }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="mt-3 flex items-end justify-between gap-2">
                        <p class="text-2xl font-bold tabular text-ink-900">{{ subject.average }}%</p>
                        <p class="text-right text-[11px] text-ink-500">
                            Pass {{ subject.pass_rate }}% · Dist {{ subject.distinction_rate }}%
                        </p>
                    </div>

                    <div class="relative mt-2 h-2 w-full rounded-full bg-ink-100">
                        <div class="h-2 rounded-full bg-accent-500" style="width: {{ subject.average }}%"></div>
                        {% if s.average is not null %}
                            <div class="absolute -top-0.5 h-3 w-0.5 bg-ink-700" style="left: {{ s.average }}%"
                                 title="School average {{ s.average }}%"></div>
                        {% endif %}
                    </div>
                    {% if not subject.approved %}
                        <p class="mt-2 text-[11px] font-semibold text-pending">Not final-approved</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {# ── Desktop: table ────────────────────────────────────────── #}
        <div class="hidden overflow-x-auto rounded-xl border border-ink-200 bg-white shadow-card md:block">
            <table class="min-w-[640px] w-full text-sm">
                <thead class="bg-ink-50 text-left text-[11px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th class="px-4 py-3 font-semibold">Subject</th>
                        <th class="px-3 py-3 text-right font-semibold">Entered</th>
                        <th class="px-3 py-3 text-right font-semibold">Average</th>
                        <th class="px-3 py-3 text-right font-semibold">Pass</th>
                        <th class="px-3 py-3 text-right font-semibold">Credit</th>
                        <th class="px-3 py-3 text-right font-semibold">Distinction</th>
                        <th class="px-4 py-3 text-right font-semibold">vs school</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for subject in data.subjects %}
                        <tr class="hover:bg-ink-50/60">
                            <td class="px-4 py-3">
                                <p class="font-semibold text-ink-900">{{ subject.name }}</p>
                                {% if not subject.approved %}
                                    <p class="text-[11px] font-semibold text-pending">Not final-approved</p>
                                {% endif %}
                            </td>
                            <td class="px-3 py-3 text-right tabular text-ink-600">{{ subject.entered }}</td>
                            <td class="px-3 py-3">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="relative h-1.5 w-24 rounded-full bg-ink-100">
                                        <div class="h-1.5 rounded-full bg-accent-500" style="width: {{ subject.average }}%"></div>
                                        {% if s.average is not null %}
                                            <div class="absolute -top-0.5 h-2.5 w-0.5 bg-ink-700" style="left: {{ s.average }}%"></div>
                                        {% endif %}
                                    </div>
                                    <span class="w-14 text-right font-bold tabular text-ink-900">{{ subject.average }}%</span>
                                </div>
                            </td>
                            <td class="px-3 py-3 text-right tabular text-ink-700">{{ subject.pass_rate }}%</td>
                            <td class="px-3 py-3 text-right tabular text-ink-700">{{ subject.credit_rate }}%</td>
                            <td class="px-3 py-3 text-right tabular text-ink-700">{{ subject.distinction_rate }}%</td>
                            <td class="px-4 py-3 text-right font-semibold tabular
                                {{ subject.average is not null and s.average is not null and subject.average >= s.average ? 'text-paid' : 'text-failed' }}">
                                {% if subject.average is not null and s.average is not null %}
                                    {{ subject.average >= s.average ? '+' : '' }}{{ (subject.average - s.average)|round(1) }}
                                {% else %}—{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="mt-3 text-[11px] text-ink-400">
            Average is the mean percentage of the subject maximum, across every {{ learner }} entered.
            The tick on each bar is the school average ({{ s.average ?? '—' }}%).
            Credit = {{ data.thresholds.credit_grade }}, distinction = {{ data.thresholds.distinction_grade }}.
        </p>
    {% endif %}
</div>
{% endblock %}
