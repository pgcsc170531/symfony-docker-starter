<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <title>Performance link unavailable</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% include '_design_tokens.html.twig' %}
    <style>body { background-color: #F9FAFB; }</style>
</head>
<body class="min-h-screen">

    <main class="flex min-h-screen items-center justify-center px-4 py-10">
        <div class="w-full max-w-md rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card">
            {% import '_brand.html.twig' as brand %}
            {{ brand.wordmark('lg') }}
            <p class="mt-3 text-lg font-bold text-ink-900">This performance link is no longer available</p>
            <p class="mt-2 text-sm text-ink-600">
                It may have expired, or the school may have issued a new report. Ask the school for a fresh link.
            </p>
        </div>
    </main>

</body>
</html>
