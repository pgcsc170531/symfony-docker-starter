{% extends 'base.html.twig' %}

{% block title %}New Store Sale{% endblock %}

{% block body %}
<div class="container mx-auto mt-10 p-5 max-w-lg">
    <div class="bg-white p-8 rounded shadow border-t-4 border-teal-600">
        <h2 class="text-2xl font-bold mb-2">New Store Sale</h2>
        <p class="text-gray-600 mb-6">
            Selling to: <strong>{{ student.fullName }}</strong><br>
            <span class="text-xs text-gray-400">This will generate a separate Store Invoice.</span>
        </p>

        {{ form_start(form) }}
            <div class="mb-4">
                {{ form_label(form.product) }}
                {{ form_widget(form.product, {'attr': {'class': 'w-full border p-2 rounded'}}) }}
            </div>
            <div class="mb-6">
                {{ form_label(form.quantity) }}
                {{ form_widget(form.quantity, {'attr': {'class': 'w-full border p-2 rounded font-bold'}}) }}
            </div>
            
            <button class="bg-teal-600 text-white w-full py-3 rounded font-bold hover:bg-teal-700">
                Generate Receipt
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}