{% extends 'base.html.twig' %}

{% block title %}{{ classroom.name }} — fees{% endblock %}

{% block body %}
{#
    Who has paid, and (for the bursary only) how much.

    A form teacher is the person a parent rings first, so they need to know which
    family has not paid — but a list of large sums against other people's children
    turns into a talking point. So the amounts are gated on ROLE_BURSAR: the
    teacher sees cleared / owing, the bursary sees the money.
#}
{% set showMoney = showAmounts|default(false) %}
<div class="px-4 py-4">

    <div class="mb-5">
        <a href="{{ path('app_tenant_my_class', {classroom: classroom.id}) }}"
           class="inline-flex min-h-[44px] items-center text-xs font-semibold text-accent-700 hover:underline">&larr; My class</a>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-ink-900">{{ classroom.name }} — fees</h1>
        <p class="mt-1 text-sm text-ink-500">
            {% if term %}{{ term.name }}{% if term.session %} · {{ term.session.name }}{% endif %}{% endif %}
            · who has cleared the term's fees, so you can remind the family through the {{ learner }}.
        </p>
    </div>

    {# ── Statistics ─────────────────────────────────────────────────────── #}
    <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {% if showMoney %}
            <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Collected</p>
                <p class="mt-1 text-xl font-semibold text-paid tabular">₦{{ fees.collected|number_format(2) }}</p>
                <p class="mt-0.5 text-xs text-ink-500">of ₦{{ fees.billed|number_format(2) }} billed</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Outstanding</p>
                <p class="mt-1 text-xl font-semibold {{ fees.outstanding > 0 ? 'text-pending' : 'text-ink-900' }} tabular">₦{{ fees.outstanding|number_format(2) }}</p>
                <p class="mt-0.5 text-xs text-ink-500">{{ fees.owing }} {{ fees.owing == 1 ? learner : learner.plural }} still owing</p>
            </div>
        {% else %}
            <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Cleared</p>
                <p class="mt-1 text-xl font-semibold text-paid tabular">{{ fees.cleared }}</p>
                <p class="mt-0.5 text-xs text-ink-500">of {{ fees.rows|length }} {{ fees.rows|length == 1 ? learner : learner.plural }}</p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Still owing</p>
                <p class="mt-1 text-xl font-semibold {{ fees.owing > 0 ? 'text-pending' : 'text-ink-900' }} tabular">{{ fees.owing }}</p>
                <p class="mt-0.5 text-xs text-ink-500">remind the family through the {{ learner }}</p>
            </div>
        {% endif %}
        <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-ink-500">Not billed</p>
            <p class="mt-1 text-xl font-semibold text-ink-900 tabular">{{ fees.notBilled }}</p>
            <p class="mt-0.5 text-xs text-ink-500">no invoice raised yet</p>
        </div>
    </div>

    {% if not showMoney %}
        <p class="mb-4 rounded-lg border border-ink-200 bg-ink-50 p-3 text-xs leading-relaxed text-ink-600">
            Amounts are shown to the bursary only. If a parent asks what they owe, send them to the bursar —
            this page tells you <strong>whether</strong> a family has cleared, not what they paid.
        </p>
    {% endif %}

    {# ── Pupil by pupil ─────────────────────────────────────────────────── #}
    {% if fees.rows is empty %}
        <p class="rounded-xl border border-dashed border-ink-300 bg-white p-6 text-center text-sm text-ink-500">
            No {{ learner.plural }} in this class yet.
        </p>
    {% else %}
        {# Wide table: it scrolls inside its own box, never the page. #}
        <div class="hidden overflow-x-auto rounded-xl border border-ink-200 bg-white shadow-card sm:block">
            <table class="w-full {{ showMoney ? 'min-w-[640px]' : 'min-w-[420px]' }} text-sm">
                <thead class="bg-ink-50 text-[10px] uppercase tracking-wider text-ink-500">
                    <tr>
                        <th class="p-3 text-left">{{ learner|capitalize }}</th>
                        {% if showMoney %}
                            <th class="p-3 text-right">Billed</th>
                            <th class="p-3 text-right">Paid</th>
                            <th class="p-3 text-right">Balance</th>
                        {% endif %}
                        <th class="p-3 text-left">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for row in fees.rows %}
                        <tr>
                            <td class="p-3">
                                <span class="block font-semibold text-ink-900">{{ row.student.fullName }}</span>
                                <span class="block text-xs text-ink-500">{{ row.student.admissionNumber ?: '—' }}</span>
                            </td>
                            {% if showMoney %}
                                <td class="p-3 text-right tabular text-ink-700">{{ row.billed > 0 ? '₦' ~ row.billed|number_format(2) : '—' }}</td>
                                <td class="p-3 text-right tabular font-semibold text-ink-900">{{ row.paid > 0 ? '₦' ~ row.paid|number_format(2) : '—' }}</td>
                                <td class="p-3 text-right tabular font-semibold {{ row.balance > 0 ? 'text-pending' : 'text-paid' }}">
                                    {{ row.invoice ? '₦' ~ row.balance|number_format(2) : '—' }}
                                </td>
                            {% endif %}
                            <td class="p-3">
                                {% if row.status == 'NOT BILLED' %}
                                    <span class="badge-neutral">Not billed</span>
                                {% elseif row.balance <= 0 %}
                                    <span class="badge-paid">Cleared</span>
                                {% elseif row.paid > 0 %}
                                    <span class="badge-pending">Part paid</span>
                                {% else %}
                                    <span class="badge-failed">Unpaid</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Phone: one card per pupil, thumb-sized, no sideways scroll. #}
        <ul class="space-y-2 sm:hidden">
            {% for row in fees.rows %}
                <li class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words font-semibold text-ink-900">{{ row.student.fullName }}</p>
                            <p class="text-xs text-ink-500">{{ row.student.admissionNumber ?: '—' }}</p>
                        </div>
                        {% if row.status == 'NOT BILLED' %}
                            <span class="badge-neutral shrink-0">Not billed</span>
                        {% elseif row.balance <= 0 %}
                            <span class="badge-paid shrink-0">Cleared</span>
                        {% elseif row.paid > 0 %}
                            <span class="badge-pending shrink-0">Part paid</span>
                        {% else %}
                            <span class="badge-failed shrink-0">Unpaid</span>
                        {% endif %}
                    </div>
                    {% if showMoney %}
                        <dl class="mt-3 grid grid-cols-3 gap-2 text-xs">
                            <div>
                                <dt class="text-ink-500">Billed</dt>
                                <dd class="font-semibold text-ink-900 tabular">{{ row.billed > 0 ? '₦' ~ row.billed|number_format(0) : '—' }}</dd>
                            </div>
                            <div>
                                <dt class="text-ink-500">Paid</dt>
                                <dd class="font-semibold text-ink-900 tabular">{{ row.paid > 0 ? '₦' ~ row.paid|number_format(0) : '—' }}</dd>
                            </div>
                            <div>
                                <dt class="text-ink-500">Balance</dt>
                                <dd class="font-semibold {{ row.balance > 0 ? 'text-pending' : 'text-paid' }} tabular">{{ row.invoice ? '₦' ~ row.balance|number_format(0) : '—' }}</dd>
                            </div>
                        </dl>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        <p class="mt-4 text-xs text-ink-400">
            Read from each pupil's academic invoice for the term. "Not billed" means no invoice has been raised —
            it does not mean the family owes nothing. Payments are verified by the bursary; this page only reports.
        </p>
    {% endif %}
</div>
{% endblock %}
