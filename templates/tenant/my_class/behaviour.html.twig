{% extends 'base.html.twig' %}

{% block title %}Behaviour — {{ classroom.name }}{% endblock %}

{% block body %}
<div class="px-4">

    <a href="{{ path('app_tenant_my_class', {classroom: classroom.id}) }}"
       class="mb-4 inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-ink-600 hover:text-accent-700">
        <span aria-hidden="true">&larr;</span> My Class
    </a>

    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
            <h1 class="text-2xl font-bold text-ink-900">Behaviour</h1>
            <p class="mt-1 text-sm text-ink-500">
                {{ classroom.name }} · {{ term.name }} · {{ ratedPupils }} of {{ pupilCount }} {{ learner.plural }} fully rated
            </p>
        </div>
        {% if locked %}
            <span class="shrink-0 self-start rounded bg-paid/10 px-2.5 py-1 text-xs font-semibold text-paid">Released — read only</span>
        {% endif %}
    </div>

    {% if pupilCount == 0 or (affective is empty and psychomotor is empty) %}
        <div class="rounded-xl border border-dashed border-ink-300 bg-white px-6 py-12 text-center">
            <p class="text-lg font-semibold text-ink-700">Nothing to rate yet</p>
            <p class="mx-auto mt-1 max-w-md text-sm text-ink-500">
                {% if pupilCount == 0 %}
                    Enrol {{ learner.plural }} into {{ classroom.name }} first.
                {% else %}
                    No traits are enabled for this school. An administrator can add them in
                    Settings → Behaviour traits.
                {% endif %}
            </p>
        </div>
    {% else %}

        {# Scale legend — also the only static declaration of the dot colours below,
           so the Tailwind CDN emits them even before anything is rated. #}
        <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 rounded-xl border border-ink-200 bg-white p-3 text-xs text-ink-600">
            <span class="font-semibold text-ink-800">The scale</span>
            {% for score, label in labels %}
                <span class="inline-flex items-center gap-1">
                    <span class="inline-flex gap-0.5" aria-hidden="true">
                        {% for n in 1..5 %}
                            <span class="h-2 w-2 rounded-full {{ n <= score ? 'bg-accent-600' : 'bg-ink-200' }}"></span>
                        {% endfor %}
                    </span>
                    {{ label }}
                </span>
            {% endfor %}
        </div>

        <div class="grid gap-4 lg:grid-cols-3">

            {# ── Pupil picker ──────────────────────────────────────── #}
            <div class="lg:col-span-1">

                {# Mobile: a select, because 41 rows scroll forever #}
                <label class="block lg:hidden">
                    <span class="mb-1 block text-sm font-medium text-ink-700">{{ learner.capital }}</span>
                    <select onchange="if (this.value) window.location = this.value"
                            class="w-full rounded-lg border border-ink-300 p-2.5 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                        {% for pupil in pupils %}
                            <option value="{{ path('app_tenant_my_class_behaviour', {classroom: classroom.id, student: pupil.id}) }}"
                                    {{ pupil.id == selectedId ? 'selected' }}>
                                {{ pupil.name }}{{ pupil.complete ? ' ✓' : ' — ' ~ pupil.rated ~ '/' ~ pupil.total }}
                            </option>
                        {% endfor %}
                    </select>
                </label>

                {# Desktop: the full list with progress #}
                <div class="hidden max-h-[70vh] overflow-y-auto rounded-xl border border-ink-200 bg-white lg:block">
                    <p class="sticky top-0 border-b border-ink-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wide text-ink-500">
                        {{ pupilCount }} {{ learner.plural }}
                    </p>
                    <ul class="divide-y divide-ink-100">
                        {% for pupil in pupils %}
                            <li>
                                <a href="{{ path('app_tenant_my_class_behaviour', {classroom: classroom.id, student: pupil.id}) }}"
                                   class="flex min-h-[44px] items-center justify-between gap-2 px-4 py-2 text-sm transition {{ pupil.id == selectedId ? 'bg-accent-50 font-semibold text-accent-700' : 'text-ink-700 hover:bg-ink-50' }}">
                                    <span class="min-w-0 break-words">{{ pupil.name }}</span>
                                    {% if pupil.complete %}
                                        <span class="shrink-0 text-xs font-semibold text-paid">Done</span>
                                    {% else %}
                                        <span class="shrink-0 text-xs text-ink-400 tabular">{{ pupil.rated }}/{{ pupil.total }}</span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            {# ── Rating panel ──────────────────────────────────────── #}
            <div class="lg:col-span-2">
                <div x-data="behaviourPanel()"
                     x-init="init($el)"
                     data-student="{{ selectedId }}"
                     data-token="{{ csrf }}"
                     data-ratings="{{ selectedRatings|json_encode|e('html_attr') }}"
                     data-locked="{{ locked ? '1' : '0' }}"
                     data-save-url="{{ path('app_tenant_my_class_behaviour_save', {student: selectedId, trait: 0}) }}"
                     data-fill-url="{{ path('app_tenant_my_class_behaviour_save_all', {student: selectedId}) }}"
                     data-base-url="{{ path('app_tenant_my_class_behaviour', {classroom: classroom.id}) }}"
                     data-student-name="{{ (selectedStudent ? (selectedStudent.firstName ~ ' ' ~ selectedStudent.lastName)|trim : 'this ' ~ learner)|e('html_attr') }}"
                     class="rounded-xl border border-ink-200 bg-white p-4 shadow-card sm:p-5">

                    <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-ink-200 pb-3">
                        <h2 class="text-lg font-bold text-ink-900">
                            {{ selectedStudent ? (selectedStudent.firstName ~ ' ' ~ selectedStudent.lastName)|trim : 'No ' ~ learner }}
                        </h2>
                        <div class="flex items-center gap-2">
                            {% if not locked %}
                                <button type="button" @click="fillAll(4)"
                                        class="inline-flex min-h-[44px] items-center rounded-lg border border-ink-300 px-3 text-sm font-semibold text-ink-700 transition hover:border-accent-400 hover:text-accent-700">
                                    All = 4
                                </button>
                            {% endif %}
                            <span class="rounded bg-ink-100 px-2 py-1 text-xs font-semibold text-ink-600"
                                  x-text="rated + ' of ' + total"></span>
                        </div>
                    </div>

                    <p x-show="message" :style="message ? '' : 'display:none'"
                       :class="isError ? 'text-failed' : 'text-paid'"
                       class="mb-3 text-sm font-medium" x-text="message"></p>

                    {% for domain, traits in {'Affective domain': affective, 'Psychomotor domain': psychomotor} %}
                        {% if traits is not empty %}
                            <h3 class="mb-1 mt-4 text-xs font-bold uppercase tracking-wide text-ink-500 first:mt-0">{{ domain }}</h3>
                            <ul class="divide-y divide-ink-100">
                                {% for trait in traits %}
                                    <li class="py-3">
                                        <div class="flex items-start justify-between gap-2">
                                            <span class="min-w-0 break-words text-sm font-medium text-ink-900">{{ trait.label }}</span>
                                            <span class="shrink-0 text-xs text-ink-500" x-text="labelFor({{ trait.id }})"></span>
                                        </div>

                                        <div class="mt-1 grid grid-cols-5 gap-1">
                                            {% for score in 5..1 %}
                                                <button type="button"
                                                        @click="rate({{ trait.id }}, {{ score }})"
                                                        :disabled="locked"
                                                        :aria-pressed="ratings[{{ trait.id }}] === {{ score }}"
                                                        aria-label="{{ labels[score] }}"
                                                        :class="(ratings[{{ trait.id }}] || 0) >= {{ score }} ? 'border-accent-600 bg-accent-600' : 'border-ink-300 bg-white hover:border-ink-400'"
                                                        class="flex min-h-[44px] items-center justify-center rounded-lg border transition disabled:opacity-60">
                                                    <span class="h-3 w-3 rounded-full"
                                                          :class="(ratings[{{ trait.id }}] || 0) >= {{ score }} ? 'bg-white' : 'bg-ink-200'"></span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endfor %}

                    {% if not locked %}
                        <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                            <button type="button" @click="next()"
                                    class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700 sm:flex-1">
                                Save &amp; next {{ learner }}
                            </button>
                            <a href="{{ path('app_tenant_my_class', {classroom: classroom.id}) }}"
                               class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-700 transition hover:border-accent-400 hover:text-accent-700 sm:flex-none">
                                Done for now
                            </a>
                        </div>
                    {% endif %}

                    <script>
                        function behaviourPanel() {
                            return {
                                ratings: {},
                                labels: {{ labels|json_encode|raw }},
                                total: {{ (affective|length) + (psychomotor|length) }},
                                student: 0,
                                token: '',
                                locked: false,
                                saveUrl: '',
                                fillUrl: '',
                                baseUrl: '',
                                studentName: '',
                                message: '',
                                isError: false,

                                init(el) {
                                    this.student = parseInt(el.dataset.student || '0', 10);
                                    this.token = el.dataset.token;
                                    this.locked = el.dataset.locked === '1';
                                    this.saveUrl = el.dataset.saveUrl;
                                    this.fillUrl = el.dataset.fillUrl;
                                    this.baseUrl = el.dataset.baseUrl;
                                    this.studentName = el.dataset.studentName || 'this {{ learner }}';
                                    const raw = JSON.parse(el.dataset.ratings || '{}');
                                    // JSON object keys arrive as strings; normalise to numbers.
                                    Object.keys(raw).forEach(k => { this.ratings[parseInt(k, 10)] = raw[k]; });
                                },

                                get rated() {
                                    return Object.keys(this.ratings).filter(k => this.ratings[k] > 0).length;
                                },

                                labelFor(traitId) {
                                    return this.labels[this.ratings[traitId]] || 'Not rated';
                                },

                                async rate(traitId, score) {
                                    if (this.locked) return;
                                    const previous = this.ratings[traitId] || 0;
                                    this.ratings[traitId] = score;

                                    const url = this.saveUrl.replace(/\/0$/, '/' + traitId);
                                    try {
                                        const res = await fetch(url, {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ _token: this.token, score: score })
                                        });
                                        const data = await res.json();
                                        if (!res.ok || !data.success) throw new Error(data.error || 'Could not save.');
                                        this.isError = false;
                                        this.message = 'Saved · ' + data.label;
                                    } catch (e) {
                                        this.ratings[traitId] = previous;
                                        this.isError = true;
                                        this.message = e.message;
                                    }
                                },

                                async fillAll(score) {
                                    if (this.locked) return;
                                    // One tap writes 18 ratings for the selected pupil. The
                                    // selection can change between reloads, so confirm rather
                                    // than silently overwrite a colleague's work.
                                    const who = this.studentName || 'this {{ learner }}';
                                    if (!window.confirm('Set all ' + this.total + ' traits to "' + (this.labels[score] || score) + '" for ' + who + '?')) {
                                        return;
                                    }
                                    try {
                                        const res = await fetch(this.fillUrl, {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ _token: this.token, score: score })
                                        });
                                        const data = await res.json();
                                        if (!res.ok || !data.success) throw new Error(data.error || 'Could not save.');
                                        this.isError = false;
                                        this.message = 'All traits set to ' + (this.labels[score] || score) + '. Adjust the ones that differ.';
                                        window.location.reload();
                                    } catch (e) {
                                        this.isError = true;
                                        this.message = e.message;
                                    }
                                },

                                // Drop the ?student= parameter so the page opens the first
                                // pupil who still has unrated traits — that is "next".
                                next() {
                                    window.location = this.baseUrl;
                                }
                            };
                        }
                    </script>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
