{% extends 'base.html.twig' %}

{% block title %}My Wallet & Credits{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-4 md:mt-8 px-4 sm:px-6">
    
    <div class="mb-6 md:mb-8">
        <h1 class="text-2xl md:text-3xl font-black text-gray-900">💳 Wallet & Credits</h1>
        <p class="text-sm md:text-base text-gray-500 mt-1">Monitor your SMS and WhatsApp credit usage.</p>
    </div>

    {# 🟢 1. PENDING REQUESTS ALERT #}
    {% if pendingRequests is defined and pendingRequests|length > 0 %}
    <div class="mb-6 md:mb-8 bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r-xl shadow-sm">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm leading-5 font-bold text-yellow-800">Pending Credit Approvals</h3>
                <div class="mt-2 text-sm leading-5 text-yellow-700">
                    <ul class="list-disc pl-5 space-y-2">
                        {% for req in pendingRequests %}
                            <li class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2">
                                <div>
                                    <strong>₦{{ req.amount|number_format }}</strong> 
                                    <span class="text-[10px] font-bold uppercase tracking-wider bg-yellow-200 px-2 py-0.5 rounded-full ml-1">Processing</span>
                                </div>
                                <span class="text-xs text-yellow-600 font-mono">Ref: {{ req.reference }}</span>
                                
                                {% if not req.proofFilename %}
                                    <a href="{{ path('tenant_wallet_payment', {id: req.id}) }}" class="sm:ml-auto underline font-bold text-yellow-900 text-xs md:text-sm mt-1 sm:mt-0 block hover:text-yellow-700 transition-colors">
                                        👉 Complete Payment
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8 mb-8">
        
        {# 🟢 2. BALANCE CARD WITH TOP-UP FORM #}
        <div class="bg-indigo-900 rounded-2xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden lg:col-span-2">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-indigo-500 rounded-full opacity-20 blur-xl"></div>
            
            <div class="relative z-10">
                <h2 class="text-indigo-200 font-bold text-[10px] md:text-xs uppercase tracking-widest mb-1">Available Balance</h2>
                <div class="text-4xl md:text-5xl font-black mb-6 md:mb-8">₦{{ school.walletBalance|number_format(2) }}</div>
                
                <div class="bg-indigo-800/50 p-4 md:p-5 rounded-xl backdrop-blur-sm border border-indigo-700/50">
                    <p class="text-[10px] md:text-xs font-bold text-indigo-300 uppercase mb-3">⚡️ Quick Top Up</p>
                    
                    {# Mobile-first form: Stacks on mobile, side-by-side on sm screens and up #}
                    <form action="{{ path('tenant_wallet_top_up') }}" method="POST" class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
                        <div class="relative flex-grow max-w-none sm:max-w-[200px]">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">₦</span>
                            </div>
                            <input type="number" name="amount" placeholder="5000" min="1000" required 
                                   class="block w-full pl-8 rounded-lg border-0 py-3 sm:py-2 text-gray-900 shadow-sm focus:ring-2 focus:ring-indigo-500 text-base sm:text-sm font-bold placeholder-gray-400">
                        </div>
                        <button type="submit" class="w-full sm:w-auto bg-white text-indigo-900 px-6 py-3 sm:py-2 rounded-lg font-bold text-sm hover:bg-indigo-50 transition-colors shadow-lg active:scale-95 transform">
                            Add Funds
                        </button>
                    </form>
                    <p class="text-[10px] text-indigo-400 mt-2">Min: ₦1,000. You will be asked to upload proof of payment.</p>
                </div>
            </div>
        </div>

        {# USAGE STATS #}
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100 flex flex-col justify-center items-center text-center h-full">
            <div class="p-3 bg-green-100 text-green-600 rounded-full mb-3">
                <svg class="w-6 h-6 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="font-bold text-gray-900 text-sm md:text-base">Total Transactions</h3>
            <p class="text-2xl md:text-3xl font-black text-gray-900 mt-1">{{ transactions|length }}</p>
        </div>
    </div>

    {# HISTORY LIST (Mobile-First Flex Cards) #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-5 md:px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="font-bold text-gray-700 text-sm md:text-base">Transaction History</h3>
        </div>
        
        <div class="divide-y divide-gray-100">
            
            {# Desktop-only table headers #}
            <div class="hidden md:flex px-6 py-3 bg-white text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100">
                <div class="w-1/4">Date</div>
                <div class="flex-1">Description</div>
                <div class="w-32 text-right">Amount</div>
                <div class="w-32 text-right">Balance</div>
            </div>

            {% for txn in transactions|sort((a, b) => b.createdAt <=> a.createdAt) %}
                <div class="p-4 md:px-6 md:py-4 hover:bg-gray-50 transition-colors flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
                    
                    {# Mobile Header: Description & Amount #}
                    <div class="flex justify-between items-start md:hidden w-full mb-1">
                        <div class="text-sm font-bold text-gray-900 pr-2 leading-tight">{{ txn.description }}</div>
                        <div class="flex-shrink-0">
                            {% if txn.type == 'CREDIT' %}
                                <span class="text-green-600 font-bold bg-green-50 border border-green-100 px-2 py-0.5 rounded text-[10px]">+ ₦{{ txn.amount|number_format }}</span>
                            {% else %}
                                <span class="text-red-600 font-bold bg-red-50 border border-red-100 px-2 py-0.5 rounded text-[10px]">- ₦{{ txn.amount|number_format }}</span>
                            {% endif %}
                        </div>
                    </div>

                    {# Desktop Date / Mobile Sub-Date #}
                    <div class="text-[10px] md:text-sm text-gray-500 w-full md:w-1/4 font-medium flex items-center md:block">
                        <span class="md:hidden mr-1">🕒</span> 
                        {{ txn.createdAt|date('M d, Y • h:i A') }}
                    </div>

                    {# Desktop Description / Mobile Reference #}
                    <div class="flex-1">
                        <div class="hidden md:block text-sm font-bold text-gray-900 mb-0.5">{{ txn.description }}</div>
                        {% if txn.reference %}
                            <div class="text-[10px] text-gray-400 font-mono tracking-wider">{{ txn.reference }}</div>
                        {% endif %}
                    </div>

                    {# Desktop Amount #}
                    <div class="hidden md:block w-32 text-right">
                        {% if txn.type == 'CREDIT' %}
                            <span class="text-green-600 font-bold bg-green-50 px-2 py-1 rounded text-xs">+ ₦{{ txn.amount|number_format }}</span>
                        {% else %}
                            <span class="text-red-600 font-bold bg-red-50 px-2 py-1 rounded text-xs">- ₦{{ txn.amount|number_format }}</span>
                        {% endif %}
                    </div>

                    {# Balance Due #}
                    <div class="mt-2 pt-2 border-t border-dashed border-gray-200 md:mt-0 md:pt-0 md:border-none text-right flex justify-between items-center md:block w-full md:w-32">
                        <span class="md:hidden text-[10px] font-bold text-gray-400 uppercase tracking-widest">Balance</span>
                        <span class="text-xs md:text-sm font-mono text-gray-600 font-bold md:font-normal">
                            ₦{{ txn.balanceAfter|number_format }}
                        </span>
                    </div>

                </div>
            {% else %}
                <div class="p-12 text-center">
                    <div class="text-3xl mb-2 opacity-50">💳</div>
                    <p class="text-gray-400 font-medium italic text-sm">No wallet activity yet.</p>
                </div>
            {% endfor %}
            
        </div>
    </div>

</div>
{% endblock %}