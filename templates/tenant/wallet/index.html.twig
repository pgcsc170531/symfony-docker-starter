{% extends 'base.html.twig' %}

{% block title %}My Wallet & Credits{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-8 px-6">
    
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900">💳 Wallet & Credits</h1>
        <p class="text-gray-500">Monitor your SMS and WhatsApp credit usage.</p>
    </div>

    {# 🟢 1. PENDING REQUESTS ALERT (Only shows if something is pending) #}
    {% if pendingRequests is defined and pendingRequests|length > 0 %}
    <div class="mb-8 bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r-xl shadow-sm">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm leading-5 font-medium text-yellow-800">Pending Credit Approvals</h3>
                <div class="mt-2 text-sm leading-5 text-yellow-700">
                    <ul class="list-disc pl-5 space-y-1">
                        {% for req in pendingRequests %}
                            <li>
                                <strong>₦{{ req.amount|number_format }}</strong> 
                                <span class="text-xs bg-yellow-200 px-2 py-0.5 rounded-full ml-2">Processing</span>
                                <span class="text-xs text-yellow-600 ml-2">Ref: {{ req.reference }}</span>
                                {% if not req.proofFilename %}
                                    <a href="{{ path('tenant_wallet_payment', {id: req.id}) }}" class="ml-4 underline font-bold text-yellow-900">
                                        👉 Complete Payment
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        
        {# 🟢 2. BALANCE CARD WITH TOP-UP FORM #}
        <div class="bg-indigo-900 rounded-2xl p-8 text-white shadow-xl relative overflow-hidden col-span-2">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-indigo-500 rounded-full opacity-20 blur-xl"></div>
            
            <div class="relative z-10">
                <h2 class="text-indigo-200 font-bold text-xs uppercase tracking-widest mb-1">Available Balance</h2>
                <div class="text-5xl font-black mb-6">₦{{ school.walletBalance|number_format(2) }}</div>
                
                <div class="bg-indigo-800/50 p-4 rounded-xl backdrop-blur-sm border border-indigo-700/50">
                    <p class="text-xs font-bold text-indigo-300 uppercase mb-2">⚡️ Quick Top Up</p>
                    <form action="{{ path('tenant_wallet_top_up') }}" method="POST" class="flex gap-2 items-center">
                        <div class="relative flex-grow max-w-[200px]">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">₦</span>
                            </div>
                            <input type="number" name="amount" placeholder="5000" min="1000" required 
                                   class="block w-full pl-7 rounded-lg border-0 py-2 text-gray-900 shadow-sm focus:ring-2 focus:ring-indigo-500 sm:text-sm font-bold">
                        </div>
                        <button type="submit" class="bg-white text-indigo-900 px-6 py-2 rounded-lg font-bold text-sm hover:bg-indigo-50 transition-colors shadow-lg">
                            Add Funds
                        </button>
                    </form>
                    <p class="text-[10px] text-indigo-400 mt-2">Min: ₦1,000. You will be asked to upload proof of payment.</p>
                </div>
            </div>
        </div>

        {# USAGE STATS #}
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col justify-center items-center text-center">
            <div class="p-3 bg-green-100 text-green-600 rounded-full mb-3">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="font-bold text-gray-900">Total Transactions</h3>
            <p class="text-2xl font-black text-gray-900">{{ transactions|length }}</p>
        </div>
    </div>

    {# HISTORY TABLE #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="font-bold text-gray-700">Transaction History</h3>
        </div>
        <table class="w-full text-left">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Date</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Description</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-right">Amount</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-right">Balance</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for txn in transactions|sort((a, b) => b.createdAt <=> a.createdAt) %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 text-sm text-gray-500">
                        {{ txn.createdAt|date('M d, Y • h:i A') }}
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-sm font-bold text-gray-900">{{ txn.description }}</div>
                        {% if txn.reference %}
                            <div class="text-xs text-gray-400 font-mono tracking-wider">{{ txn.reference }}</div>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right">
                        {% if txn.type == 'CREDIT' %}
                            <span class="text-green-600 font-bold bg-green-50 px-2 py-1 rounded text-xs">+ ₦{{ txn.amount|number_format }}</span>
                        {% else %}
                            <span class="text-red-600 font-bold bg-red-50 px-2 py-1 rounded text-xs">- ₦{{ txn.amount|number_format }}</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right text-sm font-mono text-gray-600">
                        ₦{{ txn.balanceAfter|number_format }}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="p-12 text-center text-gray-400 italic">No wallet activity yet.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}