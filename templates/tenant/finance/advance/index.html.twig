{% extends 'base.html.twig' %}
{% block title %}Advance Payments{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    {# ── Header ─────────────────────────────────────────────────────────── #}
    <div class="mb-5">
        <h1 class="text-xl font-black tracking-tight text-ink-900 sm:text-2xl">Advance Payments</h1>
        <p class="mt-1 text-sm text-ink-500">
            Money a family has paid before the bills existed. Every invoice raised afterwards
            for that pupil is settled from it — automatically, with a remark on the receipt.
        </p>
    </div>

    {# ── The two figures that matter, full width on a phone ─────────────── #}
    <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-ink-400">Credit still held</p>
            <p class="money mt-1 text-2xl font-black text-ink-900">₦{{ totalLeft|number_format(2) }}</p>
            <p class="mt-1 text-xs text-ink-500">Spendable on the next invoice raised.</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-ink-400">Received in advance</p>
            <p class="money mt-1 text-2xl font-black text-ink-900">₦{{ totalPaid|number_format(2) }}</p>
            <p class="mt-1 text-xs text-ink-500">Across {{ rows|length }} advance{{ rows|length == 1 ? '' : 's' }}.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        {# ── Record a new advance ───────────────────────────────────────── #}
        <section class="lg:col-span-1">
            <div class="rounded-xl border border-ink-200 bg-white">
                <div class="border-b border-ink-100 px-4 py-3">
                    <h2 class="text-sm font-bold text-ink-900">Record money paid ahead</h2>
                </div>

                {# Step 1 — find the pupil. GET, so the tab survives a refresh. #}
                <form method="get" action="{{ path('app_tenant_advance_index') }}" class="border-b border-ink-100 p-4">
                    <label for="advance-pupil" class="mb-1 block text-xs font-semibold text-ink-600">
                        Find the pupil
                    </label>
                    <input id="advance-pupil" name="q" type="search" value="{{ search }}" autocomplete="off"
                           placeholder="Name or admission number"
                           class="min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-base text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                    <button type="submit"
                            class="mt-2 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">
                        Search
                    </button>
                </form>

                {% if search != '' %}
                    <div class="border-b border-ink-100 p-4">
                        {% if found is empty %}
                            <p class="text-sm text-ink-500">
                                No pupil matches &ldquo;{{ search }}&rdquo;. Try the surname or the admission number.
                            </p>
                        {% else %}
                            <p class="mb-2 text-xs font-semibold text-ink-600">Choose the pupil:</p>
                            <ul class="space-y-2">
                                {% for s in found %}
                                    <li>
                                        <a href="{{ path('app_tenant_advance_index', {q: search, student: s.id}) }}"
                                           class="flex min-h-[44px] items-center justify-between gap-3 rounded-lg border px-3 py-2 text-sm
                                                  {{ student is defined and student.id == s.id
                                                     ? 'border-accent-500 bg-accent-50 text-ink-900'
                                                     : 'border-ink-200 text-ink-700 hover:border-accent-300' }}">
                                            <span class="min-w-0">
                                                <span class="block truncate font-semibold">{{ s.fullName }}</span>
                                                <span class="block truncate text-xs text-ink-500">
                                                    {{ s.admissionNumber ?: 'No admission number' }}
                                                    {%- if s.currentClassroom %} · {{ s.currentClassroom.name }}{% endif %}
                                                </span>
                                            </span>
                                            <span class="shrink-0 text-xs font-semibold text-accent-700">Select</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endif %}

                {# Step 2 — how much, how, and the remark an auditor will read. #}
                <form method="post" action="{{ path('app_tenant_advance_index') }}" class="p-4">
                    <input type="hidden" name="student_id" value="{{ student is defined ? student.id : '' }}">

                    {% if student is defined %}
                        <p class="mb-3 rounded-lg bg-ink-50 px-3 py-2 text-sm text-ink-800">
                            Recording for <strong>{{ student.fullName }}</strong>
                        </p>
                    {% else %}
                        <p class="mb-3 rounded-lg bg-ink-50 px-3 py-2 text-xs text-ink-500">
                            Search for and select a pupil above, then enter the amount.
                        </p>
                    {% endif %}

                    <div class="space-y-3">
                        <div>
                            <label for="advance-amount" class="mb-1 block text-xs font-semibold text-ink-600">Amount received (₦)</label>
                            <input id="advance-amount" name="amount" type="number" step="0.01" min="0" inputmode="decimal"
                                   placeholder="0.00"
                                   class="money min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-base font-bold text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                        </div>

                        <div>
                            <label for="advance-method" class="mb-1 block text-xs font-semibold text-ink-600">How was it paid?</label>
                            <select id="advance-method" name="method"
                                    class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                                {% for key, label in methods %}
                                    <option value="{{ key }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div>
                            <label for="advance-date" class="mb-1 block text-xs font-semibold text-ink-600">Date received</label>
                            <input id="advance-date" name="received_on" type="date" value="{{ 'now'|date('Y-m-d') }}"
                                   class="min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                        </div>

                        <div>
                            <label for="advance-covers" class="mb-1 block text-xs font-semibold text-ink-600">
                                What does it cover?
                            </label>
                            <input id="advance-covers" name="covers_note" type="text" maxlength="120"
                                   placeholder="e.g. 3 sessions, 2026/2027 – 2028/2029"
                                   class="min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-base text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                        </div>

                        <div>
                            <label for="advance-remark" class="mb-1 block text-xs font-semibold text-ink-600">
                                Remark for the audit
                            </label>
                            <textarea id="advance-remark" name="remark" rows="3"
                                      placeholder="e.g. Father paid in full at the bank — teller 0041, brought by the mother."
                                      class="w-full rounded-lg border border-ink-200 px-3 py-2 text-base text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"></textarea>
                            <p class="mt-1 text-xs text-ink-500">
                                Printed on every receipt this advance pays. Write it in words a stranger could follow.
                            </p>
                        </div>
                    </div>

                    <button type="submit"
                            class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700 disabled:opacity-50"
                            {{ student is defined ? '' : 'disabled' }}>
                        Record advance
                    </button>
                </form>
            </div>
        </section>

        {# ── The advances on file ───────────────────────────────────────── #}
        <section class="lg:col-span-2">
            <div class="rounded-xl border border-ink-200 bg-white">
                <div class="border-b border-ink-100 px-4 py-3">
                    <h2 class="text-sm font-bold text-ink-900">Advances on file</h2>
                </div>

                {% if rows is empty %}
                    <div class="px-4 py-10 text-center">
                        <p class="text-sm font-semibold text-ink-700">No advance has been recorded yet.</p>
                        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-500">
                            When a parent pays a term or a year ahead, record it with the form on the left.
                            From then on, their invoices are settled automatically.
                        </p>
                    </div>
                {% else %}
                    <ul class="divide-y divide-ink-100">
                        {% for row in rows %}
                            {% set a = row.advance %}
                            <li class="p-4">
                                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                                    <div class="min-w-0">
                                        <p class="break-words text-sm font-bold text-ink-900">
                                            {{ a.student.fullName }}
                                        </p>
                                        <p class="mt-0.5 break-words text-xs text-ink-500">
                                            <span class="tabular">{{ a.reference }}</span>
                                            · {{ a.receivedOn ? a.receivedOn|date('j M Y') : 'date not set' }}
                                            · {{ methods[a.method] ?? a.method }}
                                        </p>
                                        {% if a.coversNote %}
                                            <p class="mt-1 text-xs text-ink-600">Covers {{ a.coversNote }}</p>
                                        {% endif %}
                                    </div>

                                    <div class="flex shrink-0 items-center gap-2 sm:flex-col sm:items-end">
                                        <span class="badge-neutral rounded-full border px-2 py-0.5 text-[11px] font-semibold">
                                            {%- if a.closed %}Closed
                                            {%- elseif row.left <= 0.005 %}Fully used
                                            {%- else %}Open
                                            {%- endif -%}
                                        </span>
                                        <p class="money text-sm font-bold text-ink-900">
                                            ₦{{ row.left|number_format(2) }} left
                                        </p>
                                    </div>
                                </div>

                                <div class="mt-2 grid grid-cols-2 gap-2 text-xs text-ink-600 sm:max-w-xs">
                                    <div>
                                        <span class="block text-[11px] uppercase tracking-wider text-ink-400">Received</span>
                                        <span class="money font-semibold text-ink-800">₦{{ a.amount|number_format(2) }}</span>
                                    </div>
                                    <div>
                                        <span class="block text-[11px] uppercase tracking-wider text-ink-400">Used</span>
                                        <span class="money font-semibold text-ink-800">₦{{ row.used|number_format(2) }}</span>
                                    </div>
                                </div>

                                {% if a.remark %}
                                    <p class="mt-2 break-words rounded-lg bg-ink-50 px-3 py-2 text-xs text-ink-600">
                                        {{ a.remark }}
                                    </p>
                                {% endif %}

                                <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                                    <a href="{{ path('app_tenant_advance_show', {id: a.id}) }}"
                                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-200 px-4 text-sm font-semibold text-ink-700 hover:border-accent-300 hover:text-accent-700 sm:min-h-[38px]">
                                        View what it paid
                                    </a>
                                    <form method="post" action="{{ path('app_tenant_advance_close', {id: a.id}) }}"
                                          onsubmit="return confirm('{{ a.closed ? 'Reopen this advance?' : 'Close this advance? Its remaining credit will stop paying new invoices.' }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('advance_close_' ~ a.id) }}">
                                        <button type="submit"
                                                class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-200 px-4 text-sm font-semibold text-ink-600 hover:border-ink-300 hover:text-ink-900 sm:min-h-[38px] sm:w-auto">
                                            {{ a.closed ? 'Reopen' : 'Close' }}
                                        </button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    </div>
</div>
{% endblock %}
