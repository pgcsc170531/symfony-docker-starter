{% extends 'base.html.twig' %}

{% block title %}Unmatched transfers{% endblock %}

{#
    Money that arrived on a family's dedicated account and could not be matched to
    a bill. Placing it is deliberate: the bursar types the invoice number, so a
    transfer is never auto-applied to the wrong child
    (docs/payments/VIRTUAL-ACCOUNTS-DESIGN.md §5.5, §5.6).
#}

{% block body %}
<div class="px-4 py-4 sm:py-6">

    <h1 class="text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">Unmatched transfers</h1>
    <p class="mt-1 text-sm leading-relaxed text-ink-600">
        Transfers that reached a family's account but did not match a bill. Parents can place their own;
        anything they cannot resolve lands here.
    </p>

    {% if credits is empty %}
        <div class="mt-6 rounded-xl border border-ink-200 bg-white p-5 text-center">
            <p class="text-sm font-bold text-ink-900">Nothing is unmatched.</p>
            <p class="mt-1 text-sm text-ink-600">Every transfer received has been applied to a bill.</p>
        </div>
    {% else %}
        <div class="mt-4 rounded-xl border border-pending/40 bg-white p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-ink-500">Held in total</p>
            <p class="money text-2xl font-black text-ink-900">₦{{ total|number_format(2) }}</p>
            <p class="mt-1 text-xs text-ink-500">{{ credits|length }} transfer{{ credits|length == 1 ? '' : 's' }}</p>
        </div>

        <div class="mt-4 space-y-4">
            {% for credit in credits %}
                <div class="rounded-2xl border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="money text-lg font-bold text-ink-900">₦{{ credit.amount|number_format(2) }}</p>
                            <p class="mt-0.5 truncate text-xs text-ink-500">
                                {{ credit.paidAt|date('j M Y, g:ia') }}
                                {% if credit.senderName %} · {{ credit.senderName }}{% endif %}
                                {% if credit.senderBank %} ({{ credit.senderBank }}){% endif %}
                            </p>
                            {% if credit.virtualAccount and credit.virtualAccount.guardian %}
                                <p class="mt-1 truncate text-xs font-semibold text-ink-700">
                                    {{ credit.virtualAccount.guardian.fullName }} · {{ credit.virtualAccount.accountNumber }}
                                </p>
                            {% endif %}
                        </div>
                        <span class="shrink-0 rounded-full bg-pending/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-pending">
                            Unassigned
                        </span>
                    </div>

                    <form method="post" action="{{ path('app_finance_credit_apply', {id: credit.id}) }}" class="mt-4 space-y-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('apply_credit_' ~ credit.id) }}">

                        <div>
                            <label for="invoice-{{ credit.id }}" class="text-xs font-bold uppercase tracking-wide text-ink-500">
                                Apply to invoice
                            </label>
                            <input id="invoice-{{ credit.id }}" name="invoice_number" required
                                   placeholder="INV-2026-0002"
                                   class="mt-1 min-h-[44px] w-full rounded-lg border border-ink-300 px-3 font-mono text-base text-ink-900">
                        </div>

                        <button type="submit"
                                class="inline-flex min-h-[48px] w-full items-center justify-center rounded-xl bg-accent-600 px-5 text-sm font-bold text-white transition-colors hover:bg-accent-700">
                            Apply ₦{{ credit.amount|number_format(2) }}
                        </button>
                    </form>

                    <form method="post" action="{{ path('app_finance_credit_refund', {id: credit.id}) }}" class="mt-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('refund_credit_' ~ credit.id) }}">
                        <button type="submit"
                                class="inline-flex min-h-[44px] w-full items-center justify-center rounded-xl border border-ink-300 px-5 text-sm font-bold text-ink-700 transition-colors hover:border-failed/40 hover:text-failed">
                            Mark for refund
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>

        <p class="mt-4 text-xs leading-relaxed text-ink-500">
            A transfer larger than the bill is refused — split it by placing part of it on another bill first.
            Refunds are made at Paystack; marking one here only records the decision.
        </p>
    {% endif %}
</div>
{% endblock %}
