{% extends 'base.html.twig' %}

{% block title %}Verify Payments{% endblock %}

{% block body %}
<div class="px-4 py-4">

    <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent-600">Bursary</p>
            <h1 class="text-2xl font-semibold tracking-tight text-ink-900">Verify payments</h1>
            <p class="text-sm leading-relaxed text-ink-500">
                {% if payments|length > 0 %}
                    {{ payments|length }} payment{{ payments|length == 1 ? '' : 's' }} awaiting verification
                    &middot; ₦{{ pendingTotal|number_format(2) }} claimed
                {% else %}
                    Nothing is waiting to be verified.
                {% endif %}
            </p>
        </div>
        <a href="{{ path('app_tenant_payment_index') }}"
           class="inline-flex min-h-[44px] shrink-0 items-center text-sm font-semibold text-accent-600 hover:text-accent-700">
            Payment terminal &rarr;
        </a>
    </div>

    {# The bursar is reading a bank app: any of these values should find the row. #}
    <form method="get" action="{{ path('app_tenant_payment_verify') }}"
          class="mb-5 flex flex-wrap items-center gap-2">
        <div class="min-w-0 flex-1 basis-56">
            <label class="sr-only" for="verify-q">Search pending payments</label>
            <input id="verify-q" name="q" type="search" value="{{ q }}" autocomplete="off"
                   placeholder="Name, admission no, slip code, phone, invoice or amount"
                   class="min-h-[44px] w-full rounded-lg border border-ink-200 bg-white px-3 text-sm text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
        </div>
        <button type="submit"
                class="min-h-[44px] shrink-0 rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white transition-colors hover:bg-accent-700">
            Search
        </button>
        {% if q %}
            <a href="{{ path('app_tenant_payment_verify') }}"
               class="inline-flex min-h-[44px] shrink-0 items-center px-2 text-sm font-semibold text-ink-500 hover:text-ink-800">
                Clear
            </a>
        {% endif %}
    </form>

    {% if payments is empty %}
        <div class="rounded-lg border border-dashed border-ink-300 bg-white p-6 text-center">
            {% if q %}
                <p class="text-sm font-semibold text-ink-900">No pending payment matches “{{ q }}”</p>
                <p class="mx-auto mt-1 max-w-md text-sm leading-relaxed text-ink-500">
                    Check the spelling, or search by the slip code the parent used.
                    Payments already confirmed are in the payment register, not here.
                </p>
            {% else %}
                <p class="text-sm font-semibold text-ink-900">Every payment has been checked</p>
                <p class="mx-auto mt-1 max-w-md text-sm leading-relaxed text-ink-500">
                    A parent's transfer appears here as soon as they open a payment slip or
                    upload a receipt.
                </p>
            {% endif %}
            <a href="{{ path('app_tenant_payment_history') }}"
               class="mt-2 inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-600 hover:text-accent-700">
                Open the payment register &rarr;
            </a>
        </div>
    {% else %}
        <ul class="space-y-3">
            {% for payment in payments %}
                {% set student = payment.invoice and payment.invoice.student ? payment.invoice.student : null %}
                <li class="rounded-lg border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="break-words text-sm font-semibold text-ink-900">
                                {{ student ? student.fullName : (payment.invoice ? payment.invoice.buyerName : 'Walk-in sale') }}
                            </p>
                            <p class="text-xs text-ink-500">
                                {% if student and student.admissionNumber %}{{ student.admissionNumber }} &middot; {% endif %}
                                {{ payment.invoice ? payment.invoice.invoiceNumber : '—' }}
                            </p>
                            <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-ink-500">
                                <span class="badge-neutral font-mono">{{ payment.referenceCode }}</span>
                                <span class="badge-pending">Awaiting</span>
                                <span>{{ payment.method }}</span>
                                <span>{{ payment.createdAt ? payment.createdAt|date('d M, H:i') : '' }}</span>
                            </p>
                            <p class="mt-1 text-xs">
                                {% if payment.proofFilename %}
                                    <a href="{{ asset('uploads/proofs/' ~ payment.proofFilename) }}" target="_blank" rel="noopener"
                                       class="font-semibold text-accent-600 underline">
                                        Open the parent's proof
                                    </a>
                                    {% if payment.proofUploadedAt %}
                                        <span class="text-ink-400">({{ payment.proofUploadedAt|date('d M, H:i') }})</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-ink-400">No proof uploaded — match the slip code in your bank narration.</span>
                                {% endif %}
                            </p>
                        </div>
                        <p class="money shrink-0 text-lg font-semibold text-ink-900">
                            ₦{{ payment.amount|number_format(2) }}
                        </p>
                    </div>

                    {#
                        Approval requires the amount to be typed again. It is the
                        one deliberate second look that stops a queue being
                        rubber-stamped, and it is where a real-world difference
                        (bank charges, a part payment) is recorded.
                    #}
                    <form method="post"
                          action="{{ path('app_tenant_payment_confirm', {id: payment.id}) }}"
                          class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
                        <input type="hidden" name="_token" value="{{ csrf_token('payment_confirm_' ~ payment.id) }}">
                        <input type="hidden" name="return_to" value="queue">

                        <div>
                            <label for="amount-{{ payment.id }}" class="mb-1 block text-xs font-semibold text-ink-700">
                                Amount you saw in the bank (₦)
                            </label>
                            <input id="amount-{{ payment.id }}" name="actual_amount" type="number"
                                   step="0.01" min="0" inputmode="decimal" required
                                   value="{{ payment.amount }}"
                                   class="min-h-[44px] w-full rounded-lg border border-ink-200 px-3 text-sm text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                        </div>

                        <button type="submit"
                                class="min-h-[44px] w-full rounded-lg bg-paid px-5 text-sm font-semibold text-white transition-colors hover:bg-paid/90 sm:w-auto">
                            Approve payment
                        </button>

                        <label class="flex items-start gap-2 text-xs leading-relaxed text-ink-600 sm:col-span-2">
                            <input type="checkbox" name="amount_differs" value="1"
                                   class="mt-0.5 h-4 w-4 shrink-0 rounded border-ink-300">
                            <span>The bank shows a different amount from the slip — record the bank amount above.</span>
                        </label>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

</div>
{% endblock %}
