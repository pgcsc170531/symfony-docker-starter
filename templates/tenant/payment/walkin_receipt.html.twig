{% extends 'base.html.twig' %}

{% block title %}Walk-In Receipt - {{ payment.referenceCode }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto mt-10 p-6 bg-white shadow-lg border-t-8 border-indigo-600 rounded-lg">
    
    <div class="text-center mb-6 border-b pb-4 border-dashed border-gray-300">
        <h1 class="text-2xl font-black text-gray-900">{{ liveSchool ? liveSchool.name : 'School Store' }}</h1>
        <p class="text-gray-500 text-sm">CASH RECEIPT</p>
    </div>

    <div class="flex justify-between items-center mb-6 text-sm">
        <div>
            <p class="text-gray-500 font-bold uppercase text-[10px]">Customer Name</p>
            <p class="font-bold text-gray-900 text-lg">{{ buyerName }} <span class="text-xs text-indigo-500 font-medium">(Walk-In)</span></p>
        </div>
        <div class="text-right">
            <p class="text-gray-500 font-bold uppercase text-[10px]">Receipt Date</p>
            <p class="font-bold text-gray-900">{{ payment.confirmedAt|date('d M, Y h:i A') }}</p>
            <p class="text-xs font-mono text-gray-500 mt-1">Ref: {{ payment.referenceCode }}</p>
        </div>
    </div>

    <div class="mb-6">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-100 text-gray-600 uppercase font-bold text-[10px]">
                <tr>
                    <th class="py-2 px-3">Item Description</th>
                    <th class="py-2 px-3 text-center">Qty</th>
                    <th class="py-2 px-3 text-right">Amount</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for item in invoice.items %}
                    <tr>
                        <td class="py-3 px-3 font-medium">{{ item.product ? item.product.name : 'Unknown Item' }}</td>
                        <td class="py-3 px-3 text-center">{{ item.quantity }}</td>
                        <td class="py-3 px-3 text-right font-bold">₦{{ item.amount|number_format(2) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="flex justify-end border-t border-dashed border-gray-300 pt-4">
        <div class="text-right">
            <p class="text-gray-500 font-bold uppercase text-[10px] mb-1">Total Paid</p>
            <p class="text-3xl font-black text-green-600">₦{{ payment.amount|number_format(2) }}</p>
        </div>
    </div>

    <div class="mt-8 text-center flex gap-4 justify-center">
        <button onclick="window.print()" class="bg-gray-800 text-white px-6 py-2 rounded font-bold hover:bg-gray-900 print:hidden">🖨️ Print Receipt</button>
        <a href="{{ path('app_tenant_store_search') }}" class="bg-indigo-100 text-indigo-700 px-6 py-2 rounded font-bold hover:bg-indigo-200 print:hidden">New Sale</a>
    </div>

</div>
{% endblock %}