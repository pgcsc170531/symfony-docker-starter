<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Receipt #{{ payment.referenceCode }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
       @media print {
        body { 
            background: white; 
            -webkit-print-color-adjust: exact; /* Chrome/Safari */
            print-color-adjust: exact; /* Firefox */
        }
        .no-print { display: none !important; }
        .receipt-container { 
            border: none; 
            box-shadow: none; 
            margin: 0; 
            padding: 0;
            width: 100%;
        }
    }
        /* Watermark style */
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 6rem;
            color: rgba(0,0,0,0.03);
            font-weight: black;
            pointer-events: none;
            z-index: 0;
        }
    </style>
</head>
<body class="bg-gray-100 p-10 print:p-0">

{# Try Snapshot from Invoice first, then fallback to Live School settings #}
{% set invoice = payment.invoice %}
{% set name = invoice.schoolName|default(liveSchool ? liveSchool.name : 'School Name') %}
{% set address = invoice.schoolAddress|default(liveSchool ? liveSchool.address : '') %}
{% set email = invoice.schoolEmail|default(liveSchool ? liveSchool.email : '') %}
{% set logo = invoice.schoolLogo|default(liveSchool ? liveSchool.logoFilename : null) %}


    {# TOOLS (Hidden when printing) #}
    <div class="max-w-2xl mx-auto mb-6 flex justify-between items-center no-print">
        <a href="{{ path('app_tenant_invoice_show', {id: invoice.id}) }}" class="text-gray-600 hover:text-gray-900 font-bold">
            &larr; Back to Invoice
        </a>
        <button onclick="window.print()" class="bg-blue-600 text-white px-6 py-2 rounded shadow hover:bg-blue-700 font-bold">
            🖨️ Print Receipt
        </button>
    </div>

    {# RECEIPT CANVAS #}
    <div class="max-w-2xl mx-auto bg-white p-8 border border-gray-300 shadow-lg relative overflow-hidden receipt-container">
        
        <div class="watermark">PAID</div>

        {# HEADER #}
        <div class="flex justify-between items-start border-b-2 border-gray-800 pb-6 mb-6 relative z-10">
            <div class="flex items-center gap-4">
                {# LOGO #}
                {% if logo %}
                
                    <img src="{{ asset('uploads/logos/' ~ logo) }}" 
                    alt="{{ name }}" 
                    class="h-20 w-auto max-w-[120px] bg-white rounded p-1 object-contain">
                {% else %}
                    <div class="h-16 w-16 bg-gray-700 rounded flex items-center justify-center text-3xl">🏫</div>
                {% endif %}
                <div>
                    <h1 class="font-black text-lg uppercase tracking-tighter sm:text-2xl">{{ name }}</h1>
                    <p class="text-xs text-gray-500">{{ address }}</p>
                    <p class="text-xs text-gray-500">{{ email }}</p>
                </div>
            </div>
            <div class="text-right">
                <h2 class="text-xl font-bold text-gray-800 uppercase tracking-widest">Receipt</h2>
                <p class="font-mono text-red-600 font-bold text-lg">#{{ payment.referenceCode }}</p>
                <p class="text-xs text-gray-400">Date: {{ payment.confirmedAt|date('d-M-Y') }}</p>
            </div>
        </div>

        {# INFO GRID #}
        <div class="grid grid-cols-2 gap-8 mb-8 relative z-10 text-sm">
            <div>
                <p class="text-gray-400 uppercase text-xs font-bold mb-1">Received From</p>
                <p class="font-bold text-lg text-gray-800">{{ student.fullName }}</p>
                <p class="font-mono text-gray-500">{{ student.admissionNumber }}</p>
            </div>
            <div class="text-right">
                <p class="text-gray-400 uppercase text-xs font-bold mb-1">Payment Method</p>
                <p class="font-bold text-gray-800 uppercase">{{ payment.method }}</p>
                {% if payment.reference %}
                    <p class="text-xs text-gray-500">Ref: {{ payment.reference }}</p>
                {% endif %}
            </div>
        </div>

        {# PAYMENT DETAILS #}
        <div class="bg-gray-50 p-6 rounded mb-8 relative z-10">
            <div class="flex justify-between items-center mb-2">
                <span class="text-gray-600 font-medium">Payment For:</span>
                <span class="font-bold text-gray-800">{{ invoice.term.name }} - {{ invoice.type }}</span>
            </div>
            <div class="flex justify-between items-center border-t border-gray-200 pt-2 mt-2">
                <span class="text-gray-800 font-black text-lg">Amount Paid:</span>
                <span class="text-xl font-black text-gray-900 sm:text-2xl">₦{{ payment.amount|number_format(2) }}</span>
            </div>
        </div>

        {#
            ── ACCOUNT POSITION ─────────────────────────────────────────────
            Many families pay in instalments. A receipt that shows only the
            amount handed over proves the payment but says nothing about what is
            still owed — so from the FIRST receipt the parent can see the balance
            and knows exactly what is left to clear.

            Printed and filed, so it is plain markup with no interactive parts.
        #}
        {% set invoiceTotal = invoice.totalAmount|default(0) %}
        {% set discount = invoice.discountApplied|default(0) %}
        {% set paidToDate = invoice.paidAmount|default(0) %}
        {% set balanceLeft = invoice.balanceDue %}

        <div class="border border-gray-300 rounded mb-8 relative z-10 overflow-hidden">
            <p class="bg-gray-800 text-white text-xs font-bold uppercase tracking-widest px-4 py-2">
                Account position{% if invoice.term %} — {{ invoice.term.name }} {{ invoice.session ? invoice.session.name : '' }}{% endif %}
            </p>
            <table class="w-full text-sm">
                <tbody class="divide-y divide-gray-200">
                    <tr>
                        <td class="px-4 py-3 text-gray-600">Invoice total</td>
                        <td class="px-4 py-3 text-right font-bold text-gray-800 tabular-nums">₦{{ invoiceTotal|number_format(2) }}</td>
                    </tr>
                    {% if discount > 0 %}
                        <tr>
                            <td class="px-4 py-3 text-gray-600">Scholarship / discount</td>
                            <td class="px-4 py-3 text-right font-bold text-green-700 tabular-nums">−₦{{ discount|number_format(2) }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td class="px-4 py-3 text-gray-600">
                            Paid to date
                            <span class="block text-xs text-gray-400">includes this receipt</span>
                        </td>
                        <td class="px-4 py-3 text-right font-bold text-gray-800 tabular-nums">₦{{ paidToDate|number_format(2) }}</td>
                    </tr>
                    <tr class="bg-gray-50">
                        <td class="px-4 py-3 font-black text-gray-900">Balance remaining</td>
                        <td class="px-4 py-3 text-right font-black tabular-nums sm:text-lg {{ balanceLeft > 0 ? 'text-red-600' : 'text-green-700' }}">
                            {% if balanceLeft > 0 %}
                                ₦{{ balanceLeft|number_format(2) }}
                            {% else %}
                                ₦0.00 — fully settled
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
            <p class="px-4 py-3 text-xs leading-relaxed text-gray-500 border-t border-gray-200">
                {% if balanceLeft > 0 %}
                    ₦{{ balanceLeft|number_format(2) }} is still to be paid to clear this invoice.
                    Pay it any time from the parent portal, or transfer to the school account and upload the receipt.
                    Part payments are accepted.
                {% else %}
                    This invoice is fully paid. Nothing further is owed.
                {% endif %}
            </p>
        </div>

        {# FOOTER #}
        <div class="flex justify-between items-end relative z-10 mt-12">
            <div class="text-center">
                <div class="border-b border-gray-400 w-32 mb-1"></div>
                <p class="text-xs text-gray-400 uppercase">Bursar Signature</p>
            </div>
            <div class="text-right text-xs text-gray-400">
                <p>Generated by {{ payment.confirmedBy|default('System') }}</p>
                <p>{{ "now"|date('Y-m-d H:i:s') }}</p>
            </div>
        </div>

    </div>

</body>
</html>