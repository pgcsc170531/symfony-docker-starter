{% extends 'base.html.twig' %}

{% block title %}Payment Slip #{{ payment.referenceCode }}{% endblock %}

{% block body %}
{# === GET SCHOOL SNAPSHOT DATA === #}
{% set invoice = payment.invoice %}
{# Fallback to live school data if invoice snapshot is missing #}
{% set schoolName = invoice.schoolName|default(school ? school.name : 'School Name') %}
{% set schoolAddress = invoice.schoolAddress|default(school ? school.address : '') %}
{% set schoolLogo = invoice.schoolLogo|default(school ? school.logoFilename : null) %}

<div class="max-w-2xl mx-auto my-10 bg-white p-8 shadow-lg rounded-lg border border-gray-200 print:shadow-none print:border-none print:my-0 print:w-full">
    
    {# HEADER: School Branding + Title #}
    <div class="text-center border-b pb-6 mb-6">
        
        {# 1. School Logo & Name #}
        <div class="mb-6">
            {% if schoolLogo %}
                <img src="{{ asset('uploads/logos/' ~ schoolLogo) }}" 
                     alt="{{ schoolName }}" 
                     class="h-24 w-auto mx-auto object-contain mb-2">
            {% else %}
                <div class="text-5xl mb-2">🏫</div>
            {% endif %}
            
            <h2 class="text-xl font-bold uppercase text-gray-800 tracking-wide">{{ schoolName }}</h2>
            {% if schoolAddress %}
                <p class="text-sm text-gray-500 max-w-md mx-auto">{{ schoolAddress }}</p>
            {% endif %}
        </div>

        {# 2. Slip Title #}
        <div class="bg-gray-100 rounded py-3 print:bg-gray-100">
            <h1 class="text-2xl font-black text-gray-900 uppercase tracking-tight">Payment Instruction Slip</h1>
            <p class="text-gray-600 text-sm mt-1 font-medium">Please use the details below to complete your transfer</p>
        </div>
    </div>

    {# THE MAGIC CODE BOX (Crucial for Verification) #}
    <div class="bg-blue-50 border-2 border-blue-200 rounded-lg p-6 text-center mb-8 print:bg-blue-50 print:border-blue-200">
        <p class="text-blue-700 font-bold uppercase tracking-wider text-xs mb-2">Transaction Reference Code</p>
        <div class="text-4xl font-black text-blue-900 tracking-[0.2em] font-mono select-all">
            {{ payment.referenceCode }}
        </div>
        <div class="mt-3 flex items-start justifying-center gap-2 text-left max-w-sm mx-auto bg-white p-2 rounded border border-blue-100 shadow-sm">
            <span class="text-xl">⚠️</span>
            <p class="text-xs text-red-600 font-bold leading-tight">
                IMPORTANT: You <span class="underline">MUST</span> type this code in your bank app's "Narration" or "Remarks" field.
            </p>
        </div>
    </div>

    {# DETAILS GRID #}
    <div class="grid grid-cols-2 gap-y-6 gap-x-8 mb-8 text-sm">
        <div>
            <p class="text-gray-400 mb-1 text-[10px] uppercase font-bold tracking-wider">Student Name</p>
            <p class="font-bold text-gray-800 text-lg leading-tight">{{ student.fullName }}</p>
            <p class="text-xs text-gray-500 font-mono mt-1">{{ student.admissionNumber }}</p>
        </div>
        <div class="text-right">
            <p class="text-gray-400 mb-1 text-[10px] uppercase font-bold tracking-wider">Payment For</p>
            <p class="font-bold text-gray-800">
                {{ invoice.term.name }} <span class="text-gray-400">/</span> {{ invoice.session.name }}
            </p>
            <span class="inline-block bg-gray-100 text-gray-600 text-[10px] font-bold px-2 py-0.5 rounded mt-1 uppercase">
                {{ invoice.type }}
            </span>
        </div>
        <div>
            <p class="text-gray-400 mb-1 text-[10px] uppercase font-bold tracking-wider">Date Issued</p>
            <p class="font-bold text-gray-800">{{ payment.createdAt|date('d M Y, h:i A') }}</p>
        </div>
        <div class="text-right">
            <p class="text-gray-400 mb-1 text-[10px] uppercase font-bold tracking-wider">Amount to Pay</p>
            <p class="font-black text-gray-900 text-3xl">₦{{ payment.amount|number_format(2) }}</p>
        </div>
    </div>

    {# BANK DETAILS (Dynamic) #}
    <div class="border-t-2 border-dashed border-gray-200 pt-6 mb-8">
        <h3 class="text-xs font-bold text-gray-400 mb-4 uppercase tracking-widest text-center">Pay Into This Account</h3>
        
        <div class="flex items-center space-x-5 bg-gray-50 p-6 rounded-xl border border-gray-200 print:bg-gray-50">
            <div class="text-4xl bg-white p-3 rounded-full shadow-sm border border-gray-100">🏦</div>
            <div>
                <p class="text-gray-500 text-sm font-medium uppercase tracking-wide mb-1">
                    {{ bank_details.bank|default('Bank Not Set') }}
                </p>
                <p class="text-gray-900 font-mono text-3xl tracking-wide font-bold">
                    {{ bank_details.account_number|default('0000000000') }}
                </p>
                <p class="text-xs text-gray-500 font-bold uppercase mt-1 tracking-wider">
                    {{ bank_details.name|default('School Account') }}
                </p>
            </div>
        </div>
    </div>

    {# FOOTER / ACTIONS #}
    <div class="flex justify-between items-center no-print mt-10 border-t pt-6">
        <a href="{{ path('app_tenant_invoice_show', {id: payment.invoice.id}) }}" class="text-gray-500 hover:text-gray-900 text-sm font-bold flex items-center transition-colors">
            &larr; Return to Invoice
        </a>
        
        <button onclick="window.print()" class="bg-indigo-600 text-white px-8 py-3 rounded-lg hover:bg-indigo-700 font-bold shadow-lg flex items-center gap-2 transition-all transform hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
            Print Slip
        </button>
    </div>
</div>

<style>
    @media print {
        body { 
            background: white; 
            -webkit-print-color-adjust: exact; /* 🟢 CRITICAL: Forces background colors to print */
            print-color-adjust: exact;
        }
        .no-print { display: none !important; }
        .max-w-2xl { 
            max-width: 100% !important; 
            margin: 0 !important; 
            box-shadow: none !important; 
            border: none !important; 
        }
        /* Hide Base Template elements */
        nav, aside, footer, header { display: none !important; }
        
        /* Ensure the bank details box stands out on paper */
        .bg-gray-50 { background-color: #f9fafb !important; }
        .bg-blue-50 { background-color: #eff6ff !important; }
    }
</style>
{% endblock %}