{% extends 'base.html.twig' %}
{% block title %}Bursar Terminal{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto mt-12 px-4">
    
    <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-gray-800">💳 Payment Terminal</h1>
        <p class="text-gray-500">Search for a student to view bills and record payments.</p>
    </div>

    {# SEARCH CARD #}
    <div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
        <form method="get" action="{{ path('app_tenant_payment_index') }}" class="relative">
            <input type="text" name="q" value="{{ query }}" 
                   placeholder="Enter Student Name or Admission Number..." 
                   class="w-full pl-14 pr-4 py-4 rounded-xl border-2 border-gray-200 focus:border-indigo-600 focus:ring-0 text-lg transition-colors placeholder-gray-400"
                   autofocus>
            <div class="absolute top-0 left-0 mt-5 ml-5 text-gray-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <button type="submit" class="absolute top-2.5 right-2.5 bg-indigo-600 text-white px-8 py-2.5 rounded-lg font-bold hover:bg-indigo-700 transition-colors shadow-sm">
                Search
            </button>
        </form>

        {# QUICK LINKS #}
        <div class="mt-6 flex justify-center gap-4 text-sm text-gray-500">
            <a href="{{ path('app_tenant_payment_history') }}" class="hover:text-indigo-600 flex items-center gap-1">
                <span>📜 View Payment History</span>
            </a>
            <span>•</span>
            <a href="{{ path('app_tenant_payment_verify') }}" class="hover:text-indigo-600 flex items-center gap-1">
                <span>✅ Verify Bank Transfer</span>
            </a>
        </div>
    </div>

    {# RESULTS #}
    {% if query %}
        <div class="mt-8">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest">Search Results</h2>
            </div>
            
            {% if students|length > 0 %}
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden divide-y divide-gray-100">
                    {% for student in students %}
                        <a href="{{ path('app_tenant_payment_terminal', {id: student.id}) }}" class="flex items-center justify-between p-5 hover:bg-indigo-50 transition-colors group cursor-pointer">
                            <div class="flex items-center gap-4">
                                <div class="h-12 w-12 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-lg">
                                    {{ student.firstName|first }}{{ student.lastName|first }}
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-800 text-lg group-hover:text-indigo-700">{{ student.firstName }} {{ student.lastName }}</h3>
                                    <p class="text-sm text-gray-500">{{ student.admissionNumber }} • {{ student.currentClassroom ? student.currentClassroom.name : 'No Class' }}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 text-gray-400 group-hover:text-indigo-600">
                                <span class="text-sm font-medium">Select</span>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-12 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                    <p class="text-gray-500">No students found matching "{{ query }}"</p>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}