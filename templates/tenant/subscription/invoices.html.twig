{% extends 'base.html.twig' %}

{% block title %}Invoices{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:py-6">

    <a href="{{ path('tenant_subscription_index') }}" class="inline-flex min-h-[44px] items-center text-sm font-semibold text-accent-600 hover:underline">
        ← Subscription
    </a>

    <h1 class="mt-2 text-xl font-bold text-ink-900 sm:text-2xl">Invoices</h1>
    <p class="mt-1 text-sm text-ink-700">Every Edus invoice for this school, newest first.</p>

    {% if payments|length == 0 %}
        <div class="mt-4 rounded-xl border border-ink-200 bg-white p-6 text-center">
            <p class="text-base font-semibold text-ink-900">No invoices yet</p>
            <p class="mt-1 text-sm text-ink-700">
                Register a term and your first invoice appears here.
            </p>
            <a href="{{ path('tenant_subscription_register') }}"
               class="mt-3 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700">
                Register this term
            </a>
        </div>
    {% else %}
        <ul class="mt-4 space-y-3">
            {% for payment in payments %}
                {% set registration = payment.termRegistration %}
                <li class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-bold text-ink-900">{{ payment.reference }}</p>
                            <p class="text-xs text-ink-600">
                                {{ payment.createdAt ? payment.createdAt|date('j M Y') : '' }}
                                {% if registration %}
                                    · {{ registration.sessionName }} · {{ registration.termName }}
                                {% endif %}
                                · {{ payment.plan ? payment.plan.name : 'Plan' }}
                            </p>
                        </div>
                        <span class="rounded-full px-2.5 py-0.5 text-xs font-bold
                                     {{ payment.status == 'APPROVED' ? 'bg-paid/10 text-paid'
                                        : (payment.status == 'CANCELLED' ? 'bg-ink-100 text-ink-600'
                                        : (payment.status == 'DECLINED' ? 'bg-failed/10 text-failed' : 'bg-pending/10 text-pending')) }}">
                            {{ payment.status|capitalize }}
                        </span>
                    </div>

                    <dl class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
                        <div class="flex items-baseline gap-2">
                            <dt class="text-ink-700">Amount</dt>
                            <dd class="text-base font-extrabold text-ink-900">₦{{ payment.amount|number_format(0) }}</dd>
                        </div>
                        {% if registration %}
                            <div class="flex items-baseline gap-2">
                                <dt class="text-ink-700">Roll</dt>
                                <dd class="font-medium text-ink-900">{{ registration.declaredStudents|number_format(0) }} {{ learner.plural }}</dd>
                            </div>
                        {% endif %}
                    </dl>

                    {% if payment.status in ['PENDING', 'VERIFYING'] %}
                        <a href="{{ path('tenant_subscription_slip', {'id': payment.id}) }}"
                           class="mt-3 inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                            {{ payment.status == 'PENDING' ? 'Pay this invoice' : 'Receipt submitted — view' }}
                        </a>
                    {% endif %}

                    {# The paper version — for filing, signing and forwarding.
                       A settled invoice also offers its receipt, because that is
                       the document a bursar is asked for months later. #}
                    <div class="mt-2 flex flex-wrap items-center gap-x-5">
                        <a href="{{ path('tenant_subscription_invoice_pdf', {'id': payment.id}) }}"
                           target="_blank" rel="noopener"
                           class="inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-ink-600 transition hover:text-accent-700 hover:underline">
                            Invoice (PDF) <span aria-hidden="true">↗</span>
                        </a>
                        {% if payment.status == 'APPROVED' %}
                            <a href="{{ path('tenant_subscription_receipt_pdf', {'id': payment.id}) }}"
                               target="_blank" rel="noopener"
                               class="inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-paid transition hover:underline">
                                Receipt (PDF) <span aria-hidden="true">↗</span>
                            </a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
