{% extends 'base.html.twig' %}

{% block title %}School Settings{% endblock %}

{% block body %}
<div class="w-full px-4">
    
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">General Settings</h1>
        <p class="text-gray-500 text-sm">Update your school's official details and branding.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        {# === LEFT COLUMN: THE FORM === #}
        <div class="md:col-span-2 bg-white rounded-lg shadow p-6">
            {{ form_start(form) }}
            
            {# --- SECTION 1: CONTACT INFO --- #}
            <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4">Contact Details</h2>
            
            <div class="mb-4">
                {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.institutionType, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.institutionType, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                {% if form.institutionType.vars.help %}
                    <p class="mt-1 text-xs text-gray-500">{{ form.institutionType.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.institutionType) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                </div>
                <div>
                    {{ form_label(form.phoneNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.phoneNumber, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                </div>
                <div>
                    {{ form_label(form.whatsappNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.whatsappNumber, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                </div>
            </div>

            <div class="mb-4">
                {{ form_label(form.feesSummary, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.feesSummary, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'rows': 4}}) }}
                {% if form.feesSummary.vars.help %}
                    <p class="mt-1 text-xs text-gray-500">{{ form.feesSummary.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.feesSummary) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.foundedYear, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.foundedYear, {'attr': {'class': 'mt-1 block w-32 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'inputmode': 'numeric'}}) }}
                {% if form.foundedYear.vars.help %}
                    <p class="mt-1 text-xs text-gray-500">{{ form.foundedYear.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.foundedYear) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.facilities, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.facilities, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'rows': 4}}) }}
                {% if form.facilities.vars.help %}
                    <p class="mt-1 text-xs text-gray-500">{{ form.facilities.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.facilities) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.coreValues, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.coreValues, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'rows': 5}}) }}
                {% if form.coreValues.vars.help %}
                    <p class="mt-1 text-xs text-gray-500">{{ form.coreValues.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.coreValues) }}
            </div>

            <label class="mb-6 flex items-start gap-3 rounded-lg border border-gray-200 p-3">
                {{ form_widget(form.showStudentCount, {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                <span class="block text-sm font-medium text-gray-800">{{ form.showStudentCount.vars.label }}</span>
            </label>

            <div class="mb-6">
                {{ form_label(form.address, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.address, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
            </div>

            {# --- SECTION 2: IDENTITY (Motto & Website) --- #}
            <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4">Identity & Branding</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    {{ form_label(form.motto, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.motto, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'placeholder': 'e.g. Excellence in Education'}}) }}
                </div>
                <div>
                    {{ form_label(form.website, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.website, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                </div>
            </div>

            {# --- SECTION 3: VISUALS (Logo & Color) --- #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 items-end">
                <div>
                    {{ form_label(form.primaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    <div class="mt-1 flex items-center">
                        {{ form_widget(form.primaryColor, {'attr': {'class': 'h-10 w-20 p-1 border border-gray-300 rounded cursor-pointer'}}) }}
                        <span class="ml-2 text-xs text-gray-500">Brand Color</span>
                    </div>
                </div>
                <div>
                    {{ form_label(form.logoFile, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.logoFile, {'attr': {'class': 'mt-1 block w-full text-base text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100'}}) }}
                    {% if form.logoFile.vars.help %}
                        <p class="mt-1 text-xs text-gray-500">{{ form.logoFile.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(form.logoFile) }}
                </div>
            </div>
            {# ... (Your existing Visuals/Logo Section) ... #}

            {# === 2b. REPORT CARD SIGNATURES & RELEASE === #}
            <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4 mt-8">
                Report Cards — Signatures &amp; Release
            </h2>
            <p class="text-sm text-gray-500 mb-4">
                These details appear on the report card and its PDF. The form teacher and HOD
                sign with their own names; this is the principal's line.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    {{ form_label(form.principalName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.principalName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-accent-500 focus:ring-accent-500', 'placeholder': 'e.g. Mallam Adamu Bello'}}) }}
                    {% if form.principalName.vars.help %}<p class="mt-1 text-xs text-gray-500">{{ form.principalName.vars.help }}</p>{% endif %}
                </div>
                <div>
                    {{ form_label(form.principalTitle, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.principalTitle, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-accent-500 focus:ring-accent-500', 'placeholder': 'Principal'}}) }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 items-start">
                <div>
                    {{ form_label(form.principalSignatureFile, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.principalSignatureFile, {'attr': {'class': 'mt-1 block w-full text-base text-gray-600'}}) }}
                    {% if form.principalSignatureFile.vars.help %}<p class="mt-1 text-xs text-gray-500">{{ form.principalSignatureFile.vars.help }}</p>{% endif %}
                    {% if tenant.principalSignatureFilename %}
                        <p class="mt-2 text-xs text-gray-500">Current signature is on file.</p>
                    {% endif %}
                </div>
                <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                    {{ form_widget(form.reportFeeGateEnabled, {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-gray-300 text-accent-600 focus:ring-accent-500'}}) }}
                    <span>
                        <span class="block text-sm font-medium text-gray-800">{{ form.reportFeeGateEnabled.vars.label }}</span>
                        {% if form.reportFeeGateEnabled.vars.help %}<span class="block text-xs text-gray-500">{{ form.reportFeeGateEnabled.vars.help }}</span>{% endif %}
                    </span>
                </label>
            </div>

            {# === NEW: BANKING DETAILS SECTION === #}
            <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4 mt-8">
                🏦 Banking Details <span class="text-xs font-normal text-gray-500">(For Payment Slips)</span>
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                <div>
                    {{ form_label(form.bankName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.bankName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'placeholder': 'e.g. Zenith Bank'}}) }}
                    {{ form_errors(form.bankName) }}
                </div>
                <div>
                    {{ form_label(form.accountNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.accountNumber, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                    {{ form_errors(form.accountNumber) }}
                </div>
                <div class="md:col-span-2">
                    {{ form_label(form.accountName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.accountName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                    {{ form_errors(form.accountName) }}
                </div>
            </div>

                <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4 mt-8">
                    📱 Notification Settings <span class="text-xs font-normal text-gray-500">(SMS Toggles)</span>
                </h2>

                <div class="space-y-4 mb-8">
                    {# Enrollment Toggle #}
                    <div class="bg-indigo-50 p-4 rounded-md border border-indigo-100 flex items-start">
                        <div class="flex h-5 items-center">
                            {{ form_widget(form.smsOnEnrollment, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                        </div>
                        <div class="ml-3 text-sm">
                            {{ form_label(form.smsOnEnrollment, null, {'label_attr': {'class': 'font-bold text-indigo-900'}}) }}
                            <p class="text-indigo-700 opacity-80 text-xs text-xs">
                                Send SMS to parents when a new student is enrolled (₦{{ smsPrice }}/unit).
                            </p>
                        </div>
                    </div>

                    {# Fee Payment Toggle #}
                    <div class="bg-indigo-50 p-4 rounded-md border border-indigo-100 flex items-start">
                        <div class="flex h-5 items-center">
                            {{ form_widget(form.smsOnFeePayment, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                        </div>
                        <div class="ml-3 text-sm">
                            {{ form_label(form.smsOnFeePayment, null, {'label_attr': {'class': 'font-bold text-indigo-900'}}) }}
                            <p class="text-indigo-700 opacity-80 text-xs">
                                Send an automated receipt to parents upon fee payment (₦{{ smsPrice }}/unit).
                            </p>
                        </div>
                    </div>
 
                    {# Calendar Event Toggle #}
                    <div class="bg-indigo-50 p-4 rounded-md border border-indigo-100 flex items-start">
                        <div class="flex h-5 items-center">
                            {{ form_widget(form.smsOnCalendarEvent, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                        </div>
                        <div class="ml-3 text-sm">
                            {{ form_label(form.smsOnCalendarEvent, null, {'label_attr': {'class': 'font-bold text-indigo-900'}}) }}
                            <p class="text-indigo-700 opacity-80 text-xs">
                                Notify parents about school events and holidays (₦{{ smsPrice }}/unit).
                            </p>
                        </div>
                    </div>
                </div>

            
            {# --- SECTION 4b: EMAIL NOTIFICATIONS --- #}
            <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4 mt-8">
                📧 Email Notifications <span class="text-xs font-normal text-gray-500">(parents need an email address on file)</span>
            </h2>
            <p class="text-sm text-gray-500 mb-4">
                Every email is independent — leave on only what you want to send.
                Turning the master switch off stops all of them at once.
            </p>

            <div class="space-y-2 mb-5">
                {% for field in ['emailNotificationsEnabled', 'emailOnApplicationSubmitted', 'emailOnAdmissionDecision', 'emailOnInvoiceIssued', 'emailOnPaymentReceipt', 'emailOnResultPublished'] %}
                    <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                        {{ form_widget(form[field], {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                        <span>
                            <span class="block text-sm font-medium text-gray-800">{{ form[field].vars.label }}</span>
                            {% if form[field].vars.help %}
                                <span class="block text-xs text-gray-500">{{ form[field].vars.help }}</span>
                            {% endif %}
                        </span>
                    </label>
                {% endfor %}
            </div>

            {# --- SECTION 5: APPLICATION MODE --- #}
            <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4 mt-8">Application Mode — Online Applications</h2>
            <p class="text-sm text-gray-500 mb-4">
                Let parents create their own parent-portal account and apply for a child from your public website.
                Parents start at <code class="bg-gray-100 px-1 rounded">/apply</code> and their applications appear in
                <em>Admissions &rsaquo; Applications</em> for your bursar.
            </p>

            <div class="space-y-2 mb-5">
                {% for field in ['applicationsOpen', 'applicationRequireApproval', 'notifyBursarOnApplication', 'smsOnApplication'] %}
                    <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                        {{ form_widget(form[field], {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                        <span>
                            <span class="block text-sm font-medium text-gray-800">{{ form[field].vars.label }}</span>
                            {% if form[field].vars.help %}
                                <span class="block text-xs text-gray-500">{{ form[field].vars.help }}</span>
                            {% endif %}
                        </span>
                    </label>
                {% endfor %}
            </div>

            {% if platformOnlinePayments is defined and not platformOnlinePayments %}
                <div class="mb-4 rounded-lg border border-pending/40 bg-pending/5 p-3 text-sm" role="alert">
                    <p class="font-bold text-pending">Online payment is switched off by the platform</p>
                    <p class="mt-1 text-ink-700">
                        Your own choice below still stands, but no parent can pay online until the operator
                        turns online collection back on. Transfers with proof of payment keep working.
                    </p>
                </div>
            {% endif %}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                {% for field in ['admissionNumberPattern', 'paymentMethod', 'applicationFeeAmount', 'applicationsOpenAt', 'applicationsCloseAt', 'bursarNotificationPhone', 'applicationClassesNote'] %}
                    <div>
                        {{ form_label(form[field], null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(form[field], {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {% if form[field].vars.help %}
                            <p class="mt-1 text-xs text-gray-500">{{ form[field].vars.help }}</p>
                        {% endif %}
                        {{ form_errors(form[field]) }}
                    </div>
                {% endfor %}
            </div>

            <div class="mb-6">
                {{ form_label(form.applicationInstructions, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.applicationInstructions, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'rows': 5}}) }}
                {% if form.applicationInstructions.vars.help %}
                    <p class="mt-1 text-xs text-gray-500">{{ form.applicationInstructions.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.applicationInstructions) }}
            </div>

            {# The charge on top of an online payment — one switch for every fee in
               the system, because a parent should not be charged differently for a
               form fee and a term's fees. The ₦500 ceiling is fixed in code. #}
            <label class="mb-6 flex items-start gap-3 rounded-lg border border-gray-200 p-3 hover:bg-gray-50 cursor-pointer">
                {{ form_widget(form.onlineProcessingFeeEnabled, {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-gray-300 text-accent-600 focus:ring-accent-500'}}) }}
                <span>
                    <span class="block text-sm font-medium text-gray-800">{{ form.onlineProcessingFeeEnabled.vars.label }}</span>
                    {% if form.onlineProcessingFeeEnabled.vars.help %}
                        <span class="block text-xs text-gray-500">{{ form.onlineProcessingFeeEnabled.vars.help }}</span>
                    {% endif %}
                </span>
            </label>

            {# --- SAVE BUTTON — last thing on the page, after every section --- #}
            <div class="mt-8 border-t pt-5">
                <button type="submit"
                        class="min-h-[44px] w-full rounded-lg bg-accent-600 px-6 font-bold text-white shadow-sm transition-colors hover:bg-accent-700 md:w-auto md:px-8">
                    💾 Save School Settings
                </button>
                <p class="mt-2 text-xs text-ink-500">
                    Nothing on this page is stored until you press Save.
                </p>
            </div>

            {{ form_end(form) }}

            {# Documents live outside this form: they are their own screen, and a
               school should be able to edit the rules without touching a setting. #}
            <div class="mt-6 rounded-lg border border-gray-200 bg-white p-4">
                <p class="text-sm font-semibold text-gray-800">School documents</p>
                <p class="mt-1 text-xs leading-relaxed text-gray-500">
                    Rules and regulations, the fees policy, anything a parent should read. Written once,
                    published on your website and attached to every admission letter.
                </p>
                <a href="{{ path('app_tenant_document_index') }}"
                   class="mt-3 inline-flex min-h-[44px] items-center rounded-lg border border-gray-300 px-4 text-xs font-bold text-gray-700 hover:border-accent-400 hover:text-accent-700">
                    Manage documents &rarr;
                </a>
            </div>
        </div>

        {# === RIGHT COLUMN: LIVE PREVIEW === #}
        <div class="md:col-span-1">
            <div class="bg-white rounded-lg shadow p-6 sticky top-6">
                <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Live Preview</h3>

                {# LOGO PREVIEW #}
                <div class="mb-6 text-center border rounded p-4 bg-gray-50">
                    <p class="text-xs text-gray-400 mb-2">School Logo</p>
                    {% if tenant.logoFilename %}
                        <img src="{{ asset('uploads/logos/' ~ tenant.logoFilename) }}" alt="Logo" class="mx-auto max-h-24 object-contain">
                        <p class="mt-2 break-all text-[11px] text-gray-400">{{ tenant.logoFilename }}</p>
                    {% else %}
                        <div class="text-4xl text-gray-300">🏫</div>
                        <p class="text-xs text-gray-400 mt-1">No logo uploaded — reports show “{{ tenant.name|slice(0, 1)|upper }}” until you add one.</p>
                    {% endif %}
                </div>

                {# IDENTITY PREVIEW #}
                <div class="mb-6 text-center">
                    <h4 class="font-bold text-gray-800">{{ tenant.name }}</h4>
                    <p class="text-sm text-gray-500 italic">"{{ tenant.motto|default('Your Motto Here') }}"</p>
                    {% if tenant.website %}
                        <a href="{{ tenant.website }}" class="text-xs text-indigo-500 hover:underline mt-1 block">{{ tenant.website }}</a>
                    {% endif %}
                </div>

                {# COLOR PREVIEW #}
                <div class="text-center border rounded p-4 bg-gray-50">
                    <p class="text-xs text-gray-400 mb-2">Primary Color</p>
                    <div class="h-12 w-full rounded shadow-sm flex items-center justify-center text-white font-bold text-xs" 
                         style="background-color: {{ tenant.primaryColor|default('#1e40af') }};">
                        {{ tenant.primaryColor|default('#1e40af') }}
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
{% endblock %}