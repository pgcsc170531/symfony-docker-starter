{% extends 'base.html.twig' %}
{% block title %}Expense Manager{% endblock %}

{% block body %}
{# 1. WIDER CONTAINER FOR BREATHING ROOM #}
<div class="max-w-7xl mx-auto mt-8 px-6">
    
    {# HEADER #}
    <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">Expense Manager</h1>
            <p class="text-gray-500 mt-1">Record operational costs (Fuel, Repairs, Salaries).</p>
        </div>
        <div class="flex items-center gap-4">
             <div class="text-right">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Total Spent</span>
                <span class="text-2xl font-black text-rose-600">₦{{ totalSpent|number_format(2) }}</span>
            </div>
        </div>
    </div>

    {# 2. CHANGED GRID TO 5 COLUMNS (Form gets 2/5, Table gets 3/5) #}
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
        
        {# LEFT: ENTRY FORM (Now 40% Width) #}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden sticky top-6">
                <div class="bg-gray-900 p-6 text-white flex justify-between items-center">
                    <h2 class="font-bold text-xl">📝 Record Expense</h2>
                    <a href="{{ path('app_tenant_expense_category') }}" class="text-xs font-bold text-gray-300 hover:text-white hover:underline">Manage Categories &rarr;</a>
                </div>
                
                <div class="p-8">
                    {{ form_start(form) }}
                        
                        {# Increased vertical spacing for comfort #}
                        <div class="space-y-6">

                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Title / Description</label>
                                {{ form_widget(form.title, {'attr': {'class': 'w-full p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black placeholder-gray-400 text-gray-800 font-medium', 'placeholder': 'e.g. Purchase of Diesel'}}) }}
                            </div>

                            <div class="grid grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Amount (₦)</label>
                                    {{ form_widget(form.amount, {'attr': {'class': 'w-full p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black font-bold text-lg text-gray-900', 'placeholder': '0.00'}}) }}
                                </div>
                                 <div>
                                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Date</label>
                                    {{ form_widget(form.expenseDate, {'attr': {'class': 'w-full p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black text-sm text-gray-600'}}) }}
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Category</label>
                                {{ form_widget(form.category, {'attr': {'class': 'w-full p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black bg-white'}}) }}
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Additional Notes (Optional)</label>
                                {{ form_widget(form.note, {'attr': {'class': 'w-full p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black text-sm', 'rows': 3}}) }}
                            </div>

                        </div>

                        <button type="submit" class="w-full mt-8 bg-rose-600 text-white font-bold py-4 rounded-xl hover:bg-rose-700 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 active:translate-y-0">
                            Save Record
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        {# RIGHT: HISTORY LIST (Now 60% Width) #}
        <div class="lg:col-span-3">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden h-full">
                <div class="px-8 py-6 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h3 class="font-bold text-gray-800 text-lg">Recent Transactions</h3>
                    <a href="{{ path('app_tenant_report_profit_loss') }}" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:underline">View Full Report &rarr;</a>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-white border-b border-gray-100">
                            <tr>
                                <th class="px-8 py-4 text-xs font-bold text-gray-400 uppercase">Date</th>
                                <th class="px-8 py-4 text-xs font-bold text-gray-400 uppercase">Details</th>
                                <th class="px-8 py-4 text-xs font-bold text-gray-400 uppercase text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            {% for expense in expenses %}
                            <tr class="hover:bg-gray-50 group transition-colors">
                                <td class="px-8 py-5 text-sm text-gray-500 whitespace-nowrap align-top">
                                    {{ expense.expenseDate|date('M d, Y') }}
                                </td>
                                <td class="px-8 py-5 align-top">
                                    <div class="font-bold text-gray-900 text-base mb-1">{{ expense.title }}</div>
                                    <div class="flex items-center gap-2">
                                        <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-[10px] font-bold uppercase border border-gray-200 tracking-wide">
                                            {{ expense.category.name }}
                                        </span>
                                        {% if expense.note %}
                                            <span class="text-xs text-gray-400 truncate max-w-[200px] block">&bull; {{ expense.note }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-8 py-5 text-right font-mono font-bold text-rose-600 text-lg align-top">
                                    -₦{{ expense.amount|number_format(2) }}
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="3" class="p-16 text-center text-gray-400 italic">No expenses recorded yet.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}