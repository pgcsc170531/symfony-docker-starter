{% extends 'base.html.twig' %}
{% block title %}Expense Manager{% endblock %}

{% block body %}
{# 1. RESPONSIVE CONTAINER PADDING #}
<div class="max-w-7xl mx-auto mt-4 md:mt-8 px-4 sm:px-6">
    
    {# HEADER #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 md:mb-10 gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-black text-gray-900 tracking-tight">Expense Manager</h1>
            <p class="text-sm md:text-base text-gray-500 mt-1">Record operational costs (Fuel, Repairs, Salaries).</p>
        </div>
        
        {# Total Spent Card - Full width on mobile, auto on desktop #}
        <div class="w-full md:w-auto bg-rose-50 md:bg-transparent border border-rose-100 md:border-none p-4 md:p-0 rounded-xl md:rounded-none flex justify-between md:block items-center">
            <span class="text-xs font-bold text-gray-500 md:text-gray-400 uppercase tracking-wider block">Total Spent</span>
            <span class="text-2xl md:text-3xl font-black text-rose-600">₦{{ totalSpent|number_format(2) }}</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 md:gap-10">
        
        {# LEFT: ENTRY FORM #}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden lg:sticky lg:top-6">
                <div class="bg-gray-900 p-5 md:p-6 text-white flex justify-between items-center">
                    <h2 class="font-bold text-lg md:text-xl">📝 Record Expense</h2>
                    <a href="{{ path('app_tenant_expense_category') }}" class="text-xs font-bold text-gray-300 hover:text-white hover:underline transition-colors">Manage Categories &rarr;</a>
                </div>
                
                <div class="p-5 md:p-8">
                    {{ form_start(form) }}
                        
                        <div class="space-y-5 md:space-y-6">

                            <div>
                                <label class="block text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Title / Description</label>
                                {{ form_widget(form.title, {'attr': {'class': 'w-full p-3.5 md:p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black placeholder-gray-400 text-gray-800 font-medium text-sm md:text-base', 'placeholder': 'e.g. Purchase of Diesel'}}) }}
                            </div>

                            {# 🟢 CRITICAL: grid-cols-1 on mobile, sm:grid-cols-2 on desktop #}
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Amount (₦)</label>
                                    {{ form_widget(form.amount, {'attr': {'class': 'w-full p-3.5 md:p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black font-bold text-lg text-gray-900', 'placeholder': '0.00'}}) }}
                                </div>
                                 <div>
                                    <label class="block text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Date</label>
                                    {{ form_widget(form.expenseDate, {'attr': {'class': 'w-full p-3.5 md:p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black text-sm text-gray-600'}}) }}
                                </div>
                            </div>

                            <div>
                                <label class="block text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Category</label>
                                {{ form_widget(form.category, {'attr': {'class': 'w-full p-3.5 md:p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black bg-white text-sm md:text-base'}}) }}
                            </div>

                            <div>
                                <label class="block text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Additional Notes (Optional)</label>
                                {{ form_widget(form.note, {'attr': {'class': 'w-full p-3.5 md:p-4 rounded-xl border-gray-300 focus:border-black focus:ring-black text-sm', 'rows': 3}}) }}
                            </div>

                        </div>

                        <button type="submit" class="w-full mt-6 md:mt-8 bg-rose-600 text-white font-bold py-3.5 md:py-4 rounded-xl hover:bg-rose-700 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 active:translate-y-0">
                            Save Record
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        {# RIGHT: HISTORY LIST (Rebuilt for Mobile) #}
        <div class="lg:col-span-3">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden h-full flex flex-col">
                
                <div class="p-5 md:px-8 md:py-6 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h3 class="font-bold text-gray-800 text-base md:text-lg">Recent Transactions</h3>
                    <a href="{{ path('app_tenant_report_profit_loss') }}" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:underline">View Report &rarr;</a>
                </div>
                
                {# 🟢 MOBILE-FIRST FLEX CARDS (Replaces the Table) #}
                <div class="divide-y divide-gray-100">
                    
                    {# Desktop-only table headers #}
                    <div class="hidden md:flex px-8 py-3 bg-white text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100">
                        <div class="w-32">Date</div>
                        <div class="flex-1">Details</div>
                        <div class="w-32 text-right">Amount</div>
                    </div>

                    {% for expense in expenses %}
                        <div class="p-4 md:px-8 md:py-5 hover:bg-gray-50 transition-colors flex flex-col md:flex-row md:items-center gap-2 md:gap-6">
                            
                            {# Mobile Header: Title & Amount #}
                            <div class="flex justify-between items-start md:hidden w-full">
                                <div class="font-bold text-gray-900 text-sm sm:text-base pr-4">{{ expense.title }}</div>
                                <div class="font-mono font-bold text-rose-600 text-base">-₦{{ expense.amount|number_format(2) }}</div>
                            </div>

                            {# Desktop: Date Column #}
                            <div class="hidden md:block w-32 text-sm text-gray-500 font-medium">
                                {{ expense.expenseDate|date('M d, Y') }}
                            </div>

                            {# Shared Details #}
                            <div class="flex-1">
                                <div class="font-bold text-gray-900 text-base hidden md:block mb-1">{{ expense.title }}</div>
                                
                                <div class="flex flex-wrap items-center gap-2 mt-1 md:mt-0">
                                    {# Mobile-only Date #}
                                    <span class="md:hidden text-xs text-gray-500 font-medium border-r border-gray-200 pr-2 mr-1">
                                        {{ expense.expenseDate|date('M d, Y') }}
                                    </span>
                                    
                                    <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-[10px] font-bold uppercase border border-gray-200 tracking-wide">
                                        {{ expense.category.name }}
                                    </span>
                                    
                                    {% if expense.note %}
                                        <span class="text-xs text-gray-400 truncate max-w-[180px] sm:max-w-xs block">&bull; {{ expense.note }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            {# Desktop: Amount Column #}
                            <div class="hidden md:block w-32 text-right font-mono font-bold text-rose-600 text-lg">
                                -₦{{ expense.amount|number_format(2) }}
                            </div>
                            
                        </div>
                    {% else %}
                        <div class="p-12 md:p-16 text-center">
                            <div class="text-4xl mb-3 opacity-50">💸</div>
                            <p class="text-gray-400 font-medium italic">No expenses recorded yet.</p>
                        </div>
                    {% endfor %}
                    
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}