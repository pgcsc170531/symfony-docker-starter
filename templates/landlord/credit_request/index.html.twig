{% extends 'base.html.twig' %}

{% block title %}Credit Requests{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    
    <div class="md:flex md:items-center md:justify-between mb-6">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                💰 Wallet Credit Requests
            </h2>
        </div>
    </div>

    <div class="flex flex-col">
        <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">School</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Proof</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for request in requests %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    {{ request.createdAt|date('M d, Y') }}<br>
                                    <span class="text-xs text-gray-400">{{ request.createdAt|date('h:i A') }}</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-bold text-gray-900">{{ request.school.name }}</div>
                                    <div class="text-xs text-gray-500">{{ request.school.subdomain }}.edus.ng</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-bold text-gray-900">₦{{ request.amount|number_format }}</span>
                                    <div class="text-xs text-gray-500 font-mono">{{ request.reference }}</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-indigo-600 font-medium">
                                    {% if request.proofFilename %}
                                        {# 🟢 LINK TO THE NEW FOLDER #}
                                        <a href="{{ asset('uploads/wallet_proofs/' ~ request.proofFilename) }}" target="_blank" class="flex items-center hover:underline">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                            View Image
                                        </a>
                                    {% else %}
                                        <span class="text-gray-400">No upload</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if request.status == 'PENDING' %}
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">PENDING</span>
                                    {% elseif request.status == 'APPROVED' %}
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">APPROVED</span>
                                    {% else %}
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">REJECTED</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    {% if request.status == 'PENDING' %}
                                        <div class="flex justify-end gap-2">
                                            {# REJECT FORM #}
                                            <form action="{{ path('landlord_credit_request_reject', {id: request.id}) }}" method="POST" onsubmit="return confirm('Reject this request?');">
                                                <button type="submit" class="text-red-600 hover:text-red-900 font-bold text-xs bg-red-50 px-3 py-2 rounded-lg">Reject</button>
                                            </form>
                                            
                                            {# APPROVE FORM #}
                                            <form action="{{ path('landlord_credit_request_approve', {id: request.id}) }}" method="POST" onsubmit="return confirm('Confirm payment of ₦{{ request.amount }}? This will fund the wallet immediately.');">
                                                <button type="submit" class="bg-indigo-600 text-white hover:bg-indigo-700 font-bold text-xs px-4 py-2 rounded-lg shadow-sm">
                                                    ✓ Approve
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <span class="text-gray-400 text-xs italic">Processed</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="px-6 py-10 text-center text-gray-500 italic">
                                    No pending credit requests.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}