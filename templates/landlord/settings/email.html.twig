{% extends 'base.html.twig' %}

{% block title %}Email — outbound mail{% endblock %}

{% macro badge(text, tone) %}
    {% set tones = {
        paid: 'border-paid/40 bg-paid/10 text-paid',
        pending: 'border-pending/40 bg-pending/10 text-pending',
        failed: 'border-failed/40 bg-failed/10 text-failed',
        neutral: 'border-ink-300 bg-ink-100 text-ink-600'
    } %}
    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide {{ tones[tone] ?? tones.neutral }}">{{ text }}</span>
{% endmacro %}

{% import _self as ui %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <a href="{{ path('landlord_settings_index') }}"
       class="mb-4 inline-flex min-h-[44px] items-center text-sm font-semibold text-ink-500 hover:text-ink-900">
        &larr; Global settings
    </a>

    <div class="mb-5">
        <h1 class="text-xl font-black tracking-tight text-ink-900 sm:text-2xl">Email</h1>
        <p class="mt-1 text-sm text-ink-500">
            The account Edus sends from — receipts, invoices, result notices and reminders. Saved here, it applies on
            the next email; no deploy.
        </p>
    </div>

    <div class="mb-5 rounded-xl border border-ink-200 bg-white p-4">
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wide text-ink-400">SMTP from</span>
            {% if hostSource == 'database' %}
                {{ ui.badge('this database', 'paid') }}
            {% elseif hostSource == 'environment' %}
                {{ ui.badge('server environment', 'neutral') }}
            {% else %}
                {{ ui.badge('default (Mailpit)', 'neutral') }}
            {% endif %}
            <span class="text-xs font-bold uppercase tracking-wide text-ink-400 sm:ml-4">Password</span>
            {% if passwordSource == 'database' %}
                {{ ui.badge('this database', 'paid') }}
            {% elseif passwordSource == 'environment' %}
                {{ ui.badge('server environment', 'neutral') }}
            {% else %}
                {{ ui.badge('not set', 'neutral') }}
            {% endif %}
            <span class="font-mono text-xs text-ink-600 sm:ml-auto">{{ passwordHint ?: 'no password' }}</span>
        </div>
        <p class="mt-2 text-xs text-ink-500">
            Order of precedence: <strong>this database → the server environment → Mailpit</strong> (a fresh clone sends
            nowhere real). The environment wins as break-glass only when nothing is saved here.
        </p>
    </div>

    {% if not canEncrypt %}
        <div class="mb-5 rounded-xl border border-failed/40 bg-failed/5 p-4">
            <p class="text-sm font-bold text-failed">The SMTP password cannot be saved yet.</p>
            <p class="mt-1 text-sm text-ink-700">
                <code class="font-mono">APP_ENCRYPTION_KEY</code> is not set, so a password typed below would be refused
                rather than stored in the clear. Other fields still save.
            </p>
            <p class="mt-2 overflow-x-auto rounded-lg bg-ink-900 px-3 py-2 font-mono text-xs text-white">
                php bin/console app:platform:make-key
            </p>
        </div>
    {% endif %}

    <form method="post" action="{{ path('landlord_settings_email') }}" class="mb-5 rounded-xl border border-ink-200 bg-white">
        <input type="hidden" name="_token" value="{{ csrf_token('platform_email') }}">
        <input type="hidden" name="action" value="save">

        <div class="border-b border-ink-100 px-4 py-3">
            <h2 class="text-sm font-bold text-ink-900">SMTP server</h2>
        </div>

        <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label for="mail_host" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Host</label>
                <input id="mail_host" name="mail_host" type="text" value="{{ host }}" autocomplete="off" spellcheck="false"
                       placeholder="smtp-relay.brevo.com"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="mail_port" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Port</label>
                <input id="mail_port" name="mail_port" type="number" inputmode="numeric" min="1" max="65535" value="{{ port }}"
                       placeholder="587"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                <p class="mt-1 text-xs text-ink-500">587 = STARTTLS, 465 = implicit TLS.</p>
            </div>
            <div>
                <label for="mail_username" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Username</label>
                <input id="mail_username" name="mail_username" type="text" value="{{ username }}" autocomplete="off" spellcheck="false"
                       placeholder="9xxxxx001@smtp-brevo.com"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div class="sm:col-span-2">
                <label for="mail_password" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Password / SMTP key</label>
                <input id="mail_password" name="mail_password" type="password" autocomplete="new-password" spellcheck="false"
                       placeholder="{{ passwordHint ? 'Currently ' ~ passwordHint ~ ' — leave blank to keep it' : 'the SMTP key from your provider' }}"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                <p class="mt-1 text-xs text-ink-500">Blank keeps the current one — a save must never wipe a working credential.</p>
            </div>
        </div>

        <div class="border-b border-ink-100 px-4 py-3">
            <h2 class="text-sm font-bold text-ink-900">Who it comes from</h2>
        </div>

        <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2">
            <div>
                <label for="mail_from_name" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Sender name</label>
                <input id="mail_from_name" name="mail_from_name" type="text" value="{{ fromName }}" autocomplete="off"
                       placeholder="Edus"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
            </div>
            <div>
                <label for="mail_from_email" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Sender address</label>
                <input id="mail_from_email" name="mail_from_email" type="email" value="{{ fromEmail }}" autocomplete="off" spellcheck="false"
                       placeholder="no-reply@edus.ng"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                <p class="mt-1 text-xs text-ink-500">Must be a sender your mail provider has verified, or every receipt lands in spam.</p>
            </div>
            <div class="sm:col-span-2">
                <label for="mail_reply_to" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">
                    Reply-to <span class="normal-case text-ink-400">(optional)</span>
                </label>
                <input id="mail_reply_to" name="mail_reply_to" type="email" value="{{ replyTo }}" autocomplete="off" spellcheck="false"
                       placeholder="support@edus.ng"
                       class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                <p class="mt-1 text-xs text-ink-500">
                    School mail already replies to the school's own address; this is the platform default for everything else.
                </p>
            </div>
        </div>

        <div class="border-t border-ink-100 p-4">
            <button type="submit"
                    class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                Save email settings
            </button>
        </div>
    </form>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <h2 class="text-sm font-bold text-ink-900">Send a test</h2>
            <p class="mt-1 text-sm text-ink-500">Sends one real email to your own login through the saved settings.</p>
            <form method="post" action="{{ path('landlord_settings_email_test') }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('platform_email_test') }}">
                <button type="submit"
                        class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-700 hover:border-accent-400 hover:text-accent-700">
                    Send test email to me
                </button>
            </form>
        </div>

        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <h2 class="text-sm font-bold text-ink-900">Clear the password</h2>
            <p class="mt-1 text-sm text-ink-500">Falls back to the environment value. Use it when a key is compromised.</p>
            <form method="post" action="{{ path('landlord_settings_email') }}" class="mt-3"
                  onsubmit="return confirm('Clear the saved SMTP password?');">
                <input type="hidden" name="_token" value="{{ csrf_token('platform_email') }}">
                <input type="hidden" name="action" value="clear_password">
                <button type="submit"
                        class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-failed/40 px-4 text-sm font-semibold text-failed hover:bg-failed/5">
                    Clear password
                </button>
            </form>
        </div>
    </div>

    <p class="mt-4 rounded-xl border border-ink-200 bg-ink-50 px-4 py-3 text-xs text-ink-600">
        Last password change: {{ rotatedAt ? rotatedAt|date('j M Y, H:i') : 'never from this screen' }}.
        If a send fails, the payment or receipt is still recorded — it is marked <strong>not sent</strong> rather than
        pretending it went out.
    </p>
</div>
{% endblock %}
