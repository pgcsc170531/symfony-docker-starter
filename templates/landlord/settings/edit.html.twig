{% extends 'base.html.twig' %}

{% block title %}Edit Setting: {{ setting.settingKey }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-6">
        <a href="{{ path('landlord_settings_index') }}" class="text-sm text-gray-500 hover:text-gray-900 flex items-center">
            <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Settings
        </a>
    </div>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
            <div>
                <h1 class="text-lg font-bold text-gray-900">Edit Global Setting</h1>
                <p class="text-sm text-gray-500">{{ setting.settingKey }}</p>
            </div>
            <span class="bg-gray-200 text-gray-600 text-xs px-2 py-1 rounded font-mono">ID: {{ setting.id }}</span>
        </div>

        <div class="p-6">
            {{ form_start(form) }}
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        {{ form_label(form.settingKey, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(form.settingKey, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm bg-gray-50 sm:text-sm p-2 border'}}) }}
                    </div>

                    <div class="sm:col-span-3">
                        {{ form_label(form.settingValue, 'Configuration Value', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                        <div class="mt-1 relative rounded-md shadow-sm">
                            {% if setting.settingKey == 'sms_price' %}
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <span class="text-green-500 sm:text-sm">₦</span>
                                </div>
                                {{ form_widget(form.settingValue, {'attr': {'class': 'block w-full rounded-md border-gray-300 pl-8 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                            {% else %}
                                {{ form_widget(form.settingValue, {'attr': {'class': 'block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                            {% endif %}
                        </div>
                    </div>

                    <div class="sm:col-span-6">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border'}}) }}
                    </div>
                </div>

                <div class="mt-8 flex justify-end gap-3">
                    <a href="{{ path('landlord_settings_index') }}" class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-md font-bold shadow-sm hover:bg-indigo-700 transition">
                        Update Setting
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}