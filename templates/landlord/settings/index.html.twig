{% extends 'base.html.twig' %}

{% block title %}Global Settings | Edus Ng{% endblock %}

{% block body %}
<div class="mt-6 px-4">

    {# 1. HEADER SECTION - Matches your Plan Index #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">⚙️ Global Settings</h1>
            <p class="text-gray-500 text-sm mt-1">Manage system-wide variables and notification costs.</p>
        </div>
    </div>

    {# 1b. PLATFORM PAYMENTS SWITCH #}
    <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a href="{{ path('landlord_settings_payments') }}"
           class="flex min-h-[44px] items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white px-4 py-3 hover:border-accent-400">
            <span>
                <span class="block text-sm font-bold text-ink-900">Paystack keys</span>
                <span class="block text-xs text-ink-500">Secret + public key, live/test, check the key</span>
            </span>
            <span class="text-sm font-semibold text-accent-700">&rarr;</span>
        </a>
        <a href="{{ path('landlord_settings_email') }}"
           class="flex min-h-[44px] items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white px-4 py-3 hover:border-accent-400">
            <span>
                <span class="block text-sm font-bold text-ink-900">Email / SMTP</span>
                <span class="block text-xs text-ink-500">Host, password, sender — with a test send</span>
            </span>
            <span class="text-sm font-semibold text-accent-700">&rarr;</span>
        </a>
    </div>

    <div class="mb-6 rounded-xl border {{ onlinePaymentsEnabled ? 'border-paid/40 bg-paid/5' : 'border-failed/40 bg-failed/5' }} p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="font-bold text-ink-900">
                    Online payments are {{ onlinePaymentsEnabled ? 'ON' : 'OFF' }} platform-wide
                </p>
                <p class="mt-1 text-sm text-ink-600">
                    A school still chooses <em>offline / online / both</em> for itself. This switch is the layer
                    above it: turning it off hides every "Pay online" button on every school at once, and
                    turning it back on restores each school's own setting. Nothing is deleted either way.
                </p>
            </div>
            <form method="post" action="{{ path('landlord_settings_online_payments') }}" class="shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token('platform_online_payments') }}">
                <input type="hidden" name="enabled" value="{{ onlinePaymentsEnabled ? '0' : '1' }}">
                <button class="min-h-[44px] w-full rounded-lg px-4 text-sm font-bold text-white sm:w-auto
                               {{ onlinePaymentsEnabled ? 'bg-failed hover:bg-failed/90' : 'bg-paid hover:bg-paid/90' }}">
                    {{ onlinePaymentsEnabled ? 'Turn online payments off' : 'Turn online payments on' }}
                </button>
            </form>
        </div>
    </div>

    {# 2. SETTINGS TABLE - Matches your Table UI #}
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs uppercase font-bold text-gray-500 border-b border-gray-100">
                <tr>
                    <th class="px-6 py-3">Configuration Key</th>
                    <th class="px-6 py-3">Current Value</th>
                    <th class="px-6 py-3">Description</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for setting in settings %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-mono text-xs text-indigo-600 font-bold">
                            {{ setting.settingKey }}
                        </td>
                        <td class="px-6 py-4">
                            {% if setting.settingKey == 'sms_price' %}
                                <span class="bg-green-100 text-green-800 px-2 py-1 rounded font-bold text-xs">
                                    ₦{{ setting.settingValue|number_format(2) }}
                                </span>
                            {% else %}
                                <span class="text-gray-900 font-medium">{{ setting.settingValue }}</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-gray-500 text-xs italic">
                            {{ setting.description|default('System configuration variable.') }}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="{{ path('landlord_settings_edit', {'id': setting.id}) }}" 
                               class="text-indigo-600 hover:text-indigo-900 font-medium px-2">
                                Edit Value
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                            <p class="text-sm">No global settings found. Please seed your database.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}