{# ───────────────────────── CALCULATOR SCRIPT ───────────────────────── #}
<script>
(function () {
    var root = document.getElementById('pricing-calculator');
    if (!root) return;

    var data = {
        termRate: Number(root.dataset.termRate),
        annualTermRate: Number(root.dataset.annualTermRate),
        terms: Number(root.dataset.termsPerYear),
        termlyMin: Number(root.dataset.termlyMinimum),
        annualMin: Number(root.dataset.annualMinimum),
        licence: Number(root.dataset.licence),
        annualFee: Number(root.dataset.annualFee),
        implementation: Number(root.dataset.implementation),
        years: Number(root.dataset.termYears)
    };

    var input = document.getElementById('pupils');
    var outTermly = document.getElementById('out-termly');
    var outAnnual = document.getElementById('out-annual');
    var outEnterprise = document.getElementById('out-enterprise');
    var verdict = document.getElementById('pricing-verdict');

    function naira(value) {
        return '₦' + Math.round(value).toLocaleString('en-NG');
    }

    function withMinimum(raw, minimum) {
        return raw <= 0 ? 0 : Math.max(raw, minimum);
    }

    function render() {
        var pupils = Math.max(0, parseInt(input.value, 10) || 0);

        var termlyPerYear = withMinimum(pupils * data.termRate, data.termlyMin) * data.terms;
        var annual = withMinimum(pupils * data.annualTermRate * data.terms, data.annualMin);
        var enterpriseOne = data.licence + data.implementation + data.annualFee;
        var enterpriseThree = enterpriseOne + (data.years - 1) * data.annualFee;

        outTermly.textContent = naira(termlyPerYear);
        outAnnual.textContent = naira(annual);
        outEnterprise.textContent = naira(enterpriseOne) + ' → ' + naira(enterpriseThree);

        if (pupils === 0) {
            verdict.textContent = 'Enter your roll to compare.';
            return;
        }

        var termlyThree = termlyPerYear * data.years;
        var annualThree = annual * data.years;
        var standardThree = Math.min(termlyThree, annualThree);
        var standardName = annualThree <= termlyThree ? 'annual Standard' : 'termly Standard';
        var message;

        if (enterpriseThree < standardThree) {
            message = 'At ' + pupils.toLocaleString('en-NG') + ' pupils, Enterprise is cheaper over three years: '
                + naira(enterpriseThree) + ' against ' + naira(standardThree) + ' on ' + standardName + '.';
        } else {
            message = 'At ' + pupils.toLocaleString('en-NG') + ' pupils, ' + standardName
                + ' is cheaper over three years: ' + naira(standardThree) + ' against '
                + naira(enterpriseThree) + ' for Enterprise.';
        }

        if (enterpriseOne > annual) {
            message += ' Note that Enterprise bills ' + naira(enterpriseOne) + ' in year one, against '
                + naira(annual) + ' on annual Standard — the saving starts in year three.';
        }

        verdict.textContent = message;
    }

    input.addEventListener('input', render);
    render();
})();
</script>
