                </div>
            </div>
        </div>

        {# FEATURE 6: ID CARDS #}
        <div class="lg:grid lg:grid-cols-2 lg:gap-16 lg:items-center">
            <div class="lg:order-2 lg:sticky lg:top-10">
                <h3 class="text-2xl font-extrabold text-gray-900 tracking-tight sm:text-3xl">
