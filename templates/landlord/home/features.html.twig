                        </div>
                    </div>
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-4 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="h-10 w-10 rounded-full bg-pink-100 flex items-center justify-center text-pink-600 font-bold">AO</div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-sm">Amaka Ibrahim</h3>
                                <p class="text-xs text-gray-500">Primary 4</p>
                            </div>
                        </div>
                        <div class="text-right">
