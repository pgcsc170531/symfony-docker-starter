                    <div class="flex">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-indigo-500 text-white">✓</div>
                        </div>
                        <div class="ml-4">
                            <dt class="text-lg leading-6 font-medium text-gray-900">Zero-Hassle Payments</dt>
                            <dd class="mt-2 text-base text-gray-500">Parents see "Pay Now" only when they owe money. Receipts are generated instantly.</dd>
                        </div>
                    </div>
                </dl>
            </div>
            <div class="mt-10 lg:mt-0 lg:order-1 relative">
