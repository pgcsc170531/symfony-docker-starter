                    <div class="bg-blue-800 w-full h-12 flex flex-col items-center justify-center p-1">
                        <div class="text-white text-[10px] font-bold uppercase tracking-wider text-center">Springfield</div>
                    </div>
                    <div class="flex-grow flex flex-col items-center pt-3 px-2 bg-gradient-to-b from-gray-50 to-white">
                        <div class="w-16 h-20 rounded border-2 border-white shadow-sm bg-gray-200 overflow-hidden mb-2 flex items-center justify-center text-xl">👤</div>
                        <div class="text-center mb-2">
                            <h2 class="text-gray-900 font-extrabold text-xs uppercase">Muhammad</h2>
                            <h2 class="text-blue-800 font-extrabold text-sm uppercase">Ibrahim</h2>
                        </div>
                        <div class="w-full text-[8px] border-t border-b border-gray-200 py-1 grid grid-cols-2 gap-y-1">
                            <span class="text-gray-500 font-bold">ID No:</span><span class="text-right font-bold">2024/52</span>
                            <span class="text-gray-500 font-bold">Class:</span><span class="text-right font-bold">SS 2</span>
                        </div>
                    </div>
                    <div class="bg-gray-100 h-6 flex items-center justify-center border-t-2 border-blue-800">
