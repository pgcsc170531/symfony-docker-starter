                        </div>
                    </div>
                    <div class="mt-6 pt-4 border-t flex justify-end">
                        <button class="bg-green-600 text-white text-sm font-bold py-2 px-4 rounded shadow">
                            ✅ Complete & Bill
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# FEATURE 4: INVOICE SYSTEM #}
        <div class="lg:grid lg:grid-cols-2 lg:gap-16 lg:items-start">
