                            <div class="grid grid-cols-2 gap-3">
                                <label class="flex items-center space-x-3 bg-white p-2 rounded border border-blue-300 cursor-pointer shadow-sm">
                                    <div class="h-4 w-4 bg-blue-600 rounded flex items-center justify-center text-white text-[10px]">✓</div>
                                    <span class="text-gray-800 font-bold text-sm">JSS 1</span>
                                </label>
                                <label class="flex items-center space-x-3 bg-white p-2 rounded border border-gray-200 cursor-pointer shadow-sm opacity-60">
                                    <div class="h-4 w-4 border border-gray-300 rounded"></div>
                                    <span class="text-gray-500 font-medium text-sm">JSS 2</span>
                                </label>
                                <label class="flex items-center space-x-3 bg-white p-2 rounded border border-blue-300 cursor-pointer shadow-sm">
                                    <div class="h-4 w-4 bg-blue-600 rounded flex items-center justify-center text-white text-[10px]">✓</div>
                                    <span class="text-gray-800 font-bold text-sm">SS 1</span>
                                </label>
                                <label class="flex items-center space-x-3 bg-white p-2 rounded border border-gray-200 cursor-pointer shadow-sm opacity-60">
                                    <div class="h-4 w-4 border border-gray-300 rounded"></div>
                                    <span class="text-gray-500 font-medium text-sm">SS 2</span>
                                </label>
                            </div>
                        </div>
                        <div class="flex justify-between items-center pt-2">
                            <span class="text-gray-400 text-sm">Back</span>
                            <button class="bg-blue-600 text-white px-6 py-2 rounded shadow font-bold text-sm">Next Step &rarr;</button>
                        </div>
