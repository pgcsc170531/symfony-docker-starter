{% extends 'base.html.twig' %}

{# Reusable screenshot frame (full-page captures are clipped to the top) #}
{% macro browser(src, alt, height) %}
    <div class="rounded-2xl bg-white shadow-xl ring-1 ring-gray-200 overflow-hidden">
        <div class="flex items-center gap-1.5 px-4 py-2.5 bg-gray-50 border-b border-gray-200">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
            <span class="ml-3 text-[11px] font-mono text-gray-400 truncate">app.edus.ng</span>
        </div>
        <div class="overflow-hidden {{ height }} bg-white">
            <img src="{{ asset('images/manual/' ~ src) }}" alt="{{ alt }}" loading="lazy" class="w-full h-full object-cover object-top">
        </div>
    </div>
{% endmacro %}

{% block title %}System Features - Edus{% endblock %}
{% block title_suffix %}{% endblock %}
{% block meta_description %}Every module in Edus: online applications, admissions and enrolment, attendance and behaviour, fee schedules and invoices, results, report cards and verified documents, staff, store, messaging and the parent portal.{% endblock %}

