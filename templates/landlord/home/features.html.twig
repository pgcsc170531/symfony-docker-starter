                                <tr class="bg-gray-50"><td class="py-2 px-3">Maths Textbook (x1)</td><td class="py-2 px-3 text-right font-bold">₦2,500</td></tr>
                                <tr class="bg-gray-50"><td class="py-2 px-3">School Tie (x2)</td><td class="py-2 px-3 text-right font-bold">₦3,000</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="flex justify-between items-center bg-gray-100 p-3 rounded-lg">
