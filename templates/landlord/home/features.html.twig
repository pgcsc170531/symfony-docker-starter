                        </div>
                    </div>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-[10px] font-bold text-gray-500 uppercase">First Name</label>
                                <div class="w-full border rounded p-2 text-sm bg-gray-50 text-gray-400">Kabir</div>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-gray-500 uppercase">Last Name</label>
                                <div class="w-full border rounded p-2 text-sm bg-gray-50 text-gray-400">Ibrahim</div>
                            </div>
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-gray-500 uppercase">Assign Class</label>
