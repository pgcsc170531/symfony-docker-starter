                            <div class="w-full bg-gray-100 rounded-full h-2">
                                <div class="bg-blue-600 h-2 rounded-full" style="width: 50%"></div>
                            </div>
                        </div>
                        <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 mb-4">
