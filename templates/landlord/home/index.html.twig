            <h2 class="text-base text-blue-600 font-semibold tracking-wide uppercase">All-in-One Platform</h2>
            <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                Everything you need to run a modern school.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            {# CARD 1: PARENT PORTAL (Wide) #}
            <div class="md:col-span-2 bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition relative overflow-hidden group">
                <div class="relative z-10">
                    <h3 class="text-2xl font-bold text-gray-900">Parent Portal</h3>
                    <p class="text-gray-500 mt-2 max-w-md">Parents can view all their children, check debts, and pay fees from their phone. No more calling the bursar.</p>
                </div>
                <div class="mt-8 bg-gray-50 rounded-xl p-4 border border-gray-200 w-full md:w-3/4 shadow-inner">
                    <div class="bg-white p-3 rounded-lg shadow-sm flex justify-between items-center mb-2">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-xs">EO</div>
                            <div><p class="text-xs font-bold">Emeka I.</p><p class="text-[10px] text-gray-500">JSS 2</p></div>
                        </div>
                        <p class="text-red-600 font-bold text-xs">Owning: ₦45,000</p>
                    </div>
                    <div class="bg-white p-3 rounded-lg shadow-sm flex justify-between items-center opacity-75">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-xs">AO</div>
                            <div><p class="text-xs font-bold">Amaka I.</p><p class="text-[10px] text-gray-500">Primary 4</p></div>
                        </div>
                        <p class="text-green-600 font-bold text-xs">✓ Cleared</p>
                    </div>
                </div>
            </div>

            {# CARD 2: POS (Tall) #}
            <div class="bg-gray-900 rounded-2xl p-8 shadow-lg text-white flex flex-col justify-between relative overflow-hidden group">
                <div class="relative z-10">
                    <div class="h-10 w-10 bg-gray-800 rounded flex items-center justify-center mb-4 text-xl">🛒</div>
                    <h3 class="text-xl font-bold">School Store</h3>
                    <p class="text-gray-400 mt-2 text-sm">Sell uniforms & books. Auto-deduct stock and add the bill to the student's profile.</p>
                </div>
                <div class="absolute -bottom-10 -right-10 w-48 bg-gray-800 rounded-xl p-4 transform rotate-12 opacity-50 group-hover:opacity-80 transition">
                    <div class="h-2 w-20 bg-gray-600 rounded mb-2"></div>
                    <div class="h-2 w-12 bg-gray-600 rounded"></div>
                </div>
            </div>

            {# CARD 3: ID CARDS #}
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition">
                <div class="h-10 w-10 bg-blue-50 rounded flex items-center justify-center mb-4 text-xl">🆔</div>
                <h3 class="text-xl font-bold text-gray-900">Instant ID Cards</h3>
                <p class="text-gray-500 mt-2 text-sm">Generate standard CR80 ID cards with QR codes for your entire school in one click.</p>
            </div>

            {# CARD 4: RESULTS #}
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition">
                <div class="h-10 w-10 bg-green-50 rounded flex items-center justify-center mb-4 text-xl">📊</div>
                <h3 class="text-xl font-bold text-gray-900">Results & Broadsheets</h3>
                <p class="text-gray-500 mt-2 text-sm">Auto-calculate averages, positions, and generate PDF report cards in bulk.</p>
            </div>

            {# CARD 5: FINANCE (Wide) #}
            <div class="md:col-span-1 bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition">
                <div class="h-10 w-10 bg-orange-50 rounded flex items-center justify-center mb-4 text-xl">💰</div>
                <h3 class="text-xl font-bold text-gray-900">Smart Finance</h3>
                <p class="text-gray-500 mt-2 text-sm">Snapshot invoicing ensures historical accuracy. Track partial payments and daily income reports.</p>
            </div>
        </div>

        <div class="mt-12 text-center">
            <a href="{{ path('app_features') }}" class="inline-flex items-center text-blue-600 font-bold hover:text-blue-800">
                Explore all system capabilities <span class="ml-2">&rarr;</span>
            </a>
        </div>
    </div>
</div>

{# --- 4. PARTNER STRIP (The "Second Door") --- #}
<div class="bg-gray-900 py-16 border-t border-gray-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <svg class="h-full w-full" fill="none" viewBox="0 0 800 800">
            <path stroke="currentColor" stroke-width="2" d="M0 0 L800 800 M800 0 L0 800" class="text-white"/>
        </svg>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="lg:flex lg:items-center lg:justify-between">
            <div class="lg:w-1/2">
                <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                    <span class="block">Are you a Developer?</span>
                    <span class="block text-indigo-400">Build your own EdTech Agency.</span>
                </h2>
                <p class="mt-3 text-lg text-gray-400">
                    Use our <strong>Agent Engine</strong> to deploy schools in seconds. Manage 50+ clients from one dashboard and earn recurring commissions.
                </p>
                <div class="mt-8 flex gap-4">
                    <a href="{{ path('app_partners') }}" class="px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg">
                        View Agent Dashboard
                    </a>
                </div>
            </div>
            <div class="mt-8 lg:mt-0 lg:w-1/2 flex justify-center lg:justify-end">
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 w-full max-w-sm shadow-2xl transform rotate-2">
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-xs font-bold text-gray-500 uppercase">Your Wallet</span>
                        <span class="text-green-400 text-xs flex items-center gap-1"><span class="w-2 h-2 bg-green-500 rounded-full"></span> Live</span>
                    </div>
                    <div class="text-3xl font-mono text-white mb-6">₦450,000.00</div>
                    <div class="space-y-3">
                        <div class="flex justify-between text-sm border-b border-gray-700 pb-2">
                            <span class="text-gray-400">Divine Wisdom Int'l</span>
                            <span class="text-green-400">+₦25,000</span>
                        </div>
                        <div class="flex justify-between text-sm border-b border-gray-700 pb-2">
                            <span class="text-gray-400">Springfield College</span>
                            <span class="text-green-400">+₦15,000</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# --- 5. FINAL CTA --- #}
<div class="bg-white py-24">
    <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-4xl font-extrabold text-gray-900 mb-6">Ready to transform your school?</h2>
        <p class="text-xl text-gray-500 mb-10">
            Join the platform that is changing how Nigerian schools operate. No setup fees. No credit card required.
        </p>
        <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center px-10 py-4 border border-transparent text-lg font-bold rounded-full text-white bg-blue-600 hover:bg-blue-700 shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-1">
            Get Started for Free
        </a>
    </div>
</div>

{# --- 6. FOOTER --- #}
<footer class="bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto py-12 px-4 overflow-hidden sm:px-6 lg:px-8">
        <div class="flex justify-center space-x-8 mb-8 text-gray-400">
            <a href="{{ path('app_home') }}" class="hover:text-gray-900 transition">Home</a>
            <a href="{{ path('app_features') }}" class="hover:text-gray-900 transition">Features</a>
            <a href="{{ path('app_partners') }}" class="hover:text-gray-900 transition">Partners</a>
            <a href="{{ path('app_login') }}" class="hover:text-gray-900 transition">Login</a>
        </div>
        <p class="mt-8 text-center text-base text-gray-400">
            &copy; {{ "now"|date("Y") }} Edus. Built for Nigerian Schools.
        </p>
    </div>

    <div class="alert alert-info">
        🚀 System Update: Live Version 1.0.1 - {{ "now"|date("d/m/Y H:i") }}
    </div>
</footer>
{% endblock %}