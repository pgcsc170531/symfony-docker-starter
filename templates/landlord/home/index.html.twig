{% extends 'base.html.twig' %}

{% block title %}Edus - The School Operating System{% endblock %}

{% block body %}
{# --- 0. NAVIGATION BAR --- #}
<div class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
            <div class="flex justify-start lg:w-0 lg:flex-1">
                <a href="{{ path('app_home') }}" class="text-3xl font-black tracking-tighter text-blue-600 no-underline hover:text-blue-700">
                    Edus<span class="text-gray-900">.</span>
                </a>
            </div>
            <div class="hidden md:flex space-x-8">
                <a href="{{ path('app_features') }}" class="text-sm font-medium text-gray-700 hover:text-blue-600">Features</a>
                <a href="{{ path('app_partners') }}" class="text-sm font-medium text-gray-700 hover:text-blue-600">Partners</a>
                <a href="{{ path('app_login') }}" class="text-sm font-medium text-blue-600 hover:text-blue-500">Log in</a>
            </div>
            <div class="hidden md:flex items-center justify-end md:flex-1 lg:w-0">
