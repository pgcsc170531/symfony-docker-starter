{# --- 2. MODULE MARQUEE STRIP --- #}
<div class="bg-blue-600 py-4 overflow-hidden">
    <div class="marquee gap-10 text-white/95 text-sm font-semibold uppercase tracking-wider">
        {% set modules = ['Smart Dashboard','6-Step Onboarding','Student Registry','Admissions','Bulk Enrolment','Mass Promotion','Sessions & Terms','Smart Class Creator','Year Groups','Departments','Subjects','Grading Scale','Staff & Roles','Result Entry','4-Stage Approvals','Broadsheets','Payments & Receipts','Invoicing','Fee Schedule','Scholarships','Expenses','Profit & Loss','SMS Wallet','Store POS','Inventory','School Calendar','Public Website','Parent Portal','Bank Transfer Slips','ID Cards'] %}
        {% for i in 1..2 %}
            <div class="flex gap-10 shrink-0">
                {% for m in modules %}
                    <span class="whitespace-nowrap flex items-center gap-3">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-200"></span>{{ m }}
                    </span>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>

{# --- 3. JOURNEY / HERITAGE SECTION --- #}
<div class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl reveal">
            <p class="text-base font-semibold text-blue-600 uppercase tracking-wide">Built over years, not weekends</p>
            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-gray-900">This system didn't start yesterday.</h2>
            <p class="mt-4 text-xl text-gray-500">
                Edus was born in a real school bursary — chasing paper ledgers, lost receipts and bank alerts nobody
                could match to a student. Every module you see today was shaped by real Nigerian school operations,
                then re-engineered. That's why schools don't have to change how they work to use Edus.
            </p>
        </div>

        <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {% set phases = [
                { 'tag': 'Where it started', 'icon': '📒', 'title': 'Fee Tracking', 'text': 'A single, honest problem: stop losing fee payments to paper ledgers and unverified bank alerts.' },
                { 'tag': 'Then it grew', 'icon': '🏫', 'title': 'Full School Operations', 'text': 'Per-school databases, admissions, classes, invoicing and receipts — one school, one private portal.' },
                { 'tag': 'Then it scaled', 'icon': '🚀', 'title': 'Store, Parents & Results', 'text': 'POS, the parent portal and the results/approval workflow turned Edus into a complete school system.' },
                { 'tag': 'Today', 'icon': '✨', 'title': 'Edus 2.0 Upgrade', 'text': 'Onboarding wizard, bulk enrolment, mass promotion, P&L reporting and the SMS wallet — faster than ever.' }
            ] %}
            {% for p in phases %}
                <li class="reveal relative rounded-2xl bg-gray-50 p-6 ring-1 ring-gray-200/70 hover:ring-blue-300 hover:bg-white hover:shadow-lg transition">
                    <span class="text-3xl">{{ p.icon }}</span>
                    <span class="mt-4 block text-[11px] font-bold uppercase tracking-widest text-blue-600">{{ p.tag }}</span>
                    <h3 class="mt-1 text-lg font-bold text-gray-900">{{ p.title }}</h3>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">{{ p.text }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</div>

{# --- 4. WHAT'S NEW IN EDUS 2.0 --- #}
<div id="upgrade" class="bg-slate-50 border-y border-gray-200 py-20 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl reveal">
            <span class="inline-flex items-center gap-2 rounded-full bg-blue-600/10 text-blue-700 px-3 py-1 text-xs font-bold uppercase tracking-wide">🆕 Just shipped</span>
            <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold text-gray-900">The Edus 2.0 upgrade</h2>
            <p class="mt-4 text-xl text-gray-500">
                If your school is already with us, this is your upgrade. If you're still on pen and paper, this is
                the reason to finally switch.
            </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% set updates = [
                { 'icon': '🚀', 'title': '6-Step Onboarding Wizard', 'text': 'Launch a whole school in minutes — identity & logo, auto-generated class structure (primary / secondary / tertiary presets), academic calendar, fee items and fee pricing.' },
                { 'icon': '⚡', 'title': 'Bulk Enrolment (CSV)', 'text': 'Onboard hundreds of students at once via a manual grid or a 12-column CSV. Classes are matched automatically, parent logins are created, invoices auto-generated.' },
                { 'icon': '📈', 'title': 'Mass Promotion', 'text': 'End-of-session promotion in a few clicks: promote students, mark repeaters and auto-bill everyone for the new session.' },
                { 'icon': '✅', 'title': 'Multi-Stage Result Approvals', 'text': 'Teacher → Form Teacher → HOD → Year Group Master. Rejections unlock results for rework automatically; authorised users can unlock at any time.' },
                { 'icon': '💳', 'title': 'SMS Wallet & Top-ups', 'text': 'Prepaid messaging credits, transaction history and proof-of-payment submission for approval — SMS is automatic when you confirm a payment.' },
                { 'icon': '📊', 'title': 'Profit & Loss Reporting', 'text': "Date-range reports that split academic fees from store income and subtract expenses, so you see your school's true net position." },
                { 'icon': '🏅', 'title': 'Custom Grading Scales', 'text': 'A1–F9, WAEC, NECO or your own custom scale with score ranges, points and remarks — applied consistently across entry, reports and analytics.' },
                { 'icon': '🔎', 'title': 'Smart Dashboards & Filters', 'text': 'Outstanding debt, low-stock alerts, unpaid invoices, debtor/cleared filters and split academic-vs-store debt badges.' },
                { 'icon': '🌐', 'title': 'Public School Website', 'text': 'Every school gets a public website on its own subdomain, rendered automatically from your branding and content.' }
            ] %}
            {% for u in updates %}
                <div class="reveal bg-white rounded-2xl p-7 ring-1 ring-gray-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl">{{ u.icon }}</div>
                    <h3 class="mt-5 text-lg font-bold text-gray-900">{{ u.title }}</h3>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">{{ u.text }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{# --- 5. THE COMPLETE FEATURE CATALOGUE --- #}
<div id="tour" class="bg-white py-20 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl reveal">
