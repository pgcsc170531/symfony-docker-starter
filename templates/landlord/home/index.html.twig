<script>
    function openDemoModal() {
        const modal = document.getElementById('demoModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeDemoModal() {
        const modal = document.getElementById('demoModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function copyDemoDetails(btn) {
        const textToCopy = "Email: demo@edus.ng\nPassword: demo123";
        navigator.clipboard.writeText(textToCopy).then(() => {
            btn.innerText = "Copied! ✓";
            btn.classList.add('text-green-600', 'border-green-300', 'bg-green-50');
            btn.classList.remove('text-gray-600', 'border-gray-200');
            setTimeout(() => {
                btn.innerText = "Copy Details";
                btn.classList.remove('text-green-600', 'border-green-300', 'bg-green-50');
                btn.classList.add('text-gray-600', 'border-gray-200');
            }, 2000);
        });
    }

    document.getElementById('demoModal').addEventListener('click', function(e) {
        if (e.target === this) closeDemoModal();
    });

    // Gentle reveal-on-scroll for the landing sections
    (function () {
        const items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
            items.forEach(el => el.classList.add('is-visible'));
            return;
        }
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { rootMargin: '0px 0px -60px 0px', threshold: 0.05 });
        items.forEach(el => observer.observe(el));
    })();
</script>
{% endblock %}