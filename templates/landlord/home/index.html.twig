        <div x-show="open" x-cloak class="md:hidden pb-4 space-y-1 border-t border-white/10 pt-3">
            <a href="{{ path('app_features') }}" class="block px-2 py-2.5 text-gray-200 hover:text-white text-sm">Features</a>
            <a href="#upgrade" @click="open = false" class="block px-2 py-2.5 text-gray-200 hover:text-white text-sm">What's New in Edus 2.0</a>
            <a href="#tour" @click="open = false" class="block px-2 py-2.5 text-gray-200 hover:text-white text-sm">Screenshots</a>
            <a href="{{ path('app_partners') }}" class="block px-2 py-2.5 text-gray-200 hover:text-white text-sm">Partners</a>
            <a href="{{ path('app_manual') }}" class="block px-2 py-2.5 text-gray-200 hover:text-white text-sm">User Manual</a>
            <a href="{{ path('app_login') }}" class="block px-2 py-2.5 text-gray-200 hover:text-white text-sm">Sign In</a>
            <a href="https://wa.me/2348032714999?text=Hello!%20I%20am%20a%20school%20proprietor%20interested%20in%20setting%20up%20a%20Free%20Trial%20for%20EDUS."
