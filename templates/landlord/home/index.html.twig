{# 🟢 DEMO MODAL SCRIPT #}
<div id="demoModal" class="hidden fixed inset-0 z-[100] bg-gray-900/50 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full overflow-hidden transform transition-all">
        <div class="p-6">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-xl font-bold text-gray-900">Access Live Demo</h3>
                <button onclick="closeDemoModal()" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 mb-6">
                <p class="text-sm text-blue-800 mb-2 font-medium">Use these credentials to log in:</p>
                <div class="space-y-2 font-mono text-sm">
                    <div class="flex justify-between bg-white p-2 rounded border border-blue-100">
                        <span class="text-gray-500">Email:</span>
                        <span class="font-bold text-gray-900">demo@edus.ng</span>
                    </div>
                    <div class="flex justify-between bg-white p-2 rounded border border-blue-100">
                        <span class="text-gray-500">Password:</span>
                        <span class="font-bold text-gray-900">demo123</span>
                    </div>
                </div>
            </div>
            <div class="flex space-x-3">
                <button onclick="copyDemoDetails(this)" class="flex-1 py-2 px-4 border border-gray-200 text-gray-600 font-medium rounded-lg hover:bg-gray-50 transition">
                    Copy Details
                </button>
                <a href="https://demo.edus.ng/login" target="_blank" class="flex-1 py-2 px-4 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 text-center transition">
                    Go to Login →
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function openDemoModal() {
        const modal = document.getElementById('demoModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeDemoModal() {
        const modal = document.getElementById('demoModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function copyDemoDetails(btn) {
        const textToCopy = "Email: demo@edus.ng\nPassword: demo123";
        navigator.clipboard.writeText(textToCopy).then(() => {
            btn.innerText = "Copied! ✓";
            btn.classList.add('text-green-600', 'border-green-300', 'bg-green-50');
            btn.classList.remove('text-gray-600', 'border-gray-200');
            setTimeout(() => {
                btn.innerText = "Copy Details";
                btn.classList.remove('text-green-600', 'border-green-300', 'bg-green-50');
                btn.classList.add('text-gray-600', 'border-gray-200');
            }, 2000);
        });
    }

    document.getElementById('demoModal').addEventListener('click', function(e) {
        if (e.target === this) closeDemoModal();
    });
</script>
