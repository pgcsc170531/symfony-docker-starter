                            I'm a Developer
                        </a>
                    </div>
                    <p class="mt-3 text-sm text-gray-400">Trusted by 100+ Schools • Instant Setup</p>
                </div>
            </div>

            {# Right: Visual Stack (Using your Real UI HTML) #}
            <div class="mt-12 relative sm:max-w-lg sm:mx-auto lg:mt-0 lg:max-w-none lg:mx-0 lg:col-span-6 lg:flex lg:items-center">
                <div class="relative mx-auto w-full rounded-lg shadow-lg lg:max-w-md transform lg:scale-110 origin-top-left">
                    
                    <div class="relative block w-full bg-white rounded-lg overflow-hidden border border-gray-200 shadow-2xl z-10">
                        <div class="bg-gray-800 p-4 flex justify-between items-center text-white">
                            <div class="flex items-center space-x-2">
                                <div class="h-8 w-8 bg-gray-700 rounded flex items-center justify-center text-xs">🏫</div>
                                <div>
                                    <div class="text-xs font-bold uppercase">Springfield</div>
                                    <div class="text-[0.6rem] text-gray-400">Lagos, NG</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-sm font-mono font-bold">#INV-001</div>
                                <span class="bg-yellow-500 text-black text-[0.6rem] px-1 rounded font-bold">PARTIAL</span>
                            </div>
                        </div>
                        <div class="p-4 space-y-2">
                            <div class="flex justify-between text-xs text-gray-600 border-b pb-2">
                                <span>Tuition Fee</span><span>₦150,000</span>
                            </div>
                            <div class="flex justify-between text-xs text-gray-600 border-b pb-2">
                                <span>Uniform</span><span>₦25,000</span>
                            </div>
                            <div class="mt-1 text-right text-red-600 font-bold text-xs">Balance: ₦85,000</div>
                        </div>
                    </div>

                    <div class="absolute -bottom-12 -right-6 w-40 bg-white border border-gray-200 rounded shadow-2xl overflow-hidden transform -rotate-6 z-20 hover:rotate-0 transition duration-500">
                        <div class="bg-blue-800 h-6 flex items-center justify-center">
                            <span class="text-white text-[0.4rem] font-bold uppercase">Springfield Academy</span>
                        </div>
                        <div class="p-2 text-center">
                             <div class="h-10 w-10 bg-gray-200 rounded mx-auto mb-1 border border-gray-300"></div>
                             <div class="text-[0.5rem] font-bold">Emmanuel O.</div>
                             <div class="text-[0.4rem] text-gray-500">SS 2 Science</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

{# --- 2. SOCIAL PROOF --- #}
<div class="bg-blue-900 py-10 border-t border-blue-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4 text-center">
            <div>
                <p class="text-3xl font-extrabold text-white">100+</p>
                <p class="text-xs font-medium text-blue-200 uppercase mt-1">Schools Active</p>
            </div>
            <div>
                <p class="text-3xl font-extrabold text-white">50k+</p>
                <p class="text-xs font-medium text-blue-200 uppercase mt-1">Invoices Generated</p>
            </div>
            <div>
                <p class="text-3xl font-extrabold text-white">₦500M+</p>
                <p class="text-xs font-medium text-blue-200 uppercase mt-1">Fees Processed</p>
            </div>
            <div>
                <p class="text-3xl font-extrabold text-white">99.9%</p>
                <p class="text-xs font-medium text-blue-200 uppercase mt-1">Uptime</p>
            </div>
        </div>
    </div>
</div>

{# --- 3. BENTO GRID FEATURES (The "Why Edus" Section) --- #}
<div class="py-20 bg-gray-50">
