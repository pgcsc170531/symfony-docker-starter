{% extends 'base.html.twig' %}

{% block title %}Generate Invoice{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto mt-16 px-6">
    
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-indigo-100 text-indigo-600 rounded-full mb-4">
                🧾
            </div>
            <h1 class="text-2xl font-black text-gray-900">Generate Invoice</h1>
            <p class="text-gray-500">Creating a payment slip for <strong class="text-gray-900">{{ school.name }}</strong></p>
        </div>

        <form method="POST">
            <label class="block text-sm font-bold text-gray-700 mb-2">Select Plan to Renew/Upgrade</label>
            <div class="space-y-3">
                {% for plan in plans %}
                    <label class="flex items-center justify-between p-4 border rounded-xl cursor-pointer hover:border-indigo-500 hover:bg-indigo-50 transition-colors">
                        <div class="flex items-center">
                            <input type="radio" name="plan_id" value="{{ plan.id }}" class="h-5 w-5 text-indigo-600 border-gray-300 focus:ring-indigo-500" {% if loop.first %}checked{% endif %}>
                            <div class="ml-3">
                                <span class="block text-sm font-bold text-gray-900">{{ plan.name }}</span>
                                <span class="block text-xs text-gray-500">{{ plan.durationMonths }} Months</span>
                            </div>
                        </div>
                        <span class="font-bold text-gray-900">₦{{ plan.price|number_format }}</span>
                    </label>
                {% endfor %}
            </div>

            <div class="mt-8 flex gap-3">
                <a href="{{ path('landlord_subscription_active') }}" class="flex-1 py-3 text-center text-gray-500 font-bold hover:text-gray-900">Cancel</a>
                <button type="submit" class="flex-1 bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 shadow-lg">
                    Generate & Send Reference
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}