{% extends 'base.html.twig' %}

{% block title %}Invoices{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:py-6">

    <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-xl font-bold text-ink-900 sm:text-2xl">Invoices</h1>
            <p class="mt-1 text-sm text-ink-700">Every Edus invoice, every school, newest first.</p>
        </div>
        <a href="{{ path('landlord_subscription_registrations') }}"
           class="mt-3 inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-900 hover:bg-ink-50 sm:mt-0 sm:w-auto">
            Term registrations
        </a>
    </div>

    {# ── Totals ─────────────────────────────────────────────────────────── #}
    <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">Collected</dt>
            <dd class="mt-1 text-xl font-extrabold text-paid">₦{{ collected|number_format(0) }}</dd>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">Outstanding</dt>
            <dd class="mt-1 text-xl font-extrabold text-pending">₦{{ outstanding|number_format(0) }}</dd>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">Invoices</dt>
            <dd class="mt-1 text-xl font-extrabold text-ink-900">
                {{ (by_status.PENDING.count ?? 0) + (by_status.VERIFYING.count ?? 0) + (by_status.APPROVED.count ?? 0) + (by_status.DECLINED.count ?? 0) + (by_status.CANCELLED.count ?? 0) }}
            </dd>
        </div>
    </dl>

    {# ── Search / filter ────────────────────────────────────────────────── #}
    <form method="get" action="{{ path('landlord_subscription_invoices') }}"
          class="mt-4 rounded-xl border border-ink-200 bg-white p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <label class="flex-1">
                <span class="block text-xs font-semibold text-ink-700">School or reference</span>
                <input type="search" name="q" value="{{ q }}" placeholder="e.g. Gobarau or SUB-EC226D"
                       class="mt-1 min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-200">
            </label>
            <label class="sm:w-48">
                <span class="block text-xs font-semibold text-ink-700">Status</span>
                <select name="status"
                        class="mt-1 min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-200">
                    <option value="">All statuses</option>
                    {% for option in ['PENDING', 'VERIFYING', 'APPROVED', 'DECLINED', 'CANCELLED'] %}
                        <option value="{{ option }}" {{ status == option ? 'selected' }}>{{ option|capitalize }}</option>
                    {% endfor %}
                </select>
            </label>
            <button class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                Search
            </button>
        </div>
    </form>

    {% if payments|length == 0 %}
        <div class="mt-4 rounded-xl border border-ink-200 bg-white p-8 text-center">
            <p class="text-base font-semibold text-ink-900">No invoices match</p>
            <p class="mt-1 text-sm text-ink-700">Clear the search or pick a different status.</p>
        </div>
    {% else %}

        {# Phones #}
        <div class="mt-4 space-y-3 md:hidden">
            {% for payment in payments %}
                <article class="rounded-xl border border-ink-200 bg-white p-4 shadow-card">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h2 class="text-sm font-bold text-ink-900">{{ payment.school.name }}</h2>
                            <p class="text-xs text-ink-600">{{ payment.reference }} · {{ payment.createdAt ? payment.createdAt|date('j M Y') : '' }}</p>
                            {% if payment.termRegistration %}
                                <p class="text-xs text-ink-600">{{ payment.termRegistration.period }}</p>
                            {% endif %}
                        </div>
                        <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold
                                     {{ payment.status == 'APPROVED' ? 'bg-paid/10 text-paid'
                                        : (payment.status == 'CANCELLED' ? 'bg-ink-100 text-ink-600'
                                        : (payment.status == 'DECLINED' ? 'bg-failed/10 text-failed' : 'bg-pending/10 text-pending')) }}">
                            {{ payment.status|capitalize }}
                        </span>
                    </div>

                    <p class="mt-2 text-lg font-extrabold text-ink-900">₦{{ payment.amount|number_format(0) }}</p>
                    {% if payment.supplementary %}
                        <p class="text-xs font-semibold text-accent-700">Supplementary — overage pupils</p>
                    {% endif %}

                    {% if payment.status in ['PENDING', 'VERIFYING'] %}
                        <form method="post" action="{{ path('landlord_subscription_remind', {'id': payment.id}) }}" class="mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('remind' ~ payment.id) }}">
                            <button class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 px-4 text-sm font-semibold text-ink-900 hover:bg-ink-50">
                                Send reminder
                            </button>
                        </form>
                    {% endif %}
                </article>
            {% endfor %}
        </div>

        {# Desktop #}
        <div class="mt-4 hidden overflow-x-auto rounded-xl border border-ink-200 md:block">
            <table class="w-full min-w-[860px] text-left text-sm">
                <thead class="bg-ink-50 text-xs font-bold uppercase tracking-wide text-ink-600">
                    <tr>
                        <th scope="col" class="px-4 py-3">School</th>
                        <th scope="col" class="px-4 py-3">Reference</th>
                        <th scope="col" class="px-4 py-3">Period</th>
                        <th scope="col" class="px-4 py-3">Amount</th>
                        <th scope="col" class="px-4 py-3">Status</th>
                        <th scope="col" class="px-4 py-3">Created</th>
                        <th scope="col" class="px-4 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    {% for payment in payments %}
                        <tr>
                            <td class="px-4 py-3">
                                <p class="font-semibold text-ink-900">{{ payment.school.name }}</p>
                                {% if payment.plan %}<p class="text-xs text-ink-600">{{ payment.plan.name }}</p>{% endif %}
                            </td>
                            <td class="px-4 py-3 font-mono text-xs text-ink-700">
                                {{ payment.reference }}
                                {% if payment.supplementary %}
                                    <span class="ml-1 rounded bg-accent-100 px-1.5 py-0.5 text-[10px] font-bold uppercase text-accent-700">Overage</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-ink-700">{{ payment.termRegistration ? payment.termRegistration.period : '—' }}</td>
                            <td class="px-4 py-3 font-bold text-ink-900">₦{{ payment.amount|number_format(0) }}</td>
                            <td class="px-4 py-3">
                                <span class="rounded-full px-2.5 py-0.5 text-xs font-bold
                                             {{ payment.status == 'APPROVED' ? 'bg-paid/10 text-paid'
                                                : (payment.status == 'CANCELLED' ? 'bg-ink-100 text-ink-600'
                                                : (payment.status == 'DECLINED' ? 'bg-failed/10 text-failed' : 'bg-pending/10 text-pending')) }}">
                                    {{ payment.status|capitalize }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-ink-700">{{ payment.createdAt ? payment.createdAt|date('j M Y') : '—' }}</td>
                            <td class="px-4 py-3 text-right">
                                {% if payment.status in ['PENDING', 'VERIFYING'] %}
                                    <form method="post" action="{{ path('landlord_subscription_remind', {'id': payment.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remind' ~ payment.id) }}">
                                        <button class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-3 text-xs font-semibold text-ink-900 hover:bg-ink-50">
                                            Send reminder
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-xs text-ink-500">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
