{% extends 'base.html.twig' %} 
{# NOTE: Ensure this extends your Admin layout, e.g., 'base_landlord.html.twig' if you have one #}

{% block title %}Verify Payments{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-10 px-6">
    
    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">💰 Payment Approvals</h1>
            <p class="text-gray-500">Review receipts and activate school accounts.</p>
        </div>
        <div class="bg-indigo-100 text-indigo-700 font-bold px-4 py-2 rounded-full text-sm">
            {{ payments|length }} Requests Pending
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">School / Date</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Plan Details</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Reference</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Proof</th>
                    <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for payment in payments %}
                <tr class="hover:bg-indigo-50/30 transition-colors">
                    {# 1. School Info #}
                    <td class="px-6 py-4">
                        <div class="font-bold text-gray-900">{{ payment.school.name }}</div>
                        <div class="text-xs text-gray-400">{{ payment.createdAt|date('M d, Y • h:i A') }}</div>
                    </td>

                    {# 2. Plan Info #}
                    <td class="px-6 py-4">
                        <span class="bg-indigo-100 text-indigo-700 px-2 py-1 rounded text-xs font-bold mr-2">{{ payment.plan.name }}</span>
                        <div class="mt-1 font-mono font-bold text-gray-900">₦{{ payment.amount|number_format }}</div>
                    </td>

                    {# 3. Reference #}
                    <td class="px-6 py-4">
                        <span class="font-mono text-xs bg-yellow-100 text-yellow-800 border border-yellow-200 px-2 py-1 rounded select-all font-bold">
                            {{ payment.reference }}
                        </span>
                    </td>

                    {# 4. Receipt Link #}
                    <td class="px-6 py-4">
                        {% if payment.proofOfPayment %}
                            <a href="{{ asset('uploads/proofs/' ~ payment.proofOfPayment) }}" target="_blank" class="flex items-center gap-2 text-indigo-600 text-sm font-bold hover:underline bg-indigo-50 px-3 py-2 rounded-lg border border-indigo-100 hover:bg-indigo-100 transition-colors">
                                <span>📄 View Receipt</span>
                            </a>
                        {% else %}
                            <span class="text-red-400 text-xs italic bg-red-50 px-2 py-1 rounded">No file uploaded</span>
                        {% endif %}
                    </td>

                    {# 5. Actions #}
                    <td class="px-6 py-4 text-right">
                        <div class="flex justify-end gap-2">
                            {# APPROVE BUTTON #}
                            <form action="{{ path('landlord_subscription_verify', {id: payment.id}) }}" method="POST" onsubmit="return confirm('Confirm payment from {{ payment.school.name }}? This will extend their subscription.');">
                                <button class="bg-emerald-500 text-white px-4 py-2 rounded-lg font-bold text-xs hover:bg-emerald-600 shadow-sm transition-transform hover:-translate-y-0.5 flex items-center gap-1">
                                    ✓ Approve
                                </button>
                            </form>

                            {# REJECT BUTTON #}
                            <form action="{{ path('landlord_subscription_reject', {id: payment.id}) }}" method="POST" onsubmit="return confirm('Decline this payment?');">
                                <button class="bg-white border border-gray-200 text-gray-500 px-3 py-2 rounded-lg font-bold text-xs hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-colors">
                                    ✗
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="p-16 text-center text-gray-400">
                        <div class="text-5xl mb-3">✅</div>
                        <p class="font-medium">All caught up!</p>
                        <p class="text-sm">No pending payments to verify.</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}