{% extends 'base.html.twig' %}

{% block title %}Subscription Plans{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 px-4 sm:px-6 lg:px-8">

    {# HEADER #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">💳 Subscription Plans</h1>
            <p class="text-gray-500 text-sm mt-1">Define the pricing packages available to schools.</p>
        </div>
        <div class="w-full sm:w-auto">
            <a href="{{ path('landlord_plan_new') }}" class="w-full sm:w-auto justify-center bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-indigo-700 shadow-sm transition flex items-center gap-2">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Create New Plan</span>
            </a>
        </div>
    </div>

    {# EMPTY STATE #}
    {% if plans|length == 0 %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center text-gray-500">
            <div class="text-5xl mb-4">🏷️</div>
            <p class="text-lg font-medium text-gray-900">No plans defined</p>
            <p class="text-sm mt-1">Create your first pricing package to start selling.</p>
        </div>
    {% else %}

        {# 📱 MOBILE VIEW (Cards) #}
        <div class="grid grid-cols-1 gap-4 md:hidden">
            {% for plan in plans %}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 space-y-4 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-green-100 text-green-800 px-3 py-1 rounded-bl-lg text-xs font-bold">
                        ₦{{ plan.price|number_format(0) }}
                    </div>
                    
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">{{ plan.name }}</h3>
                        <p class="text-xs text-gray-500">{{ plan.durationMonths }} Month Duration</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4 text-sm border-t border-gray-100 pt-3">
                        <div>
                            <span class="block text-xs text-gray-400 uppercase">Capacity</span>
                            <span class="font-medium text-gray-700">
                                {% if plan.maxStudents %}
                                    {{ plan.minStudents }} - {{ plan.maxStudents }} Students
                                {% else %}
                                    Unlimited Students
                                {% endif %}
                            </span>
                        </div>
                        <div>
                            <span class="block text-xs text-gray-400 uppercase">WhatsApp Bonus</span>
                            <span class="font-medium text-green-600">+₦{{ plan.freeCreditAmount|number_format(0) }}</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-2">
                        <a href="{{ path('landlord_plan_edit', {'id': plan.id}) }}" class="flex items-center justify-center rounded-md bg-white border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50">
                            Edit
                        </a>
                        <form method="post" action="{{ path('landlord_plan_delete', {'id': plan.id}) }}" onsubmit="return confirm('Delete this plan?');" class="block w-full">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                            <button class="w-full flex items-center justify-center rounded-md bg-red-50 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-100">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# 💻 DESKTOP VIEW (Table) #}
        <div class="hidden md:block bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <table class="w-full text-left text-sm text-gray-600">
                <thead class="bg-gray-50 text-xs uppercase font-bold text-gray-500 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3">Plan Name</th>
                        <th class="px-6 py-3">Price</th>
                        <th class="px-6 py-3">Student Limit</th>
                        <th class="px-6 py-3">Duration</th>
                        <th class="px-6 py-3">Free Credit</th>
                        <th class="px-6 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for plan in plans %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 font-bold text-gray-900">{{ plan.name }}</td>
                            <td class="px-6 py-4">
                                <span class="bg-green-100 text-green-800 px-2 py-1 rounded font-bold text-xs">
                                    ₦{{ plan.price|number_format(2) }}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                {% if plan.maxStudents %}
                                    {{ plan.minStudents }} - {{ plan.maxStudents }}
                                {% else %}
                                    <span class="text-indigo-600 font-bold">Unlimited ♾️</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">{{ plan.durationMonths }} Months</td>
                            <td class="px-6 py-4 text-green-600 font-medium">+₦{{ plan.freeCreditAmount|number_format(0) }}</td>
                            <td class="px-6 py-4 text-right flex justify-end gap-2">
                                <a href="{{ path('landlord_plan_edit', {'id': plan.id}) }}" class="text-indigo-600 hover:text-indigo-900 font-medium px-2">Edit</a>
                                <form method="post" action="{{ path('landlord_plan_delete', {'id': plan.id}) }}" onsubmit="return confirm('Are you sure you want to delete this plan?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                                    <button class="text-red-500 hover:text-red-700 font-medium px-2">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {% endif %}
</div>
{% endblock %}