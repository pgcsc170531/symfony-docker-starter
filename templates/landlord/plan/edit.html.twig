{% extends 'base.html.twig' %}

{% block title %}Edit Plan: {{ plan.name }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-6">
        <a href="{{ path('landlord_plan_index') }}" class="text-sm text-gray-500 hover:text-gray-900 flex items-center">
            <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Plans
        </a>
    </div>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
            <div>
                <h1 class="text-lg font-bold text-gray-900">Edit Plan</h1>
                <p class="text-sm text-gray-500">{{ plan.name }}</p>
            </div>
            <span class="bg-gray-200 text-gray-600 text-xs px-2 py-1 rounded font-mono">ID: {{ plan.id }}</span>
        </div>
        
        <div class="p-6">
            {{ form_start(form) }}
                
                <div class="space-y-6">
                    
                    {# 1. Name & Price #}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            {{ form_widget(form.name, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                        </div>
                        <div>
                            {{ form_label(form.price, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1 relative rounded-md shadow-sm">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <span class="text-gray-500 sm:text-sm">₦</span>
                                </div>
                                {{ form_widget(form.price, {'attr': {'class': 'block w-full rounded-md border-gray-300 pl-8 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                            </div>
                        </div>
                    </div>

                    {# 🟢 2. Trial Plan Checkbox (Added) #}
                    <div class="bg-indigo-50 p-4 rounded-md border border-indigo-100 flex items-start">
                        <div class="flex h-5 items-center">
                            {{ form_widget(form.isTrial, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500'}}) }}
                        </div>
                        <div class="ml-3 text-sm">
                            {{ form_label(form.isTrial, null, {'label_attr': {'class': 'font-bold text-indigo-900'}}) }}
                            <p class="text-indigo-700 opacity-80">{{ form.isTrial.vars.help }}</p>
                        </div>
                    </div>

                    {# 3. Limits #}
                    <div class="bg-gray-50 p-4 rounded-md border border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.minStudents, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            {{ form_widget(form.minStudents, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border'}}) }}
                        </div>
                        <div>
                            {{ form_label(form.maxStudents, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            {{ form_widget(form.maxStudents, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border', 'placeholder': 'Unlimited'}}) }}
                        </div>
                    </div>

                     {# 4. Duration & Bonus #}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.durationMonths, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            {{ form_widget(form.durationMonths, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border'}}) }}
                        </div>
                        <div>
                            {{ form_label(form.freeCreditAmount, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                             <div class="mt-1 relative rounded-md shadow-sm">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <span class="text-green-500 sm:text-sm">₦</span>
                                </div>
                                {{ form_widget(form.freeCreditAmount, {'attr': {'class': 'block w-full rounded-md border-gray-300 pl-8 focus:border-green-500 focus:ring-green-500 sm:text-sm p-2 border'}}) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex justify-end gap-3">
                    <a href="{{ path('landlord_plan_index') }}" class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-md font-bold shadow-sm hover:bg-indigo-700 transition">
                        Save Changes
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}