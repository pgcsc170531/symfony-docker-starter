{% extends 'base.html.twig' %}

{% block title %}School Profile: {{ school.name }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    {# 1. BACK NAVIGATION #}
    <div class="mb-6">
        <a href="{{ path('landlord_school_index') }}" class="text-sm text-gray-500 hover:text-gray-900 flex items-center transition-colors">
            <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to School List
        </a>
    </div>

    {# 2. HEADER CARD #}
    <div class="bg-white shadow-sm rounded-lg p-6 mb-6 border border-gray-200">
        <div class="md:flex md:items-center md:justify-between">
            <div class="flex items-center space-x-5">
                <div class="flex-shrink-0">
                    <div class="h-16 w-16 bg-blue-600 rounded-lg flex items-center justify-center text-white text-2xl font-bold shadow-md">
                        {{ school.name|slice(0,1)|upper }}
                    </div>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">{{ school.name }}</h1>
                    <div class="flex items-center text-sm text-gray-500 mt-1">
                        <svg class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                        <a href="http://{{ school.subdomain }}.edus.ng" target="_blank" class="text-indigo-600 hover:underline font-mono">
                            {{ school.subdomain }}.edus.ng
                        </a>
                        <span class="mx-2 text-gray-300">|</span>
                        <span class="text-gray-500">Enrolled: {{ school.createdAt|date('M d, Y') }}</span>
                    </div>
                </div>
            </div>
            <div class="mt-4 flex space-x-3 md:mt-0">
                <button disabled class="inline-flex items-center rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-400 cursor-not-allowed">
                    <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    Edit Details
                </button>
            </div>
        </div>
    </div>

    {# 3. METRICS GRID #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        
        {# A. SYSTEM STATUS #}
        <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">System Status</h3>
            <div class="mt-3 flex items-center">
                {% if school.isActive %}
                    <span class="flex h-3 w-3 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                    </span>
                    <span class="ml-2 text-lg font-semibold text-gray-900">Active</span>
                {% else %}
                    <span class="h-3 w-3 rounded-full bg-red-500"></span>
                    <span class="ml-2 text-lg font-semibold text-gray-900">Inactive</span>
                {% endif %}
            </div>
            <p class="text-xs text-gray-400 mt-2">Database: <span class="font-mono text-gray-600">{{ school.databaseName }}</span></p>
        </div>

        {# B. PRINCIPAL INFO #}
        <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Principal Contact</h3>
            <div class="mt-3">
                <p class="text-lg font-bold text-gray-900">{{ school.principalName }}</p>
                <p class="text-sm text-gray-500 truncate">{{ school.principalEmail }}</p>
            </div>
        </div>

        {# C. REFERRING AGENT #}
        <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Managed By</h3>
            <div class="mt-3">
                {% if school.agent %}
                    <a href="{{ path('landlord_agent_show', {'id': school.agent.id}) }}" class="group flex items-center">
                        <div class="h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-xs group-hover:bg-indigo-200 transition">
                            {{ school.agent.fullName|slice(0,1)|upper }}
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-indigo-600 group-hover:text-indigo-800">{{ school.agent.fullName }}</p>
                            <p class="text-xs text-gray-400">Commission: {{ school.agent.commissionPercentage }}%</p>
                        </div>
                    </a>
                {% else %}
                    <p class="text-lg font-bold text-gray-400">Direct Sign-up</p>
                    <p class="text-xs text-gray-400">No commission agent assigned.</p>
                {% endif %}
            </div>
        </div>
    </div>

    {# 🟢 4. SUBSCRIPTION DETAILS (UPDATED) #}
    <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <div>
                <h3 class="text-base font-semibold leading-6 text-gray-900">Subscription & Limits</h3>
                <p class="mt-1 text-sm text-gray-500">Current plan details and renewal information.</p>
            </div>
            
            {# Add Payment Button (Optional, we will build this route next) #}
            {# <a href="#" class="text-sm text-indigo-600 font-bold hover:underline">+ Add Payment</a> #}
        </div>
        
        <div class="px-4 py-5 sm:p-6">
            {% if school.subscription %}
                {% set sub = school.subscription %}
                {% set plan = sub.plan %}
                {% set daysRemaining = sub.daysRemaining %}
                
                <div class="flex flex-col md:flex-row gap-6">
                    
                    {# Plan Info #}
                    <div class="flex-1 bg-indigo-50 rounded-lg p-5 border border-indigo-100">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Current Plan</p>
                                <h3 class="text-2xl font-bold text-gray-900 mt-1">{{ plan.name }}</h3>
                                <p class="text-sm text-gray-600 mt-1">
                                    Max Students: 
                                    <span class="font-bold">
                                        {{ plan.maxStudents ? plan.maxStudents : 'Unlimited' }}
                                    </span>
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="block text-2xl font-bold text-gray-900">₦{{ plan.price|number_format }}</span>
                                <span class="text-xs text-gray-500">per renewal</span>
                            </div>
                        </div>
                    </div>

                    {# Dates & Status #}
                    <div class="flex-1 grid grid-cols-2 gap-4">
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-xs text-gray-500 uppercase">Status</p>
                            <p class="font-bold text-green-600 flex items-center gap-1">
                                <span class="h-2 w-2 rounded-full bg-green-500"></span>
                                {{ sub.status }}
                            </p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-xs text-gray-500 uppercase">Expires In</p>
                            <p class="font-bold {{ daysRemaining < 5 ? 'text-red-600' : 'text-gray-900' }}">
                                {{ daysRemaining }} Days
                            </p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-xs text-gray-500 uppercase">Start Date</p>
                            <p class="font-bold text-gray-800">{{ sub.startDate|date('M d, Y') }}</p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-xs text-gray-500 uppercase">End Date</p>
                            <p class="font-bold text-gray-800">{{ sub.endDate|date('M d, Y') }}</p>
                        </div>
                    </div>

                </div>
            {% else %}
                {# Fallback if something went wrong and no sub exists #}
                <div class="rounded-md bg-red-50 p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">No Active Subscription</h3>
                            <div class="mt-2 text-sm text-red-700">
                                <p>This school has no subscription plan assigned. Please check the onboarding logic.</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}