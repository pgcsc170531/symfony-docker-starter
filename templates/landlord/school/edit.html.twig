{% extends 'base.html.twig' %}

{% block title %}Edit {{ school.name }}{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:px-6 sm:py-6">

    <a href="{{ path('landlord_school_show', {id: school.id}) }}"
       class="mb-4 inline-flex min-h-[44px] items-center text-sm font-semibold text-ink-500 hover:text-ink-900">
        &larr; Back to {{ school.name }}
    </a>

    <div class="mb-5">
        <h1 class="text-xl font-black tracking-tight text-ink-900 sm:text-2xl">Edit school</h1>
        <p class="mt-1 break-words text-sm text-ink-500">
            <span class="font-mono">{{ school.subdomain }}.edus.ng</span>
            · database <span class="font-mono">{{ school.databaseName }}</span>
        </p>
    </div>

    {{ form_start(form, {attr: {class: 'space-y-4'}}) }}

        {# ── Identity ──────────────────────────────────────────────────── #}
        <div class="rounded-xl border border-ink-200 bg-white">
            <div class="border-b border-ink-100 px-4 py-3">
                <h2 class="text-sm font-bold text-ink-900">Identity</h2>
            </div>
            <div class="space-y-4 p-4">
                <div>
                    <label for="{{ form.name.vars.id }}" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">School name</label>
                    {{ form_widget(form.name, {attr: {class: 'min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div>
                    <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Subdomain</span>
                    <p class="rounded-lg border border-ink-200 bg-ink-50 px-3 py-2.5 font-mono text-sm text-ink-700">
                        {{ school.subdomain }}.edus.ng
                    </p>
                    <p class="mt-1 text-xs text-ink-500">
                        Not editable. It is the school's address, and it is already printed on report cards,
                        receipts and emails. Renaming it is a migration, not a form field.
                    </p>
                </div>

                <div>
                    <label class="flex min-h-[44px] items-center gap-3 rounded-lg border border-ink-200 px-3 py-2">
                        {{ form_widget(form.isActive, {attr: {class: 'h-5 w-5 rounded border-ink-300 text-accent-600 focus:ring-accent-500'}}) }}
                        <span class="text-sm font-semibold text-ink-800">School is active</span>
                    </label>
                    <p class="mt-1 text-xs text-ink-500">{{ form.isActive.vars.help }}</p>
                </div>
            </div>
        </div>

        {# ── Owner account ─────────────────────────────────────────────── #}
        <div class="rounded-xl border border-ink-200 bg-white">
            <div class="border-b border-ink-100 px-4 py-3">
                <h2 class="text-sm font-bold text-ink-900">Owner account</h2>
            </div>
            <div class="space-y-4 p-4">
                <div>
                    <label for="{{ form.principalName.vars.id }}" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Name</label>
                    {{ form_widget(form.principalName, {attr: {class: 'min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500'}}) }}
                    {{ form_errors(form.principalName) }}
                </div>
                <div>
                    <label for="{{ form.principalEmail.vars.id }}" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Email</label>
                    {{ form_widget(form.principalEmail, {attr: {class: 'min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500'}}) }}
                    {% if form.principalEmail.vars.help %}<p class="mt-1 text-xs text-ink-500">{{ form.principalEmail.vars.help }}</p>{% endif %}
                    {{ form_errors(form.principalEmail) }}
                </div>
                <div>
                    <label for="{{ form.newPassword.vars.id }}" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">New password</label>
                    {{ form_widget(form.newPassword, {attr: {class: 'min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500', placeholder: 'Leave blank to keep the current one'}}) }}
                    {% if form.newPassword.vars.help %}<p class="mt-1 text-xs text-ink-500">{{ form.newPassword.vars.help }}</p>{% endif %}
                    {{ form_errors(form.newPassword) }}
                </div>
                <div>
                    <label for="{{ form.agent.vars.id }}" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">Referred by</label>
                    {{ form_widget(form.agent, {attr: {class: 'min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500'}}) }}
                    {{ form_errors(form.agent) }}
                </div>
            </div>
            <div class="border-t border-ink-100 p-4">
                <button type="submit"
                        class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                    Save changes
                </button>
            </div>
        </div>

    {{ form_end(form) }}

    {# ── Payments: the school's Paystack subaccount ───────────────────────
       Operator-only. Edus holds the single Paystack account; a subaccount is a
       record on it holding the school's settlement bank and our split. The
       school never logs into Paystack — it only enters its bank details in its
       own settings, and we create the subaccount here. #}
    <div class="mt-8 rounded-xl border border-ink-200 bg-white">
        <div class="border-b border-ink-100 px-4 py-3">
            <h2 class="text-sm font-bold text-ink-900">Payments</h2>
            <p class="mt-1 text-xs text-ink-500">Where this school's fees settle inside our Paystack account.</p>
        </div>

        <div class="space-y-4 p-4">
            {% if payments.code and payments.paystack_found is same as(false) %}
                {# A code that exists only in the other Paystack mode. Test and live
                   are separate worlds: a test ACCT_ is invisible to live, and a
                   school switched over keeps a code that resolves nowhere. #}
                <div class="rounded-lg border-2 border-failed/50 bg-failed/5 p-3">
                    <p class="text-xs font-bold uppercase tracking-wide text-failed">This code is not recognised by Paystack</p>
                    <p class="mt-1 text-xs leading-relaxed text-ink-700">
                        <span class="font-mono">{{ payments.code }}</span> was not found — most likely it was created in
                        <strong>test mode</strong> and we are now on a live key (or the reverse).
                        {% if payments.paystack_message %}<span class="block mt-1 text-ink-500">Paystack said: {{ payments.paystack_message }}</span>{% endif %}
                        Create a new subaccount below to replace it.
                    </p>
                </div>
            {% elseif payments.code %}
                <div class="rounded-lg border border-paid/30 bg-paid/5 p-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-paid">Subaccount set</p>
                    <p class="mt-1 font-mono text-sm text-ink-900">{{ payments.code }}</p>
                    <p class="mt-1 text-xs text-ink-600">Parents at this school can pay online.</p>
                </div>
            {% else %}
                <div class="rounded-lg border border-pending/40 bg-pending/5 p-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-pending">No subaccount yet</p>
                    <p class="mt-1 text-xs text-ink-700">“Pay online” is hidden for this school's parents until a subaccount exists.</p>
                </div>
            {% endif %}

            {% if payments.paystack_account_number and payments.account_number
                  and payments.paystack_account_number != payments.account_number %}
                {# The school changed its bank details after the subaccount was made.
                   Paystack still pays the old account — this is the only place that
                   divergence is visible. #}
                <div class="rounded-lg border-2 border-failed/50 bg-failed/5 p-3">
                    <p class="text-xs font-bold uppercase tracking-wide text-failed">Out of sync — money is going to the old account</p>
                    <p class="mt-1 text-xs leading-relaxed text-ink-700">
                        Paystack settles into <strong class="font-mono">{{ payments.paystack_account_number }}</strong>
                        ({{ payments.paystack_bank ?: 'the bank on record' }}), but the school has since changed its
                        details to <strong class="font-mono">{{ payments.account_number }}</strong>.
                        Press <em>Save &amp; replace subaccount</em> below to move online payments to the new account.
                    </p>
                </div>
            {% endif %}

            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Settlement account</p>
                <p class="mt-1 text-xs text-ink-600">
                    Where this school's fees are paid. The school can also set these under its own
                    Settings → General; whoever saves last wins. Editable here because at onboarding the
                    operator usually has the account letter, not the bursar.
                </p>
            </div>

            <form method="post" action="{{ path('landlord_school_subaccount', {id: school.id}) }}" class="space-y-3">
                <input type="hidden" name="_token" value="{{ csrf_token('subaccount_' ~ school.id) }}">

                <div>
                    <label for="bank_name" class="mb-1 block text-sm font-medium text-ink-700">Bank name</label>
                    <input type="text" id="bank_name" name="bank_name" autocomplete="off"
                           value="{{ payments.bank_name }}"
                           placeholder="e.g. Zenith Bank"
                           class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                </div>

                <div>
                    <label for="account_number" class="mb-1 block text-sm font-medium text-ink-700">Account number</label>
                    <input type="text" id="account_number" name="account_number" required inputmode="numeric" autocomplete="off"
                           value="{{ payments.account_number }}"
                           placeholder="10 digits"
                           class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <p class="mt-1 text-xs text-ink-500">Must be a real, active account at the bank below — Paystack resolves it against the bank's records.</p>
                </div>

                <div>
                    <label for="account_name" class="mb-1 block text-sm font-medium text-ink-700">Account name</label>
                    <input type="text" id="account_name" name="account_name" autocomplete="off"
                           value="{{ payments.account_name }}"
                           placeholder="As printed on the statement"
                           class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                </div>

                <div>
                    <label for="bank_code" class="mb-1 block text-sm font-medium text-ink-700">Settlement bank code</label>
                    <input type="text" id="bank_code" name="bank_code" inputmode="numeric" autocomplete="off"
                           placeholder="e.g. 058"
                           class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 font-mono text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <p class="mt-1 text-xs text-ink-500">
                        Paystack identifies a bank by code, not name — 058 GTBank, 011 First Bank, 044 Access, 057 Zenith.
                        Only needed to create the subaccount.
                    </p>
                </div>

                <div>
                    <label for="percentage_charge" class="mb-1 block text-sm font-medium text-ink-700">Our split (%)</label>
                    <input type="number" id="percentage_charge" name="percentage_charge" min="0" max="100" step="0.1" value="0"
                           class="min-h-[44px] w-full rounded-lg border border-ink-300 bg-white px-3 text-base text-ink-900 focus:border-accent-500 focus:ring-accent-500">
                    <p class="mt-1 text-xs text-ink-500">
                        Leave at 0. The school is paid its fee in full; Edus earns on the subscription and the
                        transfer charge, not by shaving the school's money.
                    </p>
                </div>

                <div class="flex flex-col gap-2 border-t border-ink-100 pt-4 sm:flex-row">
                    <button type="submit" name="intent" value="create"
                            class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-5 text-sm font-semibold text-white hover:bg-accent-700 sm:w-auto">
                        {{ payments.code ? 'Save & replace subaccount' : 'Save & create subaccount' }}
                    </button>
                    <button type="submit" name="intent" value="save"
                            class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 bg-white px-5 text-sm font-semibold text-ink-700 hover:bg-ink-50 sm:w-auto">
                        Save details only
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── Danger zone ───────────────────────────────────────────────────── #}
    <div class="mt-8 rounded-xl border border-failed/30 bg-white">
        <div class="border-b border-ink-100 px-4 py-3">
            <h2 class="text-sm font-bold text-failed">Danger zone</h2>
        </div>
        <div class="p-4">
            <p class="text-sm text-ink-700">
                <strong>Deleting removes the school for good.</strong> Its pupils, marks, bills, payments and staff logins
                go with it, along with the database
                <span class="font-mono text-xs">{{ school.databaseName }}</span>.
            </p>
            <p class="mt-2 text-sm text-ink-500">
                If you only want to stop them using Edus for now, switch <strong>School is active</strong> off above and save —
                nothing is deleted, and it can be switched back on.
            </p>

            <form method="post" action="{{ path('landlord_school_delete', {id: school.id}) }}"
                  class="mt-4 space-y-3"
                  onsubmit="return confirm('Delete {{ school.name|e('js') }} permanently? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_school_' ~ school.id) }}">

                <div>
                    <label for="confirm_subdomain" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-ink-500">
                        Type <span class="font-mono normal-case">{{ school.subdomain }}</span> to confirm
                    </label>
                    <input id="confirm_subdomain" name="confirm_subdomain" type="text" autocomplete="off"
                           placeholder="{{ school.subdomain }}"
                           class="min-h-[44px] w-full rounded-lg border border-ink-300 px-3 text-base text-ink-900 focus:border-failed focus:ring-failed/30 sm:max-w-xs">
                </div>

                <button type="submit"
                        class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-failed bg-failed px-5 text-sm font-semibold text-white hover:opacity-90 sm:w-auto">
                    Delete this school permanently
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
