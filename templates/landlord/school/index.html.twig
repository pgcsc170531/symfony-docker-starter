{% extends 'base.html.twig' %}

{% block title %}School Management{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto mt-6 px-4 sm:px-6 lg:px-8">

    {# HEADER & ACTIONS #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">🏫 School Management</h1>
            <p class="text-gray-500 text-sm mt-1">Monitor all registered schools, their status, and assigned agents.</p>
        </div>
        <div class="w-full sm:w-auto">
           <a href="{{ path('app_landlord_school_new') }}" class="w-full sm:w-auto justify-center bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-indigo-700 shadow-sm transition flex items-center gap-2">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Enroll New School</span>
            </a>
        </div>
    </div>

    {# EMPTY STATE #}
    {% if schools|length == 0 %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center text-gray-500">
            <div class="text-5xl mb-4">🏫</div>
            <p class="text-lg font-medium text-gray-900">No schools enrolled yet</p>
            <p class="text-sm mt-1">Click the button above to manually enroll your first school.</p>
        </div>
    {% else %}

        {# ========================================== #}
        {# 📱 MOBILE VIEW (Cards) - Visible < md      #}
        {# ========================================== #}
        <div class="grid grid-cols-1 gap-4 md:hidden">
            {% for school in schools %}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 space-y-4">
                    
                    {# Top Row: Icon & Name #}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="h-10 w-10 rounded bg-blue-100 flex items-center justify-center text-blue-700 font-bold border border-blue-200">
                                {{ school.name|slice(0,1)|upper }}
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-gray-900 truncate w-40">{{ school.name }}</h3>
                                <a href="http://{{ school.subdomain }}.edus.app" target="_blank" class="text-xs text-indigo-600 hover:underline">
                                    {{ school.subdomain }}.edus.ng
                                </a>
                            </div>
                        </div>
                        
                        {# Status Badge #}
                        {% if school.isActive %}
                            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                        {% else %}
                            <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">Inactive</span>
                        {% endif %}
                    </div>

                    {# Details Row #}
                    <div class="text-sm text-gray-600 space-y-1 border-t border-gray-100 pt-3">
                        <p class="flex items-center">
                            <span class="text-xs text-gray-400 w-16 uppercase font-bold">Principal:</span>
                            {{ school.principalName }}
                        </p>
                        <p class="flex items-center">
                            <span class="text-xs text-gray-400 w-16 uppercase font-bold">Agent:</span>
                            {% if school.agent %}
                                <span class="text-indigo-600 font-medium">{{ school.agent.fullName }}</span>
                            {% else %}
                                <span class="text-gray-400 italic">Direct</span>
                            {% endif %}
                        </p>
                    </div>

                    {# Bottom Row: Actions #}
                    <div class="grid grid-cols-2 gap-3 pt-2">
                        <a href="#" class="flex items-center justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                            Edit
                        </a>
                        <a href="{{ path('landlord_school_show', {'id': school.id}) }}" class="flex items-center justify-center rounded-md bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-100">
                            View
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# ========================================== #}
        {# 💻 DESKTOP VIEW (Table) - Visible >= md    #}
        {# ========================================== #}
        <div class="hidden md:block bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <table class="w-full text-left text-sm text-gray-600">
                <thead class="bg-gray-50 text-xs uppercase font-bold text-gray-500 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3">School Details</th>
                        <th class="px-6 py-3">Principal</th>
                        <th class="px-6 py-3">Referred By</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3">Enrolled On</th>
                        <th class="px-6 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for school in schools %}
                        <tr class="hover:bg-gray-50 transition group">
                            
                            {# School Name & Subdomain #}
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="h-8 w-8 rounded bg-blue-50 flex items-center justify-center text-blue-600 font-bold text-xs border border-blue-100">
                                        {{ school.name|slice(0,1)|upper }}
                                    </div>
                                    <div>
                                        <div class="font-bold text-gray-900">{{ school.name }}</div>
                                        <a href="http://{{ school.subdomain }}.edus.app" target="_blank" class="text-xs text-indigo-500 hover:underline">
                                            {{ school.subdomain }}.edus.app
                                        </a>
                                    </div>
                                </div>
                            </td>

                            {# Principal Info #}
                            <td class="px-6 py-4">
                                <div class="text-gray-900">{{ school.principalName }}</div>
                                <div class="text-xs text-gray-500">{{ school.principalEmail }}</div>
                            </td>

                            {# Agent Info #}
                            <td class="px-6 py-4">
                                {% if school.agent %}
                                    <a href="{{ path('landlord_agent_show', {'id': school.agent.id}) }}" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-indigo-50 text-indigo-700 text-xs font-medium hover:bg-indigo-100 transition">
                                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                                        {{ school.agent.fullName }}
                                    </a>
                                {% else %}
                                    <span class="text-gray-400 text-xs italic">Direct Sign-up</span>
                                {% endif %}
                            </td>

                            {# Status #}
                            <td class="px-6 py-4">
                                {% if school.isActive %}
                                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                                        Active
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
                                        Inactive
                                    </span>
                                {% endif %}
                            </td>

                            {# Date #}
                            <td class="px-6 py-4">
                                {{ school.createdAt|date('M d, Y') }}
                            </td>

                            {# Actions #}
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity">
                                    <a href="#" class="text-gray-500 hover:text-indigo-600 hover:bg-gray-100 p-1.5 rounded-md transition" title="Edit Settings">
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <a href="{{ path('landlord_school_show', {'id': school.id}) }}" class="text-indigo-600 hover:text-indigo-900 hover:bg-indigo-50 px-3 py-1.5 rounded-md text-xs font-bold transition flex items-center border border-transparent hover:border-indigo-200">
                                        View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {% endif %}
</div>
{% endblock %}