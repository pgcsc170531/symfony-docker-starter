{% extends 'base.html.twig' %}

{% block title %}Edit Agent: {{ agent.fullName }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto mt-6 px-4 pb-12">

    {# 1. BREADCRUMB / BACK LINK #}
    <div class="mb-6">
        <a href="{{ path('landlord_agent_show', {'id': agent.id}) }}" class="text-sm text-gray-500 hover:text-gray-900 flex items-center transition-colors">
            <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Profile
        </a>
    </div>

    {# 2. MAIN EDIT FORM CARD #}
    <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
            <h1 class="text-lg font-bold text-gray-900">Edit Agent Details</h1>
        </div>

        <div class="p-6">
            {{ form_start(form) }}
                
                <div class="grid grid-cols-1 gap-6">
                    
                    {# Full Name #}
                    <div>
                        {{ form_label(form.fullName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(form.fullName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                        {{ form_errors(form.fullName) }}
                    </div>

                    {# Email & Phone #}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            {{ form_widget(form.email, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div>
                            {{ form_label(form.phoneNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            {{ form_widget(form.phoneNumber, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border'}}) }}
                            {{ form_errors(form.phoneNumber) }}
                        </div>
                    </div>

                    {# Commission Section #}
                    <div class="bg-blue-50 p-4 rounded-md border border-blue-100">
                        <h3 class="text-sm font-bold text-blue-800 mb-2">Commission Settings</h3>
                        <div>
                            {{ form_label(form.commissionPercentage, 'Commission Rate (%)', {'label_attr': {'class': 'block text-sm font-medium text-blue-900'}}) }}
                            {{ form_widget(form.commissionPercentage, {'attr': {'class': 'mt-1 block w-full md:w-1/3 rounded-md border-blue-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 border'}}) }}
                            <p class="text-xs text-blue-600 mt-1">Percentage earned on every school subscription renewal.</p>
                            {{ form_errors(form.commissionPercentage) }}
                        </div>
                    </div>

                    {# Password Reset (Optional) #}
                    <div class="border-t border-gray-100 pt-4 mt-2">
                        <h3 class="text-sm font-bold text-gray-900 mb-2">Change Password</h3>
                        <p class="text-xs text-gray-500 mb-3">Leave blank to keep the current password.</p>
                        
                        {{ form_widget(form.plainPassword, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border', 'placeholder': 'New Password (Optional)'}}) }}
                        {{ form_errors(form.plainPassword) }}
                    </div>

                    {# Submit Actions #}
                    <div class="flex justify-end pt-4">
                        <a href="{{ path('landlord_agent_show', {'id': agent.id}) }}" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3">
                            Cancel
                        </a>
                        <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                            Save Changes
                        </button>
                    </div>

                </div>

            {{ form_end(form) }}
        </div>
    </div>

    {# 3. DANGER ZONE (DELETE) #}
    <div class="mt-10 border-t border-gray-200 pt-10">
        <div class="bg-red-50 border border-red-200 rounded-lg p-6 flex items-start justify-between">
            <div>
                <h3 class="text-sm font-bold text-red-800">Delete Agent Account</h3>
                <p class="text-sm text-red-600 mt-1">
                    Once you delete this agent, there is no going back. <br>
                    <strong>Note:</strong> You cannot delete an agent who still has active schools assigned.
                </p>
            </div>
            <div>
                <form method="post" action="{{ path('landlord_agent_delete', {'id': agent.id}) }}" onsubmit="return confirm('Are you strictly sure? This action cannot be undone.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ agent.id) }}">
                    <button class="bg-white border border-red-300 text-red-700 hover:bg-red-50 font-bold py-2 px-4 rounded text-sm shadow-sm transition">
                        Delete Agent
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
{% endblock %}