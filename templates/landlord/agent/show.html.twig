{% extends 'base.html.twig' %}

{% block title %}Agent Profile: {{ agent.fullName }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    {# Back Button #}
    <div class="mb-6">
        <a href="{{ path('landlord_agent_index') }}" class="text-sm text-gray-500 hover:text-gray-900 flex items-center">
            <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Agent List
        </a>
    </div>

    {# HEADER CARD #}
    <div class="bg-white shadow-sm rounded-lg p-6 mb-6 border border-gray-200">
        <div class="md:flex md:items-center md:justify-between">
            <div class="flex items-center space-x-5">
                <div class="flex-shrink-0">
                    {# Avatar Circle with Initials #}
                    <div class="h-16 w-16 bg-indigo-600 rounded-full flex items-center justify-center text-white text-2xl font-bold shadow-md">
                        {{ agent.fullName|slice(0,1)|upper }}
                    </div>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">{{ agent.fullName }}</h1>
                    <div class="flex items-center text-sm text-gray-500 mt-1">
                        <svg class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        {{ agent.email }}
                        <span class="mx-2 text-gray-300">|</span>
                        <svg class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        {{ agent.phoneNumber|default('No Phone') }}
                    </div>
                </div>
            </div>
            <div class="mt-4 flex space-x-3 md:mt-0">
                <a href="{{ path('landlord_agent_edit', {'id': agent.id}) }}" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg class="h-4 w-4 mr-1.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    Edit Profile
                </a>
            </div>
        </div>
    </div>

    {# METRICS GRID #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        
        {# 1. COMMISSION CARD #}
        <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Commission Rate</h3>
            <div class="mt-2 flex items-baseline">
                <span class="text-3xl font-black text-gray-900">{{ agent.commissionPercentage }}%</span>
            </div>
            <p class="text-xs text-gray-400 mt-1">Earned per subscription renewal</p>
        </div>

        {# 2. TOTAL SCHOOLS CARD #}
        <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Managed Schools</h3>
            <div class="mt-2 flex items-baseline">
                <span class="text-3xl font-black text-indigo-600">{{ agent.schools|length }}</span>
                <span class="ml-2 text-sm text-gray-500">Active Clients</span>
            </div>
        </div>

        {# 3. TOTAL REVENUE (Placeholder) #}
        <div class="bg-white shadow-sm rounded-lg p-6 border border-gray-200">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Generated</h3>
            <div class="mt-2 flex items-baseline">
                <span class="text-3xl font-black text-green-600">₦0.00</span>
            </div>
            <p class="text-xs text-gray-400 mt-1">Lifetime revenue from this agent</p>
        </div>
    </div>

    {# SCHOOLS LIST #}
    <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <h3 class="text-base font-semibold leading-6 text-gray-900">Assigned Schools</h3>
        </div>
        
        <ul class="divide-y divide-gray-200">
            {% for school in agent.schools %}
                <li class="px-4 py-4 hover:bg-gray-50 transition duration-150 ease-in-out">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center min-w-0 gap-4">
                            <div class="h-10 w-10 rounded bg-indigo-50 flex items-center justify-center text-indigo-700 font-bold border border-indigo-100">
                                {{ school.name|slice(0,1)|upper }}
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-gray-900 truncate">{{ school.name }}</p>
                                <p class="text-xs text-gray-500 truncate">
                                    <a href="#" class="hover:text-indigo-600 underline">
                                        {{ school.subdomain }}.edus.app
                                    </a>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            {% if school.isActive %}
                                <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                            {% else %}
                                <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">Inactive</span>
                            {% endif %}
                            
                            <span class="text-xs text-gray-400">Created {{ school.createdAt|date('M Y') }}</span>
                        </div>
                    </div>
                </li>
            {% else %}
                <li class="px-4 py-12 text-center">
                    <div class="text-4xl text-gray-300 mb-2">🏫</div>
                    <h3 class="text-sm font-medium text-gray-900">No schools assigned</h3>
                    <p class="mt-1 text-sm text-gray-500">This agent hasn't enrolled any schools yet.</p>
                </li>
            {% endfor %}
        </ul>
    </div>

</div>
{% endblock %}