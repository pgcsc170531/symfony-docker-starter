{% extends 'base.html.twig' %}

{% block title %}Enroll New School{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto mt-10 p-5">
    
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-800">Enroll New School</h1>
            <p class="text-gray-500 mt-1">Create a new tenant database and assign an administrator.</p>
        </div>
        {# 🔴 FIX 1: Point to AGENT dashboard, not Landlord #}
        <a href="{{ path('app_agent_dashboard') }}" class="text-sm font-medium text-gray-500 hover:text-gray-900 flex items-center">
            <span class="mr-1">←</span> Back to Dashboard
        </a>
    </div>

    {# SUCCESS MESSAGES #}
    {% for message in app.flashes('success') %}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-sm mb-6 flex items-start">
            <span class="text-xl mr-3">✅</span>
            <div>
                <p class="font-bold">Success</p>
                <p>{{ message }}</p>
            </div>
        </div>
    {% endfor %}

    {# FORM START #}
    {{ form_start(form, {'attr': {'id': 'createSchoolForm'}}) }}
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        {# === LEFT COLUMN: SCHOOL DETAILS === #}
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
            {# 🔵 FIX 2: Use Indigo for Agent Branding #}
            <div class="flex items-center mb-6 text-indigo-700 border-b border-gray-100 pb-4">
                <span class="text-2xl mr-3">🏫</span>
                <div>
                    <h2 class="text-lg font-bold text-gray-800">School Identity</h2>
                    <p class="text-xs text-gray-500">Public facing details</p>
                </div>
            </div>
            
            <div class="space-y-6">
                {# School Name #}
                <div>
                    {{ form_label(form.name, 'School Name', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 p-3 border'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.name) }}</div>
                </div>

                {# Subdomain #}
                <div>
                    {{ form_label(form.subdomain, 'Subdomain (URL)', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    <div class="flex rounded-md shadow-sm">
                        {{ form_widget(form.subdomain, {'attr': {'class': 'flex-1 min-w-0 block w-full border-gray-300 rounded-none rounded-l-lg focus:ring-indigo-500 focus:border-indigo-500 p-3 border'}}) }}
                        <span class="inline-flex items-center px-4 rounded-r-lg border border-l-0 border-gray-300 bg-gray-50 text-gray-500 text-sm font-mono">
                            .localhost
                        </span>
                    </div>
                    <p class="mt-2 text-xs text-gray-400">Database: <span class="font-mono bg-gray-100 px-1 rounded">school_[subdomain]</span></p>
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.subdomain) }}</div>
                </div>

                {# 🔴 FIX 3: Remove 'Is Active' checkbox. We want it hidden and true by default #}
                <div class="hidden">
                    {{ form_widget(form.isActive, {'attr': {'checked': 'checked'}}) }}
                </div>
            </div>
        </div>

        {# === RIGHT COLUMN: PRINCIPAL ACCOUNT === #}
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
            <div class="flex items-center mb-6 text-indigo-700 border-b border-gray-100 pb-4">
                <span class="text-2xl mr-3">🔑</span>
                <div>
                    <h2 class="text-lg font-bold text-gray-800">Admin Credentials</h2>
                    <p class="text-xs text-gray-500">Initial login for the Principal</p>
                </div>
            </div>
            
            <div class="space-y-6">
                {# Principal Name #}
                <div>
                    {{ form_label(form.principalName, 'Principal Full Name', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.principalName, {'attr': {'class': 'w-full border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 p-3 border', 'placeholder': 'e.g. Dr. John Doe'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.principalName) }}</div>
                </div>

                {# Principal Email #}
                <div>
                    {{ form_label(form.principalEmail, 'Email Address (Login ID)', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.principalEmail, {'attr': {'class': 'w-full border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 p-3 border', 'placeholder': 'admin@school.com'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.principalEmail) }}</div>
                </div>

                {# Password #}
                <div>
                    {{ form_label(form.principalPassword, 'Initial Password', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.principalPassword, {'attr': {'class': 'w-full border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 p-3 border'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.principalPassword) }}</div>
                    <p class="mt-2 text-xs text-indigo-600 bg-indigo-50 p-2 rounded border border-indigo-200 flex items-start gap-2">
                        <span>⚠️</span> 
                        <span>Copy this password. You must share it with the school admin.</span>
                    </p>
                </div>
            </div>
        </div>

    </div>

    {# SUBMIT BUTTON #}
    <div class="mt-8 pt-6 border-t border-gray-200 flex justify-end">
        <button type="submit" id="submitBtn" class="bg-gray-900 hover:bg-black text-white font-bold py-4 px-8 rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-1 flex items-center">
            <span class="mr-2">🚀</span> Launch School System
        </button>
    </div>

    {{ form_end(form) }}
</div>

{# JAVASCRIPT TO PREVENT DOUBLE CLICK #}
<script>
    document.getElementById('createSchoolForm').addEventListener('submit', function() {
        const btn = document.getElementById('submitBtn');
        
        // 1. Disable the button
        btn.disabled = true;
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        
        // 2. Change Text & Add Spinner
        btn.innerHTML = `
            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Launching School Portal...</span>
        `;
    });
</script>
{% endblock %}