{% extends 'base.html.twig' %}

{% block title %}Payment ledger{% endblock %}

{% block body %}
    <div class="px-4 py-4 sm:px-6 sm:py-6">

        <div class="mb-4">
            <h1 class="text-xl font-bold text-ink-900 sm:text-2xl">Payment ledger</h1>
            <p class="mt-1 text-sm text-ink-600">
                Money collected online across every school: what we are holding, what we earned, and what the bank cost us.
            </p>
        </div>

        {# Float is a liability, not income. It is the number that must be right. #}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border p-4 {{ float > 0 ? 'border-pending/40 bg-pending/5' : 'border-ink-200 bg-white' }}">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Held for schools</p>
                <p class="money mt-1 text-2xl font-bold {{ float > 0 ? 'text-pending' : 'text-ink-900' }}">₦{{ float|number_format(2) }}</p>
                <p class="mt-1 text-xs text-ink-600">
                    {% if float > 0 %}
                        Owed to schools, waiting for the next payout run.
                    {% else %}
                        Every school is paid up to date.
                    {% endif %}
                </p>
            </div>

            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Collected online</p>
                <p class="money mt-1 text-2xl font-bold text-ink-900">₦{{ collected|number_format(2) }}</p>
                <p class="mt-1 text-xs text-ink-600">Fees credited to schools, all time.</p>
            </div>

            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Charges earned</p>
                <p class="money mt-1 text-2xl font-bold text-ink-900">₦{{ revenue|number_format(2) }}</p>
                <p class="mt-1 text-xs text-ink-600">The flat online-payment charge, on the platform's side.</p>
            </div>

            <div class="rounded-xl border border-ink-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Net after bank cost</p>
                <p class="money mt-1 text-2xl font-bold {{ (net) >= 0 ? 'text-paid' : 'text-failed' }}">₦{{ net|number_format(2) }}</p>
                <p class="mt-1 text-xs text-ink-600">Bank &amp; API cost so far: ₦{{ cost|number_format(2) }}</p>
            </div>
        </div>

        {% if unallocated > 0 %}
            <div class="mt-4 rounded-lg border border-pending/40 bg-pending/5 p-3">
                <p class="text-sm font-semibold text-pending">
                    ₦{{ unallocated|number_format(2) }} received but not matched to a bill
                </p>
                <p class="mt-1 text-xs text-ink-700">
                    The bursar assigns these from the school's credits inbox. Money is safe; it just has no invoice yet.
                </p>
            </div>
        {% endif %}

        <div class="mt-6 rounded-xl border border-ink-200 bg-white">
            <div class="border-b border-ink-100 px-4 py-3">
                <h2 class="text-sm font-bold text-ink-900">By school</h2>
                <p class="mt-1 text-xs text-ink-500">Cash at Paystack overall: ₦{{ cash|number_format(2) }} — our balance, schools' money plus our charges.</p>
            </div>

            {% if rows is empty %}
                <div class="p-6 text-center">
                    <p class="text-sm font-semibold text-ink-700">No active schools</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-[720px] w-full text-left text-sm">
                        <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
                            <tr>
                                <th class="px-4 py-2 font-semibold">School</th>
                                <th class="px-4 py-2 font-semibold text-right">Collected</th>
                                <th class="px-4 py-2 font-semibold text-right">Paid out</th>
                                <th class="px-4 py-2 font-semibold text-right">Held now</th>
                                <th class="px-4 py-2 font-semibold text-right">Charge earned</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-ink-100">
                            {% for row in rows %}
                                <tr>
                                    <td class="px-4 py-3">
                                        <p class="font-semibold text-ink-900">{{ row.school.name }}</p>
                                        <p class="text-xs text-ink-500">{{ row.school.subdomain }}</p>
                                    </td>
                                    {% if row.unreachable is defined %}
                                        <td colspan="4" class="px-4 py-3 text-xs font-semibold text-failed">
                                            Database not reachable — figures excluded from the totals above.
                                        </td>
                                    {% else %}
                                        <td class="money px-4 py-3 text-right text-ink-800">₦{{ row.collected|number_format(2) }}</td>
                                        <td class="money px-4 py-3 text-right text-ink-800">₦{{ row.paidOut|number_format(2) }}</td>
                                        <td class="money px-4 py-3 text-right font-semibold {{ row.held > 0 ? 'text-pending' : 'text-ink-900' }}">
                                            ₦{{ row.held|number_format(2) }}
                                        </td>
                                        <td class="money px-4 py-3 text-right text-ink-800">₦{{ row.revenue|number_format(2) }}</td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <a href="{{ path('landlord_virtual_accounts') }}"
               class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-ink-300 bg-white px-5 text-sm font-semibold text-ink-700 hover:bg-ink-50 sm:w-auto">
                Family accounts (Paystack limit)
            </a>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-ink-500">
            Figures are read from each school's own ledger. Balances are never recomputed from invoices — a bill can be
            edited, a journal entry cannot. Past a few dozen schools this belongs in a nightly roll-up rather than a page load.
        </p>
    </div>
{% endblock %}
