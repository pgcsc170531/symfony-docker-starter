<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Website enquiry</title>
</head>
<body style="margin:0;padding:0;background:#F3F4F6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;">
{# Sent to the SCHOOL, not to a parent: an enquiry from the public website.
   Plain, readable and replyable — tapping Reply goes to the sender when they
   gave an email address, because the mailer sets Reply-To. #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F3F4F6;padding:24px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:10px;">
                <tr>
                    <td style="padding:24px 24px 8px;">
                        <p style="margin:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#6B7280;">{{ school_name }} · website</p>
                        <h1 style="margin:8px 0 0;font-size:20px;line-height:1.3;">New enquiry from {{ sender_name }}</h1>
                        <p style="margin:6px 0 0;font-size:13px;color:#6B7280;">
                            Sent {{ received_at|date('j F Y, H:i') }}
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px 0;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;">
                            <tr>
                                <td style="padding:8px 0;color:#6B7280;width:90px;">Name</td>
                                <td style="padding:8px 0;font-weight:600;">{{ sender_name }}</td>
                            </tr>
                            {% if sender_phone %}
                            <tr>
                                <td style="padding:8px 0;color:#6B7280;border-top:1px solid #F3F4F6;">Phone</td>
                                <td style="padding:8px 0;border-top:1px solid #F3F4F6;">
                                    <a href="tel:{{ sender_phone|replace({' ': '', '-': '', '(': '', ')': ''}) }}" style="color:#111827;text-decoration:none;font-weight:600;">{{ sender_phone }}</a>
                                </td>
                            </tr>
                            {% endif %}
                            {% if sender_email %}
                            <tr>
                                <td style="padding:8px 0;color:#6B7280;border-top:1px solid #F3F4F6;">Email</td>
                                <td style="padding:8px 0;border-top:1px solid #F3F4F6;">
                                    <a href="mailto:{{ sender_email }}" style="color:#111827;text-decoration:none;font-weight:600;">{{ sender_email }}</a>
                                </td>
                            </tr>
                            {% endif %}
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px 24px;">
                        <p style="margin:0 0 6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#6B7280;">Message</p>
                        <div style="padding:14px 16px;background:#F9FAFB;border-left:3px solid #2563EB;border-radius:4px;font-size:14px;line-height:1.6;">
                            {{ sender_message|nl2br }}
                        </div>
                        {% if sender_email %}
                            <p style="margin:16px 0 0;font-size:13px;color:#6B7280;">
                                Reply to this email and your answer goes straight to {{ sender_name }}.
                            </p>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:14px 24px;border-top:1px solid #F3F4F6;">
                        <p style="margin:0;font-size:12px;color:#9CA3AF;">
                            Sent from the {{ school_name }} website contact form.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
