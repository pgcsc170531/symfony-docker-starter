{% extends 'emails/layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#111827;">{{ headline }}</h1>

    <p style="margin:0 0 12px;">Hello{% if guardian_name is defined and guardian_name %} {{ guardian_name }}{% endif %},</p>
    <p style="margin:0 0 20px;">{{ intro }}</p>

    {{ ui.amountBox('Your reference number', reference ?: '—', brand) }}

    {{ ui.rows({
        'Child'          : child_name,
        'Class applied for': requested_class,
        'Received'       : submitted_at ? submitted_at|date('j M Y, g:ia') : null,
        'Status'         : status|replace({'_': ' '})|title,
    }) }}

    {% if fee_due_formatted %}
        {{ ui.note('One more step: this school charges ' ~ fee_due_formatted ~ ' to process an application. Review does not start until that fee is settled. You can pay it from the parent portal.') }}
    {% endif %}

    <p style="margin:0 0 20px;font-size:14px;line-height:1.65;">
        Keep this reference number — it is how you and the school will talk about this application.
        You will get another email the moment there is a decision.
    </p>

    {{ ui.button(button_label, url, brand) }}

    <p style="margin:0;padding-top:16px;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af;line-height:1.6;">
        Questions? Reply to this email or call the school{% if school_phone %} on {{ school_phone }}{% endif %}.
    </p>
{% endblock %}
