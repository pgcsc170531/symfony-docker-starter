{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#111827;">{{ headline }}</h1>

    <p style="margin:0 0 12px;">Hello {{ guardian_name }},</p>
    <p style="margin:0 0 20px;">{{ intro }}</p>

    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 22px;">
        <tr>
            <td align="center" style="background:{{ brand|default('#1e40af') }};border-radius:8px;">
                <a href="{{ url }}"
                   style="display:inline-block;padding:14px 30px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;">
                    {{ button_label }}
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 18px;font-size:13px;color:#6b7280;">
        This link works for {{ expires_minutes }} minutes and can only be used once.
        If you did not request it, you can safely ignore this email — nothing will change.
    </p>

    <p style="margin:0;padding-top:16px;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af;word-break:break-all;">
        Button not working? Copy this address into your browser:<br>
        <span style="color:#6b7280;">{{ url }}</span>
    </p>
{% endblock %}
