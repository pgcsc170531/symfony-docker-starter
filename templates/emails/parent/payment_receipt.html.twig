{% extends 'emails/layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{% block content %}
    <p style="margin:0 0 16px;font-size:34px;line-height:1;">✅</p>

    <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#111827;">{{ headline }}</h1>

    <p style="margin:0 0 12px;">Hello{% if guardian_name is defined and guardian_name %} {{ guardian_name }}{% endif %},</p>
    <p style="margin:0 0 20px;">{{ intro }}</p>

    {{ ui.amountBox('Amount received', '₦' ~ amount|number_format(2), brand) }}

    {{ ui.rows({
        'Receipt / ref' : reference_code,
        'Method'        : method|title,
        'Date'          : paid_at ? paid_at|date('j M Y, g:ia') : null,
        'Child'         : child_name,
        'Invoice'       : invoice_number,
        'Invoice total' : invoice_total > 0 ? '₦' ~ invoice_total|number_format(2) : null,
        'Total paid'    : '₦' ~ invoice_paid|number_format(2),
        'Balance left'  : balance_due > 0 ? '₦' ~ balance_due|number_format(2) : 'Fully settled',
    }) }}

    {% if balance_due > 0 %}
        <p style="margin:0 0 20px;font-size:14px;line-height:1.65;">
            ₦{{ balance_due|number_format(2) }} is still outstanding on this invoice. You can clear it
            any time from the parent portal.
        </p>
    {% else %}
        <p style="margin:0 0 20px;font-size:14px;line-height:1.65;">
            Nothing further is owed on this invoice. Thank you for paying promptly.
        </p>
    {% endif %}

    {{ ui.button(button_label, url, brand) }}

    <p style="margin:0;padding-top:16px;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af;line-height:1.6;">
        Please keep this email — it is your proof of payment.
    </p>
{% endblock %}
