{#
   A searchable select: ONE field, like a native dropdown but you can type.

   The first version put a separate search box above the <select>. It worked,
   but it read as two controls for one question and looked like a form built by
   a machine. This is the modern pattern: the field shows the chosen value, and
   tapping/focusing it turns it into a search that filters a list underneath.

   The native <select> stays in the DOM (visually hidden) because Symfony's
   EntityType submits through it — its `name` is what the server reads. Choosing
   an option sets the select's value and dispatches `change`, so the existing
   country → region → LGA cascades keep working untouched.

   No library. ~5 KB of vanilla JS, keyboard accessible, and it works with the
   native soft keyboard on a phone instead of a 249-row picker.

   Usage:
     {% include '_select_search.html.twig' %}
     <script>
       edusSelectSearch(select, { placeholder: 'Search countries…' });
       // after replacing the select's options yourself:
       select._searchRefresh && select._searchRefresh();
     </script>
#}
<script>
(function () {
    if (window.edusSelectSearch) {
        return;
    }

    /** Case- and accent-insensitive: "cote" finds "Côte d'Ivoire". */
    function normalise(text) {
        return String(text || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase();
    }

    let instances = 0;

    window.edusSelectSearch = function (select, options) {
        options = options || {};

        if (!select || select.dataset.comboReady === '1') {
            return;
        }
        select.dataset.comboReady = '1';

        const instance = ++instances;
        const listId = 'combo-list-' + instance;

        /* ── the visible field ─────────────────────────────────────────── */
        const wrapper = document.createElement('div');
        wrapper.className = 'relative';

        const input = document.createElement('input');
        input.type = 'text';
        input.autocomplete = 'off';
        input.spellcheck = false;
        input.setAttribute('role', 'combobox');
        input.setAttribute('aria-expanded', 'false');
        input.setAttribute('aria-controls', listId);
        input.setAttribute('aria-autocomplete', 'list');
        input.setAttribute('aria-label', options.label || 'Search this list');
        input.placeholder = options.placeholder || '';
        input.className = 'block w-full cursor-pointer rounded-lg border border-ink-300 bg-white px-3 pr-10 text-base text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500';
        input.style.minHeight = '44px';

        const chevron = document.createElement('span');
        chevron.setAttribute('aria-hidden', 'true');
        chevron.className = 'pointer-events-none absolute inset-y-0 right-3 flex items-center text-ink-400';
        chevron.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>';

        const list = document.createElement('ul');
        list.id = listId;
        list.setAttribute('role', 'listbox');
        list.className = 'absolute left-0 right-0 z-30 mt-1 hidden max-h-64 overflow-y-auto rounded-lg border border-ink-200 bg-white py-1 text-sm shadow-card';

        /* the real field, hidden but still submitted */
        select.style.display = 'none';
        select.parentNode.insertBefore(wrapper, select);
        wrapper.appendChild(input);
        wrapper.appendChild(chevron);
        wrapper.appendChild(list);
        wrapper.appendChild(select);

        let items = [];       // [{ value, text }] — including the placeholder
        let filtered = [];
        let active = -1;
        let open = false;

        function readOptions() {
            items = Array.from(select.options).map(function (option) {
                return { value: option.value, text: option.textContent };
            });
        }

        function selectedText() {
            const match = items.find(function (item) { return item.value === select.value; });
            return match ? match.text : (items[0] ? items[0].text : '');
        }

        function isPlaceholderSelected() {
            return select.value === '';
        }

        function paintInput() {
            input.value = selectedText();
            input.classList.toggle('text-ink-400', isPlaceholderSelected());
            input.classList.toggle('text-ink-900', !isPlaceholderSelected());
        }

        function syncDisabled() {
            const disabled = select.disabled;
            input.disabled = disabled;
            input.classList.toggle('opacity-60', disabled);
            input.classList.toggle('cursor-not-allowed', disabled);
        }

        /* ── the listbox ───────────────────────────────────────────────── */
        function render() {
            list.innerHTML = '';
            filtered.forEach(function (item, index) {
                const row = document.createElement('li');
                row.setAttribute('role', 'option');
                row.id = listId + '-' + index;
                row.setAttribute('aria-selected', String(item.value === select.value));
                row.className = 'flex cursor-pointer items-center justify-between gap-2 px-3 py-2.5 text-ink-800 hover:bg-ink-50';
                row.style.minHeight = '44px';
                if (index === active) {
                    row.classList.add('bg-accent-50', 'text-accent-900');
                    input.setAttribute('aria-activedescendant', row.id);
                }
                if (item.value === select.value) {
                    row.classList.add('font-semibold');
                }

                const label = document.createElement('span');
                label.className = 'truncate';
                label.textContent = item.text;
                row.appendChild(label);

                if (item.value === select.value) {
                    const tick = document.createElement('span');
                    tick.className = 'text-accent-600';
                    tick.textContent = '✓';
                    row.appendChild(tick);
                }

                // mousedown, not click: preventDefault keeps focus in the input so
                // the list does not close before the choice is registered.
                row.addEventListener('mousedown', function (event) {
                    event.preventDefault();
                    choose(item);
                });

                list.appendChild(row);
            });

            if (filtered.length === 0) {
                const empty = document.createElement('li');
                empty.className = 'px-3 py-3 text-ink-500';
                empty.textContent = 'No match';
                list.appendChild(empty);
            }
        }

        function openList() {
            if (open || select.disabled) {
                return;
            }

            open = true;
            active = -1;
            input.value = '';
            input.classList.remove('text-ink-400');
            list.classList.remove('hidden');
            input.setAttribute('aria-expanded', 'true');

            filtered = items.slice();
            render();
        }

        function closeList() {
            if (!open) {
                return;
            }

            open = false;
            list.classList.add('hidden');
            input.setAttribute('aria-expanded', 'false');
            input.removeAttribute('aria-activedescendant');
            paintInput();
        }

        function choose(item) {
            if (!item) {
                return;
            }

            if (select.value !== item.value) {
                select.value = item.value;
                // The cascades (country → region → LGA) listen for this.
                select.dispatchEvent(new Event('change', { bubbles: true }));
            }

            closeList();
            input.blur();
        }

        function filter(query) {
            const q = normalise(query).trim();
            const placeholders = items.filter(function (item) { return item.value === ''; });
            const matches = items.filter(function (item) {
                return item.value !== '' && (q === '' || normalise(item.text).indexOf(q) !== -1);
            });

            if (q === '') {
                filtered = items.slice();
            } else {
                // Keep the empty option so the field can still be cleared, but if
                // nothing really matches say so instead of showing the placeholder.
                filtered = matches.length > 0 ? placeholders.concat(matches) : [];
            }

            active = filtered.length > 1 ? 1 : 0;
            render();
        }

        function move(delta) {
            if (!open) {
                openList();
                return;
            }

            if (filtered.length === 0) {
                return;
            }

            active = (active + delta + filtered.length) % filtered.length;
            render();

            const row = list.children[active];
            if (row && row.scrollIntoView) {
                row.scrollIntoView({ block: 'nearest' });
            }
        }

        /* ── events ────────────────────────────────────────────────────── */
        input.addEventListener('focus', openList);
        input.addEventListener('click', openList);
        input.addEventListener('input', function () { filter(this.value); });

        input.addEventListener('keydown', function (event) {
            if (event.key === 'ArrowDown') {
                event.preventDefault();
                move(1);
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                move(-1);
            } else if (event.key === 'Enter') {
                event.preventDefault();
                choose(filtered[active > -1 ? active : 0]);
            } else if (event.key === 'Escape') {
                event.preventDefault();
                closeList();
                input.blur();
            } else if (event.key === 'Tab') {
                closeList();
            }
        });

        input.addEventListener('blur', function () {
            // A mousedown on an option runs first and closes deliberately; this is
            // for every other way of leaving the field.
            window.setTimeout(closeList, 120);
        });

        readOptions();
        paintInput();
        syncDisabled();

        // Let the cascades tell this field that its options were replaced.
        select._searchRefresh = function () {
            readOptions();
            syncDisabled();
            paintInput();

            if (open) {
                filtered = items.slice();
                active = -1;
                render();
            }
        };
    };
})();
</script>
