{# ── Edus design tokens — the single source of truth ─────────────────────────
   Tailwind here is the runtime CDN, so every colour lives in this config.
   A colour that is NOT in it produces **no CSS at all** — the class fails
   silently, with no error anywhere. See docs/architecture/UI-SPEC.md §2.

   Must be included AFTER the `cdn.tailwindcss.com` script, and included by
   every standalone document: base.html.twig AND the auth pages (which do not
   extend the shell).
#}
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    sans: ['-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto',
                           'Helvetica Neue', 'Arial', 'sans-serif'],
                },
                colors: {
                    accent: { 50: '#EFF6FF', 100: '#DBEAFE', 200: '#BFDBFE', 300: '#93C5FD',
                              400: '#60A5FA', 500: '#3B82F6', 600: '#2563EB', 700: '#1D4ED8',
                              800: '#1E40AF', 900: '#1E3A8A' },
                    ink:    { 50: '#F9FAFB', 100: '#F3F4F6', 200: '#E5E7EB', 300: '#D1D5DB',
                              400: '#9CA3AF', 500: '#6B7280', 600: '#4B5563', 700: '#374151',
                              800: '#1F2937', 900: '#111827' },
                    paid: '#059669',
                    pending: '#D97706',
                    failed: '#DC2626',
                },
                borderRadius: { DEFAULT: '0.625rem', lg: '0.75rem' },
