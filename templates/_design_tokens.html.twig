</script>

{# The phone rules the app shell enforces, repeated here so a standalone page
   cannot drift from them: no iOS zoom on focus, and thumb-sized controls —
   selects and text fields included, since a short select is as un-tappable as a
   short button. #}
<style>
    @media (max-width: 767.98px) {
        input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
        select,
        textarea {
            font-size: 16px !important;
        }
        button,
        input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
        select,
        textarea {
            min-height: 44px;
        }
    }
</style>
