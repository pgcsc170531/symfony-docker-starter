{# Public error page. Standalone by design: an error must render even when the
   app shell, the tenant database or the session is the thing that failed. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#111827">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ title }} — Edus</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% include '_design_tokens.html.twig' %}
    <style>body { background-color: #F9FAFB; }</style>
</head>
<body class="flex min-h-screen flex-col">

    <main class="flex flex-1 items-center justify-center px-4 py-10">
        <div class="w-full max-w-md rounded-xl border border-ink-200 bg-white p-6 shadow-card">
            <div class="text-center">
                <p class="text-5xl font-bold tabular text-ink-200">{{ code }}</p>
                <h1 class="mt-3 text-xl font-bold text-ink-900">{{ title }}</h1>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">{{ message }}</p>
            </div>

            {# A sentence the application wrote deliberately — "The active term has no
               start or end date" is fixable; "We could not find that page" is not. #}
            {% if reason is defined and reason %}
                <div class="mt-4 rounded-lg border border-pending/40 bg-pending/5 p-3">
                    <p class="text-[11px] font-black uppercase tracking-wide text-ink-500">What actually happened</p>
                    <p class="mt-1 break-words text-sm font-semibold leading-relaxed text-ink-800">{{ reason }}</p>
                </div>
            {% endif %}

            {% if hint is defined and hint %}
                <div class="mt-3 rounded-lg border border-ink-200 bg-ink-50 p-3">
                    <p class="text-[11px] font-black uppercase tracking-wide text-ink-500">What to do</p>
                    <p class="mt-1 break-words text-sm leading-relaxed text-ink-700">{{ hint }}</p>
                </div>
            {% endif %}

            <div class="mt-6 flex flex-col gap-2">
                {% if app.user %}
                    <a href="{{ path('app_tenant_dashboard') }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700">
                        Back to dashboard
                    </a>
                    <a href="{{ path('app_logout') }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-700 transition hover:border-accent-400 hover:text-accent-700">
                        Sign out
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700">
                        Go to sign in
                    </a>
                {% endif %}
            </div>

            {# What to quote when you call the office: the page you were on, and a
               short code for this failure. Neither reveals how the server is built,
               and two people hitting the same broken screen quote the same code. #}
            {% set shownPath = app.request is defined ? app.request.pathinfo : null %}
            {% if shownPath or (reference is defined and reference) %}
                <p class="mt-5 break-all text-center text-[11px] leading-relaxed text-ink-400">
                    {% if shownPath %}{{ shownPath }}{% endif %}
                    {% if shownPath and reference is defined and reference %} · {% endif %}
                    {% if reference is defined and reference %}Quote {{ reference }}{% endif %}
                </p>
            {% endif %}
        </div>
    </main>

    <footer class="border-t border-ink-200 bg-white px-4 py-5 text-center">
        <a href="https://edus.ng" target="_blank" rel="noopener"
           class="inline-flex items-center text-ink-700 hover:text-accent-700">
            {% import '_brand.html.twig' as brand %}
            {{ brand.wordmark('sm') }}
        </a>
        <p class="mt-1 text-xs text-ink-500">The school operating system</p>
    </footer>

</body>
</html>
