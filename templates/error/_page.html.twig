{# Public error page. Standalone by design: an error must render even when the
   app shell, the tenant database or the session is the thing that failed. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#111827">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ title }} — Edus</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% include '_design_tokens.html.twig' %}
    <style>body { background-color: #F9FAFB; }</style>
</head>
<body class="flex min-h-screen flex-col">

    <main class="flex flex-1 items-center justify-center px-4 py-10">
        <div class="w-full max-w-md rounded-xl border border-ink-200 bg-white p-6 text-center shadow-card">
            <p class="text-5xl font-bold tabular text-ink-200">{{ code }}</p>
            <h1 class="mt-3 text-xl font-bold text-ink-900">{{ title }}</h1>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{{ message }}</p>

            <div class="mt-6 flex flex-col gap-2">
                {% if app.user %}
                    <a href="{{ path('app_tenant_dashboard') }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700">
                        Back to dashboard
                    </a>
                    <a href="{{ path('app_logout') }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink-300 px-5 text-sm font-semibold text-ink-700 transition hover:border-accent-400 hover:text-accent-700">
                        Sign out
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent-600 px-5 font-semibold text-white transition hover:bg-accent-700">
                        Go to sign in
                    </a>
                {% endif %}
            </div>
        </div>
    </main>

    <footer class="border-t border-ink-200 bg-white px-4 py-5 text-center">
        <a href="https://edus.ng" target="_blank" rel="noopener"
           class="inline-flex items-center text-ink-700 hover:text-accent-700">
            {% import '_brand.html.twig' as brand %}
            {{ brand.wordmark('sm') }}
        </a>
        <p class="mt-1 text-xs text-ink-500">The school operating system</p>
    </footer>

</body>
</html>
