{% extends 'security/auth_layout.html.twig' %}

{% block title %}Choose a new password{% endblock %}

{% block heading %}{{ token ? 'Choose a new password' : 'That link has expired' }}{% endblock %}
{% block lede %}
    {% if token %}
        Signing in as <span class="break-all font-semibold text-ink-800">{{ email }}</span>.
    {% else %}
        Reset links work once, for one hour.
    {% endif %}
{% endblock %}

{% block card %}
    {% if token is empty %}
        <p class="text-sm text-ink-700">
            Ask for a fresh link and we will email a new one.
        </p>
        <a href="{{ path('app_forgot_password') }}"
           class="mt-4 flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">
            Send me a new link
        </a>
    {% else %}
        {% if error %}
            <div class="mb-4 rounded-lg border border-failed/30 bg-red-50 p-3 text-sm text-failed" role="alert">
                {{ error }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_reset_password', {token: token}) }}" class="space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">

            <div>
                <label for="password" class="block text-sm font-semibold text-ink-800">New password</label>
                <input id="password" name="password" type="password" required minlength="8"
                       autocomplete="new-password"
                       class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2.5 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
                <p class="mt-1 text-xs text-ink-500">At least 8 characters.</p>
            </div>

            <div>
                <label for="password_confirm" class="block text-sm font-semibold text-ink-800">Type it again</label>
                <input id="password_confirm" name="password_confirm" type="password" required minlength="8"
                       autocomplete="new-password"
                       class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2.5 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
            </div>

            <button type="submit"
                    class="flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">
                Save new password
            </button>
        </form>
    {% endif %}
{% endblock %}
