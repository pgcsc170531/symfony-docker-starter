<!DOCTYPE html>
<html class="h-full bg-white">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ school is defined and school ? school.name : 'School Portal Login' }}</title>
    <script src="https://cdn.tailwindcss.com"></script>

    {# This page is a standalone document — it does not extend base.html.twig, so it
       has to pull the design tokens in itself or `ink-*` / `accent-*` render as
       nothing at all. #}
    {% include '_design_tokens.html.twig' %}
    {# 1. DYNAMIC FAVICON #}
    {% if school is defined and school and school.logoFilename %}
        <link rel="icon" href="{{ asset('uploads/logos/' ~ school.logoFilename) }}">
    {% else %}
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/brand/edus-favicon.svg') }}">
    {% endif %}

    {# 2. DYNAMIC BRANDING COLORS #}
    {% if school is defined and school and school.primaryColor %}
    <style>
        /* Override specific Tailwind-like classes with School Color */
        .bg-brand { background-color: {{ school.primaryColor }} !important; }
        .text-brand { color: {{ school.primaryColor }} !important; }
        .border-brand { border-color: {{ school.primaryColor }} !important; }
        .ring-brand:focus { --tw-ring-color: {{ school.primaryColor }} !important; }
        
        /* Button Hover Effect (Darken slightly) */
        .btn-brand {
            background-color: {{ school.primaryColor }};
        }
        .btn-brand:hover {
            filter: brightness(85%);
        }
    </style>
    {% else %}
    <style>
        /* Default Fallback (Blue-900) */
        .bg-brand { background-color: #1e3a8a; } 
        .text-brand { color: #1e3a8a; }
        .border-brand { border-color: #1e3a8a; }
        .btn-brand { background-color: #1e3a8a; }
        .btn-brand:hover { background-color: #1e40af; }
    </style>
    {% endif %}
</head>
<body class="h-full">

<div class="flex min-h-full">
    
    {# === LEFT SIDE: VISUAL (Now uses School Color) === #}
    <div class="relative hidden w-0 flex-1 lg:block bg-brand">
        <div class="absolute inset-0 h-full w-full object-cover" 
             style="background-image: url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1350&q=80'); 
                    background-size: cover; background-position: center; opacity: 0.2; mix-blend-mode: multiply;">
        </div>
        
        <div class="relative z-10 flex flex-col justify-center h-full px-12 text-white">
            <h2 class="text-4xl font-bold mb-4">
                {{ school is defined and school ? school.name : 'Welcome Back' }}
            </h2>
            <p class="text-lg text-white/80">
                {% if school is defined and school and school.motto %}
                    "{{ school.motto }}"
                {% else %}
                    Manage your school, students, and finances all in one secure place.
                {% endif %}
            </p>
        </div>
    </div>

    {# === RIGHT SIDE: LOGIN FORM === #}
    {#
        This is the page's <main>, and the form has the only <h1>. It used to be
        a plain div with an <h2>, so a screen reader found no main landmark and
        no page heading at all.
    #}
    <main class="flex flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:flex-none lg:px-20 xl:px-24 bg-ink-50">
        <div class="mx-auto w-full max-w-sm lg:w-96">
            
            <div class="text-center lg:text-left">
                {# The SCHOOL's identity only — the brand is in the footer below. #}
                <div class="mb-4 flex flex-col items-center gap-2.5 lg:flex-row">
                    {% if school is defined and school and school.logoFilename %}
                        <img src="{{ asset('uploads/logos/' ~ school.logoFilename) }}" alt=""
                             class="h-14 w-14 shrink-0 rounded-lg object-contain">
                    {% elseif school is defined and school %}
                        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-lg bg-accent-600 text-xl font-bold text-white" aria-hidden="true">{{ school.name|slice(0, 1)|upper }}</span>
                    {% endif %}

                    <div class="min-w-0">
                        {% if school is defined and school %}
                            <p class="truncate text-lg font-semibold leading-tight text-ink-900">{{ school.name }}</p>
                            {% if school.motto %}
                                <p class="truncate text-xs text-ink-500">{{ school.motto }}</p>
                            {% endif %}
                        {% else %}
                            {% import '_brand.html.twig' as brand %}
                            {{ brand.wordmark('xl') }}
                        {% endif %}
                    </div>
                </div>

                <h1 class="text-2xl font-semibold tracking-tight text-ink-900">
                    {{ school is defined and school ? 'Sign In' : 'Staff Portal' }}
                </h1>
                <p class="mt-1 text-sm text-ink-600">
                    Please sign in to access your dashboard.
                </p>
            </div>

            <div class="mt-8">
                <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-200">
                    
                    <form action="{{ path('app_login') }}" method="post" class="space-y-6">
                        
                        {# ERROR ALERT #}
                        {% if error %}
                            <div class="rounded-md bg-red-50 p-4 border border-red-200 mb-4">
                                <div class="flex">
                                    <div class="flex-shrink-0 text-red-400">🚫</div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-red-800">Login Failed</h3>
                                        <div class="mt-1 text-sm text-red-700">
                                            {{ error.messageKey|trans(error.messageData, 'security') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
                            <div class="mt-1">
                                <input id="email" name="_username" type="email" autocomplete="email" required 
                                       value="{{ last_username }}"
                                       placeholder="e.g. principal@school.com"
                                       class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none ring-brand focus:ring-1 focus:ring-indigo-500 sm:text-sm">
                            </div>
                        </div>

                        <div>
                            <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
                            <div class="mt-1">
                                <input id="password" name="_password" type="password" autocomplete="current-password" required 
                                       class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none ring-brand focus:ring-1 focus:ring-indigo-500 sm:text-sm">
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div>
                            {# 4. DYNAMIC BUTTON COLOR #}
                            <button type="submit" class="flex w-full justify-center rounded-md border border-transparent btn-brand py-2 px-4 text-sm font-medium text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors">
                                Sign in to Portal
                            </button>
                        </div>
                    </form>

                </div>

                {#
                    A parent who lands here by mistake has no route back to the
                    school they were reading about. The school website lives on
                    the same host, at `/`. The login route is host-agnostic, so
                    the subdomain is not a route attribute — the host itself is
                    the address of the school. Only shown when we know the school.
                #}
                {% if school is defined and school %}
                    <a href="{{ app.request.schemeAndHttpHost }}/"
                       class="mt-4 inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-ink-700 hover:text-ink-900">
                        <span aria-hidden="true">&larr;</span> Back to {{ school.name }}
                    </a>
                {% endif %}
                
                {# The brand sits at the BOTTOM, with the credit — never at the top.
                   The wordmark IS the brand: no mark beside it.

                   Brand on the left, maker on the right, space between them.
                   "Powered by" credits the COMPANY that builds and runs Edus, not
                   the product itself — repeating "edus.ng" next to the wordmark
                   said the same thing twice.

                   📱 On a phone both halves stay on ONE row: the tagline drops
                   (it is already in the page title) so the wordmark and the
                   company name each get a side, and nothing has to shrink below
                   11px to fit 320px. #}
                <div class="mt-6 flex items-center justify-between gap-4 border-t border-ink-200 pt-4">
                    {% import '_brand.html.twig' as brand %}
                    <span class="inline-flex shrink-0 flex-col leading-tight">
                        {{ brand.wordmark('md') }}
                        <span class="mt-1.5 hidden text-xs text-ink-500 sm:block">The school operating system</span>
                    </span>
                    <p class="text-right text-[11px] leading-tight text-ink-500">
                        Powered by
                        <span class="block font-semibold text-ink-700">Mu'ammil Web Services Limited</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>