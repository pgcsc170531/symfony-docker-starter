{% extends 'security/auth_layout.html.twig' %}

{% block title %}Reset your password{% endblock %}
{% block heading %}{{ sent ? 'Check your inbox' : 'Reset your password' }}{% endblock %}
{% block lede %}
    {% if sent %}
        If we hold a mailbox for that account, a reset link is on its way.
    {% else %}
        Enter the email address or the phone number you sign in with.
    {% endif %}
{% endblock %}

{% block card %}
    {% if sent %}
        <p class="text-sm text-ink-700">
            The link works for 60 minutes and can only be used once.
        </p>

        <div class="mt-4 rounded-lg bg-ink-50 p-3 text-xs leading-relaxed text-ink-600">
            <strong class="text-ink-800">No email?</strong>
            A login created from a phone number, such as
            <span class="break-all font-mono">8031234567@edus.ng</span>, has no mailbox.
            Ask the school office to reset it, or sign in and add your own email under
            <strong>My account</strong> so this works next time.
        </div>
    {% else %}
        <form method="post" action="{{ path('app_forgot_password') }}" class="space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">

            <div>
                <label for="contact" class="block text-sm font-semibold text-ink-800">Email or phone number</label>
                <input id="contact" name="contact" type="text" required
                       autocomplete="username" inputmode="text" autocapitalize="none" spellcheck="false"
                       placeholder="e.g. 08031234567 or you@example.com"
                       class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2.5 text-base text-ink-900 placeholder-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200">
            </div>

            <button type="submit"
                    class="flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent-600 px-4 text-sm font-semibold text-white hover:bg-accent-700">
                Send reset link
            </button>
        </form>
    {% endif %}
{% endblock %}
