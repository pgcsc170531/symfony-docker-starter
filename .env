# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST — everything in this block MUST be set on the server,
# in real environment variables (they win over every .env file):
#
#   APP_SECRET=<32 random chars>      php -r "echo bin2hex(random_bytes(16));"
#   APP_ENV=prod  APP_DEBUG=0
#   DATABASE_URL=mysql://user:pass@host:3306/landlord_db?serverVersion=8.0
#   MAILER_DSN=smtp://KEY:SECRET@smtp-relay.brevo.com:587   (see docs/operations/EMAIL-SETUP.md)
#   MAILER_FROM="Edus <no-reply@edus.ng>"   MAILER_REPLY_TO="support@edus.ng"
#   DEFAULT_URI=https://edus.ng
#
# And two processes must run (docs/operations/EMAIL-SETUP.md §9):
#   php bin/console messenger:consume async   — sends queued email
#   php bin/console app:tenant:update-schema  — after every deploy that adds a column
# ─────────────────────────────────────────────────────────────────────────────
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
# Production default. Local development overrides this in .env.local (gitignored)
# and docker-compose forces APP_ENV=dev for the dev containers.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###> doctrine/doctrine-bundle ###
# 1. THE TENANT DB (Dynamic)
# We set this to a "dummy" default (school_a) for local testing.
DATABASE_URL="mysql://root:root@database:3306/school_a?serverVersion=8.0&charset=utf8mb4"

# 2. THE LANDLORD DB (Static)
# This always connects to the main admin database.
LANDLORD_DATABASE_URL="mysql://root:root@database:3306/landlord_db?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# The queue lives in the LANDLORD database on purpose: one worker then serves
# every school, instead of one consumer per tenant database. Mail is queued here
# and sent in the background (see config/packages/messenger.yaml).
MESSENGER_TRANSPORT_DSN=doctrine://landlord?auto_setup=0
###< symfony/messenger ###

# Edus's own collection account, printed on the payment page and invoice PDFs.
# Leave empty in development: the page then says "ask us for details" instead of
# showing an account number nobody can pay into.
# EDUS_BANK_NAME="Guaranty Trust Bank"
# EDUS_BANK_ACCOUNT="0000000000"
# EDUS_BANK_ACCOUNT_NAME="Edus Limited"

###> symfony/mailer ###
# DEV default: every message lands in Mailpit — read it at http://localhost:8025.
# This is a real DSN rather than `null://null` so that a fresh clone can SEE the
# emails the app sends instead of discarding them silently. It only resolves
# inside the compose network; outside Docker it fails loudly, which is the point.
#
# To send real mail, put the Brevo DSN in `.env.local` (gitignored) — that file
# loads after this one and therefore wins. compose.yaml no longer overrides it.
# The app resolves this scheme itself: the real SMTP server is read from
# Admin → Settings → Email (landlord DB), then this environment, then the
# fallback below. That is what lets the password be changed without a deploy.
MAILER_DSN=platform://default

# Last resort when neither the database nor the Brevo pair below is set.
# Points at Mailpit so a fresh clone can SEE the mail the app sends.
MAILER_FALLBACK_DSN=smtp://mailer:1025

# ── Brevo (production) ─────────────────────────────────────────────────
# Fill these two values (or put them in .env.local, which is gitignored) and the
# DSN below composes itself. Brevo shows BOTH under SMTP & API → SMTP tab:
#   • SMTP login  → looks like 9xxxxxx001@smtp-brevo.com  (NOT your Gmail address)
#   • SMTP key    → starts with "xsmtpsib-"
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# MAILER_DSN="smtp://${BREVO_SMTP_LOGIN}:${BREVO_SMTP_KEY}@smtp-relay.brevo.com:587"

# ── Encryption for stored secrets ──────────────────────────────────────
# Encrypts the Paystack key and SMTP password saved from the landlord settings
# screen (/admin/settings). Generate one with:
#   php bin/console app:platform:make-key
# Put the value in .env.local on a laptop, and in the server environment in
# production. Keep a copy: without it, saved secrets must be re-entered.
APP_ENCRYPTION_KEY=

# Must be a verified sender/domain in Brevo, otherwise Brevo rejects the message.
MAILER_FROM="Edus <no-reply@edus.ng>"
MAILER_REPLY_TO="support@edus.ng"
###< symfony/mailer ###

